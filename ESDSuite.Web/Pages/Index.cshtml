    async function loadDashboardMetrics() {
        try {
            const res = await fetch('/api/dashboard-metrics');
            if (!res.ok) return;
            const data = await res.json();

            if (document.getElementById('dash-total-assets')) document.getElementById('dash-total-assets').innerText = data.totalAssets ?? 0;
            if (document.getElementById('dash-total-floors')) document.getElementById('dash-total-floors').innerText = data.totalFloors ?? 0;
            if (document.getElementById('dash-total-grounding')) document.getElementById('dash-total-grounding').innerText = data.totalGrounding ?? 0;
            if (document.getElementById('dash-total-entrance')) document.getElementById('dash-total-entrance').innerText = data.totalEntrance ?? 0;

            if (data.assetsData && Array.isArray(data.assetsData)) {
                renderDashboardChart(data.assetsData);
            }
