                const isPass = r.status_result === 'PASS';
                const statusBadge = isPass
                    ? `<span class="badge-pass" style="font-size:11px; padding:3px 8px;">PASS</span>`
                    : `<span class="badge-fail" style="font-size:11px; padding:3px 8px;">FAIL</span>`;

                const readLFmt = formatResistanceScientific(r.reading_left);
                const refLFmt = formatResistanceScientific(r.reference_left);
                let devL = r.deviation_left != null ? parseFloat(r.deviation_left) : 0;

                const readRFmt = formatResistanceScientific(r.reading_right);
                const refRFmt = formatResistanceScientific(r.reference_right);
                let devR = r.deviation_right != null ? parseFloat(r.deviation_right) : 0;

                // Normalize any legacy anomalous raw values from early test data
                if (devL > 100 && isPass && r.reading_left > 0 && r.reference_left > 0) {
                    const logDiff = Math.abs(Math.log10(r.reading_left) - Math.log10(r.reference_left));
                    devL = (logDiff / 9.0) * 100.0;
                }
                if (devR > 100 && isPass && r.reading_right > 0 && r.reference_right > 0) {
                    const logDiff = Math.abs(Math.log10(r.reading_right) - Math.log10(r.reference_right));
                    devR = (logDiff / 9.0) * 100.0;
                }

                const chkAbbr = t('infra.lbl_chk_abbr', 'Chk');
                const refAbbr = t('infra.lbl_ref_abbr', 'Ref');
                const btnLabel = t('settings.chk_btn_details', 'View Details');

                html += `<tr style="cursor:pointer;" onclick="openCheckerDetailCardByIdx(${idx})">
                    <td style="font-size:12px;"><b>${dateStr}</b></td>
                    <td style="font-size:12.5px; font-weight:700; color:var(--accent-blue);">${r.checker_id || '-'}</td>
                    <td style="font-size:12px;">
                        <span>${chkAbbr}: <b>${readLFmt}</b> Ω</span><br/>
                        <span style="color:var(--text-muted); font-size:11px;">${refAbbr}: ${refLFmt} Ω</span>
                    </td>
                    <td style="text-align:center; font-weight:700; color:${devL <= 5.0 ? 'var(--accent-emerald)' : 'var(--accent-rose)'};">${devL.toFixed(2)}%</td>
                    <td style="font-size:12px;">
                        <span>${chkAbbr}: <b>${readRFmt}</b> Ω</span><br/>
                        <span style="color:var(--text-muted); font-size:11px;">${refAbbr}: ${refRFmt} Ω</span>
                    </td>
                    <td style="text-align:center; font-weight:700; color:${devR <= 5.0 ? 'var(--accent-emerald)' : 'var(--accent-rose)'};">${devR.toFixed(2)}%</td>
                    <td style="text-align:center;">${statusBadge}</td>
                    <td style="text-align:center;">
                        <button type="button" class="btn-primary" style="font-size:11px; padding:3px 8px; background:var(--bg-secondary); color:var(--text-primary); border:1px solid var(--border-color);" onclick="event.stopPropagation(); openCheckerDetailCardByIdx(${idx})">🔍 ${btnLabel}</button>
                    </td>
                </tr>`;
            });

            html += `</tbody></table></div>`;
            container.innerHTML = html;
        } catch(e) {
            console.error('Error loading checkers history:', e);
        }
    }

    function openCheckerDetailCardByIdx(idx) {
        if (!lastCheckersList || !lastCheckersList[idx]) return;
        const item = lastCheckersList[idx];

        const modal = document.getElementById('modal-checker-card');
        if (!modal) return;

        const isPass = item.status_result === 'PASS';
        const dateStr = item.measured_at ? new Date(item.measured_at).toLocaleDateString() + ' ' + new Date(item.measured_at).toLocaleTimeString([], {hour:'2-digit', minute:'2-digit', second:'2-digit'}) : '-';

        // Populate card fields
        document.getElementById('chk-card-modal-id').innerText = item.checker_id || 'CHECKER';
        document.getElementById('chk-card-modal-site').innerText = item.site_name || (sessionData && sessionData.site_name) || 'Planta Queretaro';
        document.getElementById('chk-card-modal-loc').innerText = item.location || 'Acceso Principal ESD';
        document.getElementById('chk-card-modal-date').innerText = dateStr;
        document.getElementById('chk-card-modal-auditor').innerText = item.auditor_name || (sessionData && sessionData.user_name) || 'Auditor ESD';
        document.getElementById('chk-card-modal-equipment').innerText = item.equipment_name || item.equipment_code || 'Megóhmetro Digital TR53 (Patrón de Calibración)';

        const devL = item.deviation_left != null ? parseFloat(item.deviation_left) : 0;
        const devR = item.deviation_right != null ? parseFloat(item.deviation_right) : 0;

        document.getElementById('chk-card-modal-read-l').innerText = formatResistanceScientific(item.reading_left) + ' Ω';
        document.getElementById('chk-card-modal-ref-l').innerText = formatResistanceScientific(item.reference_left) + ' Ω';
        document.getElementById('chk-card-modal-dev-l').innerText = devL.toFixed(2) + '%';
        document.getElementById('chk-card-modal-dev-l').style.color = devL <= 5.0 ? '#10B981' : '#EF4444';

        document.getElementById('chk-card-modal-read-r').innerText = formatResistanceScientific(item.reading_right) + ' Ω';
        document.getElementById('chk-card-modal-ref-r').innerText = formatResistanceScientific(item.reference_right) + ' Ω';
        document.getElementById('chk-card-modal-dev-r').innerText = devR.toFixed(2) + '%';
        document.getElementById('chk-card-modal-dev-r').style.color = devR <= 5.0 ? '#10B981' : '#EF4444';

        const maxDev = Math.max(devL, devR);
        document.getElementById('chk-card-modal-max-dev').innerText = maxDev.toFixed(2) + '%';
        document.getElementById('chk-card-modal-max-dev').style.color = maxDev <= 5.0 ? '#10B981' : '#EF4444';

        const statusBadgeEl = document.getElementById('chk-card-modal-status');
        if (isPass) {
            statusBadgeEl.className = 'badge-pass';
            statusBadgeEl.innerHTML = `🟢 PASS (${t('infra.chk_pass_tag', 'CALIBRACIÓN CONFORME ≤ 5.0%')})`;
        } else {
            statusBadgeEl.className = 'badge-fail';
            statusBadgeEl.innerHTML = `🔴 FAIL (${t('infra.chk_fail_tag', 'DESVIACIÓN SUPERIOR AL 5.0%')})`;
        }

        const notesText = item.observations && item.observations.trim() !== '' ? item.observations : t('settings.chk_card_no_notes', 'Sin notas adicionales.');
        document.getElementById('chk-card-modal-notes').innerText = notesText;

        const photoContainer = document.getElementById('chk-card-modal-photo-box');
        const photoImg = document.getElementById('chk-card-modal-photo-img');
        const noPhotoMsg = document.getElementById('chk-card-modal-no-photo');

        if (item.evidence_url && item.evidence_url.trim() !== '') {
            photoImg.onerror = function() {
                this.style.display = 'none';
                if (noPhotoMsg) {
                    noPhotoMsg.style.display = 'flex';
                }
            };
            photoImg.onload = function() {
                this.style.display = 'block';
                if (noPhotoMsg) {
                    noPhotoMsg.style.display = 'none';
                }
            };
            photoImg.src = item.evidence_url;
            photoImg.style.display = 'block';
            if (noPhotoMsg) noPhotoMsg.style.display = 'none';
        } else {
            photoImg.style.display = 'none';
            if (noPhotoMsg) noPhotoMsg.style.display = 'flex';
        }

        modal.style.display = 'flex';
        applyTranslations();
    }

    document.getElementById('form-infra-checkers').onsubmit = async function(e) {
        e.preventDefault();
        const chkId = document.getElementById('chk-id').value.trim();
        if (!chkId) {
            alert('Por favor ingresa el ID del Checador de Entrada.');
            return;
        }
        const refL = parseFloat(document.getElementById('chk-ref-l').value);
        const readL = parseFloat(document.getElementById('chk-read-l').value);
        const refR = parseFloat(document.getElementById('chk-ref-r').value);
        const readR = parseFloat(document.getElementById('chk-read-r').value);

        if (isNaN(refL) || isNaN(readL) || isNaN(refR) || isNaN(readR)) {
            alert('Por favor completa todas las mediciones de los canales izquierdo y derecho (Checador y Megóhmetro).');
            return;
        }

        const minR = parseFloat(document.getElementById('chk-range-min').value) || 1e3;
        const maxR = parseFloat(document.getElementById('chk-range-max').value) || 1e12;
        const obs = document.getElementById('chk-obs').value.trim();
        const equipment_id = document.getElementById('chk-meg-ref-select')?.value || document.getElementById('chk-meg-ref-id')?.value || '';
        const evidence_url = document.getElementById('chk-photo-url')?.value || '';

        try {
            const res = await fetch('/api/infra/checkers', {
                method: 'POST',
                headers: { 
                    'Content-Type': 'application/json',
                    'X-User-Id': (sessionData && sessionData.user_id) || '',
                    'X-User-Role': (sessionData && sessionData.user_role) || ''
                },
                body: JSON.stringify({
                    checker_id: chkId,
                    reference_left: refL,
                    reading_left: readL,
                    reference_right: refR,
                    reading_right: readR,
                    range_min: minR,
                    range_max: maxR,
                    equipment_id: equipment_id,
                    evidence_url: evidence_url,
                    observations: obs,
                    site_id: (sessionData && sessionData.site_id) || ''
                })
            });
            const data = await res.json();
            if (res.ok && data.success) {
                if (data.status_result === 'FAIL') {
                    alert(t('infra.chk_warn_fail', '⚠️ ADVERTENCIA: La variación entre el checador y el megóhmetro supera el 5% sobre el rango del equipo. Se guardó como FAIL.'));
                } else {
                    alert('✅ Verificación de Checador guardada exitosamente (PASS).');
                }

                // Reset form fields
                document.getElementById('chk-id').value = '';
                document.getElementById('chk-read-l').value = '';
                document.getElementById('chk-read-r').value = '';
                document.getElementById('chk-ref-l').value = '';
                document.getElementById('chk-ref-r').value = '';
                document.getElementById('chk-obs').value = '';
                clearGenericPhoto('chk-photo-file', 'chk-photo-thumb', 'chk-photo-img', 'chk-photo-url');
                updateCheckerVariation();

                await loadCheckersHistory();
            } else {
                alert('❌ Error al guardar registro de checador.');
            }
        } catch(ex) {
            alert('❌ Error de conexión con el servidor.');
        }
    };

    // --- SCHEDULE & VALIDATIONS ENGINE ---
    let scheduleData = null;
    let currentCalendarYear = new Date().getFullYear();
    let currentCalendarMonth = new Date().getMonth(); // 0-indexed
    let selectedCalendarDate = null;
    let selectedAssetForCard = null;

    function switchScheduleSubTab(tab) {
        const btnCal = document.getElementById('tab-btn-sched-calendar');
        const btnRep = document.getElementById('tab-btn-sched-reports');
        const btnRepo = document.getElementById('tab-btn-sched-repository');
        const secCal = document.getElementById('sec-schedule-calendar');
        const secRep = document.getElementById('sec-schedule-reports');
        const secRepo = document.getElementById('sec-schedule-repository');

        if (btnCal) btnCal.classList.remove('active');
        if (btnRep) btnRep.classList.remove('active');
        if (btnRepo) btnRepo.classList.remove('active');
        if (secCal) secCal.style.display = 'none';
        if (secRep) secRep.style.display = 'none';
        if (secRepo) secRepo.style.display = 'none';

        if (tab === 'calendar') {
            if (btnCal) btnCal.classList.add('active');
            if (secCal) secCal.style.display = 'block';
            loadScheduleData();
        } else if (tab === 'reports') {
            if (btnRep) btnRep.classList.add('active');
            if (secRep) secRep.style.display = 'block';

            // Auto-fill auditor name from logged-in session user
            const auditorInput = document.getElementById('rep-auditor');
            if (auditorInput) {
                auditorInput.value = (sessionData && (sessionData.full_name || sessionData.user_name)) || '';
            }

            // Comments input starts empty by default
            const commentsInput = document.getElementById('rep-comments');
            if (commentsInput && !commentsInput.value) {
                commentsInput.value = '';
            }

            loadInfraLinesSelect();
        } else if (tab === 'repository') {
            if (btnRepo) btnRepo.classList.add('active');
            if (secRepo) secRepo.style.display = 'block';
            loadReportsRepository();
        }
    }

    async function loadScheduleData() {
        try {
            const siteId = (sessionData && sessionData.site_id) || '';
            const search = (document.getElementById('sched-search-input')?.value || '').trim();
            const area = document.getElementById('sched-filter-area')?.value || 'all';
            const line = document.getElementById('sched-filter-line')?.value || 'all';
            const status = document.getElementById('sched-filter-status')?.value || 'all';

            const query = new URLSearchParams({ siteId, search, area, line, status });
            const res = await fetch(`/api/schedule/assets-due?${query.toString()}`);
            if (!res.ok) throw new Error('Error al cargar datos del cronograma');
            scheduleData = await res.json();

            // 1. Update Metrics Cards
            if (scheduleData.summary) {
                const overdueEl = document.getElementById('sched-count-overdue');
                const dueSoonEl = document.getElementById('sched-count-duesoon');
                const compliantEl = document.getElementById('sched-count-compliant');
                const totalEl = document.getElementById('sched-count-total');

                if (overdueEl) overdueEl.innerText = scheduleData.summary.overdue_count || 0;
                if (dueSoonEl) dueSoonEl.innerText = scheduleData.summary.due_soon_count || 0;
                if (compliantEl) compliantEl.innerText = scheduleData.summary.compliant_count || 0;
                if (totalEl) totalEl.innerText = scheduleData.summary.total_assets || 0;

                const urgentBar = document.getElementById('sched-urgent-alert-bar');
                const urgentCount = document.getElementById('sched-urgent-count');
                if (urgentBar) {
                    if (scheduleData.summary.overdue_count > 0) {
                        urgentBar.style.display = 'flex';
                        if (urgentCount) urgentCount.innerText = scheduleData.summary.overdue_count;
                    } else {
                        urgentBar.style.display = 'none';
                    }
                }
            }

            // 2. Populate Filters (if not already populated)
            populateScheduleAreaFilter(scheduleData.areas || []);
            populateScheduleLineFilter(scheduleData.lines || []);

            // 3. Render Calendar
            renderScheduleCalendar(currentCalendarYear, currentCalendarMonth);

            // 4. Render Upcoming / Day details panel
            if (selectedCalendarDate) {
                filterScheduleByDate(selectedCalendarDate);
            } else {
                renderScheduleUpcomingPanel(scheduleData.assets || [], t('schedule.upcoming_list_title', '📋 Próximas Validaciones Programadas'));
            }

        } catch (e) {
            console.error('Error loading schedule data:', e);
        }
    }

    function populateScheduleAreaFilter(areas) {
        const sel = document.getElementById('sched-filter-area');
        if (!sel) return;
        const current = sel.value;
        const defaultText = t('schedule.all_areas', '-- Todas las Áreas --');
        let html = `<option value="all">${defaultText}</option>`;
        areas.forEach(a => {
            if (a && a !== 'all') {
                html += `<option value="${a}">${a}</option>`;
            }
        });
        sel.innerHTML = html;
        if (current && areas.includes(current)) sel.value = current;
    }

    function populateScheduleLineFilter(lines) {
        const sel = document.getElementById('sched-filter-line');
        if (!sel) return;
        const current = sel.value;
        const defaultText = t('schedule.all_lines', '-- Todas las Líneas --');
        let html = `<option value="all">${defaultText}</option>`;
        lines.forEach(l => {
            if (l && l !== 'all') {
                html += `<option value="${l}">${l}</option>`;
            }
        });
        sel.innerHTML = html;
        if (current && lines.includes(current)) sel.value = current;
    }

    function handleScheduleSearchInput(val) {
        const q = (val || '').trim().toLowerCase();
        if (!q) {
            closeSingleAssetCard();
            loadScheduleData();
            return;
        }

        if (!scheduleData || !scheduleData.assets) return;

        // Check if there is an exact or single strong match
        const matched = scheduleData.assets.filter(a => 
            (a.custom_id && a.custom_id.toLowerCase().includes(q)) ||
            (a.name && a.name.toLowerCase().includes(q))
        );

        if (matched.length === 1) {
            showSingleAssetCard(matched[0]);
        } else {
            // Apply filter
            loadScheduleData();
        }
    }

    function showSingleAssetCard(asset) {
        selectedAssetForCard = asset;
        const singleView = document.getElementById('sched-single-asset-view');
        const calView = document.getElementById('sched-calendar-view');

        if (!singleView) return;

        const nameEl = document.getElementById('sched-card-name');
        const idEl = document.getElementById('sched-card-id');
        const catSubEl = document.getElementById('sched-card-cat-sub');
        const areaLineEl = document.getElementById('sched-card-area-line');
        const perEl = document.getElementById('sched-card-periodicity');
        const lastDateEl = document.getElementById('sched-card-last-date');
        const lastDetailEl = document.getElementById('sched-card-last-detail');
        const nextDateEl = document.getElementById('sched-card-next-date');
        const countdownEl = document.getElementById('sched-card-countdown');

        const assetName = asset.name || asset.custom_id || asset.asset_id || 'Activo ESD';
        const assetId = asset.custom_id || asset.asset_id || '';
        const cat = asset.category || 'Mobiliario ESD';
        const subCat = asset.sub_category || cat;
        const loc = asset.location || 'N/A';
        const area = asset.area || (loc.includes('->') ? loc.split('->')[0].trim() : 'General');
        const per = asset.periodicity || '1m';
        const lastDate = asset.last_verification ? asset.last_verification.split('T')[0] : (asset.created_at ? 'Alta: ' + asset.created_at.split('T')[0] : 'N/D');
        const nextDate = asset.next_verification || (per === 'permanent' ? t('schedule.card_permanent_note', 'Sin vencimiento (Permanente)') : 'N/D');

        if (nameEl) nameEl.innerText = assetName;
        if (idEl) idEl.innerText = assetId;
        if (catSubEl) catSubEl.innerHTML = `${cat} &bull; <i>${subCat}</i>`;
        if (areaLineEl) areaLineEl.innerText = `${area} -> ${loc}`;

        const perMap = {
            '1d': '1 Día (Diario)',
            '1w': '1 Semana (Semanal)',
            '2w': '2 Semanas (Quincenal)',
            '1m': '1 Mes (Mensual)',
            '3m': '3 Meses (Trimestral)',
            '6m': '6 Meses (Semestral)',
            '1y': '1 Año (Anual)',
            'permanent': 'Permanente (Sin vencimiento)'
        };
        if (perEl) perEl.innerText = t('periodicity.' + per, perMap[per] || per);

        if (lastDateEl) lastDateEl.innerText = lastDate;
        if (lastDetailEl) {
            if (asset.auditor) {
                lastDetailEl.innerText = `Auditor: ${asset.auditor}`;
            } else {
                lastDetailEl.innerText = `Registrado el: ${asset.created_at ? asset.created_at.split('T')[0] : '-'}`;
            }
        }

        if (nextDateEl) nextDateEl.innerText = nextDate;

        if (countdownEl) {
            if (per === 'permanent' || asset.status_schedule === 'PERMANENT') {
                countdownEl.className = 'badge-pass';
                countdownEl.style.background = '#F1F5F9';
                countdownEl.style.color = '#475569';
                countdownEl.style.borderColor = '#CBD5E1';
                countdownEl.innerText = t('schedule.card_permanent_note', '⚪ Sin vencimiento programado');
            } else if (asset.status_schedule === 'OVERDUE') {
                countdownEl.className = 'badge-fail';
                countdownEl.style.background = '#FEE2E2';
                countdownEl.style.color = '#991B1B';
                countdownEl.style.borderColor = '#FECDD3';
                countdownEl.innerText = `🔴 ${t('schedule.card_days_overdue', `Vencido hace ${asset.overdue_days || 1} días`).replace('{0}', asset.overdue_days || 1)}`;
            } else if (asset.status_schedule === 'DUE_SOON') {
                countdownEl.className = 'badge-pass';
                countdownEl.style.background = '#FEF3C7';
                countdownEl.style.color = '#B45309';
                countdownEl.style.borderColor = '#FDE68A';
                if (asset.days_left === 0) {
                    countdownEl.innerText = `🟡 ${t('schedule.card_days_today', '¡Vence HOY!')}`;
                } else {
                    countdownEl.innerText = `🟡 ${t('schedule.card_days_left', `Vence en ${asset.days_left} días`).replace('{0}', asset.days_left)}`;
                }
            } else {
                countdownEl.className = 'badge-pass';
                countdownEl.style.background = '#D1FAE5';
                countdownEl.style.color = '#065F46';
                countdownEl.style.borderColor = '#A7F3D0';
                countdownEl.innerText = `🟢 ${t('schedule.card_days_left', `Vence en ${asset.days_left} días`).replace('{0}', asset.days_left)}`;
            }
        }

        singleView.style.display = 'block';
    }

    function closeSingleAssetCard() {
        selectedAssetForCard = null;
        const singleView = document.getElementById('sched-single-asset-view');
        if (singleView) singleView.style.display = 'none';
    }

    const monthNamesEs = ['Enero', 'Febrero', 'Marzo', 'Abril', 'Mayo', 'Junio', 'Julio', 'Agosto', 'Septiembre', 'Octubre', 'Noviembre', 'Diciembre'];
    const dayHeaders = ['Dom', 'Lun', 'Mar', 'Mié', 'Jue', 'Vie', 'Sáb'];

    function renderScheduleCalendar(year, month) {
        const grid = document.getElementById('sched-calendar-grid');
        const monthLabel = document.getElementById('sched-cal-month-label');
        if (!grid) return;

        if (monthLabel) {
            monthLabel.innerText = `${monthNamesEs[month]} ${year}`;
        }

        grid.innerHTML = '';

        // 1. Day headers
        dayHeaders.forEach(dh => {
            grid.innerHTML += `<div style="font-size:11px; font-weight:700; color:var(--text-muted); padding:6px 2px; border-bottom:1px solid #F1F5F9;">${dh}</div>`;
        });

        const firstDayIndex = new Date(year, month, 1).getDay(); // 0 = Sun
        const totalDaysInMonth = new Date(year, month + 1, 0).getDate();
        const prevMonthDays = new Date(year, month, 0).getDate();

        // Map assets by due date string "YYYY-MM-DD"
        const eventsByDate = {};
        if (scheduleData && scheduleData.assets) {
            scheduleData.assets.forEach(a => {
                if (a.next_verification) {
                    const dateKey = a.next_verification;
                    if (!eventsByDate[dateKey]) eventsByDate[dateKey] = [];
                    eventsByDate[dateKey].push(a);
                }
            });
        }

        const todayStr = new Date().toISOString().split('T')[0];

        // Padding before 1st day
        for (let i = firstDayIndex - 1; i >= 0; i--) {
            const dNum = prevMonthDays - i;
            grid.innerHTML += `<div style="padding:8px 4px; min-height:54px; opacity:0.35; font-size:11px; color:var(--text-muted); border-radius:6px;">${dNum}</div>`;
        }

        // Days of current month
        for (let d = 1; d <= totalDaysInMonth; d++) {
            const monthStr = String(month + 1).padStart(2, '0');
            const dayStr = String(d).padStart(2, '0');
            const dateKey = `${year}-${monthStr}-${dayStr}`;

            const dayAssets = eventsByDate[dateKey] || [];
            const isToday = dateKey === todayStr;
            const isSelected = dateKey === selectedCalendarDate;

            let borderStyle = isSelected ? '2px solid var(--accent-blue)' : (isToday ? '1.5px solid var(--accent-blue)' : '1px solid #F1F5F9');
            let bgStyle = isSelected ? 'var(--accent-blue-light)' : (isToday ? '#EFF6FF' : '#FFFFFF');

            // Build chips
            let chipsHtml = '';
            if (dayAssets.length > 0) {
                const hasOverdue = dayAssets.some(x => x.status_schedule === 'OVERDUE');
                const hasDueSoon = dayAssets.some(x => x.status_schedule === 'DUE_SOON');

                let chipColor = '#10B981';
                let chipBg = '#D1FAE5';
                let chipText = '#065F46';

                if (hasOverdue) {
                    chipColor = '#EF4444';
                    chipBg = '#FEE2E2';
                    chipText = '#991B1B';
                } else if (hasDueSoon) {
                    chipColor = '#F59E0B';
                    chipBg = '#FEF3C7';
                    chipText = '#92400E';
                }

                chipsHtml = `<div style="background:${chipBg}; color:${chipText}; border:1px solid ${chipColor}; border-radius:4px; font-size:9.5px; font-weight:800; padding:1px 4px; margin-top:2px; display:inline-block; max-width:100%; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;" title="${dayAssets.length} activos programados">
                    ${dayAssets.length} ${dayAssets.length === 1 ? 'activo' : 'activos'}
                </div>`;
            }

            grid.innerHTML += `
                <div style="background:${bgStyle}; border:${borderStyle}; border-radius:6px; padding:6px 2px; min-height:58px; cursor:pointer; display:flex; flex-direction:column; align-items:center; transition:all 0.15s ease;" onclick="onScheduleDayClick('${dateKey}')">
                    <span style="font-size:12px; font-weight:${isToday || isSelected ? '800' : '600'}; color:${isToday ? 'var(--accent-blue)' : 'var(--text-primary)'};">${d}</span>
                    ${chipsHtml}
                </div>
            `;
        }

        // Trailing padding to fill 35 or 42 grid cells
        const totalRendered = firstDayIndex + totalDaysInMonth;
        const remaining = totalRendered <= 35 ? (35 - totalRendered) : (42 - totalRendered);
        for (let j = 1; j <= remaining; j++) {
            grid.innerHTML += `<div style="padding:8px 4px; min-height:54px; opacity:0.35; font-size:11px; color:var(--text-muted); border-radius:6px;">${j}</div>`;
        }
    }

    function prevScheduleMonth() {
        currentCalendarMonth--;
        if (currentCalendarMonth < 0) {
            currentCalendarMonth = 11;
            currentCalendarYear--;
        }
        renderScheduleCalendar(currentCalendarYear, currentCalendarMonth);
    }

    function nextScheduleMonth() {
        currentCalendarMonth++;
        if (currentCalendarMonth > 11) {
            currentCalendarMonth = 0;
            currentCalendarYear++;
        }
        renderScheduleCalendar(currentCalendarYear, currentCalendarMonth);
    }

    function goToScheduleToday() {
        currentCalendarYear = new Date().getFullYear();
        currentCalendarMonth = new Date().getMonth();
        selectedCalendarDate = new Date().toISOString().split('T')[0];
        renderScheduleCalendar(currentCalendarYear, currentCalendarMonth);
        filterScheduleByDate(selectedCalendarDate);
    }

    function onScheduleDayClick(dateStr) {
        selectedCalendarDate = dateStr;
        renderScheduleCalendar(currentCalendarYear, currentCalendarMonth);
        filterScheduleByDate(dateStr);
    }

    function filterScheduleByDate(dateStr) {
        if (!scheduleData || !scheduleData.assets) return;
        const matching = scheduleData.assets.filter(a => a.next_verification === dateStr);
        const titleText = `📅 Validaciones para el ${dateStr}`;
        renderScheduleUpcomingPanel(matching, titleText);
    }

    function renderScheduleUpcomingPanel(items, titleText) {
        const container = document.getElementById('sched-panel-items');
        const titleEl = document.getElementById('sched-panel-title');
        const countEl = document.getElementById('sched-panel-count');
        if (!container) return;

        if (titleEl && titleText) titleEl.innerText = titleText;
        if (countEl) countEl.innerText = `${items.length} activos`;

        if (!items || items.length === 0) {
            container.innerHTML = `<div style="text-align:center; padding:24px; color:var(--text-muted); font-size:12px;">ℹ️ ${t('schedule.cal_no_events', 'No hay activos programados para esta selección.')}</div>`;
            return;
        }

        let html = '';
        items.slice(0, 25).forEach((a, idx) => {
            const assetName = a.name || a.custom_id || a.asset_id || 'Activo';
            const assetId = a.custom_id || a.asset_id || '';
            const loc = a.location || 'N/A';
            const nextDate = a.next_verification || (a.periodicity === 'permanent' ? 'Permanente' : 'N/D');

            let badgeStatusHtml = '';
            if (a.status_schedule === 'OVERDUE') {
                badgeStatusHtml = `<span class="badge-fail" style="font-size:10px; padding:2px 6px;">🔴 Vencido (${a.overdue_days}d)</span>`;
            } else if (a.status_schedule === 'DUE_SOON') {
                badgeStatusHtml = `<span class="badge-pass" style="background:#FEF3C7; color:#B45309; border-color:#FDE68A; font-size:10px; padding:2px 6px;">🟡 Vence en ${a.days_left}d</span>`;
            } else if (a.status_schedule === 'PERMANENT') {
                badgeStatusHtml = `<span class="badge-pass" style="background:#F1F5F9; color:#475569; border-color:#CBD5E1; font-size:10px; padding:2px 6px;">⚪ Permanente</span>`;
            } else {
                badgeStatusHtml = `<span class="badge-pass" style="font-size:10px; padding:2px 6px;">🟢 Al día (${a.days_left}d)</span>`;
            }

            html += `
                <div class="glass-card" style="background:#FFFFFF; border:1px solid var(--border-color); border-radius:8px; padding:10px 12px; cursor:pointer; transition:transform 0.1s ease;" onclick="openScheduleAssetDetailByIdx(${idx})">
                    <div style="display:flex; justify-content:space-between; align-items:flex-start; gap:8px;">
                        <div>
                            <div style="font-weight:700; font-size:12.5px; color:var(--text-primary);">${assetName}</div>
                            <div style="font-size:11px; color:var(--text-muted); margin-top:2px;">
                                <span style="color:var(--accent-blue); font-weight:700;">${assetId}</span> &bull; <span>${loc}</span>
                            </div>
                        </div>
                        <div>${badgeStatusHtml}</div>
                    </div>
                    <div style="display:flex; justify-content:space-between; align-items:center; margin-top:6px; font-size:10.5px; color:var(--text-muted); border-top:1px solid #F8FAFC; padding-top:4px;">
                        <span>Próxima: <b>${nextDate}</b></span>
                        <span style="color:var(--accent-blue); font-weight:600;">Ver Ficha 🔍</span>
                    </div>
                </div>
            `;
        });

        container.innerHTML = html;
    }

