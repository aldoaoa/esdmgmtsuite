<script>
    let currentModule = 'dashboard';
    let sessionData = null;
    let extraPoints = [];
    let currentLocale = {};
    let allCompanies = [];
    let allSites = [];

    // QR SCANNER STATE
    let html5QrCode = null;
    let videoDevices = [];
    let currentCamIdx = 0;
    let wideCamId = null;

    window.onload = function() {
        checkSession();
    };

    async function checkSession() {
        let sessionRes = null;
        try {
            const res = await fetch('/api/session');
            if (res.ok) {
                sessionRes = await res.json();
            }
        } catch (e) {
            console.error('Error fetching session:', e);
        }

        if (sessionRes && sessionRes.isLoggedIn) {
            sessionData = sessionRes;
            const overlay = document.getElementById('login-overlay');
            if (overlay) overlay.style.display = 'none';

            if (document.getElementById('user-display-name')) {
                document.getElementById('user-display-name').innerText = sessionRes.user_name || sessionRes.user_email || 'Usuario';
            }
            if (document.getElementById('user-display-role')) {
                document.getElementById('user-display-role').innerText = sessionRes.user_role || 'AUDITOR';
            }
            if (document.getElementById('user-avatar-initials')) {
                document.getElementById('user-avatar-initials').innerText = (sessionRes.user_name || 'U').substring(0, 1).toUpperCase();
            }
            if (document.getElementById('audit-auditor')) {
                document.getElementById('audit-auditor').value = sessionRes.user_name || 'Auditor ESD';
            }
            
            const userLang = getStoredLang();
            if (document.getElementById('settings-lang-select')) document.getElementById('settings-lang-select').value = userLang;
            if (document.getElementById('login-landing-lang-select')) document.getElementById('login-landing-lang-select').value = userLang;

            const userReportLang = sessionRes.report_lang || getStoredReportLang();
            setStoredReportLang(userReportLang);
            if (document.getElementById('settings-reports-lang-select')) document.getElementById('settings-reports-lang-select').value = userReportLang;

            const userTempUnit = (sessionRes && sessionRes.temp_unit) || getStoredTempUnit();
            if (typeof changeTemperatureUnit === 'function') {
                currentTempUnit = userTempUnit;
                localStorage.setItem('esd_temp_unit', userTempUnit);
                if (document.getElementById('settings-temp-unit-select')) document.getElementById('settings-temp-unit-select').value = userTempUnit;
                updateTemperatureUnitUI();
            }

            if (sessionRes.version && document.getElementById('system-version-badge')) {
                document.getElementById('system-version-badge').innerText = 'v' + sessionRes.version;
            }
            if (sessionRes.version && document.getElementById('login-version-badge')) {
                document.getElementById('login-version-badge').innerText = 'v' + sessionRes.version;
            }

            if (sessionRes.company_logo_url) {
                updateSidebarCompanyLogo(sessionRes.company_logo_url);
            } else {
                syncActiveCompanySidebarLogo();
            }

            try { enforceRolePermissions(); } catch(e) { console.warn('enforceRolePermissions error:', e); }
            try { await loadTranslations(userLang); } catch(e) { console.warn('loadTranslations error:', e); }
            try { await loadSites(); } catch(e) { console.warn('loadSites error:', e); }
            try { await loadEquipmentForSite(); } catch(e) { console.warn('loadEquipmentForSite error:', e); }
            try { await loadSitePhotoPolicy(); } catch(e) { console.warn('loadSitePhotoPolicy error:', e); }
