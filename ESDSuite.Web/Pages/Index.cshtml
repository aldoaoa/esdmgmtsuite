    function getStoredReportLang() {
        const match = document.cookie.match(/(?:^|; )esd360_report_lang=([^;]*)/);
        if (match && match[1]) return match[1];
        return localStorage.getItem('esd360_report_lang') || getStoredLang() || 'es';
