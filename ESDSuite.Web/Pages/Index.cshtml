    // =========================================================================
    // TEMPERATURE UNIT PREFERENCE & CONVERSION HELPERS
    // =========================================================================
    let currentTempUnit = localStorage.getItem('esd_temp_unit') || 'C';

    function getStoredTempUnit() {
        return localStorage.getItem('esd_temp_unit') || 'C';
    }

    function changeTemperatureUnit(unit) {
        currentTempUnit = (unit === 'F') ? 'F' : 'C';
        localStorage.setItem('esd_temp_unit', currentTempUnit);
        if (document.getElementById('settings-temp-unit-select')) {
            document.getElementById('settings-temp-unit-select').value = currentTempUnit;
        }
        updateTemperatureUnitUI();
        filterValidationHistory();
        try {
            fetch('/api/settings/temp-unit', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ unit: currentTempUnit })
            }).catch(e => console.error('Error syncing temp unit:', e));
        } catch(e) {}
    }

    function updateTemperatureUnitUI() {
        const unit = getStoredTempUnit();
        const displayEl = document.getElementById('val-temp-unit-display');
        if (displayEl) {
            displayEl.innerText = unit === 'F' ? '°F' : '°C';
        }
        if (document.getElementById('settings-temp-unit-select')) {
            document.getElementById('settings-temp-unit-select').value = unit;
        }
    }

    function formatTemperature(val, itemUnit = null) {
        if (val === null || val === undefined || val === '') return 'N/D';
        let str = String(val).trim();
        let num = parseFloat(str.replace(/[^0-9.-]/g, ''));
        if (isNaN(num)) return val;

        const isStoredF = (itemUnit === 'F') || str.toLowerCase().includes('f');
        let cVal = isStoredF ? (num - 32) * 5 / 9 : num;
        
        const userUnit = getStoredTempUnit();
        if (userUnit === 'F') {
            let fVal = isStoredF ? num : (cVal * 9 / 5) + 32;
            return `${fVal.toFixed(1)} °F`;
        } else {
            return `${cVal.toFixed(1)} °C`;
        }
    }

