    function onFindingSeverityChange(val) {
        const card = document.getElementById('fnd-severity-info-card');
        if (!card) return;
        
        let key = 'F2 Major';
        if (val.includes('F1') || val.includes('CRITICAL')) key = 'F1 Critical';
        else if (val.includes('F2') || val.includes('MAJOR')) key = 'F2 Major';
        else if (val.includes('F3') || val.includes('MINOR')) key = 'F3 Minor';
        else if (val.includes('F4') || val.includes('OBSERVATION')) key = 'F4 Observation';

        const info = FINDING_SEVERITY_GUIDES[key] || FINDING_SEVERITY_GUIDES['F2 Major'];
        card.style.background = info.bg;
        card.style.borderLeft = `4px solid ${info.border}`;
        card.style.borderColor = info.border;
        card.style.color = info.color;
        card.innerHTML = `
            <div style="font-weight:800; font-size:12px; margin-bottom:4px; display:flex; align-items:center; justify-content:space-between;">
                <span>Guía Normativa de Severidad: <strong>${key}</strong></span>
                <span style="font-size:10px; background:${info.badgeBg}; padding:2px 8px; border-radius:10px; font-weight:800;">${key}</span>
            </div>
            <div style="margin-bottom:3px;"><strong>📌 Criterio:</strong> ${info.criterio}</div>
            <div style="margin-bottom:3px;"><strong>📋 Ejemplos:</strong> ${info.ejemplos}</div>
            <div><strong>⚡ Reacción mínima requerida:</strong> ${info.reaccion}</div>
        `;
    }

    let findingFormContextCache = null;

    async function loadFindingFormContext(force = false) {
        const siteId = getActiveSiteId();
        if (findingFormContextCache && findingFormContextCache.siteId === siteId && !force) {
            populateFindingFormControls(findingFormContextCache);
            return;
        }

        try {
            let url = '/api/findings/form-context';
            if (siteId) url += '?siteId=' + encodeURIComponent(siteId);
            const res = await fetch(url);
            if (res.ok) {
                const data = await res.json();
                if (data && data.success) {
                    findingFormContextCache = { ...data, siteId: siteId };
                    populateFindingFormControls(findingFormContextCache);
                }
            }
        } catch(e) {
            console.error('Error loading findings form context:', e);
        }
    }

    function populateFindingFormControls(ctx) {
        if (!ctx) return;

        // 1. Ubicaciones
        const locSelect = document.getElementById('fnd-new-location');
        if (locSelect) {
            const currentVal = locSelect.value;
            locSelect.innerHTML = '<option value="">-- Seleccionar Ubicación / Línea / Área --</option>';
            if (Array.isArray(ctx.locations)) {
                ctx.locations.forEach(loc => {
                    if (!loc) return;
                    const opt = document.createElement('option');
                    opt.value = loc;
                    opt.textContent = loc;
                    locSelect.appendChild(opt);
                });
            }
            if (currentVal) locSelect.value = currentVal;
        }

        // 2. Elementos auditados (Datalist para autocompletar)
        const elemDatalist = document.getElementById('fnd-elements-datalist');
        if (elemDatalist) {
            elemDatalist.innerHTML = '';
            if (Array.isArray(ctx.elements)) {
                ctx.elements.forEach(el => {
                    if (!el.custom_id) return;
                    const opt = document.createElement('option');
                    opt.value = el.custom_id;
                    opt.label = `${el.category || 'Elemento'} (${el.location || 'General'})`;
                    elemDatalist.appendChild(opt);
                });
            }
        }

        // 3. Responsables Asignados
        const assigneeSelect = document.getElementById('fnd-new-assignee');
        if (assigneeSelect) {
            const currentVal = assigneeSelect.value;
            assigneeSelect.innerHTML = '<option value="">-- Seleccionar Responsable Asignado --</option>';
            if (Array.isArray(ctx.users)) {
                ctx.users.forEach(u => {
                    if (!u.name) return;
                    const opt = document.createElement('option');
                    opt.value = u.name;
                    opt.textContent = u.display || u.name;
                    opt.setAttribute('data-email', u.email || '');
                    assigneeSelect.appendChild(opt);
                });
            }
            if (currentVal) assigneeSelect.value = currentVal;
        }
    }

    function onFindingElementSelected(val) {
        if (!val || !findingFormContextCache || !Array.isArray(findingFormContextCache.elements)) return;
        const trimmed = val.trim().toLowerCase();
        const found = findingFormContextCache.elements.find(e => (e.custom_id || '').toLowerCase() === trimmed);
        if (found) {
            // Auto-select location if present
            if (found.location) {
                const locSelect = document.getElementById('fnd-new-location');
                if (locSelect) {
                    for (let i = 0; i < locSelect.options.length; i++) {
                        if (locSelect.options[i].value.toLowerCase() === found.location.toLowerCase()) {
                            locSelect.selectedIndex = i;
                            break;
                        }
                    }
                }
            }
            // If normative table matches category
            if (found.category) {
                const catLower = found.category.toLowerCase();
                const tblSelect = document.getElementById('fnd-new-table');
                if (tblSelect) {
                    if (catLower.includes('tierra') || catLower.includes('pulsera')) tblSelect.value = 'Tabla 1';
                    else if (catLower.includes('superficie') || catLower.includes('tapete') || catLower.includes('mesa')) tblSelect.value = 'Tabla 2';
                    else if (catLower.includes('piso') || catLower.includes('calzado')) tblSelect.value = 'Tabla 3';
                    else if (catLower.includes('empaque') || catLower.includes('ionizador')) tblSelect.value = 'Tabla 4';
                }
            }
        }
    }

    function openNewFindingModal() {
        document.getElementById('form-new-finding').reset();
        const due = new Date(Date.now() + 7 * 86400000).toISOString().substring(0, 10);
        document.getElementById('fnd-new-due-date').value = due;
        const sevSel = document.getElementById('fnd-new-severity');
        if (sevSel) sevSel.value = 'F2 Major';
        onFindingSeverityChange('F2 Major');
        loadFindingFormContext();
        document.getElementById('modal-new-finding').style.display = 'flex';
    }

    function closeNewFindingModal() {
        document.getElementById('modal-new-finding').style.display = 'none';
    }

    async function submitNewFinding() {
        const titleVal = (document.getElementById('fnd-new-title')?.value || '').trim();
        if (!titleVal) {
            alert('⚠️ Por favor ingresa el título o descripción del hallazgo.');
            return;
        }

        const locationVal = (document.getElementById('fnd-new-location')?.value || '').trim();
        if (!locationVal) {
            alert('⚠️ Por favor selecciona la Ubicación / Línea / Área.');
            return;
        }

        const assigneeSelect = document.getElementById('fnd-new-assignee');
        const assigneeVal = (assigneeSelect?.value || '').trim();
        if (!assigneeVal) {
            alert('⚠️ Por favor selecciona el Responsable Asignado de la lista.');
            return;
        }
        const selectedAssigneeOpt = assigneeSelect?.selectedOptions ? assigneeSelect.selectedOptions[0] : null;
        const assigneeEmailVal = selectedAssigneeOpt ? (selectedAssigneeOpt.getAttribute('data-email') || '') : '';

        const fileInput = document.getElementById('fnd-new-photo-file');
        let evidenceUrl = null;

        if (fileInput && fileInput.files && fileInput.files.length > 0) {
            try {
                const formData = new FormData();
                formData.append('file', fileInput.files[0]);
                formData.append('photo', fileInput.files[0]);
                formData.append('finding_id', 'draft');
                formData.append('type', 'open');
                formData.append('evidence_type', 'open');
                const upRes = await fetch('/api/findings/upload-evidence', { method: 'POST', body: formData });
                const upText = await upRes.text();
                let upData;
                try {
                    upData = JSON.parse(upText);
                } catch(pe) {
                    console.warn('Non-JSON response from upload-evidence:', upText);
                }
                if (upData && upData.success) {
                    evidenceUrl = upData.url;
                } else if (upData && upData.message) {
                    console.warn('Photo upload backend message:', upData.message);
                }
            } catch(e) {
                console.warn('Could not pre-upload photo:', e);
            }
        }

        const tableVal = document.getElementById('fnd-new-table').value;
        const limitVal = document.getElementById('fnd-new-limit').value.trim();
        const containmentVal = document.getElementById('fnd-new-containment').value.trim();

        const payload = {
            title: titleVal,
            normative_table: tableVal,
            reference_table: tableVal,
            severity: document.getElementById('fnd-new-severity').value,
            element_id: (document.getElementById('fnd-new-elem-id')?.value || '').trim(),
            location: locationVal,
            area: locationVal.includes('->') ? locationVal.split('->')[0].trim() : locationVal,
            measured_value: document.getElementById('fnd-new-measured').value.trim(),
            required_limit: limitVal,
            limit_applied: limitVal,
            assignee_name: assigneeVal,
            assigned_to: assigneeVal,
            assignee_email: assigneeEmailVal,
            due_date: document.getElementById('fnd-new-due-date').value,
            containment_action: containmentVal,
            immediate_containment: containmentVal,
            evidence_open_url: evidenceUrl,
            opened_by: sessionData ? sessionData.user_name : 'Auditor',
            auditor_name: sessionData ? sessionData.user_name : 'Auditor',
            site_id: getActiveSiteId(),
            source_module: 'Levantamiento Manual',
            source: 'Levantamiento Manual'
        };

        try {
            const res = await fetch('/api/findings', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            });
            const resText = await res.text();
            let data;
            try {
                data = JSON.parse(resText);
            } catch(pe) {
                console.error('Non-JSON response from /api/findings:', resText);
                alert(`❌ Error del servidor (${res.status}): ${resText.substring(0, 150)}`);
                return;
            }

            if (data && data.success) {
                const code = (data.finding && (data.finding.tracking_code || data.finding.tracker_code))
                    || (data.data && (data.data.tracking_code || data.data.tracker_code))
                    || '';
                alert('✅ Hallazgo creado con éxito' + (code ? `: ${code}` : '.'));
                closeNewFindingModal();
                await loadFindingsModule();
                if (typeof loadFindingsDashboard === 'function') {
                    await loadFindingsDashboard();
                }
            } else {
                alert('❌ ' + (data && data.message ? data.message : 'Error al crear el hallazgo.'));
            }
        } catch(e) {
            console.error('Error creating manual finding:', e);
            alert('❌ Error al procesar la solicitud: ' + (e.message || e));
        }
    }

    async function loadFindingsDashboard() {
        try {
            const siteId = getActiveSiteId();
            let url = '/api/findings/dashboard';
            if (siteId) url += '?site_id=' + encodeURIComponent(siteId);
            const res = await fetch(url);
            if (!res.ok) return;
            const data = await res.json();
            const m = (data && (data.metrics || data.data)) ? (data.metrics || data.data) : data;
            if (!m || typeof m !== 'object') return;

            const elTotal = document.getElementById('fnd-dash-total');
            const elActive = document.getElementById('fnd-dash-active');
            const elOntime = document.getElementById('fnd-dash-ontime');
            const elMttr = document.getElementById('fnd-dash-mttr');
            const elCrit = document.getElementById('fnd-dash-critical');
            const elRes = document.getElementById('fnd-dash-resolution');

            const total = m.total ?? m.totalFindings ?? 0;
            const open = m.open ?? m.openFindings ?? 0;
            const inProg = m.in_progress ?? m.inProgressFindings ?? 0;
            const pending = m.pending_verification ?? m.pendingVerificationFindings ?? 0;
            const closed = m.closed ?? m.closedFindings ?? 0;
            const active = m.active_findings ?? m.activeFindings ?? (open + inProg + pending);
            const openCrit = m.open_critical_count ?? m.openCriticalCount ?? (m.criticalFindings ?? 0);

            if (elTotal) elTotal.textContent = total;
            if (elActive) elActive.textContent = active;
            if (elCrit) elCrit.textContent = openCrit;
            if (elMttr) elMttr.textContent = (m.mean_time_to_resolve_days ?? m.mttrDays ?? 0) + ' d';
            if (elOntime) elOntime.textContent = (m.on_time_closure_rate ?? m.onTimeRate ?? 0) + '%';
            
            const resRate = total > 0 ? Math.round((closed / total) * 100) : 0;
            if (elRes) elRes.textContent = resRate + '%';

            renderFindingsCharts(m);
        } catch(e) {
            console.error('Error loading findings dashboard:', e);
        }
    }

    function renderFindingsCharts(m) {
        if (typeof Chart === 'undefined') return;

        // 1. By Table
        const ctxTable = document.getElementById('chart-findings-by-table');
        if (ctxTable) {
            if (chartFindingsByTable) chartFindingsByTable.destroy();
            const tableMap = m.by_table || {};
            if (Object.keys(tableMap).length === 0 && Array.isArray(m.typeDistribution)) {
                m.typeDistribution.forEach(t => { if (t && t.name) tableMap[t.name] = t.count || 0; });
            }
            const labels = Object.keys(tableMap);
            const values = Object.values(tableMap);
            chartFindingsByTable = new Chart(ctxTable, {
                type: 'doughnut',
                data: {
                    labels: labels.length ? labels : ['Sin datos'],
                    datasets: [{
                        data: values.length ? values : [0],
                        backgroundColor: ['#3B82F6', '#10B981', '#F59E0B', '#8B5CF6', '#EC4899', '#06B6D4', '#64748B']
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { position: 'bottom' } }
                }
            });
        }

        // 2. By Severity
        const ctxSev = document.getElementById('chart-findings-by-severity');
        if (ctxSev) {
            if (chartFindingsBySeverity) chartFindingsBySeverity.destroy();
            const sevMap = m.by_severity || {};
            const cF1 = sevMap['f1_critical'] ?? sevMap['critical'] ?? sevMap['CRITICAL'] ?? (m.criticalFindings ?? 0);
            const cF2 = sevMap['f2_major'] ?? sevMap['major'] ?? sevMap['MAJOR'] ?? (m.majorFindings ?? 0);
            const cF3 = sevMap['f3_minor'] ?? sevMap['minor'] ?? sevMap['MINOR'] ?? (m.minorFindings ?? 0);
            const cF4 = sevMap['f4_observation'] ?? sevMap['observation'] ?? sevMap['OBSERVATION'] ?? (m.observationFindings ?? 0);

            chartFindingsBySeverity = new Chart(ctxSev, {
                type: 'pie',
                data: {
                    labels: ['F1 Critical', 'F2 Major', 'F3 Minor', 'F4 Observation'],
                    datasets: [{
                        data: [cF1, cF2, cF3, cF4],
                        backgroundColor: ['#EF4444', '#F59E0B', '#3B82F6', '#10B981']
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { position: 'bottom' } }
                }
            });
        }

        // 3. By Responsible
        const ctxResp = document.getElementById('chart-findings-by-responsible');
        if (ctxResp) {
            if (chartFindingsByResponsible) chartFindingsByResponsible.destroy();
            const respMap = m.by_responsible || {};
            if (Object.keys(respMap).length === 0 && Array.isArray(m.responsibleDistribution)) {
                m.responsibleDistribution.forEach(r => {
                    if (r && r.name) {
                        respMap[r.name] = {
                            total: r.total || 0,
                            open: r.open || 0,
                            closed: r.closed || 0
                        };
                    }
                });
            }
            const labels = Object.keys(respMap).slice(0, 8);
            const totals = labels.map(k => respMap[k]?.total || 0);
            const opens = labels.map(k => respMap[k]?.open || 0);
            const closed = labels.map(k => respMap[k]?.closed || 0);

            chartFindingsByResponsible = new Chart(ctxResp, {
                type: 'bar',
                data: {
                    labels: labels.length ? labels : ['Sin asignaciones'],
                    datasets: [
                        { label: 'Total Asignados', data: totals, backgroundColor: '#94A3B8' },
                        { label: 'Abiertos / En Proceso', data: opens, backgroundColor: '#F59E0B' },
                        { label: 'Cerrados Eficaces', data: closed, backgroundColor: '#10B981' }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { position: 'bottom' } },
                    scales: { y: { beginAtZero: true, ticks: { precision: 0 } } }
                }
            });
        }

        // 4. By Area (Pareto)
        const ctxArea = document.getElementById('chart-findings-by-area');
        if (ctxArea) {
            if (chartFindingsByArea) chartFindingsByArea.destroy();
            const areaMap = m.by_area || {};
            if (Object.keys(areaMap).length === 0 && Array.isArray(m.areaDistribution)) {
                m.areaDistribution.forEach(a => { if (a && a.name) areaMap[a.name] = a.count || 0; });
            }
            const sortedAreas = Object.keys(areaMap).sort((a,b) => areaMap[b] - areaMap[a]).slice(0, 7);
            const areaValues = sortedAreas.map(k => areaMap[k]);

            chartFindingsByArea = new Chart(ctxArea, {
                type: 'bar',
                data: {
                    labels: sortedAreas.length ? sortedAreas : ['Sin datos'],
                    datasets: [{
                        label: 'No Conformidades',
                        data: areaValues,
                        backgroundColor: '#F97316'
                    }]
                },
                options: {
                    indexAxis: 'y',
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { display: false } },
                    scales: { x: { beginAtZero: true, ticks: { precision: 0 } } }
                }
            });
        }
    }

    async function loadLessonsLearned() {
        const container = document.getElementById('fnd-lessons-container');
        if (!container) return;

        try {
            const siteId = getActiveSiteId();
            let url = '/api/findings/dashboard';
            if (siteId) url += '?site_id=' + encodeURIComponent(siteId);
            let res = await fetch(url);
            if (!res.ok) {
                // Fallback a endpoint dedicado /api/lessons-learned
                let fbUrl = '/api/lessons-learned';
                if (siteId) fbUrl += '?site_id=' + encodeURIComponent(siteId);
                res = await fetch(fbUrl);
            }

            if (!res.ok) {
                container.innerHTML = `<div style="text-align:center; padding:24px; color:#DC2626;">
                    ⚠️ Error al cargar el banco de lecciones aprendidas (HTTP ${res.status}).
                    <div style="margin-top:8px;">
                        <button type="button" class="tab-btn" onclick="loadLessonsLearned()" style="font-size:11.5px; padding:4px 12px; background:#F1F5F9; font-weight:700;">🔄 Reintentar Carga</button>
                    </div>
                </div>`;
                return;
            }

            const data = await res.json();
            const m = (data && (data.metrics || data.data)) ? (data.metrics || data.data) : data;
            
            let rawLessons = [];
            if (data && Array.isArray(data.lessons)) {
                rawLessons = data.lessons;
            } else if (m && (m.lessons_learned || m.lessonsLearned)) {
                rawLessons = m.lessons_learned || m.lessonsLearned;
            }
            allLessonsLearned = Array.isArray(rawLessons) ? rawLessons : [];

            const totalCount = (m && m.totalLessonsCount !== undefined) ? m.totalLessonsCount : allLessonsLearned.length;
            const manualCount = (m && m.manualLessonsCount !== undefined) ? m.manualLessonsCount : allLessonsLearned.filter(x => x.is_manual || x.source_module === 'Lección Aprendida Manual' || (x.tracker_code && x.tracker_code.startsWith('LRN'))).length;
            const auditCount = (m && m.auditLessonsCount !== undefined) ? m.auditLessonsCount : Math.max(0, totalCount - manualCount);

            const elTotal = document.getElementById('fnd-lessons-count-total');
            if (elTotal) elTotal.textContent = totalCount;
            const elManual = document.getElementById('fnd-lessons-count-manual');
            if (elManual) elManual.textContent = manualCount;
            const elAudit = document.getElementById('fnd-lessons-count-audit');
            if (elAudit) elAudit.textContent = auditCount;

            if (allLessonsLearned.length > 0) {
                renderLessonsLearned(allLessonsLearned);
            } else {
                container.innerHTML = `<p style="text-align:center; color:var(--text-muted); padding:30px;">Aún no se han documentado lecciones aprendidas ni de forma manual ni en hallazgos cerrados.</p>`;
            }
        } catch(e) {
            console.error('Error loading lessons learned:', e);
            if (container) {
                container.innerHTML = `<div style="text-align:center; padding:24px; color:#DC2626;">
                    ⚠️ Error de conexión al cargar lecciones aprendidas: ${escapeHtml(e.message || 'Error')}
                    <div style="margin-top:8px;">
                        <button type="button" class="tab-btn" onclick="loadLessonsLearned()" style="font-size:11.5px; padding:4px 12px; background:#F1F5F9; font-weight:700;">🔄 Reintentar Carga</button>
                    </div>
                </div>`;
            }
        }
    }

    function renderLessonsLearned(lessons) {
        const container = document.getElementById('fnd-lessons-container');
        if (!container) return;
        if (!lessons || lessons.length === 0) {
            container.innerHTML = `<p style="text-align:center; color:var(--text-muted); padding:30px;">No se encontraron lecciones aprendidas que coincidan con la búsqueda.</p>`;
