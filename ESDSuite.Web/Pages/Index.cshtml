            const isOverdue = (statusKey !== 'CLOSED' && dueStr && new Date(dueStr) < new Date(new Date().setHours(0,0,0,0)));

            const openPhotoIcon = f.evidence_open_url 
                ? `<a href="javascript:void(0)" onclick="previewPhotoModal('${f.evidence_open_url}')" title="Ver foto apertura" style="font-size:15px; margin-right:4px;">📸</a>`
                : `<span style="color:#CBD5E1; font-size:15px; margin-right:4px;" title="Sin foto apertura">📷</span>`;
            
            const closePhotoIcon = f.evidence_close_url 
                ? `<a href="javascript:void(0)" onclick="previewPhotoModal('${f.evidence_close_url}')" title="Ver foto cierre" style="font-size:15px; color:#10B981;">✅</a>`
                : `<span style="color:#CBD5E1; font-size:15px;" title="Sin evidencia cierre">⚪</span>`;

            const deleteBtn = canDelete ? `
                <button type="button" class="tab-btn" style="padding:4px 8px; font-size:11px; color:#DC2626; background:#FEF2F2; border-color:#FECACA;" onclick="deleteFindingConfirm('${f.id}', '${escapeHtml(code)}')" title="Eliminar Hallazgo (Solo CompanyAdmin / SuperAdmin)">
                    🗑️
                </button>
            ` : '';

            html += `
            <tr style="border-bottom:1px solid #F1F5F9;">
                <td style="padding:10px 12px;">
                    <div style="font-family:var(--font-mono); font-weight:800; font-size:12.5px; color:var(--accent-blue);">${escapeHtml(code)}</div>
                    <span style="background:${sev.bg}; color:${sev.color}; font-size:9.5px; font-weight:800; padding:1px 6px; border-radius:8px; display:inline-block; margin-top:2px;">
                        ${sev.label}
                    </span>
                </td>
                <td style="padding:10px 12px;">
                    <div style="font-weight:700; font-size:12px; color:var(--text-primary);">${escapeHtml(f.location || f.area || '-')}</div>
                    <div style="font-size:11px; color:var(--text-muted);">${dateStr || '-'}</div>
                </td>
                <td style="padding:10px 12px;">
                    <div style="font-weight:700; font-size:12px; color:var(--text-primary);">${escapeHtml(f.element_id || f.title || '-')}</div>
                    <div style="font-size:11px; color:var(--text-secondary);">${escapeHtml(f.normative_table || f.reference_table || 'ANSI/ESD S20.20')}</div>
                </td>
                <td style="padding:10px 12px; font-family:var(--font-mono); font-size:11.5px;">
                    <div style="color:#EF4444; font-weight:700;">Med: ${escapeHtml(f.measured_value || '-')}</div>
                    <div style="color:var(--text-muted); font-size:10.5px;">Lím: ${escapeHtml(f.required_limit || f.limit_applied || '-')}</div>
                </td>
                <td style="padding:10px 12px;">
                    <div style="font-weight:700; font-size:12px; color:var(--text-primary);">${escapeHtml(f.assignee_name || f.assigned_to || 'Sin asignar')}</div>
                    <div style="font-size:11px; ${isOverdue ? 'color:#DC2626; font-weight:800;' : 'color:var(--text-muted);'}">
                        📅 ${dueStr || 'Sin fecha'}${isOverdue ? ' ⚠️ Vencido' : ''}
                    </div>
                </td>
                <td style="padding:10px 12px; text-align:center;">
                    ${stat}
                </td>
                <td style="padding:10px 12px; text-align:center;">
                    ${openPhotoIcon} ${closePhotoIcon}
                </td>
                <td style="padding:10px 12px; text-align:center;">
                    <div style="display:inline-flex; gap:4px; align-items:center;">
                        <button type="button" class="tab-btn" style="padding:4px 10px; font-size:11.5px; font-weight:700; background:#F8FAFC;" onclick="openFindingModal('${f.id}')">
                            ✏️ CAPA
                        </button>
                        ${deleteBtn}
                    </div>
                </td>
            </tr>`;
        });
        tbody.innerHTML = html;
    }

    function filterFindingsList() {
        const q = (document.getElementById('fnd-filter-search')?.value || '').toLowerCase().trim();
        const st = (document.getElementById('fnd-filter-status')?.value || '').toUpperCase();
        const sev = (document.getElementById('fnd-filter-severity')?.value || '').toUpperCase();
        const tbl = document.getElementById('fnd-filter-table')?.value || '';

        const filtered = allFindings.filter(f => {
            const fStatus = (f.status || '').toUpperCase();
            const fSev = (f.severity || '').toUpperCase();
            const fTbl = (f.normative_table || f.reference_table || '');

            if (st && fStatus !== st) return false;
            if (sev) {
                if (sev === 'F1' && !fSev.includes('F1') && !fSev.includes('CRITICAL')) return false;
                else if (sev === 'F2' && !fSev.includes('F2') && !fSev.includes('MAJOR')) return false;
                else if (sev === 'F3' && !fSev.includes('F3') && !fSev.includes('MINOR')) return false;
                else if (sev === 'F4' && !fSev.includes('F4') && !fSev.includes('OBSERVATION')) return false;
                else if (sev !== 'F1' && sev !== 'F2' && sev !== 'F3' && sev !== 'F4' && fSev !== sev) return false;
            }
            if (tbl && !fTbl.includes(tbl)) return false;
            if (q) {
                const code = f.tracking_code || f.tracker_code || '';
                const assignee = f.assignee_name || f.assigned_to || '';
                const loc = f.location || f.area || '';
                const haystack = `${code} ${f.title || ''} ${f.element_id || ''} ${loc} ${assignee} ${fTbl}`.toLowerCase();
                if (!haystack.includes(q)) return false;
            }
            return true;
        });

        renderFindingsTable(filtered);
    }

    async function openFindingModal(id) {
        try {
            const res = await fetch('/api/findings/' + encodeURIComponent(id));
            const data = await res.json();
            const f = data.finding || data.data || data;
            if (!f || !f.id) {
                alert('❌ No se encontró el hallazgo solicitado.');
                return;
            }
            currentFinding = f;

            const code = f.tracking_code || f.tracker_code || f.id;
            document.getElementById('fnd-det-id').value = f.id;
            document.getElementById('fnd-det-tracker-code').textContent = code;
            document.getElementById('fnd-det-header-title').textContent = f.title || 'Desviación normativa';

            // Check if user can delete
            const delBtnModal = document.getElementById('fnd-det-btn-delete');
            if (delBtnModal) {
                delBtnModal.style.display = isUserCompanyAdminOrSuper() ? 'inline-block' : 'none';
            }

            // Severity badge
            const sevKey = (f.severity || 'MAJOR').toUpperCase();
            const sevEl = document.getElementById('fnd-det-severity-badge');
            if (sevEl) {
                if (sevKey.includes('CRITICAL') || sevKey.includes('F1')) {
                    sevEl.textContent = '🔴 F1 Critical';
                    sevEl.style.background = '#FEE2E2';
                    sevEl.style.color = '#DC2626';
                } else if (sevKey.includes('MAJOR') || sevKey.includes('F2')) {
                    sevEl.textContent = '🟠 F2 Major';
                    sevEl.style.background = '#FEF3C7';
                    sevEl.style.color = '#D97706';
                } else if (sevKey.includes('MINOR') || sevKey.includes('F3')) {
                    sevEl.textContent = '🔵 F3 Minor';
                    sevEl.style.background = '#E0E7FF';
                    sevEl.style.color = '#4F46E5';
                } else if (sevKey.includes('OBSERVATION') || sevKey.includes('F4')) {
                    sevEl.textContent = '🟢 F4 Observation';
                    sevEl.style.background = '#DCFCE7';
                    sevEl.style.color = '#15803D';
                } else {
                    sevEl.textContent = sevKey;
                    sevEl.style.background = '#FEF3C7';
                    sevEl.style.color = '#D97706';
                }
            }

            // Status badge
            const statusKey = (f.status || 'OPEN').toUpperCase();
            const statEl = document.getElementById('fnd-det-status-badge');
            if (statEl) {
                statEl.textContent = statusKey;
                statEl.style.background = statusKey === 'OPEN' ? '#FEE2E2' : (statusKey === 'IN_PROGRESS' ? '#FEF3C7' : (statusKey === 'PENDING_VERIFICATION' ? '#EDE9FE' : '#D1FAE5'));
                statEl.style.color = statusKey === 'OPEN' ? '#DC2626' : (statusKey === 'IN_PROGRESS' ? '#D97706' : (statusKey === 'PENDING_VERIFICATION' ? '#7C3AED' : '#059669'));
            }

            document.getElementById('fnd-det-element-id').textContent = f.element_id || f.category || '-';
            document.getElementById('fnd-det-location').textContent = f.location || f.area || '-';
            document.getElementById('fnd-det-table').textContent = f.normative_table || f.reference_table || 'ANSI/ESD S20.20';
            document.getElementById('fnd-det-deviation').textContent = `Medido: ${f.measured_value || '-'} | Límite: ${f.required_limit || f.limit_applied || '-'}`;
            document.getElementById('fnd-det-opened-info').textContent = `${(f.opened_at || f.created_at || '').substring(0, 10)} (${f.auditor_name || f.opened_by || 'Auditor'})`;
            document.getElementById('fnd-det-source').textContent = f.source_module || f.source || 'Auditoría en Piso';

            // Form fields
            document.getElementById('fnd-det-assignee').value = f.assignee_name || f.assigned_to || '';
            document.getElementById('fnd-det-due-date').value = (f.due_date || '').substring(0, 10);
            document.getElementById('fnd-det-containment').value = f.containment_action || f.immediate_containment || '';
            document.getElementById('fnd-det-root-cause').value = f.root_cause || '';
            document.getElementById('fnd-det-corrective').value = f.corrective_action || '';
            document.getElementById('fnd-det-lessons').value = f.lessons_learned || '';

            // Render Evidences
            const openContainer = document.getElementById('fnd-det-open-evidence-container');
            if (f.evidence_open_url) {
                openContainer.innerHTML = `<img src="${f.evidence_open_url}" style="max-height:100%; max-width:100%; object-fit:contain; cursor:pointer;" onclick="previewPhotoModal('${f.evidence_open_url}')" />`;
            } else {
                openContainer.innerHTML = `<span style="font-size:11.5px; color:var(--text-muted);">Sin evidencia fotográfica</span>`;
            }

            const closeContainer = document.getElementById('fnd-det-close-evidence-container');
            if (f.evidence_close_url) {
                closeContainer.innerHTML = `<img src="${f.evidence_close_url}" style="max-height:100%; max-width:100%; object-fit:contain; cursor:pointer;" onclick="previewPhotoModal('${f.evidence_close_url}')" />`;
            } else {
                closeContainer.innerHTML = `<span style="font-size:11.5px; color:var(--text-muted);">Pendiente de evidencia de cierre</span>`;
            }

            // Render timeline
            const tlContainer = document.getElementById('fnd-det-timeline');
            if (tlContainer) {
                const tl = f.timeline || [];
                if (tl.length > 0) {
                    let tlHtml = '';
                    tl.forEach(item => {
                        const dt = (item.timestamp || '').replace('T', ' ').substring(0, 16);
                        const notes = item.notes || item.comment || '';
                        tlHtml += `<div style="border-left:2px solid #CBD5E1; padding-left:8px; margin-left:4px; margin-bottom:4px;">
                            <span style="font-weight:700; color:var(--text-primary);">${escapeHtml(item.action || 'Evento')}</span>
                            <span style="color:var(--text-muted); font-size:10.5px;">por ${escapeHtml(item.user || 'Sistema')} (${dt})</span>
                            ${notes ? `<div style="color:var(--text-secondary); font-style:italic;">"${escapeHtml(notes)}"</div>` : ''}
                        </div>`;
                    });
                    tlContainer.innerHTML = tlHtml;
                } else {
                    tlContainer.innerHTML = `<span style="color:var(--text-muted); font-size:11px;">Sin historial de cambios registrado.</span>`;
                }
            }

            document.getElementById('modal-finding-detail').style.display = 'flex';
        } catch(e) {
            console.error('Error opening finding modal:', e);
            alert('❌ Error al cargar los detalles del hallazgo.');
        }
    }

    function closeFindingModal() {
        document.getElementById('modal-finding-detail').style.display = 'none';
