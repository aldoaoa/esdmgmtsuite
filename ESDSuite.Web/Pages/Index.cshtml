    // WebCam Camera Stream & Capture
    let valWebcamStream = null;

    async function openValWebcamModal() {
        const modal = document.getElementById('modal-val-camera');
        const video = document.getElementById('val-webcam-video');
        const errDiv = document.getElementById('val-webcam-error');
        if (!modal || !video) return;

        modal.style.display = 'flex';
        if (errDiv) errDiv.style.display = 'none';
        video.style.display = 'block';

        try {
            if (!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia) {
                throw new Error('La API de cámara no es soportada por este navegador o contexto.');
            }

            const constraints = {
                video: {
                    facingMode: { ideal: 'environment' },
                    width: { ideal: 1280 },
                    height: { ideal: 720 }
                }
            };

            valWebcamStream = await navigator.mediaDevices.getUserMedia(constraints);
            video.srcObject = valWebcamStream;
            await video.play();
        } catch(err) {
            console.warn('Error accessing environment camera, trying default video:', err);
            try {
                valWebcamStream = await navigator.mediaDevices.getUserMedia({ video: true });
                video.srcObject = valWebcamStream;
                await video.play();
            } catch(fallbackErr) {
                console.error('Camera access failed:', fallbackErr);
                if (errDiv) {
                    errDiv.style.display = 'block';
                    errDiv.innerHTML = `⚠️ No se pudo acceder a la cámara: ${fallbackErr.message || 'Permiso denegado'}.<br><br><small>Puedes subir una imagen directamente con el botón 📁.</small>`;
                }
                video.style.display = 'none';
            }
        }
    }

    function captureValWebcamPhoto() {
        const video = document.getElementById('val-webcam-video');
        const canvas = document.getElementById('val-webcam-canvas');
        if (!video || !canvas || !valWebcamStream) return;

        const width = video.videoWidth || 640;
        const height = video.videoHeight || 480;
        canvas.width = width;
        canvas.height = height;

        const ctx = canvas.getContext('2d');
        ctx.drawImage(video, 0, 0, width, height);

        canvas.toBlob(blob => {
            if (blob) {
                const fileName = `camera_val_${Date.now()}.jpg`;
                const file = new File([blob], fileName, { type: 'image/jpeg' });
                validationEvidenceFile = file;

                const prevContainer = document.getElementById('val-img-preview-container');
                if (prevContainer) {
                    const dataUrl = canvas.toDataURL('image/jpeg');
                    prevContainer.innerHTML = `
                        <div style="position:relative; display:inline-block;">
                            <img src="${dataUrl}" style="max-height:110px; max-width:100%; border-radius:6px; object-fit:contain; border:1px solid #CBD5E1;" alt="Preview" />
                            <button type="button" onclick="clearValEvidence()" style="position:absolute; top:2px; right:2px; background:rgba(239,68,68,0.9); color:#FFF; border:none; border-radius:50%; width:20px; height:20px; font-size:11px; cursor:pointer; display:flex; align-items:center; justify-content:center;">✕</button>
                        </div>
                    `;
                }
            }
            closeValWebcamModal();
        }, 'image/jpeg', 0.85);
    }

    function closeValWebcamModal() {
        if (valWebcamStream) {
            valWebcamStream.getTracks().forEach(track => track.stop());
            valWebcamStream = null;
        }
        const video = document.getElementById('val-webcam-video');
        if (video) video.srcObject = null;
        const modal = document.getElementById('modal-val-camera');
        if (modal) modal.style.display = 'none';
    }

