    async function loadSites() {
        const sel = document.getElementById('active-site-select');
        try {
            const res = await fetch('/api/sites');
            const sites = await res.json();
            allSites = sites || [];

            if (sel) {
                sel.innerHTML = '';
                if (!sessionData.can_change_site) {
                    const activeName = sessionData.site_name || (allSites.length > 0 ? allSites[0].name : 'Mi Planta');
                    const activeId = sessionData.site_id || (allSites.length > 0 ? allSites[0].id : '');
                    sel.innerHTML = `<option value="${activeId}" selected>${activeName}</option>`;
                    sel.disabled = true;
                    sel.title = "Tu rol no permite cambiar de site. Estás asignado exclusivamente a tu planta.";
                } else {
                    sel.disabled = false;
                    allSites.forEach(s => {
                        const opt = document.createElement('option');
                        opt.value = s.id;
                        opt.innerText = `${s.name}`;
                        if (s.id === sessionData.site_id) opt.selected = true;
                        sel.appendChild(opt);
                    });
                }
            }

            populateEquipmentSiteSelects(allSites);
        } catch (ex) {
            console.log('Error loading sites:', ex);
            if (sel) {
                sel.innerHTML = `<option value="${sessionData.site_id || ''}" selected>${sessionData.site_name || 'Mi Planta'}</option>`;
                sel.disabled = true;
            }
        }
    }

    function populateEquipmentSiteSelects(sites) {
        const eqFilter = document.getElementById('eq-site-filter');
        const eqFormSite = document.getElementById('eq-form-site');
        const siteGroup = document.getElementById('eq-site-group');

        if (eqFilter) {
            eqFilter.innerHTML = '<option value="">Todos los Sites...</option>';
            sites.forEach(s => {
                eqFilter.innerHTML += `<option value="${s.id}">${s.name}</option>`;
            });
            if (sessionData.site_id) eqFilter.value = sessionData.site_id;
        }

        if (eqFormSite) {
            eqFormSite.innerHTML = '';
            if (!sessionData.can_change_site) {
                eqFormSite.innerHTML = `<option value="${sessionData.site_id}" selected>${sessionData.site_name || 'Mi Planta'}</option>`;
                if (siteGroup) siteGroup.style.display = 'none';
            } else {
                if (siteGroup) siteGroup.style.display = 'block';
                sites.forEach(s => {
                    eqFormSite.innerHTML += `<option value="${s.id}">${s.name}</option>`;
                });
                if (sessionData.site_id) eqFormSite.value = sessionData.site_id;
            }
        }
    }

