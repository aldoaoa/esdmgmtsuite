    async function onEventMeterLineChange(lineName) {
        const opSel = document.getElementById('em-op-id');
        if (!opSel) return;
        const defaultText = t('eventmeter.opt_select_asset', '-- Seleccionar Activo u Operación --');
        opSel.innerHTML = `<option value="">${defaultText}</option>`;
        if (!lineName) return;

        try {
            const siteId = sessionData.site_id || '';
            const res = await fetch(`/api/line-assets?line=${encodeURIComponent(lineName)}&siteId=${siteId}`);
            if (res.ok) {
                const assets = await res.json();
                if (assets && assets.length > 0) {
                    assets.forEach(a => {
                        const subtype = a.element_subtype ? ` - ${a.element_subtype}` : '';
                        const type = a.element_type ? ` (${a.element_type})` : '';
                        opSel.innerHTML += `<option value="${a.asset_id}">${a.asset_id}${subtype}${type}</option>`;
                    });
                }
                opSel.innerHTML += `<option value="${lineName}-OP01">${lineName}-OP01 (Operación General)</option>`;
                opSel.value = '';
            }
        } catch(e) {
            console.error('Error loading line assets:', e);
            opSel.innerHTML += `<option value="${lineName}-OP01">${lineName}-OP01</option>`;
        }
    }

