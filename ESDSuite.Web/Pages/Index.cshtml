    // ========================================================
    // ESD FLOOR MAPS & 2D CONTINUOUS HEATMAP ENGINE
    // ========================================================
    let editorCurrentMap = null;
    let editorPointsList = [];
    let allMapsList = [];
    let editorIsDragging = false;
    let editorDraggedIdx = -1;

    let currentViewerMap = null;
    let activeHeatmapMode = 'mixed'; // 'mixed', 'heatmap', 'plan'
    let activePointEditIdx = -1;

    // --- MAP EDITOR IN SETTINGS ---
    async function loadMapsEditor() {
        const siteId = (sessionData && sessionData.site_id) || '';
        try {
            // 1. Load Area dropdown in editor
            const areaSel = document.getElementById('map-input-area');
            if (areaSel) {
                const lineRes = await fetch(`/api/lines?siteId=${siteId}`);
                if (lineRes.ok) {
                    const lines = await lineRes.json();
                    areaSel.innerHTML = '<option value="">-- Seleccionar Área / Línea --</option>';
                    lines.forEach(l => {
                        const name = l.nombre_linea || l.name;
                        areaSel.innerHTML += `<option value="${name}">${name}</option>`;
                    });
                }
            }

            // 2. Fetch Maps
            const res = await fetch(`/api/maps?siteId=${siteId}`);
            if (res.ok) {
                allMapsList = await res.json();
                const sel = document.getElementById('map-select-edit');
                if (sel) {
                    sel.innerHTML = '<option value="">-- Crear Nuevo Plano --</option>';
                    allMapsList.forEach(m => {
                        sel.innerHTML += `<option value="${m.id}">${m.mapName || m.areaName} (${m.areaName})</option>`;
                    });
                }

                if (allMapsList.length > 0 && (!editorCurrentMap || !allMapsList.some(m => m.id === editorCurrentMap.id))) {
                    loadMapForEditing(allMapsList[0].id);
                } else if (allMapsList.length === 0) {
                    initNewMapEditor();
                }
            }
        } catch(e) {
            console.error('Error loading maps in editor:', e);
        }
    }

    function initNewMapEditor() {
        editorCurrentMap = null;
        editorPointsList = [];
        const sel = document.getElementById('map-select-edit');
        if (sel) sel.value = '';

        document.getElementById('map-input-name').value = '';
        document.getElementById('map-input-area').value = '';
        document.getElementById('map-input-total-area').value = '500';
        document.getElementById('map-input-unit').value = 'm2';
        document.getElementById('map-input-file').value = '';
        document.getElementById('map-input-base64').value = '';
        document.getElementById('map-input-current-url').value = '/images/mockups/smt1_layout.svg';
        document.getElementById('editor-floorplan-img').src = '/images/mockups/smt1_layout.svg';

        renderEditorPoints();
    }

    function loadMapForEditing(mapId) {
        if (!mapId) {
            initNewMapEditor();
            return;
        }
        const map = allMapsList.find(m => m.id === mapId);
        if (!map) return;

        editorCurrentMap = map;
        editorPointsList = JSON.parse(JSON.stringify(map.points || []));

        const sel = document.getElementById('map-select-edit');
        if (sel) sel.value = mapId;

        document.getElementById('map-input-name').value = map.mapName || '';
        document.getElementById('map-input-area').value = map.areaName || '';
        document.getElementById('map-input-total-area').value = map.totalAreaValue || 500;
        document.getElementById('map-input-unit').value = map.areaUnit || 'm2';
        document.getElementById('map-input-file').value = '';
        document.getElementById('map-input-base64').value = '';
        document.getElementById('map-input-current-url').value = map.imageUrl || '/images/mockups/smt1_layout.svg';
        document.getElementById('editor-floorplan-img').src = map.imageUrl || '/images/mockups/smt1_layout.svg';

        renderEditorPoints();
    }

    function onMapFileSelected(event) {
        const file = event.target.files && event.target.files[0];
        if (!file) return;

        const reader = new FileReader();
        reader.onload = function(e) {
            const base64 = e.target.result;
            document.getElementById('map-input-base64').value = base64;
            document.getElementById('editor-floorplan-img').src = base64;
        };
        reader.readAsDataURL(file);
    }

    function generateAutoPointsNorm() {
        const rawArea = parseFloat(document.getElementById('map-input-total-area').value) || 500;
        const unit = document.getElementById('map-input-unit').value || 'm2';
        
        // Convert to m2 if ft2 (1 m2 = 10.7639 ft2)
        const areaM2 = unit === 'ft2' ? rawArea / 10.7639 : rawArea;
        
        // Rule: 5 points per each 500 m2 (Minimum 5 points)
        const targetPoints = Math.max(5, Math.round(5 * (areaM2 / 500)));

        editorPointsList = [];

        if (targetPoints === 5) {
            // Standard 5-point layout (4 corners + 1 center)
            const coords = [
                { x: 20, y: 25 },
                { x: 80, y: 25 },
                { x: 50, y: 50 },
                { x: 20, y: 75 },
                { x: 80, y: 75 }
            ];
            coords.forEach((c, idx) => {
                editorPointsList.push({
                    id: 'pt-' + (idx + 1) + '-' + Date.now(),
                    code: (idx + 1).toString(),
                    label: `Punto de Prueba ${idx + 1}`,
                    xPercent: c.x,
                    yPercent: c.y,
                    lastResistanceOhms: null
                });
            });
        } else {
            // Regular grid pattern with 15% margins
            const cols = Math.ceil(Math.sqrt(targetPoints * 1.4));
            const rows = Math.ceil(targetPoints / cols);
            let created = 0;

            for (let r = 0; r < rows; r++) {
                const y = rows === 1 ? 50 : 20 + (r * 60) / (rows - 1);
                for (let c = 0; c < cols; c++) {
                    if (created >= targetPoints) break;
                    const x = cols === 1 ? 50 : 18 + (c * 64) / (cols - 1);
                    created++;
                    editorPointsList.push({
                        id: 'pt-' + created + '-' + Date.now(),
                        code: created.toString(),
                        label: `Punto de Prueba ${created}`,
                        xPercent: parseFloat(x.toFixed(1)),
                        yPercent: parseFloat(y.toFixed(1)),
                        lastResistanceOhms: null
                    });
                }
            }
        }

        renderEditorPoints();
        const msg = t('maps.auto_gen_toast', '⚡ Generación normativa completada: {0} puntos de prueba distribuidos según {1} m² (5 pts / 500 m²). Puedes arrastrarlos para ajustar.')
            .replace('{0}', targetPoints)
            .replace('{1}', Math.round(areaM2));
        alert(msg);
    }

    function addManualPointToCenter() {
        const nextCode = (editorPointsList.length + 1).toString();
        editorPointsList.push({
            id: 'pt-' + nextCode + '-' + Date.now(),
            code: nextCode,
            label: `Punto de Prueba ${nextCode}`,
            xPercent: 50,
            yPercent: 50,
            lastResistanceOhms: null
        });
        renderEditorPoints();
    }

    function clearAllEditorPoints() {
        if (editorPointsList.length === 0) return;
        if (!confirm('¿Deseas limpiar todos los puntos del mapa?')) return;
        editorPointsList = [];
        renderEditorPoints();
    }

    function onEditorMapClick(event) {
        if (editorIsDragging) return;
        // Only trigger if clicked on the wrapper/image, not directly on an existing pin
        if (event.target.classList.contains('floor-pin') || event.target.closest('.floor-pin')) return;

        const wrapper = document.getElementById('editor-map-wrapper');
        if (!wrapper) return;

        const rect = wrapper.getBoundingClientRect();
        const xPx = event.clientX - rect.left;
        const yPx = event.clientY - rect.top;

        const xPercent = Math.min(98, Math.max(2, parseFloat(((xPx / rect.width) * 100).toFixed(1))));
        const yPercent = Math.min(98, Math.max(2, parseFloat(((yPx / rect.height) * 100).toFixed(1))));

        const nextCode = (editorPointsList.length + 1).toString();
        editorPointsList.push({
            id: 'pt-' + nextCode + '-' + Date.now(),
            code: nextCode,
            label: `Punto ${nextCode}`,
            xPercent: xPercent,
            yPercent: yPercent,
            lastResistanceOhms: null
        });

        renderEditorPoints();
    }

    function renderEditorPoints() {
        const overlay = document.getElementById('editor-points-overlay');
        const tbody = document.getElementById('editor-points-tbody');
        const badge = document.getElementById('map-points-badge');

        if (badge) badge.innerText = `${editorPointsList.length} Puntos Mapeados`;
        if (overlay) overlay.innerHTML = '';
        if (tbody) tbody.innerHTML = '';

        if (!editorPointsList || editorPointsList.length === 0) {
            if (tbody) tbody.innerHTML = '<tr><td colspan="5" style="text-align:center; color:var(--text-muted); font-size:12px;">Sin puntos en el mapa. Haz clic en el plano o presiona "Generar Puntos Automáticos".</td></tr>';
            return;
        }

        editorPointsList.forEach((pt, idx) => {
            // 1. Render Pin on Overlay
            if (overlay) {
                const pin = document.createElement('div');
                pin.className = 'floor-pin';
                pin.style.left = `${pt.xPercent}%`;
                pin.style.top = `${pt.yPercent}%`;
                pin.setAttribute('data-idx', idx);
                pin.title = `${pt.label || 'Punto ' + pt.code} (X: ${pt.xPercent}%, Y: ${pt.yPercent}%)`;
                pin.innerHTML = `${pt.code || (idx + 1)}<div class="pin-tooltip">${pt.label || 'Punto ' + (idx + 1)}</div>`;

                // Drag and drop event listeners
                pin.addEventListener('mousedown', (e) => startDragPin(e, idx));
                pin.addEventListener('touchstart', (e) => startDragPin(e, idx), { passive: false });

                overlay.appendChild(pin);
            }

            // 2. Render Table Row
            if (tbody) {
                const tr = document.createElement('tr');
                tr.innerHTML = `
                    <td style="font-weight:700; text-align:center;">${pt.code || (idx + 1)}</td>
                    <td>
                        <input type="text" class="form-control" style="padding:4px 8px; font-size:12px;" value="${pt.label || 'Punto ' + (idx + 1)}" onchange="updateEditorPointLabel(${idx}, this.value)" />
                    </td>
                    <td style="text-align:center; font-family:monospace; font-weight:700;" id="pt-coord-x-${idx}">${pt.xPercent}%</td>
                    <td style="text-align:center; font-family:monospace; font-weight:700;" id="pt-coord-y-${idx}">${pt.yPercent}%</td>
                    <td style="text-align:center;">
                        <button type="button" class="btn-primary" style="background:var(--accent-rose); padding:3px 7px; font-size:11px;" onclick="deleteEditorPoint(${idx})">🗑️</button>
                    </td>
                `;
                tbody.appendChild(tr);
            }
        });
    }

    function updateEditorPointLabel(idx, newLabel) {
        if (editorPointsList[idx]) {
            editorPointsList[idx].label = newLabel;
        }
    }

    function deleteEditorPoint(idx) {
        editorPointsList.splice(idx, 1);
        // Renumber codes sequentially
        editorPointsList.forEach((p, i) => { p.code = (i + 1).toString(); });
        renderEditorPoints();
    }

    // --- DRAGGING PIN LOGIC FOR MAP EDITOR ---
    function startDragPin(e, idx) {
        e.stopPropagation();
        if (e.type === 'touchstart') e.preventDefault();

        editorIsDragging = true;
        editorDraggedIdx = idx;

        const pin = e.currentTarget;
        pin.classList.add('dragging');

        const onMove = (moveEvt) => {
            if (!editorIsDragging || editorDraggedIdx < 0) return;
            const clientX = moveEvt.clientX || (moveEvt.touches && moveEvt.touches[0].clientX);
            const clientY = moveEvt.clientY || (moveEvt.touches && moveEvt.touches[0].clientY);
            if (clientX === undefined || clientY === undefined) return;

            const wrapper = document.getElementById('editor-map-wrapper');
            if (!wrapper) return;
            const rect = wrapper.getBoundingClientRect();

            const xPx = clientX - rect.left;
            const yPx = clientY - rect.top;

            const xPercent = Math.min(98, Math.max(2, parseFloat(((xPx / rect.width) * 100).toFixed(1))));
            const yPercent = Math.min(98, Math.max(2, parseFloat(((yPx / rect.height) * 100).toFixed(1))));

            editorPointsList[editorDraggedIdx].xPercent = xPercent;
            editorPointsList[editorDraggedIdx].yPercent = yPercent;

            pin.style.left = `${xPercent}%`;
            pin.style.top = `${yPercent}%`;

            const xCell = document.getElementById(`pt-coord-x-${editorDraggedIdx}`);
            const yCell = document.getElementById(`pt-coord-y-${editorDraggedIdx}`);
            if (xCell) xCell.innerText = `${xPercent}%`;
            if (yCell) yCell.innerText = `${yPercent}%`;
        };

        const onEnd = () => {
            editorIsDragging = false;
            editorDraggedIdx = -1;
            pin.classList.remove('dragging');
            window.removeEventListener('mousemove', onMove);
            window.removeEventListener('mouseup', onEnd);
            window.removeEventListener('touchmove', onMove);
            window.removeEventListener('touchend', onEnd);
        };

        window.addEventListener('mousemove', onMove);
        window.addEventListener('mouseup', onEnd);
        window.addEventListener('touchmove', onMove, { passive: false });
        window.addEventListener('touchend', onEnd);
    }

    async function saveMapConfigToServer() {
        const areaName = document.getElementById('map-input-area').value;
        const mapName = document.getElementById('map-input-name').value.trim();
        const totalArea = parseFloat(document.getElementById('map-input-total-area').value) || 500;
        const unit = document.getElementById('map-input-unit').value || 'm2';
        const base64 = document.getElementById('map-input-base64').value;
        const currentUrl = document.getElementById('map-input-current-url').value;

        if (!areaName) {
            alert('Por favor selecciona el Área / Línea asignada.');
            return;
        }
        if (!mapName) {
            alert('Por favor ingresa un nombre para el plano.');
            return;
        }

        const mapId = editorCurrentMap ? editorCurrentMap.id : '';
        const siteId = (sessionData && sessionData.site_id) || '';

        const payload = {
            id: mapId,
            siteId: siteId,
            areaName: areaName,
            mapName: mapName,
            totalAreaValue: totalArea,
            areaUnit: unit,
            imageBase64: base64,
            imageUrl: base64 ? '' : currentUrl,
            points: editorPointsList
        };

        try {
            const res = await fetch('/api/maps/upload', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'X-User-Id': (sessionData && sessionData.user_id) || '',
                    'X-User-Role': (sessionData && sessionData.user_role) || ''
                },
                body: JSON.stringify(payload)
            });
            const data = await res.json();
            if (res.ok && data.success) {
                alert(`✅ Plano "${mapName}" con ${editorPointsList.length} puntos guardado exitosamente.`);
                await loadMapsEditor();
                if (data.map && data.map.id) {
                    loadMapForEditing(data.map.id);
                }
            } else {
                alert(data.message || '❌ Error al guardar el plano.');
            }
        } catch(e) {
            console.error('Error saving map:', e);
            alert('❌ Error de conexión al guardar el plano.');
        }
    }

    // ========================================================
    // ESD FLOORING MAP VIEWER & CONTINUOUS 2D HEATMAP ENGINE
    // ========================================================
    async function loadFloorMapsForViewer() {
        const siteId = (sessionData && sessionData.site_id) || '';
        const sel = document.getElementById('fl-map-select');
        if (!sel) return;

        try {
            const res = await fetch(`/api/maps?siteId=${siteId}`);
            if (res.ok) {
                allMapsList = await res.json();
                sel.innerHTML = '<option value="">-- Seleccionar Plano de Línea --</option>';
                allMapsList.forEach(m => {
                    sel.innerHTML += `<option value="${m.id}">${m.mapName || m.areaName} (${m.areaName})</option>`;
                });

                if (allMapsList.length > 0 && !currentViewerMap) {
                    sel.value = allMapsList[0].id;
                    onFloorMapViewerSelected(allMapsList[0].id);
                }
            }
        } catch(e) {
            console.error('Error loading maps for viewer:', e);
        }
    }

    function onFloorMapViewerSelected(mapId) {
        const card = document.getElementById('floor-map-viewer-card');
        if (!mapId) {
            if (card) card.style.display = 'none';
            currentViewerMap = null;
            return;
        }

        currentViewerMap = allMapsList.find(m => m.id === mapId);
        if (!currentViewerMap) return;

        if (card) card.style.display = 'block';

        const img = document.getElementById('viewer-floorplan-img');
        if (img) {
            img.src = currentViewerMap.imageUrl || '/images/mockups/smt1_layout.svg';
            img.onload = () => {
                renderViewerPoints();
                renderFloor2DHeatmap();
            };
        }

        renderViewerPoints();
        setTimeout(renderFloor2DHeatmap, 80);
    }

    function setHeatmapMode(mode) {
        activeHeatmapMode = mode;
        document.getElementById('btn-hm-mode-mixed').classList.toggle('active', mode === 'mixed');
        document.getElementById('btn-hm-mode-heatmap').classList.toggle('active', mode === 'heatmap');
        document.getElementById('btn-hm-mode-plan').classList.toggle('active', mode === 'plan');

        const canvas = document.getElementById('viewer-heatmap-canvas');
        const img = document.getElementById('viewer-floorplan-img');

        if (canvas && img) {
            if (mode === 'mixed') {
                canvas.style.opacity = '0.6';
                canvas.style.display = 'block';
                img.style.opacity = '1';
            } else if (mode === 'heatmap') {
                canvas.style.opacity = '1';
                canvas.style.display = 'block';
                img.style.opacity = '0.15';
            } else if (mode === 'plan') {
                canvas.style.opacity = '0';
                canvas.style.display = 'none';
                img.style.opacity = '1';
