                <div style="font-weight:700; color:var(--text-primary); margin-bottom:4px;">No se encontraron hallazgos registrados</div>
                <div style="font-size:11.5px; color:var(--text-secondary); margin-bottom:14px;">Todos los elementos auditados cumplen con los rangos normativos ANSI/ESD S20.20-2021.</div>
                <button type="button" class="btn-primary" onclick="openNewFindingModal()" style="font-size:12px; padding:6px 16px; background:#2563EB;">
                    ➕ Levantar Hallazgo Manual
                </button>
            </td></tr>`;
            return;
        }

        const canDelete = isUserCompanyAdminOrSuper();

        function getSeverityBadgeInfo(rawSev) {
            const s = (rawSev || 'MAJOR').toUpperCase();
            if (s.includes('CRITICAL') || s.includes('F1')) {
                return { bg: '#FEE2E2', color: '#DC2626', label: '🔴 F1 Critical' };
            }
            if (s.includes('MAJOR') || s.includes('F2')) {
                return { bg: '#FEF3C7', color: '#D97706', label: '🟠 F2 Major' };
            }
            if (s.includes('MINOR') || s.includes('F3')) {
                return { bg: '#E0E7FF', color: '#4F46E5', label: '🔵 F3 Minor' };
            }
            if (s.includes('OBSERVATION') || s.includes('F4')) {
                return { bg: '#DCFCE7', color: '#15803D', label: '🟢 F4 Observation' };
            }
            return { bg: '#FEF3C7', color: '#D97706', label: '🟠 ' + (rawSev || 'F2 Major') };
        }

        const statusBadges = {
