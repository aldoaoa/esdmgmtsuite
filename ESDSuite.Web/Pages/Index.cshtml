    async function submitEditEventMeter(e) {
        e.preventDefault();
        const id = document.getElementById('edit-em-id').value;
        const tiempoVal = parseFloat(document.getElementById('edit-em-tiempo-valor').value) || 30;
        const tiempoUnidad = document.getElementById('edit-em-tiempo-unidad').value || 'min';
        const tiempoAnalisis = `${tiempoVal} ${tiempoUnidad}`;

        const payload = {
            linea_ubicacion: document.getElementById('edit-em-linea').value,
            id_operacion: document.getElementById('edit-em-op-id').value,
            tipo_contacto: document.getElementById('edit-em-contacto').value,
            tiempo_analisis: tiempoAnalisis,
            tiempo_analisis_valor: tiempoVal,
            tiempo_analisis_unidad: tiempoUnidad,
            cantidad_eventos: parseInt(document.getElementById('edit-em-cant').value) || 0,
            voltaje_maximo: parseFloat(document.getElementById('edit-em-volt-max').value) || 0,
            temperatura: parseFloat(document.getElementById('edit-em-temp').value) || 23.5,
            humedad: parseFloat(document.getElementById('edit-em-hum').value) || 45.0,
            notas: document.getElementById('edit-em-notas').value.trim()
        };

        try {
            const res = await fetch(`/api/event-meter/${encodeURIComponent(id)}`, {
                method: 'PUT',
                headers: { 
                    'Content-Type': 'application/json',
                    'X-User-Id': (sessionData && sessionData.user_id) || '',
                    'X-User-Role': (sessionData && sessionData.user_role) || ''
                },
                body: JSON.stringify(payload)
            });
            const data = await res.json();
            if (res.ok && data.success) {
                alert(t('eventmeter.updated_success', 'Registro de Event Meter actualizado exitosamente.'));
