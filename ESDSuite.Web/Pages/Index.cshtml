    async function populateAssetModalLines(selectElementId, selectedLocation, targetSiteId) {
        const sel = document.getElementById(selectElementId);
        if (!sel) return;
        const siteSelect = document.getElementById('active-site-select');
        const siteId = targetSiteId || (siteSelect && siteSelect.value) || (sessionData && sessionData.site_id) || '';
        const defaultText = t('audit.opt_select_line', '-- Seleccionar Línea --');
        sel.innerHTML = `<option value="">${defaultText}</option>`;

        try {
            const res = await fetch(`/api/lines?siteId=${encodeURIComponent(siteId)}`);
            if (res.ok) {
                const lines = await res.json();
                let found = false;
                if (Array.isArray(lines)) {
                    lines.forEach(l => {
                        const name = l.nombre_linea || l.name;
                        if (!name) return;
                        const opt = document.createElement('option');
                        opt.value = name;
                        opt.textContent = name;
                        if (selectedLocation && (selectedLocation.trim().toLowerCase() === name.trim().toLowerCase())) {
                            opt.selected = true;
                            found = true;
                        }
                        sel.appendChild(opt);
                    });
                }
                if (selectedLocation && !found && selectedLocation.trim() !== '') {
                    const opt = document.createElement('option');
                    opt.value = selectedLocation;
                    opt.textContent = selectedLocation;
                    opt.selected = true;
                    sel.appendChild(opt);
                }
            }
        } catch(e) {
            console.error('Error fetching lines for asset modal:', e);
        }
    }

