                <span style="font-size:22px;">📦</span>
                <div>
                    <h3 style="margin:0; font-size:15.5px; font-weight:800; color:var(--text-primary);" data-i18n="inventory.modal_new_title">Alta y Configuración de Activo ESD</h3>
                    <p style="margin:2px 0 0 0; font-size:11.5px; color:var(--text-muted);" data-i18n="inventory.modal_new_subtitle">Registro de nuevo punto de control, ubicación y frecuencia de validación periódica.</p>
                </div>
            </div>
            <button type="button" class="btn-text" style="font-size:20px; color:var(--text-muted); cursor:pointer; padding:4px 8px; border-radius:6px;" onclick="closeNewAssetModal()">✕</button>
        </div>

        <!-- FORM BODY -->
        <div style="padding:20px; display:flex; flex-direction:column; gap:14px;">
            <div style="display:grid; grid-template-columns: 1fr 1fr; gap:14px;">
                <div class="form-group">
                    <label data-i18n="inventory.lbl_custom_id">Código / ID Único del Activo*</label>
                    <input type="text" id="inv-new-id" class="form-control" placeholder="Ej: WS-SMT-01 / ION-ICT-02" data-i18n-placeholder="inventory.ph_custom_id" required />
                </div>
                <div class="form-group">
                    <label data-i18n="inventory.lbl_name">Nombre / Descripción del Activo*</label>
                    <input type="text" id="inv-new-name" class="form-control" placeholder="Ej: Mesa de Trabajo Principal SMT 1" data-i18n-placeholder="inventory.ph_name" required />
                </div>
            </div>

            <div style="display:grid; grid-template-columns: 1fr 1fr; gap:14px;">
                <div class="form-group">
                    <label data-i18n="inventory.lbl_category">Tipo / Categoría de Activo*</label>
                    <select id="inv-new-category" class="form-control" onchange="onNewAssetCategoryChange(this.value)">
                        <option value="Mobiliario ESD" data-i18n="audit.cat_furniture">Mobiliario ESD</option>
                        <option value="Sistema de ionización" data-i18n="audit.cat_ionizer">Sistema de ionización</option>
                        <option value="Maquinaria y equipo" data-i18n="audit.cat_machinery">Maquinaria y equipo</option>
                        <option value="Puntos de Tierra / Grounding" data-i18n="audit.cat_grounding">Puntos de Tierra / Grounding</option>
                        <option value="Pisos y Calzado" data-i18n="audit.cat_floors">Pisos y Calzado</option>
                        <option value="Prendas y Guantes" data-i18n="audit.cat_garments">Prendas y Guantes</option>
                    </select>
                </div>
                <div class="form-group">
                    <label data-i18n="inventory.lbl_subtype">Subtipo de Activo*</label>
                    <select id="inv-new-subtype" class="form-control">
                        <!-- Populated dynamically -->
                    </select>
                </div>
            </div>

            <div style="display:grid; grid-template-columns: 1fr 1fr; gap:14px;">
                <div class="form-group">
                    <label data-i18n="inventory.lbl_line">Línea / Ubicación Asignada*</label>
                    <select id="inv-new-line" class="form-control" onchange="onNewAssetLineChange(this.value)" required>
                        <option value="">-- Seleccionar Línea --</option>
                    </select>
                </div>
                <div class="form-group">
                    <label data-i18n="inventory.lbl_area">Área / Zona*</label>
                    <input type="text" id="inv-new-area" class="form-control" placeholder="Ej: Backend, SMT, Almacén" data-i18n-placeholder="inventory.ph_area" />
                </div>
            </div>

            <div style="display:grid; grid-template-columns: 1fr 1fr; gap:14px;">
                <div class="form-group">
                    <label data-i18n="inventory.lbl_periodicity">Periodicidad de Validación*</label>
                    <select id="inv-new-periodicity" class="form-control">
                        <option value="1d" data-i18n="periodicity.1d">1 Día (Diario)</option>
                        <option value="1w" data-i18n="periodicity.1w">1 Semana (Semanal)</option>
                        <option value="2w" data-i18n="periodicity.2w">2 Semanas (Quincenal)</option>
                        <option value="1m" selected data-i18n="periodicity.1m">1 Mes (Mensual)</option>
                        <option value="3m" data-i18n="periodicity.3m">3 Meses (Trimestral)</option>
                        <option value="6m" data-i18n="periodicity.6m">6 Meses (Semestral)</option>
                        <option value="1y" data-i18n="periodicity.1y">1 Año (Anual)</option>
                        <option value="permanent" data-i18n="periodicity.permanent">Permanente (N/A)</option>
                    </select>
                </div>
                <div class="form-group">
                    <label data-i18n="inventory.lbl_created_at">Fecha de Instalación / Registro*</label>
                    <input type="date" id="inv-new-date" class="form-control" required />
                </div>
            </div>

            <div class="form-group">
                <label data-i18n="inventory.lbl_notes">Notas / Observaciones Técnicas</label>
                <input type="text" id="inv-new-notes" class="form-control" placeholder="Ej: Ubicada junto a estación de reflujo" data-i18n-placeholder="inventory.ph_notes" />
            </div>
        </div>

        <!-- FOOTER -->
        <div style="padding:14px 20px; border-top:1px solid var(--border-color); display:flex; justify-content:flex-end; gap:10px; background:#F8FAFC; border-radius:0 0 14px 14px;">
            <button type="button" class="tab-btn" style="padding:7px 16px; font-size:12px;" onclick="closeNewAssetModal()" data-i18n="inventory.btn_cancel">✕ Cancelar</button>
            <button type="button" class="btn-primary" style="padding:7px 20px; font-size:12.5px; font-weight:700;" onclick="submitNewAsset()" data-i18n="inventory.btn_save_asset">💾 Guardar Activo</button>
        </div>
    </div>
</div>

<!-- MODAL: ASSET DETAIL, EDITING & DECOMMISSION -->
<div id="modal-edit-asset" class="modal-backdrop" style="display:none; position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(15,23,42,0.75); backdrop-filter:blur(4px); z-index:9995; justify-content:center; align-items:center; padding:16px;" onclick="if(event.target===this) closeAssetEditModal()">
    <div class="glass-card" style="background:#FFFFFF; border:1px solid var(--border-color); border-radius:14px; width:100%; max-width:720px; max-height:92vh; overflow-y:auto; box-shadow:0 24px 48px rgba(0,0,0,0.3); padding:0; display:flex; flex-direction:column;" onclick="event.stopPropagation()">
        <!-- HEADER -->
        <div style="padding:16px 20px; border-bottom:1px solid var(--border-color); display:flex; justify-content:space-between; align-items:center; background:#F8FAFC; border-radius:14px 14px 0 0;">
            <div style="display:flex; align-items:center; gap:10px;">
                <span style="font-size:22px;">🛠️</span>
                <div>
                    <h3 style="margin:0; font-size:15.5px; font-weight:800; color:var(--text-primary);" data-i18n="inventory.modal_edit_title">Detalle y Edición de Activo ESD</h3>
                    <p style="margin:2px 0 0 0; font-size:11.5px; color:var(--text-muted);" data-i18n="inventory.modal_edit_subtitle">Modificación de clasificación, ubicación y baja de control normativo.</p>
                </div>
            </div>
            <button type="button" class="btn-text" style="font-size:20px; color:var(--text-muted); cursor:pointer; padding:4px 8px; border-radius:6px;" onclick="closeAssetEditModal()">✕</button>
        </div>

        <!-- FORM BODY -->
        <div style="padding:20px; display:flex; flex-direction:column; gap:14px;">
            <!-- COMPLIANCE INTEGRITY NOTICE -->
            <div style="background:#EFF6FF; border:1px solid #BFDBFE; border-radius:8px; padding:10px 14px; font-size:12px; color:#1E40AF; display:flex; align-items:center; gap:8px;">
                <span data-i18n="inventory.lbl_readonly_notice">ℹ️ Las mediciones históricas, fechas de validación y auditor original no son editables para garantizar trazabilidad normativa.</span>
            </div>

            <input type="hidden" id="inv-edit-db-id" />

            <!-- ROW 1: ASSET ID (READONLY) & STATUS BADGE -->
            <div style="display:grid; grid-template-columns: 1fr 1fr; gap:14px; align-items:center;">
                <div class="form-group">
                    <label data-i18n="inventory.lbl_custom_id">Código / ID Único del Activo*</label>
                    <input type="text" id="inv-edit-id" class="form-control" readonly style="background:#F1F5F9; font-family:monospace; font-weight:700; color:var(--accent-blue); cursor:not-allowed;" />
                </div>
                <div class="form-group">
                    <label data-i18n="inventory.col_status">Estatus Actual</label>
                    <div style="display:flex; align-items:center; height:38px;">
                        <span id="inv-edit-status-badge" class="badge-pass" style="font-size:12px; padding:6px 16px; font-weight:800; letter-spacing:0.5px;">ACTIVO</span>
                    </div>
                </div>
            </div>

            <!-- ROW 2: DESCRIPTION & CATEGORY -->
            <div style="display:grid; grid-template-columns: 1fr 1fr; gap:14px;">
                <div class="form-group">
                    <label data-i18n="inventory.lbl_name">Nombre / Descripción del Activo*</label>
                    <input type="text" id="inv-edit-name" class="form-control" placeholder="Ej: Mesa de Trabajo Principal SMT 1" data-i18n-placeholder="inventory.ph_name" required />
                </div>
                <div class="form-group">
                    <label data-i18n="inventory.lbl_category">Tipo / Categoría de Activo*</label>
                    <select id="inv-edit-category" class="form-control" onchange="onEditAssetCategoryChange(this.value)">
                        <option value="Mobiliario ESD" data-i18n="audit.cat_furniture">Mobiliario ESD</option>
                        <option value="Sistema de ionización" data-i18n="audit.cat_ionizer">Sistema de ionización</option>
                        <option value="Maquinaria y equipo" data-i18n="audit.cat_machinery">Maquinaria y equipo</option>
                        <option value="Puntos de Tierra / Grounding" data-i18n="audit.cat_grounding">Puntos de Tierra / Grounding</option>
                        <option value="Pisos y Calzado" data-i18n="audit.cat_floors">Pisos y Calzado</option>
                        <option value="Prendas y Guantes" data-i18n="audit.cat_garments">Prendas y Guantes</option>
                    </select>
                </div>
            </div>

            <!-- ROW 3: SUBTYPE & LINE -->
            <div style="display:grid; grid-template-columns: 1fr 1fr; gap:14px;">
                <div class="form-group">
                    <label data-i18n="inventory.lbl_subtype">Subtipo de Activo*</label>
                    <select id="inv-edit-subtype" class="form-control">
                        <!-- Populated dynamically -->
                    </select>
                </div>
                <div class="form-group">
                    <label data-i18n="inventory.lbl_line">Línea / Ubicación Asignada*</label>
                    <select id="inv-edit-line" class="form-control" onchange="onEditAssetLineChange(this.value)" required>
                        <option value="">-- Seleccionar Línea --</option>
                    </select>
                </div>
            </div>

            <!-- ROW 4: AREA & PERIODICITY -->
            <div style="display:grid; grid-template-columns: 1fr 1fr; gap:14px;">
                <div class="form-group">
                    <label data-i18n="inventory.lbl_area">Área / Zona*</label>
                    <input type="text" id="inv-edit-area" class="form-control" placeholder="Ej: Backend, SMT, Almacén" data-i18n-placeholder="inventory.ph_area" />
                </div>
                <div class="form-group">
                    <label data-i18n="inventory.lbl_periodicity">Periodicidad de Validación*</label>
                    <select id="inv-edit-periodicity" class="form-control">
                        <option value="1d" data-i18n="periodicity.1d">1 Día (Diario)</option>
                        <option value="1w" data-i18n="periodicity.1w">1 Semana (Semanal)</option>
                        <option value="2w" data-i18n="periodicity.2w">2 Semanas (Quincenal)</option>
                        <option value="1m" data-i18n="periodicity.1m">1 Mes (Mensual)</option>
                        <option value="3m" data-i18n="periodicity.3m">3 Meses (Trimestral)</option>
                        <option value="6m" data-i18n="periodicity.6m">6 Meses (Semestral)</option>
                        <option value="1y" data-i18n="periodicity.1y">1 Año (Anual)</option>
                        <option value="permanent" data-i18n="periodicity.permanent">Permanente (N/A)</option>
                    </select>
                </div>
            </div>

            <!-- ROW 5: NOTES -->
            <div class="form-group">
                <label data-i18n="inventory.lbl_notes">Notas / Observaciones Técnicas</label>
                <input type="text" id="inv-edit-notes" class="form-control" placeholder="Ej: Ubicada junto a estación de reflujo" data-i18n-placeholder="inventory.ph_notes" />
            </div>

            <!-- READ-ONLY AUDIT & TRACEABILITY CARD -->
            <div style="background:#F8FAFC; border:1px solid #E2E8F0; border-radius:10px; padding:14px; display:flex; flex-direction:column; gap:10px;">
                <div style="display:grid; grid-template-columns: 1fr 1fr 1fr; gap:12px;">
                    <div>
                        <small style="color:var(--text-muted); font-size:11px; font-weight:700;" data-i18n="inventory.registered_by">Registrado / Auditado por</small>
                        <div id="inv-edit-auditor" style="font-size:12.5px; font-weight:600; color:var(--text-primary); margin-top:2px;">-</div>
                    </div>
                    <div>
                        <small style="color:var(--text-muted); font-size:11px; font-weight:700;" data-i18n="inventory.col_last_test">Última Verificación</small>
                        <div id="inv-edit-last-date" style="font-size:12.5px; font-weight:600; color:var(--text-primary); margin-top:2px;">-</div>
                    </div>
                    <div>
                        <small style="color:var(--text-muted); font-size:11px; font-weight:700;" data-i18n="inventory.col_next_test">Próxima Verificación</small>
                        <div id="inv-edit-next-date" style="font-size:12.5px; font-weight:700; color:var(--accent-blue); margin-top:2px;">-</div>
                    </div>
                </div>
                <div style="border-top:1px dashed #CBD5E1; padding-top:8px;">
                    <small style="color:var(--text-muted); font-size:11px; font-weight:700;" data-i18n="inventory.last_meas_title">Última Medición Registrada</small>
                    <div id="inv-edit-measurements" style="font-size:12.5px; margin-top:3px;">-</div>
                </div>
            </div>
        </div>

        <!-- FOOTER -->
        <div style="padding:14px 20px; border-top:1px solid var(--border-color); display:flex; justify-content:space-between; align-items:center; background:#F8FAFC; border-radius:0 0 14px 14px; gap:10px;">
            <div style="display:flex; gap:8px;">
                <button type="button" id="inv-btn-decommission" class="tab-btn" style="color:var(--accent-rose); border-color:#FECDD3; background:#FFF1F2; font-size:12px; font-weight:700;" onclick="decommissionCurrentAsset()" data-i18n="inventory.btn_decommission">🗑️ Dar de Baja Activo</button>
                <button type="button" id="inv-btn-reactivate" class="tab-btn" style="display:none; color:var(--accent-green); border-color:#A7F3D0; background:#ECFDF5; font-size:12px; font-weight:700;" onclick="reactivateCurrentAsset()" data-i18n="inventory.btn_reactivate">🔄 Reactivar Activo</button>
                <button type="button" class="tab-btn" style="font-size:12px; font-weight:600;" onclick="viewHistoryFromEditModal()" data-i18n="inventory.btn_view_history">📜 Ver Historial</button>
            </div>
            <div style="display:flex; gap:8px;">
                <button type="button" class="tab-btn" style="padding:7px 16px; font-size:12px;" onclick="closeAssetEditModal()" data-i18n="inventory.btn_cancel">✕ Cancelar</button>
                <button type="button" class="btn-primary" style="padding:7px 20px; font-size:12.5px; font-weight:700;" onclick="saveAssetChanges()" data-i18n="inventory.btn_save_changes">💾 Guardar Cambios</button>
            </div>
        </div>
    </div>
</div>
</body>
</html>
