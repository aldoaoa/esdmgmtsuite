    function setHeatmapMode(mode) {
        activeHeatmapMode = mode;
        document.getElementById('btn-hm-mode-mixed').classList.toggle('active', mode === 'mixed');
        document.getElementById('btn-hm-mode-heatmap').classList.toggle('active', mode === 'heatmap');
        document.getElementById('btn-hm-mode-plan').classList.toggle('active', mode === 'plan');

        const canvas = document.getElementById('viewer-heatmap-canvas');
        const img = document.getElementById('viewer-floorplan-img');

        if (canvas && img) {
            if (mode === 'mixed') {
                canvas.style.opacity = '0.6';
                canvas.style.display = 'block';
                img.style.opacity = '1';
            } else if (mode === 'heatmap') {
                canvas.style.opacity = '1';
                canvas.style.display = 'block';
                img.style.opacity = '0.15';
            } else if (mode === 'plan') {
                canvas.style.opacity = '0';
                canvas.style.display = 'none';
                img.style.opacity = '1';
            }
        }
    }

    function renderViewerPoints() {
        const overlay = document.getElementById('viewer-points-overlay');
        if (!overlay || !currentViewerMap || !currentViewerMap.points) return;

        overlay.innerHTML = '';
        let total = currentViewerMap.points.length;
        let measured = 0;
        let pass = 0;
        let fail = 0;

        currentViewerMap.points.forEach((pt, idx) => {
            const pin = document.createElement('div');
            pin.className = 'floor-pin';
            pin.style.left = `${pt.xPercent}%`;
            pin.style.top = `${pt.yPercent}%`;

            let resText = 'N/D';
            if (pt.lastResistanceOhms != null && !isNaN(pt.lastResistanceOhms)) {
                measured++;
                const ohms = parseFloat(pt.lastResistanceOhms);
                resText = formatResistanceScientific(ohms) + ' Ω';

                if (ohms <= 1.0e8) {
                    pin.classList.add('pin-pass');
                    pass++;
                } else if (ohms <= 1.0e9) {
                    pin.classList.add('pin-warning');
                    pass++;
                } else {
                    pin.classList.add('pin-fail');
                    fail++;
                }
            }

            pin.innerHTML = `${pt.code || (idx + 1)}<div class="pin-tooltip"><b>${pt.label || 'Punto ' + (idx + 1)}</b>: ${resText}</div>`;
            pin.addEventListener('click', () => openPointMeasurementModal(idx));
            overlay.appendChild(pin);
        });

        document.getElementById('v-total-pts').innerText = total;
        document.getElementById('v-measured-pts').innerText = measured;
        document.getElementById('v-pass-pts').innerText = pass;
        document.getElementById('v-fail-pts').innerText = fail;
    }

    function formatResistanceScientific(val) {
        if (val == null || val === '' || val === '-') return '-';
        const num = typeof val === 'number' ? val : parseFloat(val.toString().replace(/,/g, ''));
        if (isNaN(num)) return val.toString();
        if (num < 10) {
            return num.toFixed(2);
        }
        if (num < 1000) {
            return Math.round(num).toString();
        }
        let exp = Math.floor(Math.log10(num));
        let mantissa = num / Math.pow(10, exp);
        if (parseFloat(mantissa.toFixed(2)) >= 10.0) {
            mantissa /= 10.0;
            exp += 1;
        }
        return `${mantissa.toFixed(2)}x10^${exp}`;
    }

    function openPointMeasurementModal(pointIdx) {
        if (!currentViewerMap || !currentViewerMap.points || !currentViewerMap.points[pointIdx]) return;
        activePointEditIdx = pointIdx;

        const pt = currentViewerMap.points[pointIdx];
        document.getElementById('pt-modal-title').innerText = `📍 ${pt.label || 'Punto ' + pt.code} (Punto #${pt.code || (pointIdx + 1)})`;
        const resInput = document.getElementById('pt-modal-resistance');
        resInput.value = pt.lastResistanceOhms != null ? formatResistanceScientific(pt.lastResistanceOhms) : '';

        if (document.getElementById('pt-modal-equipment')) {
            document.getElementById('pt-modal-equipment').value = pt.equipmentId || '';
        }
        if (document.getElementById('pt-modal-photo-url')) {
            document.getElementById('pt-modal-photo-url').value = pt.evidenceUrl || '';
            const thumb = document.getElementById('pt-modal-photo-thumb');
            const img = document.getElementById('pt-modal-photo-img');
            if (pt.evidenceUrl && thumb && img) {
                img.src = pt.evidenceUrl;
                thumb.style.display = 'inline-flex';
            } else {
                clearGenericPhoto('pt-modal-photo-file', 'pt-modal-photo-thumb', 'pt-modal-photo-img', 'pt-modal-photo-url');
            }
        }

        updatePointModalBadge(resInput.value);
        document.getElementById('modal-point-measurement').style.display = 'flex';
        setTimeout(() => resInput.focus(), 50);
    }

    function closePointMeasurementModal() {
        document.getElementById('modal-point-measurement').style.display = 'none';
        activePointEditIdx = -1;
    }

    function updatePointModalBadge(valStr) {
        const badge = document.getElementById('pt-modal-badge');
        if (!badge) return;

        if (!valStr || valStr.trim() === '') {
            badge.className = 'badge-pending';
            badge.innerText = '--';
            return;
        }

        const ohms = parseFloat(valStr);
        if (isNaN(ohms) || ohms < 0) {
            badge.className = 'badge-pending';
            badge.innerText = t('maps.badge_invalid', 'VALOR INVÁLIDO');
            return;
        }

        if (ohms <= 1.0e8) {
            badge.className = 'badge-pass';
            badge.innerText = t('maps.badge_pass', '🟢 PASS (≤ 1.0e8 Ω / Conforme Óptimo)');
        } else if (ohms <= 1.0e9) {
            badge.className = 'badge-pending';
            badge.innerText = t('maps.badge_warn', '🟠 ADVERTENCIA (1.01e8 - 0.99e9 Ω)');
        } else {
            badge.className = 'badge-fail';
            badge.innerText = t('maps.badge_fail', '🔴 FAIL (> 1.0e9 Ω / Fuera de Límite)');
        }
    }

    function applyPointMeasurement() {
        if (activePointEditIdx < 0 || !currentViewerMap || !currentViewerMap.points[activePointEditIdx]) return;

        const valStr = document.getElementById('pt-modal-resistance').value.trim();
        const ohms = parseFloat(valStr);

        if (isNaN(ohms) || ohms < 0) {
            alert(t('inventory.invalid_val', 'Por favor ingresa un valor de resistencia numérico válido en Ohms (ej: 4.5e7 o 45000000).'));
            return;
        }

        const eqVal = document.getElementById('pt-modal-equipment')?.value || '';
        const photoUrl = document.getElementById('pt-modal-photo-url')?.value || '';

        currentViewerMap.points[activePointEditIdx].lastResistanceOhms = ohms;
        currentViewerMap.points[activePointEditIdx].equipmentId = eqVal;
        currentViewerMap.points[activePointEditIdx].evidenceUrl = photoUrl;
        currentViewerMap.points[activePointEditIdx].measuredAt = new Date().toISOString();

        closePointMeasurementModal();
        renderViewerPoints();
        renderFloor2DHeatmap();
    }

    // --- 2D CONTINUOUS INVERSE DISTANCE WEIGHTING (IDW) HEATMAP ENGINE ---
    function renderFloor2DHeatmap() {
        const canvas = document.getElementById('viewer-heatmap-canvas');
        const img = document.getElementById('viewer-floorplan-img');
        if (!canvas || !img || !currentViewerMap || !currentViewerMap.points || currentViewerMap.points.length === 0) return;

        const width = img.naturalWidth || img.clientWidth || 800;
        const height = img.naturalHeight || img.clientHeight || 520;
        canvas.width = width;
        canvas.height = height;

        const ctx = canvas.getContext('2d');
        if (!ctx) return;

        ctx.clearRect(0, 0, width, height);

        // Filter points with measurements
        const pts = currentViewerMap.points.filter(p => p.lastResistanceOhms != null && !isNaN(p.lastResistanceOhms));
        if (pts.length === 0) return;

        const step = 4; // 4px spatial resolution for smooth continuous rendering
        const cols = Math.ceil(width / step);
        const rows = Math.ceil(height / step);

        const imgData = ctx.createImageData(width, height);
        const data = imgData.data;

        // Convert points to pixel coordinates & log10(R)
        const pData = pts.map(p => {
            const px = (p.xPercent / 100) * width;
            const py = (p.yPercent / 100) * height;
            const res = Math.max(1, p.lastResistanceOhms);
            const logR = Math.log10(res);
            return { px, py, res, logR };
        });

        // Power parameter = 3.5 provides strong local zone dominance:
        // Cleanroom clusters with green points stay solidly green across their room
        const power = 3.5;

        for (let r = 0; r < rows; r++) {
            const y = r * step;
            for (let c = 0; c < cols; c++) {
                const x = c * step;

                let sumWeights = 0;
                let sumLogR = 0;
                let exactMatchLogR = null;

                for (let i = 0; i < pData.length; i++) {
                    const p = pData[i];
                    const dx = x - p.px;
                    const dy = y - p.py;
                    const dist = Math.sqrt(dx * dx + dy * dy);

                    if (dist < 1.0) {
                        exactMatchLogR = p.logR;
                        break;
                    }

                    const w = 1.0 / Math.pow(dist, power);
                    sumWeights += w;
                    sumLogR += w * p.logR;
                }

                let interpLogR;
                if (exactMatchLogR !== null) {
                    interpLogR = exactMatchLogR;
                } else if (sumWeights > 0) {
                    interpLogR = sumLogR / sumWeights;
                } else {
                    interpLogR = 7.0; // 1e7 default
                }

                // Physical ESD floor qualification logic (ANSI/ESD S20.20):
                // <= 1.0e8 Ohms (log <= 8.0) -> PURE SOLID GREEN (#10B981)
                // 1.01e8 - 0.99e9 Ohms (8.0 < log < 9.0) -> ORANGE (#F59E0B)
                // >= 1.0e9 Ohms (log >= 9.0) -> PURE SOLID RED (#EF4444)
                let red, green, blue;

                if (interpLogR <= 8.0) {
                    // Solid Pure Green for all compliant green zones
                    red = 16;
                    green = 185;
                    blue = 129;
                } else if (interpLogR < 8.2) {
                    // Smooth transition from Green (#10B981) to Orange (#F59E0B)
                    const t = (interpLogR - 8.0) / 0.2;
                    red = Math.round(16 + (245 - 16) * t);
                    green = Math.round(185 + (158 - 185) * t);
                    blue = Math.round(129 + (11 - 129) * t);
                } else if (interpLogR <= 8.95) {
                    // Solid Pure Orange for warning zone (1.01e8 - 0.99e9 Ohms)
                    red = 245;
                    green = 158;
                    blue = 11;
                } else if (interpLogR < 9.05) {
                    // Smooth transition from Orange (#F59E0B) to Red (#EF4444)
                    const t = (interpLogR - 8.95) / 0.10;
                    red = Math.round(245 + (239 - 245) * t);
                    green = Math.round(158 + (68 - 158) * t);
                    blue = Math.round(11 + (68 - 11) * t);
                } else {
                    // Solid Pure Red for out of spec (> 1.0e9 Ohms)
                    red = 239;
                    green = 68;
                    blue = 68;
                }

                const alpha = activeHeatmapMode === 'heatmap' ? 225 : 140;

                for (let dy = 0; dy < step && (y + dy) < height; dy++) {
                    for (let dx = 0; dx < step && (x + dx) < width; dx++) {
                        const idx = ((y + dy) * width + (x + dx)) * 4;
                        data[idx] = red;
                        data[idx + 1] = green;
                        data[idx + 2] = blue;
                        data[idx + 3] = alpha;
                    }
                }
            }
        }

        ctx.putImageData(imgData, 0, 0);
    }

    async function saveFloorMapBatchMeasurements() {
        if (!currentViewerMap) return;

        const measuredCount = currentViewerMap.points.filter(p => p.lastResistanceOhms != null).length;
        if (measuredCount === 0) {
            alert(t('maps.no_points_hint', 'Por favor captura al menos una medición en los puntos del plano antes de guardar.'));
            return;
        }

        const payload = {
            mapId: currentViewerMap.id,
            siteId: currentViewerMap.siteId || (sessionData && sessionData.site_id) || '',
            areaName: currentViewerMap.areaName || '',
            temperature: 23.5,
            humidity: 45.0,
            notes: `Verificación por plano ${currentViewerMap.mapName || currentViewerMap.areaName}`,
            points: currentViewerMap.points
        };

        try {
            const res = await fetch('/api/maps/measurements', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'X-User-Id': (sessionData && sessionData.user_id) || '',
                    'X-User-Role': (sessionData && sessionData.user_role) || ''
                },
                body: JSON.stringify(payload)
            });
            const data = await res.json();
            if (res.ok && data.success) {
                const failCount = currentViewerMap.points.filter(p => p.lastResistanceOhms != null && p.lastResistanceOhms > 1.0e9).length;
                const passCount = measuredCount - failCount;

                if (failCount > 0) {
                    const msg = t('maps.batch_alert_mixed', '⚠️ Lote de {0} mediciones guardado en el historial:\n\n• {1} puntos CONFORMES (PASS ≤ 1.0e9 Ω)\n• {2} puntos FUERA DE LÍMITE (FAIL > 1.0e9 Ω)\n\nTodos los registros se almacenaron correctamente para trazabilidad y se han marcado en rojo en el heatmap.')
                        .replace('{0}', measuredCount)
                        .replace('{1}', passCount)
                        .replace('{2}', failCount);
                    alert(msg);
                } else {
                    const msg = t('maps.batch_alert_pass', '✅ Lote de {0} mediciones de piso guardado exitosamente (100% PASS) y registrado en el historial.')
                        .replace('{0}', measuredCount);
                    alert(msg);
                }
                loadInfraData();
            } else {
                alert(data.message || '❌ Error al guardar las mediciones de piso.');
            }
        } catch(e) {
            console.error('Error saving floor measurements batch:', e);
            alert('❌ Error de conexión al guardar el lote de mediciones.');
        }
    }
</script>

