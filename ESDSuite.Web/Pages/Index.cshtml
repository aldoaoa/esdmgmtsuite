                });

                const savedActiveId = localStorage.getItem('activeFloorMapId');
                const targetId = (savedActiveId && allMapsList.some(m => m.id === savedActiveId))
                    ? savedActiveId
                    : (allMapsList.length > 0 ? allMapsList[0].id : null);

