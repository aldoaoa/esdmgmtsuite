        "Piso ESD": { limite: "RTG < 1.0x10^9 ohms / Walking Test < 100V", ref_num: 1.0e9, tipo_material: "", magnitud: "Resistencia", metodo: "ANSI/ESD TR53 / ANSI/ESD 97.2", frecuencia: "Semestralmente" },
        "Superficie de trabajo": { limite: "RTG < 1.0x10^9 ohms", ref_num: 1.0e9, tipo_material: "", magnitud: "Resistencia", metodo: "ANSI/ESD TR53", frecuencia: "Anualmente" },
        "Monitor Continuo": { limite: "RTG < 2 ohms", ref_num: 2.0, tipo_material: "", magnitud: "Resistencia", metodo: "Anexo A.1", frecuencia: "Trimestralmente" },
        "Ionizador": { limite: "Descarga: <10s, Bal: +-35V", ref_num: 10.0, tipo_material: "", magnitud: "Tiempo", metodo: "ANSI/ESD SP3.3-2016", frecuencia: "Trimestralmente" },
        "Bolsa disipativa": { limite: "RS < 1.0x10^9 ohms", ref_num: 1.0e9, tipo_material: "", magnitud: "Resistencia", metodo: "ANSI/ESD STM11.11", frecuencia: "Semestralmente" },
        "Cautín / Estación de soldar": { limite: "RTG < 10 ohms", ref_num: 10.0, tipo_material: "", magnitud: "Resistencia", metodo: "ANSI/ESD TR53", frecuencia: "Semestralmente" },
        "Caja Disipativa": { limite: "RS < 1.0x10^11 ohms", ref_num: 1.0e11, tipo_material: "", magnitud: "Resistencia", metodo: "ANSI/ESD STM11.11", frecuencia: "Anualmente" },
