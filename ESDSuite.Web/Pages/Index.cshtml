    async function loadEmailNotificationLogs() {
        const tbody = document.getElementById('email-logs-tbody');
        const countSpan = document.getElementById('email-logs-count');
        if (!tbody) return;

        try {
            const res = await fetch('/api/notifications/logs?limit=50');
            const data = await res.json();
            const logs = (data && data.logs) ? data.logs : [];

            if (countSpan) countSpan.innerText = `${logs.length} registros recientes`;

            if (logs.length === 0) {
                tbody.innerHTML = '<tr><td colspan="6" style="text-align:center; padding:24px; color:var(--text-muted);">No hay correos registrados aún.</td></tr>';
                return;
            }

            let html = '';
            logs.forEach(l => {
                const isSent = (l.status || '').toUpperCase() === 'SENT';
                const statusBadge = isSent
                    ? '<span class="badge-pass" style="font-size:10px; padding:2px 7px;">ENVIADO</span>'
                    : '<span style="background:#FEE2E2; color:#DC2626; font-size:10px; font-weight:800; padding:2px 7px; border-radius:6px;">FALLIDO</span>';

                let dateFormatted = l.created_at || '';
                try {
                    const d = new Date(l.created_at);
                    dateFormatted = d.toLocaleString('es-MX', { dateStyle:'short', timeStyle:'short' });
                } catch(e) {}

                const msgId = l.message_id || '-';
                const msgIdShort = msgId.length > 18 ? msgId.substring(0, 18) + '...' : msgId;

                html += `<tr>
                    <td style="font-size:12px; color:#475569;">${escapeHtml(dateFormatted)}</td>
                    <td style="font-size:12px; font-weight:600;">${escapeHtml(l.to_email || '')}</td>
                    <td style="font-size:11.5px;"><span style="background:#F1F5F9; color:#475569; padding:2px 6px; border-radius:4px; font-weight:700;">${escapeHtml(l.email_type || 'GENERIC')}</span></td>
                    <td style="font-size:12px; color:#334155;">${escapeHtml(l.subject || '')}</td>
                    <td style="text-align:center;">${statusBadge}</td>
                    <td style="font-family:var(--font-mono); font-size:11px; color:#64748B;" title="${escapeHtml(msgId)}">${escapeHtml(msgIdShort)}</td>
                </tr>`;
            });
            tbody.innerHTML = html;
        } catch(ex) {
            console.error('Error loading email logs:', ex);
            tbody.innerHTML = '<tr><td colspan="6" style="text-align:center; padding:20px; color:#DC2626;">Error al cargar bitácora de correos.</td></tr>';
        }
    }

