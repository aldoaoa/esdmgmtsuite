    let chartInstance = null;
    function renderDashboardChart(assets) {
        const ctx = document.getElementById('dashboardChart').getContext('2d');
        if (chartInstance) chartInstance.destroy();

        const categories = {};
        assets.forEach(a => {
            const cat = a.category || 'General';
            categories[cat] = (categories[cat] || 0) + 1;
        });

        chartInstance = new Chart(ctx, {
            type: 'bar',
            data: {
                labels: Object.keys(categories),
                datasets: [{
                    label: 'Cantidad de Activos Registrados',
                    data: Object.values(categories),
                    backgroundColor: '#2563EB',
                    borderRadius: 5
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: { legend: { labels: { color: '#0F172A', font: { family: 'Montserrat', weight: '700' } } } },
                scales: {
                    x: { ticks: { color: '#64748B', font: { family: 'Montserrat' } }, grid: { color: '#F1F5F9' } },
                    y: { ticks: { color: '#64748B', font: { family: 'Inter' } }, grid: { color: '#F1F5F9' } }
                }
            }
        });
    }

    function switchInfraTab(tabName) {
        document.querySelectorAll('#mod-infra .tab-btn').forEach(btn => btn.classList.remove('active'));
        document.querySelectorAll('#mod-infra .tab-content').forEach(c => c.classList.remove('active'));
        if (window.event && window.event.currentTarget && window.event.currentTarget.classList) {
            window.event.currentTarget.classList.add('active');
        } else {
            document.querySelectorAll('#mod-infra .tab-btn').forEach(b => {
                if (b.getAttribute('onclick')?.includes(`'${tabName}'`)) b.classList.add('active');
            });
        }
        const tabEl = document.getElementById('infra-tab-' + tabName);
        if (tabEl) tabEl.classList.add('active');
        if (tabName === 'floor') {
            loadFloorMapsForViewer();
        }
        if (tabName === 'iso') {
            loadIsolatedHistory();
        }
        if (tabName === 'checkers') {
            loadCheckersHistory();
        }
    }

    async function loadInfraLinesSelect() {
        const selects = ['gnd-loc', 'fl-room', 'iso-loc', 'chk-loc', 'rep-linea', 'inv-new-line', 'inv-edit-line'];
        try {
            const siteId = (sessionData && sessionData.site_id) || '';
            const res = await fetch(`/api/lines?siteId=${siteId}`);
            if (res.ok) {
                const lines = await res.json();
                const defaultText = t('eventmeter.opt_select_line', '-- Seleccionar Línea --');
                selects.forEach(id => {
                    const sel = document.getElementById(id);
                    if (!sel) return;
                    const prevVal = sel.value;
                    sel.innerHTML = `<option value="">${defaultText}</option>`;
                    lines.forEach(l => {
                        const name = l.nombre_linea || l.name;
                        sel.innerHTML += `<option value="${name}">${name}</option>`;
                    });
                    if (prevVal && lines.some(l => (l.nombre_linea || l.name) === prevVal)) {
                        sel.value = prevVal;
                    } else {
                        sel.value = '';
                    }
                });
            }
        } catch(e) {
            console.error('Error loading infra lines:', e);
        }
    }

    async function loadInfraData() {
        await loadInfraLinesSelect();
        const siteId = (sessionData && sessionData.site_id) || '';

        // 1. Load Grounding History
        try {
            const gRes = await fetch(`/api/infra/grounding?siteId=${siteId}`);
            const grounds = await gRes.json();
            const gContainer = document.getElementById('ground-history-table');
            if (gContainer) {
                if (!grounds || grounds.length === 0) {
                    gContainer.innerHTML = `<div class="glass-card" style="text-align:center; padding:16px; color:var(--text-muted); font-size:13px;" data-i18n="infra.no_records">No hay registros de tierras para esta planta.</div>`;
                } else {
                    let html = `<div class="table-responsive" style="max-height:400px; overflow-y:auto; border:1px solid var(--border-color); border-radius:8px;">
                        <table class="data-table" style="margin:0; width:100%;">
                            <thead style="position:sticky; top:0; background:#F8FAFC; z-index:2;">
                                <tr>
                                    <th style="min-width:120px;" data-i18n="eventmeter.col_date">Fecha</th>
                                    <th style="min-width:130px;" data-i18n="eventmeter.col_line">Línea / Ubicación</th>
                                    <th style="min-width:110px;">ID Punto</th>
                                    <th style="min-width:140px;">Tipo de Punto</th>
                                    <th style="min-width:120px; text-align:right;">Resistencia (Ω)</th>
                                    <th style="min-width:90px; text-align:center;" data-i18n="eventmeter.col_status">Estatus</th>
                                </tr>
                            </thead>
                            <tbody>`;
                    grounds.forEach(g => {
                        const dateStr = g.measured_at ? new Date(g.measured_at).toLocaleDateString() + ' ' + new Date(g.measured_at).toLocaleTimeString([], {hour:'2-digit', minute:'2-digit'}) : (g.created_at ? new Date(g.created_at).toLocaleDateString() : '-');
                        const ohms = g.resistance_ohms != null ? parseFloat(g.resistance_ohms) : null;
                        const ohmsFormatted = ohms !== null ? (ohms < 1 ? ohms.toFixed(3) : ohms.toFixed(2)) + ' Ω' : '-';
                        const statusBadge = (g.status_result === 'PASS' || (ohms !== null && ohms <= 2.0))
                            ? `<span class="badge-pass" style="font-size:11px; padding:3px 8px;">PASS</span>`
                            : `<span class="badge-fail" style="font-size:11px; padding:3px 8px;">FAIL</span>`;
                        html += `<tr>
                            <td style="font-size:12px;"><b>${dateStr}</b></td>
                            <td style="font-size:12px;">${g.location || g.area_line || '-'}</td>
                            <td style="font-size:12.5px; font-weight:700; color:var(--accent-blue);">${g.point_id || '-'}</td>
                            <td style="font-size:12px;">${g.point_type || 'Main Ground'}</td>
                            <td style="font-size:12.5px; font-weight:800; text-align:right; color:${ohms > 2.0 ? 'var(--accent-rose)' : 'var(--text-primary)'};">${ohmsFormatted}</td>
                            <td style="text-align:center;">${statusBadge}</td>
                        </tr>`;
                    });
                    html += `</tbody></table></div>`;
                    gContainer.innerHTML = html;
                }
            }
        } catch(e) {
            console.error('Error loading grounds:', e);
        }

        // 2. Load Flooring History
        try {
            const fRes = await fetch(`/api/infra/floors?siteId=${siteId}`);
            const floors = await fRes.json();
            const fContainer = document.getElementById('floor-history-table');
            if (fContainer) {
                if (!floors || floors.length === 0) {
                    fContainer.innerHTML = `<div class="glass-card" style="text-align:center; padding:16px; color:var(--text-muted); font-size:13px;" data-i18n="infra.no_records">No hay registros de pisos ESD para esta planta.</div>`;
                } else {
                    let html = `<div class="table-responsive" style="max-height:400px; overflow-y:auto; border:1px solid var(--border-color); border-radius:8px;">
                        <table class="data-table" style="margin:0; width:100%;">
                            <thead style="position:sticky; top:0; background:#F8FAFC; z-index:2;">
                                <tr>
                                    <th style="min-width:120px;" data-i18n="eventmeter.col_date">Fecha</th>
                                    <th style="min-width:130px;">Área / Cuarto</th>
                                    <th style="min-width:90px; text-align:center;">Punto</th>
                                    <th style="min-width:140px;">Resistencia PTP (Ω)</th>
                                    <th style="min-width:120px;">Temp / Hum</th>
                                    <th style="min-width:90px; text-align:center;" data-i18n="eventmeter.col_status">Estatus</th>
                                </tr>
                            </thead>
                            <tbody>`;
                    floors.forEach(f => {
                        const dateStr = f.measured_at ? new Date(f.measured_at).toLocaleDateString() + ' ' + new Date(f.measured_at).toLocaleTimeString([], {hour:'2-digit', minute:'2-digit'}) : (f.created_at ? new Date(f.created_at).toLocaleDateString() : '-');
                        const statusBadge = (f.status_result === 'PASS')
                            ? `<span class="badge-pass" style="font-size:11px; padding:3px 8px;">PASS</span>`
                            : `<span class="badge-fail" style="font-size:11px; padding:3px 8px;">FAIL</span>`;
                        const resFormatted = formatResistanceScientific(f.ptp_resistance || f.resistance_ohms);
                        html += `<tr>
                            <td style="font-size:12px;"><b>${dateStr}</b></td>
                            <td style="font-size:12px;">${f.room_name || f.location || '-'}</td>
                            <td style="text-align:center; font-weight:700;">${f.point_number || 1}</td>
                            <td style="font-size:12.5px; font-weight:800;">${resFormatted} Ω</td>
                            <td style="font-size:11.5px; color:var(--text-muted);">${f.temp_hum || '-'}</td>
                            <td style="text-align:center;">${statusBadge}</td>
                        </tr>`;
                    });
                    html += `</tbody></table></div>`;
                    fContainer.innerHTML = html;
                }
            }
        } catch(e) {
            console.error('Error loading floors:', e);
        }

        // 3. Load Floor Maps for Viewer
        await loadFloorMapsForViewer();

        // 4. Load Isolated Conductors History
        await loadIsolatedHistory();

        // 5. Load Entrance Checkers History
        await loadCheckersHistory();
    }

    document.getElementById('form-infra-ground').onsubmit = async function(e) {
        e.preventDefault();
        const loc = document.getElementById('gnd-loc').value;
        if (!loc) {
            alert(t('eventmeter.opt_select_line', 'Por favor selecciona una línea / ubicación.'));
            return;
        }
        const pointType = document.getElementById('gnd-type').value;
        const pointId = document.getElementById('gnd-id').value.trim();
        const ohmsRaw = document.getElementById('gnd-ohms').value.trim();
        const ohms = parseFloat(ohmsRaw) || 0;

        const limit = pointType.includes('Auxiliary') ? 25.0 : (pointType.includes('Main') ? 1.0 : 2.0);
        const isPass = ohms <= limit;
        const equipment_id = document.getElementById('gnd-equipment-select')?.value || '';
        const evidence_url = document.getElementById('gnd-photo-url')?.value || '';

        try {
            const res = await fetch('/api/infra/grounding', {
                method: 'POST',
                headers: { 
                    'Content-Type': 'application/json',
                    'X-User-Id': (sessionData && sessionData.user_id) || '',
                    'X-User-Role': (sessionData && sessionData.user_role) || ''
                },
                body: JSON.stringify({
                    point_type: pointType,
                    location: loc,
                    point_id: pointId,
                    resistance_ohms: ohms,
                    equipment_id: equipment_id,
                    evidence_url: evidence_url,
                    site_id: (sessionData && sessionData.site_id) || ''
                })
            });
            const data = await res.json();
            if (res.ok && data.success) {
                if (isPass) {
                    alert(`✅ Verificación de Tierra registrada exitosamente. (Estatus: PASS - ${ohms} Ω ≤ ${limit} Ω)`);
                } else {
                    alert(`⚠️ ¡ALERTA DE TIERRA FUERA DE LÍMITE!\n\nLa resistencia registrada (${ohms} Ω) EXCEDE el límite permitido de ${limit} Ω (Estatus: FAIL).\n\nSe requiere revisión y mantenimiento del punto de tierra.`);
                }
                document.getElementById('gnd-loc').value = '';
                document.getElementById('gnd-id').value = '';
                document.getElementById('gnd-ohms').value = '';
                clearGenericPhoto('gnd-photo-file', 'gnd-photo-thumb', 'gnd-photo-img', 'gnd-photo-url');
                loadInfraData();
            } else {
                alert('❌ Error al guardar verificación de tierra.');
            }
        } catch(ex) {
            alert('❌ Error de conexión con el servidor.');
        }
    };

