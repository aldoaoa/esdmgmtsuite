    // --- PROTECTED DELETE MODAL (REQUIRES TYPING "DELETE"), LOCATION RENAME & ARCHIVE REASSIGNMENT ---
    let pendingDeleteCallback = null;
    let editLocContext = { entityType: '', targetId: '', oldName: '', parentArea: '' };
    let activeReassignGroupId = '';

    function openDeleteConfirmModal(title, messageHtml, onConfirmAsync) {
        const modal = document.getElementById('modal-confirm-delete');
        const titleEl = document.getElementById('confirm-delete-title');
        const msgEl = document.getElementById('confirm-delete-desc');
        const inputEl = document.getElementById('confirm-delete-input');
        const btnEl = document.getElementById('btn-confirm-delete-exec');

        if (!modal || !inputEl || !btnEl) return;

        if (titleEl) titleEl.innerHTML = title || '⚠️ Confirmar Eliminación Protegida';
        if (msgEl) msgEl.innerHTML = messageHtml || '';
        inputEl.value = '';
        btnEl.disabled = true;
        btnEl.style.opacity = '0.5';
        btnEl.style.cursor = 'not-allowed';
        btnEl.innerText = '🗑️ Confirmar Eliminación';

        inputEl.onkeydown = function(ev) {
            if (ev.key === 'Enter' && inputEl.value.trim() === 'DELETE') {
                ev.preventDefault();
                executeConfirmedDelete();
            }
        };

        pendingDeleteCallback = onConfirmAsync;
        modal.style.display = 'flex';
        setTimeout(() => inputEl.focus(), 50);
    }

    function onConfirmDeleteInputChange(val) {
        const btnEl = document.getElementById('btn-confirm-delete-exec');
        if (!btnEl) return;
        const isMatch = (val || '').trim() === 'DELETE';
        btnEl.disabled = !isMatch;
        btnEl.style.opacity = isMatch ? '1' : '0.5';
        btnEl.style.cursor = isMatch ? 'pointer' : 'not-allowed';
    }

    function closeDeleteConfirmModal() {
        const modal = document.getElementById('modal-confirm-delete');
        if (modal) modal.style.display = 'none';
        pendingDeleteCallback = null;
    }

    async function executeConfirmedDelete() {
        const inputEl = document.getElementById('confirm-delete-input');
        const btnEl = document.getElementById('btn-confirm-delete-exec');
        if (!inputEl || inputEl.value.trim() !== 'DELETE' || !pendingDeleteCallback) return;

        const fn = pendingDeleteCallback;
        if (btnEl) {
            btnEl.disabled = true;
            btnEl.innerText = '⏳ Procesando...';
        }
        try {
            await fn();
        } finally {
            closeDeleteConfirmModal();
        }
    }

