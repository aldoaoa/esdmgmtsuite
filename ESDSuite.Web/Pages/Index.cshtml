            <!-- MODULE 6: ESD CONTROL ELEMENT VALIDATION -->
            <div id="mod-validation" class="module-view" style="display:none;">
                <div class="glass-panel">
                    <div style="display:flex; justify-content:space-between; align-items:flex-start; margin-bottom:16px; flex-wrap:wrap; gap:12px;">
                        <div>
                            <h3 style="display:flex; align-items:center; gap:8px; margin:0;">
                                <img src="/images/icons/icon-lab.svg" class="ui-icon-3d" alt="" />
                                <span data-i18n="validation.heading">Validación de Elementos de Control ESD</span>
                            </h3>
                            <div style="font-size:12px; color:var(--text-muted); margin-top:4px;" data-i18n="validation.subtitle">
                                Registro de trazabilidad. Selecciona el equipo de medición y el elemento para autocompletar la información.
                            </div>
                        </div>

                        <!-- Sub-tabs switcher -->
                        <div style="display:flex; gap:6px; background:#F1F5F9; padding:4px; border-radius:8px; border:1px solid var(--border-color);">
                            <button type="button" id="val-tab-btn-form" class="tab-btn active" onclick="switchValidationSubTab('form')" style="padding:6px 14px; font-size:12.5px; font-weight:700;">
                                📝 <span data-i18n="validation.tab_form">Registrar Validación</span>
                            </button>
                            <button type="button" id="val-tab-btn-history" class="tab-btn" onclick="switchValidationSubTab('history')" style="padding:6px 14px; font-size:12.5px; font-weight:700;">
                                🖼️ <span data-i18n="validation.tab_history">Visor de Registros</span>
                            </button>
                            <button type="button" id="val-tab-btn-garments" class="tab-btn" onclick="switchValidationSubTab('garments')" style="padding:6px 14px; font-size:12.5px; font-weight:700;">
                                🥼 <span data-i18n="validation.tab_garments">Garments</span>
                            </button>
                        </div>
                    </div>

                    <!-- SUBTAB 1: FORMULARIO DE REGISTRO -->
                    <div id="val-subview-form" style="display:block;">
                        <div id="val-success-alert" style="display:none; margin-bottom:16px; padding:12px 16px; border-radius:8px; background:#ECFDF5; border:1px solid #10B981; color:#065F46; font-weight:600; font-size:13px;"></div>

                        <form id="form-esd-validation" onsubmit="event.preventDefault(); submitEsdValidation();">
                            <!-- 1. Parámetros -->
                            <div class="glass-card" style="margin-bottom:16px; padding:18px;">
                                <h4 style="margin:0 0 14px 0; color:var(--accent-blue); font-size:13.5px; font-weight:800; display:flex; align-items:center; gap:6px;" data-i18n="validation.sec1_title">
                                    1. Parámetros
                                </h4>
                                <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(240px, 1fr)); gap:14px;">
                                    <div class="form-group">
                                        <label data-i18n="validation.lbl_element_sel">Elemento a validar:</label>
                                        <select id="val-elemento-sel" class="form-control" onchange="onValElementoChange(this.value)">
                                            <!-- Dynamically populated from INFO_ELEMENTOS_ESD with translations -->
                                        </select>
                                    </div>
                                    <div class="form-group">
                                        <label data-i18n="validation.lbl_equipment_sel">ID del Equipo de Medición:</label>
                                        <select id="val-equipo-sel" class="form-control" onchange="onValEquipoChange(this.value)">
                                            <option value="">Cargando equipos...</option>
                                        </select>
                                    </div>
                                    <div class="form-group">
                                        <label data-i18n="validation.lbl_magnitude_sel">Magnitud Medida:</label>
                                        <select id="val-magnitud-sel" class="form-control" onchange="onValMagnitudChange(this.value)">
                                            <option value="Resistencia" data-i18n="validation.opt_magnitude_res">Resistencia</option>
                                            <option value="Voltaje" data-i18n="validation.opt_magnitude_volt">Voltaje</option>
                                            <option value="Tiempo" data-i18n="validation.opt_magnitude_time">Tiempo</option>
                                            <option value="Otro" data-i18n="validation.opt_magnitude_other">Otro</option>
                                        </select>
                                    </div>
                                </div>

                                <!-- Selected equipment metadata preview card -->
                                <div id="val-equipo-card" style="margin-top:12px; padding:10px 14px; background:#F8FAFC; border:1px solid #E2E8F0; border-radius:6px; font-size:12px; display:grid; grid-template-columns:repeat(auto-fit, minmax(200px, 1fr)); gap:8px;">
                                    <div><strong style="color:var(--text-muted);" data-i18n="validation.eq_type">Tipo de Equipo:</strong> <span id="val-prev-eq-tipo" style="font-weight:600;">N/D</span></div>
                                    <div><strong style="color:var(--text-muted);" data-i18n="validation.eq_report">Reporte / Cert.:</strong> <span id="val-prev-eq-rep" style="font-weight:600;">N/D</span></div>
                                    <div><strong style="color:var(--text-muted);" data-i18n="validation.eq_maker">Fabricante / Modelo:</strong> <span id="val-prev-eq-fab" style="font-weight:600;">N/D</span></div>
                                    <div><strong style="color:var(--text-muted);" data-i18n="validation.eq_sn">No. Serie:</strong> <span id="val-prev-eq-sn" style="font-weight:600; font-family:monospace;">N/D</span></div>
                                    <div><strong style="color:var(--text-muted);" data-i18n="validation.eq_next_cal">Próx. Calibración:</strong> <span id="val-prev-eq-prox" style="font-weight:700; color:var(--accent-blue);">N/D</span></div>
                                </div>
                            </div>

                            <!-- 2. Datos del Elemento -->
                            <div class="glass-card" style="margin-bottom:16px; padding:18px;">
                                <h4 style="margin:0 0 14px 0; color:var(--accent-blue); font-size:13.5px; font-weight:800; display:flex; align-items:center; gap:6px;" data-i18n="validation.sec2_title">
                                    2. Datos del Elemento
                                </h4>
                                <div style="display:grid; grid-template-columns:1fr 2fr; gap:14px; margin-bottom:12px;">
                                    <div class="form-group">
                                        <label data-i18n="validation.lbl_elem_id">ID del Elemento*</label>
                                        <input type="text" id="val-id-elemento" class="form-control" style="font-family:monospace; font-weight:700; text-transform:uppercase;" placeholder="" required />
                                    </div>
                                    <div class="form-group">
                                        <label data-i18n="validation.lbl_material_type">Tipo de Material*</label>
                                        <input type="text" id="val-tipo-material" class="form-control" placeholder="" value="" required />
                                    </div>
                                </div>
                                <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(200px, 1fr)); gap:14px;">
                                    <div class="form-group">
                                        <label data-i18n="validation.lbl_elem_maker">Fabricante del Elemento</label>
                                        <input type="text" id="val-fab-elem" class="form-control" placeholder="" />
                                    </div>
                                    <div class="form-group">
                                        <label data-i18n="validation.lbl_elem_model">Modelo del Elemento</label>
                                        <input type="text" id="val-mod-elem" class="form-control" placeholder="" />
                                    </div>
                                    <div class="form-group">
                                        <label data-i18n="validation.lbl_elem_sn">Número de Serie</label>
                                        <input type="text" id="val-sn-elem" class="form-control" placeholder="" />
                                    </div>
                                </div>
                            </div>

                            <!-- 3. Condiciones Ambientales y Ubicación -->
                            <div class="glass-card" style="margin-bottom:16px; padding:18px;">
                                <h4 style="margin:0 0 14px 0; color:var(--accent-blue); font-size:13.5px; font-weight:800; display:flex; align-items:center; gap:6px;" data-i18n="validation.sec3_title">
                                    3. Condiciones Ambientales y Ubicación
                                </h4>
                                <div style="display:grid; grid-template-columns:2fr 1fr 1fr; gap:14px;">
                                    <div class="form-group">
                                        <label data-i18n="validation.lbl_location">Ubicación de Medición (Línea / Área)*</label>
                                        <input type="text" id="val-ubicacion-input" list="val-lines-datalist" class="form-control" placeholder="" required />
                                        <datalist id="val-lines-datalist"></datalist>
                                    </div>
                                    <div class="form-group">
                                        <label id="val-lbl-temp"><span data-i18n="validation.lbl_temp">Temperatura</span> (<span id="val-temp-unit-display">°C</span>)</label>
                                        <input type="number" step="any" id="val-temp" class="form-control" placeholder="23.5" value="" />
                                    </div>
                                    <div class="form-group">
                                        <label><span data-i18n="validation.lbl_humidity">Humedad Relativa</span> (%)</label>
                                        <input type="number" step="any" id="val-humedad" class="form-control" placeholder="45" value="" />
                                    </div>
                                </div>
                            </div>

                            <!-- 4. Parámetros y Medición -->
                            <div class="glass-card" style="margin-bottom:16px; padding:18px;">
                                <h4 style="margin:0 0 14px 0; color:var(--accent-blue); font-size:13.5px; font-weight:800; display:flex; align-items:center; gap:6px;" data-i18n="validation.sec4_title">
                                    4. Parámetros y Medición
                                </h4>
                                <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(200px, 1fr)); gap:14px; margin-bottom:14px;">
                                    <div class="form-group">
                                        <label data-i18n="validation.lbl_method">Método</label>
                                        <input type="text" id="val-metodo" class="form-control" />
                                    </div>
                                    <div class="form-group">
                                        <label data-i18n="validation.lbl_mode">Modo de Medición</label>
                                        <input type="text" id="val-modo" class="form-control" placeholder="" />
                                    </div>
                                    <div class="form-group">
                                        <label data-i18n="validation.lbl_unit">Unidad</label>
                                        <select id="val-unidad-sel" class="form-control" onchange="onValUnitChange(this.value)">
                                            <option value="ohms" data-i18n="validation.unit_ohms">ohms</option>
                                            <option value="volts" data-i18n="validation.unit_volts">volts</option>
                                            <option value="s" data-i18n="validation.unit_seconds">s</option>
                                            <option value="other" data-i18n="validation.unit_other">Otro</option>
                                        </select>
                                        <div id="val-unidad-other-wrap" style="display:none; margin-top:6px;">
                                            <input type="text" id="val-unidad-other" class="form-control" data-i18n-placeholder="validation.ph_other_unit" placeholder="" />
                                        </div>
                                    </div>
                                    <div class="form-group">
                                        <label data-i18n="validation.lbl_reference">Límite Permitido (Referencia)</label>
                                        <input type="number" step="any" id="val-referencia" class="form-control" />
                                    </div>
                                </div>

                                <h5 style="margin:14px 0 10px 0; font-size:12.5px; font-weight:700; color:var(--text-secondary);" data-i18n="validation.sec4_results">
                                    Resultados y Mediciones
                                </h5>

                                <!-- Dynamic Unlimited Readings Container -->
                                <div id="val-readings-container" style="display:flex; flex-direction:column; gap:10px; margin-bottom:12px;">
                                    <!-- Populated via addValReadingRow() / initValReadings() -->
                                </div>

                                <button type="button" class="tab-btn" onclick="addValReadingRow()" style="font-size:12px; font-weight:700; display:inline-flex; align-items:center; gap:6px; margin-bottom:14px; background:#F1F5F9;">
                                    ➕ <span data-i18n="validation.btn_add_reading">Agregar medición adicional</span>
                                </button>

                                <div class="form-group" style="margin-top:8px;">
                                    <label data-i18n="validation.lbl_notes">Notas / Observaciones</label>
                                    <textarea id="val-notas" class="form-control" rows="2" placeholder=""></textarea>
                                </div>
                            </div>

                            <!-- 5. Evidencia -->
                            <div class="glass-card" style="margin-bottom:20px; padding:18px;">
                                <h4 style="margin:0 0 14px 0; color:var(--accent-blue); font-size:13.5px; font-weight:800; display:flex; align-items:center; gap:6px;" data-i18n="validation.sec5_title">
                                    5. Evidencia
                                </h4>
                                <div style="display:grid; grid-template-columns:1fr 1fr; gap:16px; align-items:center;">
                                    <div>
                                        <label style="display:block; margin-bottom:8px; font-weight:600; font-size:12.5px;" data-i18n="validation.lbl_photo">Foto o Evidencia Digital</label>
                                        <div style="display:flex; gap:10px; align-items:center;">
                                            <button type="button" class="tab-btn" onclick="openValWebcamModal()" style="font-size:20px; padding:6px 16px; min-width:54px; height:42px; display:inline-flex; align-items:center; justify-content:center; cursor:pointer;" data-i18n-title="validation.btn_camera_tooltip" title="📷">
                                                📷
                                            </button>
                                            <button type="button" class="tab-btn" onclick="document.getElementById('val-img-input').click()" style="font-size:20px; padding:6px 16px; min-width:54px; height:42px; display:inline-flex; align-items:center; justify-content:center; cursor:pointer;" data-i18n-title="validation.btn_upload_tooltip" title="📁">
                                                📁
                                            </button>
                                            <input type="file" id="val-img-input" accept="image/*" style="display:none;" onchange="onValEvidenceSelected(this)" />
