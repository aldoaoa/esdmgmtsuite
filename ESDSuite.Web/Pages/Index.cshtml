    async function exportElementValidationReport(target) {
        let record = null;
        if (typeof target === 'number') {
            record = allValidationRecords[target];
        } else if (typeof target === 'object' && target !== null) {
            record = target;
        } else if (typeof target === 'string') {
            record = allValidationRecords.find(x => x.id === target || x.id_elemento === target);
        }

        if (!record) {
            alert('⚠️ No se encontró el registro de validación.');
            return;
        }

        const btn = event && event.currentTarget;
        let originalContent = '';
        if (btn) {
            originalContent = btn.innerHTML;
            btn.disabled = true;
            btn.innerHTML = `⏳ Exportando...`;
        }

        try {
            const siteId = (sessionData && sessionData.site_id) || '';
            const companyId = (sessionData && sessionData.company_id) || '';
            const payload = {
                ...record,
                site_id: siteId,
                company_id: companyId
            };

            const res = await fetch('/api/validation/reports/generate', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            });

            const data = await res.json();
            if (res.ok && data.success && data.download_url) {
                window.open(data.download_url, '_blank');
                if (typeof loadReportsRepository === 'function') {
                    loadReportsRepository();
                }
            } else {
                alert('❌ ' + (data.message || 'Error al generar el reporte de validación.'));
            }
        } catch(err) {
            console.error('Error exporting element validation report:', err);
            alert('❌ Error de comunicación al exportar el reporte: ' + err.message);
        } finally {
            if (btn) {
                btn.disabled = false;
                btn.innerHTML = originalContent;
            }
        }
    }

    function toggleValCard(bodyId) {
        const body = document.getElementById(bodyId);
        const icon = document.getElementById('icon-' + bodyId);
        if (!body) return;
        if (body.style.display === 'none') {
            body.style.display = 'block';
            if (icon) icon.innerText = '▼';
        } else {
            body.style.display = 'none';
            if (icon) icon.innerText = '▶';
        }
    }

    async function loadRoutes() {
        const res = await fetch('/api/routes/products');
        const products = await res.json();
        const container = document.getElementById('routes-container');
        container.innerHTML = '';
        if (products.length === 0) {
            container.innerHTML = '<p>No hay productos registrados en este Site.</p>';
            return;
        }
        products.forEach(p => {
            let stepsHtml = '';
            const lineas = p.lineas_asociadas || [];
            lineas.forEach((l, idx) => {
                stepsHtml += `<div class="step-node"><div class="step-num">PASO ${idx + 1}</div><div class="step-title">${l}</div></div>`;
                if (idx < lineas.length - 1) stepsHtml += '<div class="step-arrow">➡️</div>';
            });
            container.innerHTML += `<div class="glass-card" style="margin-bottom:16px;">
                <h4 style="color:var(--accent-blue);">📦 ${p.nombre_producto}</h4>
                <div class="sequence-flow">${stepsHtml}</div>
            </div>`;
        });
    }

