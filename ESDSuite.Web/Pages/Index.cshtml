    function getStoredLang() {
        const match = document.cookie.match(/(?:^|; )esd360_lang=([^;]*)/);
        if (match && match[1]) return match[1];
        return localStorage.getItem('esd360_lang') || 'es';
    }

    function setStoredLang(lang) {
        localStorage.setItem('esd360_lang', lang);
        document.cookie = `esd360_lang=${lang}; path=/; max-age=${365 * 24 * 60 * 60}; SameSite=Lax`;
