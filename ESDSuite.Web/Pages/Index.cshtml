    async function saveFindingActionPlan() {
        if (!currentFinding) return;
        const id = currentFinding.id;
        const assignee = document.getElementById('fnd-det-assignee').value.trim();
        const containment = document.getElementById('fnd-det-containment').value.trim();

        const body = {
            assignee_name: assignee,
            assigned_to: assignee,
            due_date: document.getElementById('fnd-det-due-date').value,
            containment_action: containment,
            immediate_containment: containment,
            root_cause: document.getElementById('fnd-det-root-cause').value.trim(),
            corrective_action: document.getElementById('fnd-det-corrective').value.trim(),
            lessons_learned: document.getElementById('fnd-det-lessons').value.trim(),
            updated_by: sessionData ? sessionData.user_name : 'Usuario'
        };

        try {
            const res = await fetch('/api/findings/' + encodeURIComponent(id), {
                method: 'PUT',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(body)
            });
            const data = await res.json();
            if (data.success) {
                alert('✅ Plan de acción CAPA guardado correctamente.');
                await openFindingModal(id);
                loadFindingsModule();
                if (typeof loadLessonsLearned === 'function') loadLessonsLearned();
                if (typeof loadFindingsDashboard === 'function') loadFindingsDashboard();
            } else {
                alert('❌ ' + (data.message || 'Error al guardar el plan de acción.'));
            }
        } catch(e) {
            console.error('Error saving action plan:', e);
            alert('❌ Error de conexión al guardar el plan de acción.');
        }
    }

    async function changeFindingStatus(newStatus) {
        if (!currentFinding) return;
        const id = currentFinding.id;

        // Obtain latest values from input elements
        const rootCauseVal = document.getElementById('fnd-det-root-cause')?.value?.trim() || '';
        const correctiveVal = document.getElementById('fnd-det-corrective')?.value?.trim() || '';
        const lessonsVal = document.getElementById('fnd-det-lessons')?.value?.trim() || '';
        const containmentVal = document.getElementById('fnd-det-containment')?.value?.trim() || '';
        const assigneeVal = document.getElementById('fnd-det-assignee')?.value?.trim() || '';
        const dueDateVal = document.getElementById('fnd-det-due-date')?.value || '';

        if (newStatus === 'CLOSED') {
            const effectiveCorrective = correctiveVal || currentFinding.corrective_action;
            if (!effectiveCorrective) {
                alert('⚠️ Para cerrar un hallazgo debe documentar la Acción Correctiva Definitiva implementada.');
                document.getElementById('fnd-det-corrective')?.focus();
                return;
            }
            if (!currentFinding.evidence_close_url) {
                if (!confirm('⚠️ No se ha subido fotografía de evidencia de cierre. ¿Desea proceder con el cierre de todos modos?')) {
                    return;
                }
            }
        }

        const comment = prompt(`Ingrese un comentario o justificación para el cambio a ${newStatus}:`, `Actualización de estado a ${newStatus}`);
        if (comment === null) return;

        try {
            const payload = {
                status: newStatus,
                new_status: newStatus,
                newStatus: newStatus,
                comment: comment,
                notes: comment,
                user: sessionData ? sessionData.user_name : 'Auditor',
                root_cause: rootCauseVal,
                corrective_action: correctiveVal,
                lessons_learned: lessonsVal,
                containment_action: containmentVal,
                assignee_name: assigneeVal,
                due_date: dueDateVal,
                evidence_close_url: currentFinding.evidence_close_url || ''
            };

            const res = await fetch(`/api/findings/${encodeURIComponent(id)}/status`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            });
            const data = await res.json();
            if (data.success) {
                alert('✅ Estado del hallazgo actualizado.');
                await openFindingModal(id);
                loadFindingsModule();
                if (typeof loadLessonsLearned === 'function') loadLessonsLearned();
                if (typeof loadFindingsDashboard === 'function') loadFindingsDashboard();
            } else {
                alert('❌ ' + (data.message || 'Error al actualizar el estado.'));
            }
        } catch(e) {
            console.error('Error changing finding status:', e);
            alert('❌ Error de conexión al actualizar el estado.');
        }
    }

    async function handleEvidenceUpload(type, fileInput) {
        if (!currentFinding || !fileInput.files || fileInput.files.length === 0) return;
        const file = fileInput.files[0];
        const fId = currentFinding.id;

        // Capture current form inputs so they are NOT lost when uploading
        const draftAssignee = document.getElementById('fnd-det-assignee')?.value || '';
        const draftDueDate = document.getElementById('fnd-det-due-date')?.value || '';
        const draftContainment = document.getElementById('fnd-det-containment')?.value || '';
        const draftRootCause = document.getElementById('fnd-det-root-cause')?.value || '';
        const draftCorrective = document.getElementById('fnd-det-corrective')?.value || '';
        const draftLessons = document.getElementById('fnd-det-lessons')?.value || '';

        const formData = new FormData();
        formData.append('file', file);
        formData.append('photo', file);
        formData.append('finding_id', fId);
        formData.append('findingId', fId);
        formData.append('type', type);
        formData.append('evidence_type', type);
        formData.append('root_cause', draftRootCause);
        formData.append('corrective_action', draftCorrective);
        formData.append('lessons_learned', draftLessons);
        formData.append('containment_action', draftContainment);
        formData.append('assignee_name', draftAssignee);
        formData.append('due_date', draftDueDate);

        try {
            const res = await fetch('/api/findings/upload-evidence', {
                method: 'POST',
                body: formData
            });
            const resText = await res.text();
            let data;
            try {
                data = JSON.parse(resText);
            } catch(pe) {
                console.error('Non-JSON response from upload-evidence:', resText);
                alert(`❌ Error del servidor al subir evidencia (${res.status})`);
                return;
            }
            if (data && data.success) {
                alert('✅ Evidencia fotográfica guardada exitosamente.');
                if (data.finding) {
                    currentFinding = data.finding;
                } else if (type === 'close') {
                    currentFinding.evidence_close_url = data.url || data.evidence_url;
                } else {
                    currentFinding.evidence_open_url = data.url || data.evidence_url;
                }
                await openFindingModal(fId);

                // Preserve draft values if modal reload didn't populate them
                if (draftRootCause && !document.getElementById('fnd-det-root-cause').value) {
                    document.getElementById('fnd-det-root-cause').value = draftRootCause;
                }
                if (draftCorrective && !document.getElementById('fnd-det-corrective').value) {
                    document.getElementById('fnd-det-corrective').value = draftCorrective;
                }
                if (draftLessons && !document.getElementById('fnd-det-lessons').value) {
                    document.getElementById('fnd-det-lessons').value = draftLessons;
                }
                loadFindingsModule();
            } else {
                alert('❌ ' + (data && data.message ? data.message : 'Error al subir la evidencia.'));
            }
        } catch(e) {
            console.error('Error uploading evidence:', e);
            alert('❌ Error al subir la imagen: ' + (e.message || e));
        } finally {
            fileInput.value = '';
        }
    }

