    function parsearResistencia(val) {
        if (val === null || val === undefined) return null;
        if (typeof val === 'number') return isNaN(val) ? 'ERROR' : val;
        let s = String(val).trim().toLowerCase();
        if (!s) return null;

        s = s.replace(/x10\^/g, 'e').replace(/\*10\^/g, 'e').replace(/x10/g, 'e').replace(/×10\^/g, 'e');
        
        let multiplier = 1;
        if (s.endsWith('g') || s.endsWith('gohm') || s.endsWith('gΩ') || s.endsWith('g ohms')) {
            multiplier = 1e9;
            s = s.replace(/[^0-9.e+-]/g, '');
        } else if (s.endsWith('m') || s.endsWith('mohm') || s.endsWith('mΩ') || s.endsWith('m ohms')) {
            multiplier = 1e6;
            s = s.replace(/[^0-9.e+-]/g, '');
        } else if (s.endsWith('k') || s.endsWith('kohm') || s.endsWith('kΩ') || s.endsWith('k ohms')) {
            multiplier = 1e3;
            s = s.replace(/[^0-9.e+-]/g, '');
        } else {
            s = s.replace(/[^0-9.e+-]/g, '');
        }

        const num = parseFloat(s);
        if (isNaN(num)) return 'ERROR';
        return num * multiplier;
    }

    async function submitEsdValidation() {
        const id_elemento = document.getElementById('val-id-elemento').value.trim().toUpperCase();
        const elemento_s20_20 = document.getElementById('val-elemento-sel').value;
        const id_equipo_sel = document.getElementById('val-equipo-sel').value;
        const magnitud_med = document.getElementById('val-magnitud-sel').value;
        const tipo_material = document.getElementById('val-tipo-material').value.trim();
        const fab_elem = document.getElementById('val-fab-elem').value.trim();
        const mod_elem = document.getElementById('val-mod-elem').value.trim();
        const sn_elem = document.getElementById('val-sn-elem').value.trim();
        const ubicacion = document.getElementById('val-ubicacion-input').value.trim();
        const temp = document.getElementById('val-temp').value.trim();
        const humedad = document.getElementById('val-humedad').value.trim();
        const metodo_med = document.getElementById('val-metodo').value.trim();
        const modo_med = document.getElementById('val-modo').value.trim();
        
        const unSel = document.getElementById('val-unidad-sel').value;
        const unidad_med = (unSel === 'other') ? (document.getElementById('val-unidad-other').value.trim() || 'Custom') : unSel;
        
        const referencia = parseFloat(document.getElementById('val-referencia').value) || 1.0e9;
        const notas_val = document.getElementById('val-notas').value.trim();

        if (!id_elemento) {
            alert('⚠️ ' + t('validation.msg_err_required', 'El ID del Elemento es obligatorio.'));
            document.getElementById('val-id-elemento').focus();
            return;
        }
        if (!ubicacion) {
            alert('⚠️ ' + t('validation.msg_err_required', 'Por favor ingresa o selecciona una Ubicación / Línea.'));
            document.getElementById('val-ubicacion-input').focus();
            return;
        }

        // Collect all dynamic reading rows
        const readingRows = document.querySelectorAll('.val-reading-row');
        const readings = [];
        let hasError = false;
        let isNonCompliant = false;

        readingRows.forEach((row, i) => {
            const valInput = row.querySelector('.val-reading-val');
            const locInput = row.querySelector('.val-reading-loc');
            const rawVal = valInput ? valInput.value.trim() : '';
            const pointLoc = locInput ? locInput.value.trim() : '';

            if (i === 0 && !rawVal) {
                hasError = true;
                alert('⚠️ ' + t('validation.msg_err_required', 'La Medición 1 es obligatoria.'));
                if (valInput) valInput.focus();
                return;
            }

            if (rawVal) {
                const parsed = parsearResistencia(rawVal);
                if (parsed === 'ERROR' || parsed === null) {
                    hasError = true;
                    alert(`⚠️ Ingresa un valor numérico válido para la Medición ${i+1} (ej: 1.5e6 o 500000).`);
                    if (valInput) valInput.focus();
                    return;
                }
                if (parsed > referencia) {
                    isNonCompliant = true;
                }
                readings.push({
                    index: i + 1,
                    value: parsed,
                    location_point: pointLoc
                });
            }
        });

        if (hasError || readings.length === 0) return;

        const med1 = readings[0].value;
        const submitBtn = document.getElementById('val-btn-submit');
        if (submitBtn) {
            submitBtn.disabled = true;
            submitBtn.innerHTML = `⏳ Procesando validación...`;
        }

        try {
            // Upload evidence image if selected to 'validation-evidence' bucket
            let uploadedImageUrl = '';
            if (validationEvidenceFile) {
                const fd = new FormData();
                fd.append('file', validationEvidenceFile);
                fd.append('elementId', id_elemento);
                fd.append('siteId', (sessionData && sessionData.site_id) || '');
                const upRes = await fetch('/api/validation/upload-evidence', {
                    method: 'POST',
                    body: fd
                });
                if (upRes.ok) {
                    const upData = await upRes.json();
                    if (upData.success) uploadedImageUrl = upData.evidence_url || '';
                }
            }

            // Get equipment metadata
            const eq = allValidationEquipos.find(x => (x.codigo_equipo === id_equipo_sel || x.custom_id === id_equipo_sel || x.id === id_equipo_sel)) || {};

            const resultado_calc = !isNonCompliant ? "CUMPLE (APROBADO)" : "NO CUMPLE (RECHAZADO)";

            const payload = {
                fecha_auditoria: new Date().toISOString(),
                auditor: (sessionData && sessionData.name) || 'Auditor ESD',
                elemento_s20_20,
                id_elemento,
                tipo_material,
                fabricante_elem: fab_elem,
                modelo_elem: mod_elem,
                sn_elem,
                temperatura: temp ? `${temp} °${getStoredTempUnit()}` : '',
                temp_unit: getStoredTempUnit(),
                humedad,
                ubicacion,
                id_equipo_utilizado: id_equipo_sel,
                tipo_equipo: eq.nombre_equipo || eq.equipment_type || 'Megóhmetro TR53',
                reporte_cal: eq.reporte_calibracion || eq.calibration_report || 'CERT-2026',
                resolucion: eq.resolucion || '0.01',
                fabricante_eq: eq.marca_modelo || eq.fabricante || 'Desco',
                modelo_eq: eq.modelo || '19787',
                sn_eq: eq.numero_serie || 'SN-982310',
                fecha_prox_cal: eq.fecha_proxima_calibracion ? eq.fecha_proxima_calibracion.split('T')[0] : '2027-01-15',
                limite_referencia: referencia,
                medicion_1: med1,
                readings,
                unidad: unidad_med,
                metodo: metodo_med,
                modo_medicion: modo_med,
                resultado: resultado_calc,
                notas: notas_val,
                imagen_url: uploadedImageUrl,
                site_id: (sessionData && sessionData.site_id) || ''
            };

            const res = await fetch('/api/validation/records', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            });

            const data = await res.json();
            if (res.ok && data.success) {
                const alertEl = document.getElementById('val-success-alert');
                if (alertEl) {
                    const isPass = resultado_calc.includes('CUMPLE');
                    alertEl.style.display = 'block';
                    alertEl.style.background = isPass ? '#ECFDF5' : '#FFF1F2';
                    alertEl.style.borderColor = isPass ? '#10B981' : '#F43F5E';
                    alertEl.style.color = isPass ? '#065F46' : '#9F1239';
                    alertEl.innerHTML = `✅ <strong>Validación guardada con éxito.</strong> Resultado evaluado: <strong>${resultado_calc}</strong> (${med1 < 1000 ? (med1 < 10 ? med1.toFixed(2) : Math.round(med1)) : med1.toExponential(2)} ${unidad_med})`;
                }

                // Clear input values
                document.getElementById('val-id-elemento').value = '';
                document.getElementById('val-tipo-material').value = '';
                document.getElementById('val-fab-elem').value = '';
                document.getElementById('val-mod-elem').value = '';
                document.getElementById('val-sn-elem').value = '';
                document.getElementById('val-temp').value = '';
                document.getElementById('val-humedad').value = '';
                document.getElementById('val-notas').value = '';
                clearValEvidence();
                initValReadings();

                // Refresh history
                loadValidationHistory();
            } else {
                alert('❌ ' + (data.message || 'Error al guardar la validación.'));
            }
        } catch(e) {
            console.error('Error submitting ESD validation:', e);
            alert('❌ Error de conexión al guardar la validación.');
        } finally {
            if (submitBtn) {
                submitBtn.disabled = false;
                submitBtn.innerHTML = `💾 <span data-i18n="validation.btn_submit">Evaluar y Guardar Validación</span>`;
                applyTranslations();
            }
        }
    }

    async function loadValidationHistory() {
        const container = document.getElementById('val-history-cards-container');
        if (!container) return;

        try {
            const siteId = (sessionData && sessionData.site_id) || '';
            const res = await fetch(`/api/validation/records?siteId=${encodeURIComponent(siteId)}`);
            if (res.ok) {
                allValidationRecords = await res.json();
                
                // Populate elements filter dropdown
                const elemFilter = document.getElementById('val-hist-elem-filter');
                if (elemFilter) {
                    const currVal = elemFilter.value;
                    elemFilter.innerHTML = `<option value="" data-i18n="validation.filter_all_elements">Todos los elementos</option>`;
                    const uniqueElems = [...new Set(allValidationRecords.map(x => x.elemento_s20_20).filter(Boolean))].sort();
                    uniqueElems.forEach(elName => {
                        const opt = document.createElement('option');
                        opt.value = elName;
                        opt.textContent = t(`validation.elements.${elName}`, elName);
                        if (currVal === elName) opt.selected = true;
                        elemFilter.appendChild(opt);
                    });
                }

                filterValidationHistory();
            }
        } catch(e) {
            console.error('Error loading validation history:', e);
            container.innerHTML = `<div style="text-align:center; padding:30px; color:var(--accent-rose);">❌ Error al cargar registros históricos: ${e.message}</div>`;
        }
    }

    function filterValidationHistory() {
        const container = document.getElementById('val-history-cards-container');
        if (!container) return;

        const q = (document.getElementById('val-hist-search')?.value || '').toLowerCase().trim();
        const elemFilter = document.getElementById('val-hist-elem-filter')?.value || '';
        const statusFilter = document.getElementById('val-hist-status-filter')?.value || '';

        let filtered = allValidationRecords.filter(r => {
            if (elemFilter && r.elemento_s20_20 !== elemFilter) return false;
            
            const resUpper = (r.resultado || '').toUpperCase();
            const isPass = resUpper.includes('CUMPLE') && !resUpper.includes('NO CUMPLE') && !resUpper.includes('RECHAZADO');
            if (statusFilter === 'PASS' && !isPass) return false;
            if (statusFilter === 'FAIL' && isPass) return false;

            if (q) {
                const combined = `${r.id_elemento || ''} ${r.elemento_s20_20 || ''} ${r.ubicacion || ''} ${r.auditor || ''} ${r.tipo_material || ''}`.toLowerCase();
                if (!combined.includes(q)) return false;
            }
            return true;
        });

        if (filtered.length === 0) {
            container.innerHTML = `
                <div style="text-align:center; padding:40px; background:#F8FAFC; border:1px dashed var(--border-color); border-radius:10px; color:var(--text-muted);">
                    ℹ️ No se encontraron registros de validación que coincidan con los filtros seleccionados.
                </div>
            `;
            return;
        }

        container.innerHTML = '';
        filtered.forEach((r, idx) => {
            const resUpper = (r.resultado || '').toUpperCase();
            const isPass = resUpper.includes('CUMPLE') && !resUpper.includes('NO CUMPLE') && !resUpper.includes('RECHAZADO');
            const icon = isPass ? '🟢' : '🔴';
            const colorClass = isPass ? '#059669' : '#E11D48';
            const bgClass = isPass ? '#ECFDF5' : '#FFF1F2';
            const borderClass = isPass ? '#A7F3D0' : '#FECDD3';
            const fechaCorta = r.fecha_auditoria ? r.fecha_auditoria.split('T')[0] : 'N/D';
            const elemTranslated = t(`validation.elements.${r.elemento_s20_20}`, r.elemento_s20_20 || 'General');

            // Format dynamic readings
            let readingsHtml = '';
            if (Array.isArray(r.readings) && r.readings.length > 0) {
                readingsHtml = r.readings.map((rd, i) => {
                    const n = Number(rd.value);
                    const valFmt = isNaN(n) ? rd.value : (n < 1000 ? (n < 10 ? n.toFixed(2) : Math.round(n).toString()) : n.toExponential(2));
                    const locPart = rd.location_point ? ` <span style="color:var(--text-muted); font-size:11px;">(${rd.location_point})</span>` : '';
                    return `<div><strong>M${i+1}:</strong> <span style="font-family:monospace; font-weight:700;">${valFmt} ${r.unidad || 'ohms'}</span>${locPart}</div>`;
                }).join('');
            } else if (r.medicion_1 !== null && r.medicion_1 !== undefined) {
                const n = Number(r.medicion_1);
                const medStr = isNaN(n) ? r.medicion_1 : (n < 1000 ? (n < 10 ? n.toFixed(2) : Math.round(n).toString()) : n.toExponential(2));
                readingsHtml = `<div><strong>M1:</strong> <span style="font-family:monospace; font-weight:700;">${medStr} ${r.unidad || 'ohms'}</span></div>`;
            } else {
                readingsHtml = `<div><span style="color:var(--text-muted);">N/D</span></div>`;
            }

            // Image tag
            let imgHtml = `<span style="color:var(--text-muted); font-size:11.5px;">Sin imagen adjunta</span>`;
            if (r.imagen_url && (r.imagen_url.startsWith('http') || r.imagen_url.startsWith('/api/'))) {
                imgHtml = `<img src="${r.imagen_url}" style="max-height:120px; max-width:100%; border-radius:6px; object-fit:contain; border:1px solid #CBD5E1; cursor:pointer;" onclick="window.open('${r.imagen_url}', '_blank')" alt="Evidencia" />`;
