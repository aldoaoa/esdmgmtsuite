    async function loadReportsRepository() {
        const tbody = document.getElementById('reports-repository-tbody');
        const lineSelect = document.getElementById('repo-filter-line');
        if (!tbody) return;

        tbody.innerHTML = '<tr><td colspan="6" style="text-align:center; padding:24px; color:var(--text-muted);">' + t('schedule.loading_reports', '⏳ Consultando historial de reportes...') + '</td></tr>';

        try {
            const siteSelect = document.getElementById('active-site-select');
            const siteId = (siteSelect && siteSelect.value) ? siteSelect.value : ((sessionData && sessionData.site_id) || '');
            const res = await fetch(`/api/schedule/reports?siteId=${encodeURIComponent(siteId)}`);
            if (!res.ok) throw new Error('Error al cargar repositorio de reportes');
            const data = await res.json();
            allGeneratedReports = data.reports || [];

            // Populate lines filter options
            if (lineSelect) {
                const currentVal = lineSelect.value;
                const lines = [...new Set(allGeneratedReports.map(r => r.linea).filter(Boolean))];
                let opts = `<option value="all">${t('schedule.all_lines', '-- Todas las Líneas --')}</option>`;
                lines.forEach(l => {
                    opts += `<option value="${l}">${l}</option>`;
                });
                lineSelect.innerHTML = opts;
                if (currentVal && lines.includes(currentVal)) lineSelect.value = currentVal;
            }

            filterReportsRepository();
        } catch (ex) {
            tbody.innerHTML = `<tr><td colspan="6" style="text-align:center; padding:24px; color:var(--accent-rose);">❌ Error al consultar repositorio: ${ex.message}</td></tr>`;
        }
    }

    function filterReportsRepository() {
        const search = (document.getElementById('repo-search-input')?.value || '').trim().toLowerCase();
        const typeFilter = document.getElementById('repo-filter-type')?.value || 'all';
        const lineFilter = document.getElementById('repo-filter-line')?.value || 'all';

        let filtered = allGeneratedReports.filter(r => {
            const folio = (r.folio || '').toLowerCase();
            const auditor = (r.auditor || '').toLowerCase();
            const rLine = (r.linea || '').toLowerCase();
            const rType = (r.report_type || 'LINE_VALIDATION').toUpperCase();

            const matchesSearch = !search || folio.includes(search) || auditor.includes(search) || rLine.includes(search);
            const matchesLine = lineFilter === 'all' || rLine.includes(lineFilter.toLowerCase());
            const matchesType = typeFilter === 'all' || rType === typeFilter || (typeFilter === 'LINE_VALIDATION' && (!r.report_type || r.report_type === 'LINE_VALIDATION'));

            return matchesSearch && matchesLine && matchesType;
        });

        renderReportsRepositoryTable(filtered);
    }

