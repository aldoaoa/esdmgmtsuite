    async function loadFindingsModule() {
        const tbody = document.getElementById('findings-table-tbody');
        if (tbody && (!allFindings || allFindings.length === 0)) {
            tbody.innerHTML = `<tr><td colspan="8" style="text-align:center; padding:28px; color:var(--text-muted); font-size:12.5px;">
                <div style="display:inline-flex; align-items:center; gap:8px;">
                    <span style="display:inline-block; width:16px; height:16px; border:2px solid #CBD5E1; border-top-color:#2563EB; border-radius:50%; animation:spin 0.8s linear infinite;"></span>
                    <span>Cargando hallazgos normativos...</span>
                </div>
            </td></tr>`;
        }

        const controller = new AbortController();
        const timeoutId = setTimeout(() => controller.abort(), 9000);

        try {
            const siteId = getActiveSiteId();
            let url = '/api/findings';
            if (siteId) url += '?site_id=' + encodeURIComponent(siteId);

            const res = await fetch(url, { signal: controller.signal });
            clearTimeout(timeoutId);
            if (!res.ok) {
                throw new Error(`HTTP ${res.status}: ${res.statusText}`);
            }
            const data = await res.json();
            
            let list = [];
            if (Array.isArray(data)) {
                list = data;
            } else if (data && Array.isArray(data.findings)) {
                list = data.findings;
            } else if (data && Array.isArray(data.data)) {
                list = data.data;
            }

            allFindings = list;
            updateFindingsKpis(allFindings);
            filterFindingsList();
            refreshOpenFindingsBadge();
        } catch(e) {
            clearTimeout(timeoutId);
            console.error('Error loading findings module:', e);
            if (tbody) {
                const isTimeout = e.name === 'AbortError';
                tbody.innerHTML = `<tr><td colspan="8" style="text-align:center; padding:24px; color:#DC2626; font-size:12.5px;">
                    ⚠️ ${isTimeout ? 'La consulta tardó más del tiempo esperado.' : 'Error al cargar los hallazgos: ' + escapeHtml(e.message || 'Error de conexión')}
                    <div style="margin-top:8px;">
                        <button type="button" class="tab-btn" onclick="loadFindingsModule()" style="font-size:11.5px; padding:4px 12px; background:#F1F5F9; font-weight:700;">🔄 Reintentar Carga</button>
                    </div>
                </td></tr>`;
            }
        }
    }

    function updateFindingsKpis(findings) {
        if (!Array.isArray(findings)) findings = [];
        const total = findings.length;
        const open = findings.filter(f => (f.status || '').toUpperCase() === 'OPEN').length;
        const progress = findings.filter(f => (f.status || '').toUpperCase() === 'IN_PROGRESS').length;
        const pending = findings.filter(f => (f.status || '').toUpperCase() === 'PENDING_VERIFICATION').length;
        const closed = findings.filter(f => (f.status || '').toUpperCase() === 'CLOSED').length;

        const elTotal = document.getElementById('fnd-kpi-total');
        const elOpen = document.getElementById('fnd-kpi-open');
        const elProg = document.getElementById('fnd-kpi-progress');
        const elPend = document.getElementById('fnd-kpi-pending');
        const elClosed = document.getElementById('fnd-kpi-closed');

        if (elTotal) elTotal.textContent = total;
        if (elOpen) elOpen.textContent = open;
        if (elProg) elProg.textContent = progress;
        if (elPend) elPend.textContent = pending;
        if (elClosed) elClosed.textContent = closed;
    }

