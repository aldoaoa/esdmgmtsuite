    // --- LIGHTWEIGHT QR SCANNER LOGIC ---
    function initQRScanner() {
        loadAuditLinesSelect();
        populateElementSubtypes(document.getElementById('audit-tipo-equipo').value || "Mobiliario ESD");
        if (!window.Html5Qrcode) return;
        const statusEl = document.getElementById('cam-status');
        
        Html5Qrcode.getCameras().then(devices => {
            if (devices && devices.length) {
                videoDevices = devices.filter(c => {
                    const lbl = c.label.toLowerCase();
                    return lbl.includes('back') || lbl.includes('trasera') || lbl.includes('environment');
                });
                if (videoDevices.length === 0) videoDevices = devices;

                wideCamId = videoDevices[0].id;
                for (let c of videoDevices) {
                    let lbl = c.label.toLowerCase();
                    if (lbl.includes('wide') && !lbl.includes('ultra')) {
                        wideCamId = c.id; break;
                    }
                }
                currentCamIdx = videoDevices.findIndex(c => c.id === wideCamId);
                if (currentCamIdx === -1) currentCamIdx = 0;

                startScannerWithCamId(wideCamId);
            } else {
                statusEl.innerText = "No se detectaron cámaras en el dispositivo.";
            }
        }).catch(err => {
            statusEl.innerText = "Permisos de cámara denegados o cámara no disponible.";
        });
    }

    function startScannerWithCamId(camId) {
        if (!html5QrCode) html5QrCode = new Html5Qrcode("qr-reader");
        const statusEl = document.getElementById('cam-status');

        if (html5QrCode.isScanning) {
            html5QrCode.stop().then(() => { runScanner(camId); }).catch(e => console.log(e));
        } else {
            runScanner(camId);
        }
    }

    function runScanner(camId) {
        const statusEl = document.getElementById('cam-status');
        html5QrCode.start(
            camId,
            { fps: 15, qrbox: { width: 220, height: 220 }, aspectRatio: 1.0 },
            (decodedText) => {
                // QR Code detected!
                document.getElementById('audit-id-elemento').value = decodedText.toUpperCase();
                lookupScannedAsset(decodedText);
            },
            (err) => {}
        ).then(() => {
            let activeCam = videoDevices.find(c => c.id === camId);
            statusEl.innerText = "Lente activo: " + (activeCam ? activeCam.label : "Cámara");
        }).catch(err => {
            statusEl.innerText = "Error al iniciar lente. Prueba '🔄 OTRA CÁMARA'.";
        });
    }

    function startScannerStandard() {
        if (wideCamId) startScannerWithCamId(wideCamId);
    }

    function cycleCamera() {
        if (!videoDevices.length) return;
        currentCamIdx = (currentCamIdx + 1) % videoDevices.length;
        startScannerWithCamId(videoDevices[currentCamIdx].id);
    }

    // --- LOOKUP SCANNED ASSET & HISTORY ---
    async function lookupScannedAsset(scannedId) {
        if (!scannedId || !scannedId.trim()) return;
        const cleanId = scannedId.trim().toUpperCase();
        document.getElementById('audit-id-elemento').value = cleanId;

        const res = await fetch(`/api/audit/last-measurement/${encodeURIComponent(cleanId)}`);
        const data = await res.json();
        
        const card = document.getElementById('scanned-asset-card');
        const cardId = document.getElementById('card-asset-id');
        const cardStatus = document.getElementById('card-asset-status');
        const cardLoc = document.getElementById('card-asset-loc');
        const cardClass = document.getElementById('card-asset-class');
        const cardHist = document.getElementById('card-history-details');

        card.style.display = 'block';
        cardId.innerText = `🔍 ID: ${cleanId}`;

        if (data.found && data.data) {
            const m = data.data;
            const isDecommissioned = (m.asset_status === 'INACTIVE' || m.asset_status === 'BAJA' || m.asset_status === 'DECOMMISSIONED' || m.status_result === 'INACTIVE' || m.estatus === 'INACTIVE');

            if (isDecommissioned) {
                cardStatus.className = 'badge-fail';
                cardStatus.innerText = t('inventory.status_inactive', 'DADO DE BAJA');
            } else {
                cardStatus.className = (m.estatus === 'PASA' || m.status_result === 'PASS') ? 'badge-pass' : (m.status_result === 'PENDING' ? 'badge-pending' : 'badge-fail');
                cardStatus.innerText = m.estatus || m.status_result || 'ACTIVE';
            }

            cardLoc.innerText = m.ubicacion || m.linea_ubicacion || m.location || 'N/A';
            cardClass.innerText = m.tipo_equipo || m.category || 'Mobiliario ESD';

            const resTxt = m.resistencia ? `${m.resistencia.toExponential(2)} Ω` : (m.resistance_value ? `${m.resistance_value.toExponential(2)} Ω` : 'N/D');
            const voltTxt = m.voltaje_campo !== undefined ? `${m.voltaje_campo} V` : (m.static_field_value !== undefined ? `${m.static_field_value} V` : 'N/D');

            const lblDate = t('audit.card_date', 'Fecha');
            const lblRes = t('audit.card_res', 'Resistencia');
            const lblField = t('audit.card_field', 'Campo');
            const lblStatus = t('audit.card_status', 'Estatus');

            if (m.is_asset_only) {
                cardHist.innerHTML = `<div>📦 <b>${t('audit.card_registered_asset', 'Activo Registrado en Catálogo')}</b> | 📍 <b>${m.location || 'N/A'}</b></div>`;
            } else {
                const ptTxt = m.punto_contacto ? ` | 📍 <i>${m.punto_contacto}</i>` : '';
                cardHist.innerHTML = `
                    <div>📅 <b>${lblDate}:</b> ${m.fecha_medicion || m.measured_at || 'N/A'}${ptTxt}</div>
                    <div>⚡ <b>${lblRes}:</b> ${resTxt} | 🧲 <b>${lblField}:</b> ${voltTxt}</div>
                    <div>📊 <b>${lblStatus}:</b> <b>${m.estatus || m.status_result || 'PASA'}</b></div>
                `;
            }

            if (isDecommissioned) {
                cardHist.innerHTML += `
                    <div style="margin-top:8px; padding:8px 12px; background:#FEF3C7; border:1px solid #FDE68A; border-radius:6px; color:#92400E; font-size:12px; font-weight:600;">
                        ⚠️ <b>Activo Dado de Baja:</b> Al registrar y guardar esta auditoría, el equipo será reactivado automáticamente en el directorio operativo.
                    </div>
                `;
            }
            if (m.tipo_equipo || m.category) {
                const eqCat = m.tipo_equipo || m.category;
                document.getElementById('audit-tipo-equipo').value = eqCat;
                toggleAuditFormType(eqCat);
            }
            if (m.subtipo_elemento || m.sub_category || m.subtipo_key) {
                populateElementSubtypes(m.tipo_equipo || m.category, m.subtipo_key || m.subtipo_elemento || m.sub_category);
            }
            if (m.ubicacion || m.location) {
                const u = m.ubicacion || m.location;
                const selU = document.getElementById('audit-ubicacion-select');
                if (selU) {
                    for (let opt of selU.options) {
                        if (opt.value === u || opt.value.toUpperCase() === u.toUpperCase()) {
                            opt.selected = true; break;
                        }
                    }
                }
            }
            if (m.punto_contacto) {
                const mobPt = document.getElementById('mob-punto-contacto');
                const ionPt = document.getElementById('ion-punto-contacto');
                if (mobPt) mobPt.value = m.punto_contacto;
                if (ionPt) ionPt.value = m.punto_contacto;
            }
        } else {
            cardStatus.className = 'badge-pass';
            cardStatus.innerText = t('audit.card_new_asset', 'NUEVO ACTIVO');
            cardLoc.innerText = 'N/A';
            cardClass.innerText = 'Mobiliario ESD';
            cardHist.innerHTML = `<i>ℹ️ ${t('audit.card_no_history', 'No hay mediciones anteriores para este activo. Captura la primera auditoría abajo.')}</i>`;
        }
    }

    // --- AUDIT FORM LOGIC & ELEMENT SUBTYPES ---
    const ELEMENT_SUBTYPES_DEF = {
        "furniture": ["worksurface", "seating", "shelving", "cart", "flow_rack"],
        "machinery": ["smt", "oven_soldering", "conveyor", "test_equipment", "router_depaneling", "screwdriver", "soldering_iron"],
        "ionizer": ["benchtop", "overhead", "ionizing_bar", "air_gun", "in_machine", "ceiling"],
        "grounding": ["ground_point", "ground_bus"],
        "floors": ["esd_floor", "esd_footwear"],
        "garments": ["esd_smock", "esd_gloves"]
    };

    function getCategoryGroup(categoryVal) {
        if (!categoryVal) return "furniture";
        const c = categoryVal.toLowerCase();
        if (c.includes('ioniz') || c.includes('ion') || c.includes('离子')) return "ionizer";
        if (c.includes('maquin') || c.includes('machin') || c.includes('smt') || c.includes('equipo') || c.includes('cautin') || c.includes('cautín') || c.includes('horno') || c.includes('conveyor') || c.includes('test') || c.includes('机械') || c.includes('utilaj')) return "machinery";
        if (c.includes('tierra') || c.includes('ground') || c.includes('gnd') || c.includes('接地') || c.includes('împământare') || c.includes('erdung')) return "grounding";
        if (c.includes('piso') || c.includes('calzad') || c.includes('floor') || c.includes('foot') || c.includes('zapato') || c.includes('talon') || c.includes('talón') || c.includes('pulsera') || c.includes('wrist') || c.includes('walking') || c.includes('pardosel') || c.includes('paviment') || c.includes('böden') || c.includes('地板')) return "floors";
        if (c.includes('prenda') || c.includes('bata') || c.includes('smock') || c.includes('guant') || c.includes('glove') || c.includes('gorra') || c.includes('cap') || c.includes('garment') || c.includes('îmbrăcăminte') || c.includes('indumenti') || c.includes('kleidung') || c.includes('服') || c.includes('手套')) return "garments";
        return "furniture";
    }

    function normalizeAssetCategory(rawCat) {
        if (!rawCat) return "Mobiliario ESD";
        const c = rawCat.toLowerCase().trim();
        if (c.includes('ioniz') || c.includes('ion') || c.includes('离子')) return "Sistema de ionización";
        if (c.includes('maquin') || c.includes('machin') || c.includes('smt') || c.includes('equipo') || c.includes('cautin') || c.includes('cautín') || c.includes('horno') || c.includes('conveyor') || c.includes('test') || c.includes('机械') || c.includes('utilaj')) return "Maquinaria y equipo";
        if (c.includes('tierra') || c.includes('ground') || c.includes('gnd') || c.includes('接地') || c.includes('împământare') || c.includes('erdung')) return "Puntos de Tierra / Grounding";
        if (c.includes('piso') || c.includes('calzad') || c.includes('floor') || c.includes('foot') || c.includes('zapato') || c.includes('talon') || c.includes('talón') || c.includes('pulsera') || c.includes('wrist') || c.includes('walking') || c.includes('pardosel') || c.includes('paviment') || c.includes('böden') || c.includes('地板')) return "Pisos y Calzado";
        if (c.includes('prenda') || c.includes('bata') || c.includes('smock') || c.includes('guant') || c.includes('glove') || c.includes('gorra') || c.includes('cap') || c.includes('garment') || c.includes('îmbrăcăminte') || c.includes('indumenti') || c.includes('kleidung') || c.includes('服') || c.includes('手套')) return "Prendas y Guantes";
        return "Mobiliario ESD";
    }

    function populateElementSubtypes(categoryVal, preselectedSubtypeKey) {
        const subSel = document.getElementById('audit-subtipo-elemento');
        if (!subSel) return;
        const currentVal = preselectedSubtypeKey || subSel.value;
        subSel.innerHTML = '';
        const group = getCategoryGroup(categoryVal);
        const keys = ELEMENT_SUBTYPES_DEF[group] || ELEMENT_SUBTYPES_DEF["furniture"];
        
        keys.forEach(k => {
            const label = t('audit.subtypes.' + k, k);
            const opt = document.createElement('option');
            opt.value = k;
            opt.setAttribute('data-subtype-key', k);
            opt.textContent = label;
            if (currentVal && (currentVal === k || currentVal === label)) opt.selected = true;
            subSel.appendChild(opt);
        });
    }

