                                ${r.notas ? `<strong>Notas:</strong> ${r.notas}` : ''}
                            </div>
                            <button type="button" class="tab-btn" onclick="exportElementValidationReport(${idx})" style="padding:6px 14px; font-size:11.5px; font-weight:700; display:inline-flex; align-items:center; gap:6px; background:#EFF6FF; color:#2563EB; border-color:#BFDBFE; cursor:pointer;" title="Exportar Reporte Oficial PDF / HTML">
