    async function showAddSubOperationModal(siteId, areaName, parentCompNodeId, parentSiteNodeId) {
        if (parentCompNodeId) expandedTreeNodes.add(parentCompNodeId);
        if (parentSiteNodeId) expandedTreeNodes.add(parentSiteNodeId);

        const opName = prompt(`Ingrese el nombre de la Operación / Sub-área para "${areaName}":`);
        if (!opName || !opName.trim()) return;

        const fullName = `${areaName} -> ${opName.trim()}`;
        const res = await fetch('/api/lines', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                site_id: siteId,
                nombre_linea: fullName
            })
        });
        const data = await res.json();
        if (data.success) {
            showToast(`✅ Operación "${opName.trim()}" agregada a "${areaName}".`);
            loadSettings();
        } else {
            showToast('❌ ' + (data.message || 'Error al crear la Operación.'), 'error');
