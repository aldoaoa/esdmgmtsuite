    async function handleGenericPhotoUpload(inputEl, imgId, thumbId, urlInputId, prefix = 'ev') {
        if (!inputEl || !inputEl.files || !inputEl.files[0]) return;
        const file = inputEl.files[0];
        
        const compressedBase64 = await compressEvidenceImage(file, 1024, 0.75);
        if (!compressedBase64) return;

        const thumb = document.getElementById(thumbId);
        const img = document.getElementById(imgId);
        const urlInput = document.getElementById(urlInputId);

        if (img) img.src = compressedBase64;
        if (thumb) thumb.style.display = 'inline-flex';
        if (urlInput) urlInput.value = compressedBase64;

        try {
            // Upload to Supabase Storage Vault via /api/evidence/upload
            const formData = new FormData();
            formData.append('file', file);
            formData.append('section', prefix);
            formData.append('siteId', (sessionData && sessionData.site_id) || '');

            const res = await fetch('/api/evidence/upload', {
                method: 'POST',
                body: formData
            });
            if (res.ok) {
                const data = await res.json();
                if (data.success && data.evidence_url && urlInput) {
                    urlInput.value = data.evidence_url;
                }
            }
        } catch(e) {
            console.warn('Background photo upload note:', e);
        }
    }

    function clearGenericPhoto(fileInputId, thumbId, imgId, urlInputId) {
        const fileInput = document.getElementById(fileInputId);
        const thumb = document.getElementById(thumbId);
        const img = document.getElementById(imgId);
        const urlInput = document.getElementById(urlInputId);
        if (fileInput) fileInput.value = '';
        if (thumb) thumb.style.display = 'none';
        if (img) img.src = '';
        if (urlInput) urlInput.value = '';
    }

