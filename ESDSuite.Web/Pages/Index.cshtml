    async function submitReassignGroup(e) {
        if (e && e.preventDefault) e.preventDefault();
        const groupId = activeReassignGroupId;
        const targetSiteId = document.getElementById('reassign-target-site')?.value || '';
        const mode = document.getElementById('reassign-loc-mode')?.value || 'keep';

        if (!groupId || !targetSiteId) {
            alert('Por favor selecciona un Site destino.');
            return;
        }

        let targetLocationOverride = null;
        if (mode === 'custom') {
            const typed = (document.getElementById('reassign-custom-loc-input')?.value || '').trim();
            const selected = (document.getElementById('reassign-existing-loc-select')?.value || '').trim();
            targetLocationOverride = typed || selected || null;
            if (!targetLocationOverride) {
                alert('Por favor selecciona o escribe el Área / Operación destino.');
                return;
            }
        }

        const btn = document.getElementById('btn-submit-reassign-group');
        if (btn) { btn.disabled = true; btn.innerText = '⏳ Reasignando...'; }

        try {
            const res = await fetch(`/api/hierarchy/archived-groups/${encodeURIComponent(groupId)}/reassign`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    target_site_id: targetSiteId,
                    target_location_override: targetLocationOverride
                })
            });
            const data = await res.json();
            if (res.ok && data.success) {
                showToast(`✅ ${data.message || 'Elementos reasignados exitosamente.'}`);
                closeReassignGroupModal();
                await loadSettings();
                try { await loadSites(); } catch (err) {}
            } else {
                showToast('❌ ' + (data.message || 'Error al reasignar el grupo.'), 'error');
            }
        } catch (ex) {
            showToast('❌ Error de conexión al reasignar el grupo.', 'error');
        } finally {
            if (btn) { btn.disabled = false; btn.innerText = '🔄 Reasignar Todo al Site Destino'; }
        }
    }

