                        opt.value = eq.codigo_equipo || eq.id;
                        
                        let statusText = t('settings.status_valid', 'VIGENTE');
                        let statusEmoji = '✅';
                        if (eq.estatus === 'VENCIDO') {
                            statusText = t('settings.status_expired', 'VENCIDO');
                            statusEmoji = '❌';
                        } else if (eq.estatus === 'PROXIMO_VENCER') {
                            statusText = t('settings.status_soon', 'POR VENCER');
                            statusEmoji = '⚠️';
                        }
                        
                        opt.text = `${eq.codigo_equipo || 'EQ'} - ${eq.nombre_equipo || ''} (${eq.marca_modelo || 'N/A'}) [${statusEmoji} ${statusText}]`;
                        opt.dataset.estatus = eq.estatus || 'VIGENTE';
                        el.appendChild(opt);
                    });
                }
                if (currentVal) el.value = currentVal;
            });
        } catch(e) {
            console.error('Error loading site equipment:', e);
        }
    }

