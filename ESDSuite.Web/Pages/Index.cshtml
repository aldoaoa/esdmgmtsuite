            container.innerHTML = `<div class="glass-card" style="text-align:center; color:var(--accent-rose); padding:16px;">❌ Error al cargar historial.</div>`;
        }
    }

    async function openEditEventMeterModal(logId) {
        const log = cachedEventMeterLogs.find(x => x.id === logId);
        if (!log) return;

        const modal = document.getElementById('modal-edit-eventmeter');
        if (!modal) return;

        document.getElementById('edit-em-id').value = log.id;
        document.getElementById('edit-em-contacto').value = log.tipo_contacto || 'Maquinaria';
        document.getElementById('edit-em-tiempo-valor').value = log.tiempo_analisis_valor || (log.tiempo_analisis ? parseFloat(log.tiempo_analisis) : 30) || 30;
        document.getElementById('edit-em-tiempo-unidad').value = log.tiempo_analisis_unidad || (log.tiempo_analisis && log.tiempo_analisis.includes('s') ? 's' : (log.tiempo_analisis && log.tiempo_analisis.includes('h') ? 'h' : 'min')) || 'min';
        document.getElementById('edit-em-cant').value = log.cantidad_eventos;
        document.getElementById('edit-em-volt-max').value = log.voltaje_maximo;
        document.getElementById('edit-em-temp').value = log.temperatura || 23.5;
        document.getElementById('edit-em-hum').value = log.humedad || 45;
        document.getElementById('edit-em-notas').value = log.observaciones || '';

        // Populate lines in edit modal
        const lineSel = document.getElementById('edit-em-linea');
        const siteId = sessionData.site_id || '';
        try {
            const res = await fetch(`/api/lines?siteId=${siteId}`);
            if (res.ok) {
                const lines = await res.json();
                lineSel.innerHTML = '';
                lines.forEach(l => {
                    const name = l.nombre_linea || l.name;
                    lineSel.innerHTML += `<option value="${name}">${name}</option>`;
                });
                lineSel.value = log.linea_ubicacion || (lines.length > 0 ? (lines[0].nombre_linea || lines[0].name) : '');
            }
        } catch(e) {}

        // Populate operation / assets in edit modal
        const opSel = document.getElementById('edit-em-op-id');
        try {
            const res = await fetch(`/api/line-assets?line=${encodeURIComponent(lineSel.value)}&siteId=${siteId}`);
            if (res.ok) {
                const assets = await res.json();
                opSel.innerHTML = '';
                let foundCurrent = false;
                assets.forEach(a => {
                    const subtype = a.element_subtype ? ` (${a.element_subtype})` : '';
                    if (a.asset_id === log.id_operacion) foundCurrent = true;
                    opSel.innerHTML += `<option value="${a.asset_id}">${a.asset_id}${subtype}</option>`;
                });
                if (!foundCurrent && log.id_operacion) {
                    opSel.innerHTML = `<option value="${log.id_operacion}" selected>${log.id_operacion}</option>` + opSel.innerHTML;
                }
                opSel.value = log.id_operacion;
            }
        } catch(e) {}

        modal.style.display = 'flex';
    }

