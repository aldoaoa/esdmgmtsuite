                            <div>
                                <h5 style="margin:0 0 8px 0; font-size:12px; font-weight:700; color:var(--accent-blue);">📊 Resultados y Mediciones</h5>
                                <div style="display:flex; flex-direction:column; gap:3px; margin-bottom:6px;">
                                    ${readingsHtml}
                                </div>
                                <div><strong>Límite Ref.:</strong> <span style="font-family:monospace;">&lt; ${r.limite_referencia ? Number(r.limite_referencia).toExponential(2) : '1.00e+9'}</span></div>
                                <div style="margin-top:4px;"><strong>Resultado:</strong> <span style="color:${colorClass}; font-weight:800;">${r.resultado || 'CUMPLE'}</span></div>
                            </div>

                            <!-- Column 4: Evidencia -->
                            <div style="text-align:center;">
                                <h5 style="margin:0 0 8px 0; font-size:12px; font-weight:700; color:var(--accent-blue);">📷 Evidencia</h5>
