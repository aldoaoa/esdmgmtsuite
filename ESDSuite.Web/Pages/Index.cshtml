            </div>

            <!-- DYNAMIC SEVERITY CRITERIA CARD -->
            <div id="fnd-severity-info-card" style="padding:10px 14px; background:#FFFBEB; border:1px solid #FCD34D; border-left:4px solid #D97706; border-radius:8px; font-size:11.5px; line-height:1.45; color:#92400E;">
                <!-- Populated dynamically -->
            </div>

            <div style="display:grid; grid-template-columns: 1fr 1fr; gap:12px;">
                <div class="form-group" style="margin-bottom:0;">
                    <label style="font-weight:700; font-size:12px; margin-bottom:4px; display:flex; justify-content:space-between; align-items:center;">
                        <span>ID del Elemento Auditado</span>
                        <span style="font-size:11px; font-weight:normal; color:var(--text-muted);">(Opcional)</span>
                    </label>
                    <input id="fnd-new-elem-id" class="form-control" list="fnd-elements-datalist" placeholder="Opcional - Escribir o buscar ID..." autocomplete="off" onchange="onFindingElementSelected(this.value)" />
                    <datalist id="fnd-elements-datalist"></datalist>
                </div>
                <div class="form-group" style="margin-bottom:0;">
                    <label style="font-weight:700; font-size:12px; margin-bottom:4px;">Ubicación / Línea / Área*</label>
                    <select id="fnd-new-location" class="form-control" required>
                        <option value="">-- Seleccionar Ubicación / Línea / Área --</option>
                    </select>
                </div>
            </div>

            <div style="display:grid; grid-template-columns: 1fr 1fr; gap:12px;">
                <div class="form-group" style="margin-bottom:0;">
                    <label style="font-weight:700; font-size:12px; margin-bottom:4px;">Valor Medido</label>
                    <input id="fnd-new-measured" class="form-control" placeholder="Ej: 3.5e9 &Omega;" />
                </div>
                <div class="form-group" style="margin-bottom:0;">
                    <label style="font-weight:700; font-size:12px; margin-bottom:4px;">Límite Normativo</label>
                    <input id="fnd-new-limit" class="form-control" placeholder="Ej: &lt; 1.0e9 &Omega;" />
                </div>
            </div>

            <div style="display:grid; grid-template-columns: 1fr 1fr; gap:12px;">
                <div class="form-group" style="margin-bottom:0;">
                    <label style="font-weight:700; font-size:12px; margin-bottom:4px;">Responsable Asignado*</label>
                    <select id="fnd-new-assignee" class="form-control" required>
                        <option value="">-- Seleccionar Responsable Asignado --</option>
                    </select>
                </div>
                <div class="form-group" style="margin-bottom:0;">
                    <label style="font-weight:700; font-size:12px; margin-bottom:4px;">Fecha Compromiso*</label>
                    <input type="date" id="fnd-new-due-date" class="form-control" required />
                </div>
            </div>

            <div class="form-group" style="margin-bottom:0;">
                <label style="font-weight:700; font-size:12px; margin-bottom:4px;">Acción Inmediata de Contención</label>
                <input id="fnd-new-containment" class="form-control" placeholder="Ej: Paro de mesa y colocación de tapete disipativo provisional..." />
            </div>

            <div class="form-group" style="margin-bottom:0;">
                <label style="font-weight:700; font-size:12px; margin-bottom:4px;">Evidencia Fotográfica Inicial (Apertura)</label>
                <input type="file" id="fnd-new-photo-file" accept="image/*" class="form-control" style="font-size:12px;" />
            </div>

            <div style="display:flex; justify-content:flex-end; gap:10px; margin-top:8px; padding-top:14px; border-top:1px solid var(--border-color);">
                <button type="button" class="tab-btn" onclick="closeNewFindingModal()" style="padding:8px 18px;">✕ Cancelar</button>
                <button type="submit" class="btn-primary" style="padding:8px 22px; font-weight:800; background:#2563EB;">➕ Crear Hallazgo</button>
            </div>
        </form>
    </div>
</div>

<!-- MODAL: CREATE MANUAL LESSON LEARNED -->
<div id="modal-new-lesson" class="modal-backdrop" style="display:none; position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(15,23,42,0.75); backdrop-filter:blur(4px); z-index:9995; justify-content:center; align-items:center; padding:16px;" onclick="if(event.target===this) closeNewLessonModal()">
    <div class="glass-card" style="background:#FFFFFF; border-radius:14px; width:100%; max-width:680px; padding:0; box-shadow:0 25px 50px -12px rgba(0,0,0,0.25); border:1px solid var(--border-color); max-height:92vh; display:flex; flex-direction:column; overflow:hidden;" onclick="event.stopPropagation()">
        <!-- Header -->
        <div style="padding:16px 20px; border-bottom:1px solid var(--border-color); display:flex; justify-content:space-between; align-items:center; background:#FAF5FF;">
            <div>
                <h3 style="margin:0; font-size:16px; font-weight:800; color:#581C87; display:flex; align-items:center; gap:8px;">
                    <span>💡</span> <span>Nueva Lección Aprendida &amp; Buena Práctica</span>
                </h3>
                <p style="margin:2px 0 0 0; font-size:11.5px; color:#7E22CE;">
                    Registro manual de acción de mejora continua, optimización preventiva o solución técnica consolidada
                </p>
            </div>
            <button type="button" onclick="closeNewLessonModal()" style="background:none; border:none; font-size:22px; cursor:pointer; color:var(--text-muted);">&times;</button>
        </div>

        <!-- Form Body -->
        <form id="form-new-lesson" onsubmit="event.preventDefault(); submitNewLesson();" style="padding:20px; overflow-y:auto; display:flex; flex-direction:column; gap:12px;">
            <div class="form-group" style="margin-bottom:0;">
                <label style="font-weight:700; font-size:12px; margin-bottom:4px;">Título de la Lección / Buena Práctica*</label>
                <input id="lsn-new-title" class="form-control" placeholder="Ej: Optimización de aterrizaje de mesas y sustitución de broches en ensamble" required />
            </div>

            <div style="display:grid; grid-template-columns: 1fr 1fr; gap:12px;">
                <div class="form-group" style="margin-bottom:0;">
                    <label style="font-weight:700; font-size:12px; margin-bottom:4px;">Categoría de Mejora*</label>
                    <select id="lsn-new-category" class="form-control" required>
                        <option value="Mantenimiento Preventivo" selected>Mantenimiento Preventivo</option>
                        <option value="Diseño de Estación">Diseño de Estación / Puesto EPA</option>
                        <option value="Capacitación de Personal">Capacitación de Personal</option>
                        <option value="Procedimiento Operativo">Procedimiento Operativo / SOP</option>
                        <option value="Calibración y Metrología">Calibración y Metrología</option>
                        <option value="Control de Materiales ESD">Control de Materiales y Empaque</option>
                        <option value="Mejora Continua Kaizen">Mejora Continua Kaizen</option>
                        <option value="Otro">Otro</option>
                    </select>
                </div>
                <div class="form-group" style="margin-bottom:0;">
                    <label style="font-weight:700; font-size:12px; margin-bottom:4px;">Referencia Normativa*</label>
                    <select id="lsn-new-table" class="form-control" required>
                        <option value="ANSI/ESD S20.20 Tabla 2 (Superficies/EPA)" selected>ANSI/ESD S20.20 Tabla 2 (Superficies/EPA)</option>
                        <option value="ANSI/ESD S20.20 Tabla 1 (Personal/Tierra)">ANSI/ESD S20.20 Tabla 1 (Personal/Tierra)</option>
                        <option value="ANSI/ESD S20.20 Tabla 3 (Pisos/Calzado)">ANSI/ESD S20.20 Tabla 3 (Pisos/Calzado)</option>
                        <option value="ANSI/ESD S20.20 Tabla 4 (Empaque)">ANSI/ESD S20.20 Tabla 4 (Empaque)</option>
                        <option value="ANSI/ESD S20.20 General">ANSI/ESD S20.20 General</option>
                        <option value="Buenas Prácticas Internas">Buenas Prácticas Internas</option>
                    </select>
                </div>
            </div>

            <div style="display:grid; grid-template-columns: 1fr 1fr; gap:12px;">
                <div class="form-group" style="margin-bottom:0;">
                    <label style="font-weight:700; font-size:12px; margin-bottom:4px;">Ubicación / Línea / Área*</label>
                    <input id="lsn-new-location" class="form-control" list="val-lines-datalist" placeholder="Ej: Línea SMT 2 / Estación 4" required />
                </div>
                <div class="form-group" style="margin-bottom:0;">
                    <label style="font-weight:700; font-size:12px; margin-bottom:4px;">Elemento / Equipo Involucrado</label>
                    <input id="lsn-new-element" class="form-control" placeholder="Ej: Tapete conductivo, Pulsera, Ionizador..." />
                </div>
            </div>

            <div style="display:grid; grid-template-columns: 1fr 1fr; gap:12px;">
                <div class="form-group" style="margin-bottom:0;">
                    <label style="font-weight:700; font-size:12px; margin-bottom:4px; color:#DC2626;">🔍 Causa Raíz o Condición Previa*</label>
                    <textarea id="lsn-new-root-cause" class="form-control" rows="3" placeholder="Detalla la condición observada, desgaste o causa raíz que motivó la mejora..." required></textarea>
                </div>
                <div class="form-group" style="margin-bottom:0;">
                    <label style="font-weight:700; font-size:12px; margin-bottom:4px; color:#059669;">🛠️ Acción Correctiva o Preventiva*</label>
                    <textarea id="lsn-new-corrective" class="form-control" rows="3" placeholder="Describe la solución técnica implementada, ajuste o estandarización..." required></textarea>
                </div>
            </div>

            <div class="form-group" style="margin-bottom:0; background:#FAF5FF; padding:12px; border-radius:8px; border:1px solid #E9D5FF;">
                <label style="font-weight:800; font-size:12px; margin-bottom:4px; color:#7C3AED; display:flex; align-items:center; gap:6px;">
                    <span>💡</span> <span>Lección Aprendida y Beneficio Clave*</span>
                </label>
                <textarea id="lsn-new-lesson" class="form-control" rows="3" placeholder="Explica el principio clave y recomendación para evitar recurrencias en otras áreas de la planta..." style="border-color:#C084FC;" required></textarea>
            </div>

            <div style="display:grid; grid-template-columns: 1fr 1fr; gap:12px;">
                <div class="form-group" style="margin-bottom:0;">
                    <label style="font-weight:700; font-size:12px; margin-bottom:4px;">Autor / Responsable*</label>
                    <input id="lsn-new-author" class="form-control" placeholder="Ej: Ing. Carlos Morales" required />
                </div>
                <div class="form-group" style="margin-bottom:0;">
                    <label style="font-weight:700; font-size:12px; margin-bottom:4px;">Evidencia Fotográfica (Opcional)</label>
                    <input type="file" id="lsn-new-photo-file" accept="image/*" class="form-control" style="font-size:12px;" />
                </div>
            </div>

            <div style="display:flex; justify-content:flex-end; gap:10px; margin-top:8px; padding-top:14px; border-top:1px solid var(--border-color);">
                <button type="button" class="tab-btn" onclick="closeNewLessonModal()" style="padding:8px 18px;">✕ Cancelar</button>
                <button type="submit" class="btn-primary" style="padding:8px 22px; font-weight:800; background:#7C3AED; border-color:#6D28D9; box-shadow:0 2px 4px rgba(124,58,237,0.25);">💡 Guardar Lección Aprendida</button>
            </div>
        </form>
    </div>
</div>
</body>
</html>
