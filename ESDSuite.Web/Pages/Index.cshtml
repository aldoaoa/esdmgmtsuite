@page
@model IndexModel
@{
    ViewData["Title"] = "esd360 - Compliance Platform";
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <title>esd360 - ANSI/ESD S20.20 & TR53 Compliance Platform</title>

    <!-- FAVICON & TAB ICONS -->
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/icon-192.png" />
    <link rel="shortcut icon" type="image/png" href="/favicon-32x32.png" />

    <!-- APPLE TOUCH ICON (iOS SAFARI & HOMESCREEN APP) -->
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- PWA & MOBILE WEB APP METADATA -->
    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#1E1B4B" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="esd360" />
    <meta name="application-name" content="esd360" />
    <meta name="msapplication-TileImage" content="/icon-512.png" />
    <meta name="msapplication-TileColor" content="#1E1B4B" />

    <link rel="stylesheet" href="~/css/site.css" />
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>
    <script src="https://unpkg.com/html5-qrcode"></script>
</head>
<body>

<div id="toast-container"></div>

<div id="app-container">

    <!-- LOGIN OVERLAY / SPLIT SCREEN LANDING HOME -->
    <div id="login-overlay" style="position:fixed; inset:0; z-index:9999; display:flex; align-items:center; justify-content:center; background:#F8FAFC; backdrop-filter:blur(10px); padding:20px; overflow-y:auto; -webkit-overflow-scrolling:touch;">
        <div style="width:960px; max-width:95vw; background:#FFFFFF; border-radius:20px; box-shadow:0 25px 60px -15px rgba(15, 23, 42, 0.18); border:1px solid #E2E8F0; overflow:hidden; display:flex; flex-wrap:wrap; position:relative;">
            
            <!-- DISCRETE LANGUAGE SELECTOR -->
            <div style="position:absolute; top:18px; right:20px; z-index:10; display:flex; align-items:center; gap:6px;">
                <span style="font-size:13px;">🌐</span>
                <select id="login-landing-lang-select" onchange="changeLanguage(this.value)" style="background:#F1F5F9; border:1px solid #CBD5E1; border-radius:8px; padding:5px 10px; font-size:12px; font-weight:700; color:#334155; cursor:pointer; font-family:var(--font-main);">
                    <option value="en">English (EN)</option>
                    <option value="es">Español (ES)</option>
                    <option value="de">Deutsch (DE)</option>
                    <option value="zh">中文 (ZH)</option>
                    <option value="it">Italiano (IT)</option>
                    <option value="ro">Română (RO)</option>
                </select>
            </div>

            <!-- LEFT COLUMN: LOGIN FORM -->
            <div style="flex:1; min-width:320px; padding:44px 38px; display:flex; flex-direction:column; justify-content:center;">
                <div style="margin-bottom:26px; text-align:center; display:flex; flex-direction:column; align-items:center;">
                    <img src="/images/esd360-logo.png" alt="esd360 Logo" style="height:64px; max-width:240px; width:auto; object-fit:contain; display:block; margin:0 auto 16px auto; filter:drop-shadow(0 4px 6px rgba(15, 23, 42, 0.06));" />
                    <h2 style="font-family:var(--font-heading); font-weight:800; font-size:24px; color:#0F172A; margin:0 0 6px 0;" data-i18n="login.heading">Sign In</h2>
                    <p style="font-size:13px; color:#64748B; margin:0; text-align:center;" data-i18n="login.access_sub">Access your account on the esd360 platform</p>
                </div>
                
                <form id="login-form" method="POST" action="/api/login" onsubmit="event.preventDefault(); return handleLoginSubmit(event);" autocomplete="on">
                    <div class="form-group" style="margin-bottom:16px;">
                        <label style="font-size:12px; font-weight:700; color:#334155; margin-bottom:6px; display:block;" data-i18n="login.email">Email Address</label>
                        <input type="email" id="login-email" name="email" autocomplete="username" class="form-control" placeholder="user@company.com" required value="" style="height:44px; font-size:13.5px;" />
                    </div>
                    <div class="form-group" style="margin-bottom:14px;">
                        <label style="font-size:12px; font-weight:700; color:#334155; margin-bottom:6px; display:block;" data-i18n="login.password">Password</label>
                        <input type="password" id="login-password" name="password" autocomplete="current-password" class="form-control" placeholder="••••••••" required value="" style="height:44px; font-size:13.5px;" />
                    </div>
                    <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:18px;">
                        <label style="display:flex; align-items:center; gap:8px; font-size:12px; font-weight:600; color:#475569; cursor:pointer; user-select:none;">
                            <input type="checkbox" id="login-remember" name="remember_me" value="true" checked style="width:16px; height:16px; accent-color:var(--primary); cursor:pointer;" />
                            <span data-i18n="login.remember_me">Mantener sesión iniciada en este equipo</span>
                        </label>
                    </div>
                    <div id="login-error" style="color:var(--accent-rose); font-size:12.5px; font-weight:600; margin-bottom:14px; display:none;"></div>
                    <button type="submit" class="btn-primary" style="width:100%; height:46px; font-size:14px; font-weight:700; border-radius:8px;" data-i18n="login.submit">🔒 Log In to esd360</button>
                </form>

                <script>
                    async function handleLoginSubmit(e) {
                        if (e && e.preventDefault) e.preventDefault();
                        const emailInput = document.getElementById('login-email');
                        const pwdInput = document.getElementById('login-password');
                        const email = emailInput ? emailInput.value.trim() : '';
                        const password = pwdInput ? pwdInput.value : '';
                        const rememberMe = document.getElementById('login-remember') ? document.getElementById('login-remember').checked : true;
                        const errDiv = document.getElementById('login-error');
                        const form = document.getElementById('login-form');
                        const submitBtn = form ? form.querySelector('button[type="submit"]') : null;

                        if (errDiv) errDiv.style.display = 'none';
                        if (submitBtn) {
                            submitBtn.disabled = true;
                            submitBtn.innerText = '⏳ Verificando credenciales...';
                        }

                        try {
                            const res = await fetch('/api/login', {
                                method: 'POST',
                                headers: { 
                                    'Content-Type': 'application/json',
                                    'Accept': 'application/json'
                                },
                                body: JSON.stringify({ email, password, remember_me: rememberMe })
                            });
                            const data = await res.json();
                            if (res.ok && data.success) {
                                if (window.PasswordCredential && navigator.credentials && navigator.credentials.store) {
                                    try {
                                        const cred = new PasswordCredential({
                                            id: email,
                                            password: password,
                                            name: email
                                        });
                                        await navigator.credentials.store(cred);
                                    } catch (cErr) {
                                        console.debug('[CredentialManager] Notice:', cErr);
                                    }
                                }

                                if (typeof checkSession === 'function') {
                                    await checkSession();
                                } else {
                                    window.location.href = '/';
                                }
                            } else {
                                if (errDiv) {
                                    errDiv.innerText = data.message ? ('❌ ' + data.message) : '❌ Credenciales incorrectas o cuenta inactiva.';
                                    errDiv.style.display = 'block';
                                }
                            }
                        } catch (ex) {
                            console.error('Login error:', ex);
                            if (errDiv) {
                                errDiv.innerText = '❌ Error de comunicación con el servidor al iniciar sesión.';
                                errDiv.style.display = 'block';
                            }
                        } finally {
                            if (submitBtn) {
                                submitBtn.disabled = false;
                                submitBtn.innerText = '🔒 Iniciar Sesión en esd360';
                            }
                        }
                        return false;
                    }

                    (function() {
                        try {
                            const params = new URLSearchParams(window.location.search);
                            if (params.has('login_error')) {
                                const err = params.get('login_error');
                                const errDiv = document.getElementById('login-error');
                                if (errDiv && err) {
                                    errDiv.innerText = '❌ ' + decodeURIComponent(err);
                                    errDiv.style.display = 'block';
                                }
                            }
                        } catch (e) {}
                    })();
                </script>

                <div style="margin-top:32px; padding-top:20px; border-top:1px solid #F1F5F9; font-size:11.5px; color:#94A3B8; text-align:center; display:flex; flex-direction:column; gap:6px; align-items:center;">
                    <div data-i18n="login.footer">esd360 &bull; Compliance ANSI/ESD S20.20 &bull; IEC 61340-5-1 &bull; ESD TR53</div>
                    <div style="display:inline-flex; align-items:center; gap:6px; font-weight:700; font-size:11px; color:var(--text-muted);">
                        <span>Version:</span>
                        <span id="login-version-badge" class="badge-pass" style="font-size:10px; padding:2px 7px; font-weight:800; background:var(--accent-blue-light); color:var(--accent-blue); border-color:rgba(37,99,235,0.2);">v2.10.0</span>
                    </div>
                </div>
            </div>

            <!-- RIGHT COLUMN: MARKETING BRAND HERO -->
            <div style="flex:1.15; min-width:340px; background:linear-gradient(135deg, #0F172A 0%, #1E1B4B 50%, #312E81 100%); padding:40px 36px; color:#FFFFFF; display:flex; flex-direction:column; justify-content:center; position:relative; overflow:hidden;">
                <div style="position:absolute; top:-60px; right:-60px; width:220px; height:220px; background:rgba(99, 102, 241, 0.15); border-radius:50%; filter:blur(40px); pointer-events:none;"></div>
                
                <h3 style="font-family:var(--font-heading); font-size:23px; font-weight:800; line-height:1.25; margin:0 0 10px 0; color:#FFFFFF;" data-i18n="login.title">
                    360° ESD Compliance & Control
                </h3>
                <p style="font-size:13px; line-height:1.55; color:#CBD5E1; margin:0 0 22px 0;" data-i18n="login.subtitle">
                    Comprehensive platform for digitization, traceability, and audit management in electronics manufacturing.
                </p>

                <div style="display:flex; flex-direction:column; gap:14px;">
                    <div style="display:flex; align-items:flex-start; gap:12px;">
                        <img src="/images/icons/icon-audit.svg" class="ui-icon-3d-lg" style="width:28px; height:28px;" alt="" />
                        <div>
                            <div style="font-weight:700; font-size:13px; color:#F8FAFC; margin-bottom:2px;" data-i18n="login.kpi1_title">ANSI/ESD S20.20 & IEC 61340-5-1 Compliance</div>
                            <div style="font-size:11.5px; color:#94A3B8; line-height:1.4;" data-i18n="login.kpi1_desc">Periodic verification and TR53 inspection automation in EPA areas.</div>
                        </div>
                    </div>

                    <div style="display:flex; align-items:flex-start; gap:12px;">
                        <img src="/images/icons/icon-event-meter.svg" class="ui-icon-3d-lg" style="width:28px; height:28px;" alt="" />
                        <div>
                            <div style="font-weight:700; font-size:13px; color:#F8FAFC; margin-bottom:2px;" data-i18n="login.kpi2_title">Metrology & Calibration Traceability</div>
                            <div style="font-size:11.5px; color:#94A3B8; line-height:1.4;" data-i18n="login.kpi2_desc">Expiration alerts and centralized control of instruments, grounds, and ionizers.</div>
                        </div>
                    </div>

                    <div style="display:flex; align-items:flex-start; gap:12px;">
                        <img src="/images/icons/icon-schedule.svg" class="ui-icon-3d-lg" style="width:28px; height:28px;" alt="" />
                        <div>
                            <div style="font-weight:700; font-size:13px; color:#F8FAFC; margin-bottom:2px;" data-i18n="login.kpi3_title">1-Click Auditable Reports</div>
                            <div style="font-size:11.5px; color:#94A3B8; line-height:1.4;" data-i18n="login.kpi3_desc">Immediate generation of digital files ready for customer audits.</div>
                        </div>
                    </div>

                    <div style="display:flex; align-items:flex-start; gap:12px;">
                        <img src="/images/icons/icon-companies.svg" class="ui-icon-3d-lg" style="width:28px; height:28px;" alt="" />
                        <div>
                            <div style="font-weight:700; font-size:13px; color:#F8FAFC; margin-bottom:2px;" data-i18n="login.kpi4_title">Multi-Plant & Line Visibility</div>
                            <div style="font-size:11.5px; color:#94A3B8; line-height:1.4;" data-i18n="login.kpi4_desc">Compliance status monitoring at production line and corporate level.</div>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>

    <!-- MOBILE SIDEBAR BACKDROP -->
    <div id="sidebar-backdrop" class="sidebar-backdrop" onclick="closeMobileSidebar()"></div>

    <!-- SIDEBAR NAVIGATION -->
    <aside class="sidebar" id="app-sidebar">
        <div class="sidebar-brand" style="padding:16px 14px; display:flex; align-items:center; justify-content:center; text-align:center;">
            <img id="sidebar-brand-logo" src="/images/esd360-logo.png" alt="esd360" style="height:46px; max-width:85%; width:auto; object-fit:contain; display:block; margin:0 auto; filter:drop-shadow(0 2px 4px rgba(15, 23, 42, 0.08));" />
        </div>

        <div class="sidebar-category" data-i18n="sidebar.cat_monitoring">MONITOREO & MÉTRICAS</div>
        <div id="nav-dashboard" class="nav-item active" onclick="switchModule('dashboard')">
            <span class="icon"><img src="/images/icons/icon-dashboard.svg" class="sidebar-icon-img" alt="" /></span> <span data-i18n="nav.dashboard">Dashboard Overview</span>
        </div>

        <div class="sidebar-category" data-i18n="sidebar.cat_verification">VERIFICACIÓN Y PISO</div>
        <div id="nav-audit" class="nav-item" onclick="switchModule('audit')">
            <span class="icon"><img src="/images/icons/icon-audit.svg" class="sidebar-icon-img" alt="" /></span> <span data-i18n="nav.audit">Auditoría en Piso (TR53)</span>
        </div>
        <div id="nav-eventmeter" class="nav-item" onclick="switchModule('eventmeter')">
            <span class="icon"><img src="/images/icons/icon-event-meter.svg" class="sidebar-icon-img" alt="" /></span> <span data-i18n="nav.eventmeter">Event Meter (Eventos ESD)</span>
        </div>
        <div id="nav-infra" class="nav-item" onclick="switchModule('infra')">
            <span class="icon"><img src="/images/icons/icon-infra.svg" class="sidebar-icon-img" alt="" /></span> <span data-i18n="nav.infra">Infraestructura EPA</span>
        </div>
        <div id="nav-schedule" class="nav-item" onclick="switchModule('schedule')">
            <span class="icon"><img src="/images/icons/icon-schedule.svg" class="sidebar-icon-img" alt="" /></span> <span data-i18n="nav.schedule">Cronograma & Reportes</span>
        </div>
        <div id="nav-findings" class="nav-item" onclick="switchModule('findings')">
            <span class="icon"><img src="/images/icons/icon-checklist.svg" class="sidebar-icon-img" alt="" onerror="this.src='/images/icons/icon-event-meter.svg'" /></span>
            <span data-i18n="nav.findings">Gestión de Hallazgos</span>
            <span id="badge-open-findings" style="background:#EF4444; color:#fff; font-size:10px; font-weight:800; border-radius:10px; padding:2px 7px; margin-left:auto; display:none;">0</span>
        </div>

        <div class="sidebar-category" data-i18n="sidebar.cat_assets">ACTIVOS & CAPACITACIÓN</div>
        <div id="nav-inventory" class="nav-item" onclick="switchModule('inventory')">
            <span class="icon"><img src="/images/icons/icon-inventory.svg" class="sidebar-icon-img" alt="" /></span> <span data-i18n="nav.inventory">Directorio de Activos</span>
        </div>
        <div id="nav-validation" class="nav-item" onclick="switchModule('validation')">
            <span class="icon"><img src="/images/icons/icon-lab.svg" class="sidebar-icon-img" alt="" /></span> <span data-i18n="nav.validation">Validación de Elementos ESD</span>
        </div>
        <div id="nav-training" class="nav-item" onclick="switchModule('training')">
            <span class="icon"><img src="/images/icons/icon-training.svg" class="sidebar-icon-img" alt="" /></span> <span data-i18n="nav.training">Exámenes & Certificación</span>
        </div>

        <div class="sidebar-category" data-i18n="sidebar.cat_config">CONFIGURACIÓN</div>
        <div id="nav-settings" class="nav-item" onclick="switchModule('settings')">
            <span class="icon"><img src="/images/icons/icon-settings.svg" class="sidebar-icon-img" alt="" /></span> <span data-i18n="nav.settings">Settings</span>
        </div>

        <div style="margin-top: auto; padding-top: 14px; border-top: 1px solid var(--border-color); display:flex; flex-direction:column; gap:8px;">
            <div class="nav-item" onclick="logout()" style="color: var(--accent-rose);">
                <span class="icon"><img src="/images/icons/icon-logout.svg" class="sidebar-icon-img" alt="" /></span> <span data-i18n="auth.logout">Cerrar Sesión</span>
            </div>
            <div style="padding:8px 10px; background:#F8FAFC; border:1px solid var(--border-color); border-radius:7px; display:flex; align-items:center; justify-content:space-between;">
                <div>
                    <div style="font-family:var(--font-heading); font-weight:700; font-size:11px; color:var(--text-primary);" data-i18n="sidebar.platform">esd360 Enterprise Platform</div>
                    <div style="font-size:10px; color:var(--text-muted);">ANSI/ESD S20.20</div>
                </div>
                <span id="system-version-badge" class="badge-pass" style="font-size:10px; padding:2px 7px; font-weight:800; background:var(--accent-blue-light); color:var(--accent-blue); border-color:rgba(37,99,235,0.2);">v2.10.0</span>
            </div>
        </div>
    </aside>

    <!-- MAIN CONTENT -->
    <main class="main-content">

        <!-- TOP HEADER -->
        <header class="top-header">
            <div style="display:flex; align-items:center; gap:12px;">
                <button type="button" id="sidebar-toggle-btn" class="mobile-menu-btn" onclick="toggleMobileSidebar()" aria-label="Toggle Navigation">
                    <span>☰</span>
                </button>
                <div class="header-title">
                    <h2 id="header-module-title" data-i18n="dashboard.title">Dashboard Overview</h2>
                    <p id="header-module-subtitle" data-i18n="dashboard.subtitle">Métricas generales del sistema y estado de cumplimiento normativo</p>
                </div>
            </div>
            <div class="header-actions">
                <div id="site-selector-container" class="site-badge">
                    <img src="/images/icons/icon-companies.svg" class="ui-icon-3d-sm" alt="" />
                    <span data-i18n="header.site_lbl">Site:</span>
                    <select id="active-site-select" onchange="changeActiveSite(this.value)" style="background:transparent; border:none; color:inherit; font-weight:700; cursor:pointer;">
                        <option value="">Cargando Sites...</option>
                    </select>
                </div>
                <div class="user-profile">
                    <div class="avatar" id="user-avatar-initials">U</div>
                    <div style="font-size: 12.5px;">
                        <div id="user-display-name" style="font-weight: 700;">Usuario</div>
                        <div id="user-display-role" style="font-size:10.5px; color:var(--text-muted);">AUDITOR</div>
                    </div>
                </div>
            </div>
        </header>

        <!-- VIEW CONTAINER -->
        <div class="view-container">

            <!-- MODULE 1: DASHBOARD -->
            <div id="mod-dashboard" class="module-view">
                <div class="metrics-grid">
                    <div class="glass-card metric-card">
                        <div class="metric-info">
                            <h4 data-i18n="dashboard.kpi_total_assets">Total Activos ESD</h4>
                            <div class="value" id="dash-total-assets">0</div>
                        </div>
                        <div class="metric-icon" style="background:transparent; padding:0;"><img src="/images/icons/icon-inventory.svg" class="ui-icon-3d-lg" alt="" /></div>
                    </div>
                    <div class="glass-card metric-card">
                        <div class="metric-info">
                            <h4 data-i18n="dashboard.kpi_floor_verifications">Verificaciones Piso</h4>
                            <div class="value" id="dash-total-floors">0</div>
                        </div>
                        <div class="metric-icon" style="background:transparent; padding:0;"><img src="/images/icons/icon-infra.svg" class="ui-icon-3d-lg" alt="" /></div>
                    </div>
                    <div class="glass-card metric-card">
                        <div class="metric-info">
                            <h4 data-i18n="dashboard.kpi_grounding">Tierras Auditadas</h4>
                            <div class="value" id="dash-total-grounding">0</div>
                        </div>
                        <div class="metric-icon" style="background:transparent; padding:0;"><img src="/images/icons/icon-event-meter.svg" class="ui-icon-3d-lg" alt="" /></div>
                    </div>
                    <div class="glass-card metric-card">
                        <div class="metric-info">
                            <h4 data-i18n="dashboard.kpi_entrance">Checadores Entrada</h4>
                            <div class="value" id="dash-total-entrance">0</div>
                        </div>
                        <div class="metric-icon" style="background:transparent; padding:0;"><img src="/images/icons/icon-checkers.svg" class="ui-icon-3d-lg" alt="" /></div>
                    </div>
                </div>

                <div class="glass-panel">
                    <h3 style="margin-bottom: 14px; font-weight:700; display:flex; align-items:center; gap:8px;">
                        <img src="/images/icons/icon-dashboard.svg" class="ui-icon-3d" alt="" />
                        <span data-i18n="dashboard.chart_title">Cumplimiento Operativo por Categoría de Activo</span>
                    </h3>
                    <div style="height: 300px; position:relative; width:100%;">
                        <canvas id="dashboardChart"></canvas>
                    </div>
                </div>
            </div>

            <!-- MODULE 2: AUDIT & VERIFICATION WITH LIGHTWEIGHT QR SCANNER -->
            <div id="mod-audit" class="module-view" style="display:none;">
                <div style="display:grid; grid-template-columns: 1fr 1fr; gap: 20px;">

                    <!-- LEFT COLUMN: LIGHTWEIGHT CAMERA QR SCANNER & MANUAL SEARCH -->
                    <div class="glass-panel">
                        <h3 style="margin-bottom: 4px; display:flex; align-items:center; gap:8px;">
                            <img src="/images/icons/icon-qr.svg" class="ui-icon-3d" alt="" />
                            <span data-i18n="audit.lbl_scan">Escanear Código QR del Activo</span>
                        </h3>
                        <p style="font-size:12px; color:var(--text-muted); margin-bottom:14px;" data-i18n="audit.scan_sub">Lente principal activado por defecto. Cambio rápido entre cámaras.</p>

                        <div id="qr-reader-wrapper" style="width:100%; border-radius:10px; overflow:hidden; border:2px solid var(--accent-blue); background:#F8FAFC; min-height:240px; position:relative;">
                            <div id="qr-reader" style="width:100%;"></div>
                        </div>

                        <div style="display:flex; justify-content:center; gap:6px; margin-top:12px; flex-wrap:wrap;">
                            <button type="button" class="tab-btn active" id="btn-cam-standard" onclick="startScannerStandard()" data-i18n="audit.btn_cam_std">📸 LENTE ESTÁNDAR</button>
                            <button type="button" class="tab-btn" id="btn-cam-cycle" onclick="cycleCamera()" data-i18n="audit.btn_cam_cycle">🔄 OTRA CÁMARA</button>
                        </div>
