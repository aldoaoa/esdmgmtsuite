            'PENDING_VERIFICATION': `<span style="background:#EDE9FE; color:#7C3AED; padding:3px 8px; border-radius:12px; font-weight:800; font-size:11px;">🟣 Verificación</span>`,
            'CLOSED': `<span style="background:#D1FAE5; color:#059669; padding:3px 8px; border-radius:12px; font-weight:800; font-size:11px;">🟢 Cerrado</span>`
        };

        let html = '';
        findings.forEach(f => {
            const code = f.tracking_code || f.tracker_code || f.id;
            const sev = getSeverityBadgeInfo(f.severity);
            const statusKey = (f.status || 'OPEN').toUpperCase();
