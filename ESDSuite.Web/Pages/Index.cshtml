                    <img src="${item.evidence_url}" alt="Evidencia" style="width:38px; height:38px; object-fit:cover; border-radius:4px; border:1px solid #CBD5E1;" />
                    <span style="font-size:11px; font-weight:700; color:#2563EB;">📷 Ver Evidencia Fotográfica</span>
                </div>` : '';

