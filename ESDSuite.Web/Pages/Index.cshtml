    // --- GARMENTS (ANSI/ESD STM2.1 / S20.20) MANAGEMENT ---
    function formatScientificVal(val) {
        if (val === null || val === undefined || isNaN(val)) return 'N/D';
        const num = parseFloat(val);
        if (num >= 1e4 || (num > 0 && num < 1e-2)) {
            return num.toExponential(2).toUpperCase();
        }
        return num.toLocaleString();
    }

    function escapeHtml(str) {
        if (!str) return '';
        return String(str).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;').replace(/'/g, '&#039;');
    }

    let allGarmentsData = [];
    let currentGarmentCategoryFilter = 'all';

    async function loadGarmentsCatalog() {
        const siteId = (sessionData && sessionData.site_id) || '';
        const tbody = document.getElementById('garments-table-body');
        if (tbody) tbody.innerHTML = '<tr><td colspan="9" style="text-align:center; padding:30px; color:var(--text-muted);">⏳ Cargando prendas y vestimenta ESD...</td></tr>';

        try {
            const res = await fetch(`/api/garments?siteId=${encodeURIComponent(siteId)}`);
            if (res.ok) {
                allGarmentsData = await res.json();
                renderGarmentsKPIs();
                filterGarmentsList();
            }
        } catch(e) {
            console.error('Error loading garments:', e);
            if (tbody) tbody.innerHTML = '<tr><td colspan="9" style="text-align:center; padding:20px; color:var(--accent-rose);">❌ Error al cargar vestimenta ESD.</td></tr>';
        }
    }

    function renderGarmentsKPIs() {
        const total = allGarmentsData.length;
        const smocks = allGarmentsData.filter(g => (g.category || '').toLowerCase().includes('bata')).length;
        const footwear = allGarmentsData.filter(g => (g.category || '').toLowerCase().includes('calzado')).length;
        const others = allGarmentsData.filter(g => {
            const c = (g.category || '').toLowerCase();
            return c.includes('guante') || c.includes('gorra');
        }).length;

        const passed = allGarmentsData.filter(g => (g.estatus || '').toUpperCase().includes('CUMPLE') || (g.estatus || '').toUpperCase().includes('VIGENTE')).length;
        const failed = allGarmentsData.filter(g => (g.estatus || '').toUpperCase().includes('NO CUMPLE') || (g.estatus || '').toUpperCase().includes('RECHAZADO')).length;
        const compliancePct = total > 0 ? Math.round((passed / total) * 100) : 100;

        const elTot = document.getElementById('kpi-garments-total');
        const elSmk = document.getElementById('kpi-garments-smocks');
        const elFoot = document.getElementById('kpi-garments-footwear');
        const elOth = document.getElementById('kpi-garments-others');
        const elComp = document.getElementById('kpi-garments-compliance');
        const elStat = document.getElementById('kpi-garments-status-detail');

        if (elTot) elTot.innerText = total;
        if (elSmk) elSmk.innerText = smocks;
        if (elFoot) elFoot.innerText = footwear;
        if (elOth) elOth.innerText = others;
        if (elComp) elComp.innerText = `${compliancePct}%`;
        if (elStat) elStat.innerText = failed > 0 ? `${failed} No Cumple / Vencido` : '100% Conforme';
    }

    function setGarmentCategoryFilter(cat) {
        currentGarmentCategoryFilter = cat;
        document.querySelectorAll('#val-subview-garments [id^="gar-filter-cat-"]').forEach(btn => btn.classList.remove('active'));
        
        const targetBtn = document.getElementById(
            cat === 'all' ? 'gar-filter-cat-all' :
            cat === 'Bata' ? 'gar-filter-cat-smock' :
            cat === 'Calzado' ? 'gar-filter-cat-footwear' :
            cat === 'Guantes' ? 'gar-filter-cat-gloves' : 'gar-filter-cat-headwear'
        );
        if (targetBtn) targetBtn.classList.add('active');

        // Show/hide STM2.1 classification filter dropdown if Bata is active
        const classFilter = document.getElementById('gar-classification-filter');
        if (classFilter) {
            classFilter.style.display = (cat === 'Bata' || cat === 'all') ? 'inline-block' : 'none';
        }

        filterGarmentsList();
    }

    function filterGarmentsList() {
        const q = (document.getElementById('gar-search-input')?.value || '').trim().toLowerCase();
        const classFilter = (document.getElementById('gar-classification-filter')?.value || '').trim().toLowerCase();
        const statusFilter = (document.getElementById('gar-status-filter')?.value || '').trim().toUpperCase();

        const filtered = allGarmentsData.filter(g => {
            // Category filter
            if (currentGarmentCategoryFilter !== 'all') {
                const gCat = (g.category || '').toLowerCase();
                if (!gCat.includes(currentGarmentCategoryFilter.toLowerCase())) return false;
            }

            // Classification filter
            if (classFilter) {
                const gClass = (g.classification || '').toLowerCase();
                if (!gClass.includes(classFilter)) return false;
            }

            // Status filter
            if (statusFilter) {
                const gStat = (g.estatus || '').toUpperCase();
                if (!gStat.includes(statusFilter)) return false;
            }

            // Search query
            if (q) {
                const id = (g.id || '').toLowerCase();
                const empName = (g.nombre_empleado || '').toLowerCase();
                const empNum = (g.num_empleado || '').toLowerCase();
                const dept = (g.departamento || '').toLowerCase();
                const classification = (g.classification || '').toLowerCase();
                if (!id.includes(q) && !empName.includes(q) && !empNum.includes(q) && !dept.includes(q) && !classification.includes(q)) {
                    return false;
                }
            }

            return true;
        });

        renderGarmentsTable(filtered);
    }

    function renderGarmentsTable(items) {
