    async function deleteEquipment(id) {
        if (!confirm('¿Estás seguro de eliminar este equipo de medición?')) return;
        const res = await fetch(`/api/equipment/${id}`, { method: 'DELETE' });
        const data = await res.json();
        if (data.success) {
            showToast('✅ Equipo eliminado correctamente.');
            loadEquipmentTable();
        } else {
            showToast('❌ Error al eliminar el equipo.', 'error');
        }
    }

    let expandedTreeNodes = new Set();

    function showToast(msg, type = 'success') {
        const container = document.getElementById('toast-container');
        if (!container) return;
        const toast = document.createElement('div');
        toast.className = `toast-msg toast-${type}`;
        toast.innerHTML = msg;
        container.appendChild(toast);
        setTimeout(() => {
            toast.style.opacity = '0';
            toast.style.transition = 'opacity 0.3s ease';
            setTimeout(() => toast.remove(), 300);
        }, 2200);
    }

    async function loadHierarchyTree() {
        const container = document.getElementById('multi-tenant-tree');
        try {
            const res = await fetch('/api/hierarchy');
            if (!res.ok) {
                container.innerHTML = `<p style="font-size:12.5px; color:var(--accent-rose);">❌ Error al cargar jerarquía desde el servidor.</p>`;
                return;
            }
            const tree = await res.json();
            
            if (!tree || tree.length === 0) {
                container.innerHTML = `<p style="font-size:12.5px; color:var(--text-muted);">No hay empresas o sites registrados aún.</p>`;
                return;
            }

            const canCreateSite = sessionData && sessionData.can_create_site;
            const canCreateArea = sessionData && sessionData.can_create_area;

            let html = '';
            tree.forEach((comp, cIdx) => {
                const compId = `comp-children-${cIdx}`;
                const sites = comp.sites || [];
                const safeCompName = (comp.name || '').replace(/'/g, "\\'");
                const isCompOpen = expandedTreeNodes.has(compId) ? ' open' : '';
                
                html += `<div class="tree-node">
                    <div class="tree-header" onclick="toggleTreeNode('${compId}')">
                        <span style="display:inline-flex; align-items:center; gap:6px;"><img src="/images/icons/icon-companies.png" class="ui-icon-3d-sm" alt="" /> <b>${comp.name}</b> <span style="font-size:11px; color:var(--text-muted); font-weight:400;">(${sites.length} Sites)</span></span>
                        <div style="display:flex; align-items:center; gap:8px;">
                            ${canCreateSite ? `<button type="button" class="tree-action-btn" title="Agregar Site a esta Empresa" onclick="event.stopPropagation(); showAddSiteForCompanyModal('${comp.id}', '${safeCompName}', '${compId}')">➕ Site</button>` : ''}
                            <span style="font-size:11px;">▶️</span>
                        </div>
                    </div>
                    <div class="tree-children${isCompOpen}" id="${compId}">`;

                if (sites.length === 0) {
                    html += `<div class="tree-leaf"><i>Sin sites registrados en esta empresa.</i></div>`;
                } else {
                    sites.forEach((site, sIdx) => {
                        const siteId = `site-children-${cIdx}-${sIdx}`;
                        const locs = site.locations || [];
                        const safeSiteName = (site.name || '').replace(/'/g, "\\'");
                        const isSiteOpen = expandedTreeNodes.has(siteId) ? ' open' : '';

                        html += `<div style="margin:4px 0;">
                            <div class="tree-subnode" onclick="toggleTreeNode('${siteId}')">
                                <span style="display:inline-flex; align-items:center; gap:6px;"><img src="/images/icons/icon-companies.png" class="ui-icon-3d-sm" style="width:15px; height:15px;" alt="" /> <b>${site.name}</b> <span style="font-size:11px; color:var(--text-muted);">(${locs.length} Áreas/Líneas)</span></span>
                                <div style="display:flex; align-items:center; gap:8px;">
                                    ${canCreateArea ? `<button type="button" class="tree-action-btn" title="Agregar Área a este Site" onclick="event.stopPropagation(); showAddAreaForSiteModal('${site.id}', '${safeSiteName}', '${compId}', '${siteId}')">➕ Área / Línea</button>` : ''}
                                    <span style="font-size:10px;">▶️</span>
                                </div>
                            </div>
                            <div class="tree-children${isSiteOpen}" id="${siteId}">`;

                        if (locs.length === 0) {
                            html += `<div class="tree-leaf" style="justify-content:space-between;">
                                <span><img src="/images/icons/icon-routes.png" class="ui-icon-3d-sm" alt="" /> <i>Sin áreas registradas en este site.</i></span>
                            </div>`;
                        } else {
                            const areaGroupMap = {};
                            locs.forEach(loc => {
                                if (loc.includes(' -> ')) {
                                    const parts = loc.split(' -> ');
                                    const parent = parts[0].trim();
                                    const child = parts.slice(1).join(' -> ').trim();
                                    if (!areaGroupMap[parent]) areaGroupMap[parent] = [];
                                    if (child && !areaGroupMap[parent].includes(child)) {
                                        areaGroupMap[parent].push(child);
                                    }
                                } else {
                                    if (!areaGroupMap[loc]) areaGroupMap[loc] = [];
                                }
                            });

                            Object.keys(areaGroupMap).forEach(areaName => {
                                const subOps = areaGroupMap[areaName];
                                const safeAreaName = (areaName || '').replace(/'/g, "\\'");

                                html += `<div class="area-card-box">
                                    <div class="area-header">
                                        <span style="display:inline-flex; align-items:center; gap:6px;"><img src="/images/icons/icon-routes.png" class="ui-icon-3d-sm" alt="" /> <b>${areaName}</b> ${subOps.length > 0 ? `<span style="font-size:11px; color:var(--text-muted); font-weight:400;">(${subOps.length} Sub-operaciones)</span>` : ''}</span>
                                        ${canCreateArea ? `<button type="button" class="tree-action-btn" style="padding:2px 8px; font-size:10.5px;" title="Agregar Operación a ${safeAreaName}" onclick="event.stopPropagation(); showAddSubOperationModal('${site.id}', '${safeAreaName}', '${compId}', '${siteId}')">➕ Operación</button>` : ''}
                                    </div>`;

                                if (subOps.length > 0) {
                                    html += `<div class="sub-ops-container">`;
                                    subOps.forEach(sub => {
                                        html += `<div class="sub-op-item">
                                            <span style="display:inline-flex; align-items:center; gap:6px;"><img src="/images/icons/icon-machinery.png" class="ui-icon-3d-sm" alt="" /> <b>${sub}</b></span>
                                            <span style="font-size:10.5px; color:var(--text-muted); font-weight:600;">Operación</span>
                                        </div>`;
                                    });
                                    html += `</div>`;
                                }

                                html += `</div>`;
                            });
                        }
                        html += `</div></div>`;
                    });
                }
                html += `</div></div>`;
            });

            container.innerHTML = html;
        } catch (ex) {
            console.log('Error loading hierarchy:', ex);
            container.innerHTML = `<p style="font-size:12.5px; color:var(--accent-rose);">❌ Error de conexión al cargar la estructura.</p>`;
        }
    }

    function toggleTreeNode(id) {
        const el = document.getElementById(id);
        if (el) {
            el.classList.toggle('open');
            if (el.classList.contains('open')) {
                expandedTreeNodes.add(id);
            } else {
                expandedTreeNodes.delete(id);
            }
        }
    }

    async function loadCompaniesAndSitesSelects() {
        const cRes = await fetch('/api/companies');
        allCompanies = await cRes.json();

        const sRes = await fetch('/api/sites');
        allSites = await sRes.json();

        const cSel = document.getElementById('u-company-select');
        cSel.innerHTML = '<option value="">Selecciona Empresa...</option>';
        allCompanies.forEach(c => {
            cSel.innerHTML += `<option value="${c.id}">${c.name}</option>`;
        });

        filterSitesForUserForm('');
    }

    function filterSitesForUserForm(companyId) {
        const sSel = document.getElementById('u-site-select');
        sSel.innerHTML = '<option value="">Selecciona Site...</option>';
        
        const filtered = companyId ? allSites.filter(s => s.company_id === companyId) : allSites;
        filtered.forEach(s => {
            sSel.innerHTML += `<option value="${s.id}">${s.name}</option>`;
        });
    }

    async function showAddCompanyModal() {
        const name = prompt("Ingrese el nombre de la Nueva Empresa (Corporativo):");
        if (!name || !name.trim()) return;

        const res = await fetch('/api/companies', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ name: name.trim(), is_active: true })
        });
        const data = await res.json();
        if (data.success) {
            showToast(`✅ Empresa "${name.trim()}" registrada en Supabase.`);
            loadSettings();
        } else {
            showToast('❌ ' + (data.message || 'Error al crear la empresa.'), 'error');
        }
    }

    async function showAddSiteForCompanyModal(companyId, companyName, parentCompNodeId) {
        if (parentCompNodeId) expandedTreeNodes.add(parentCompNodeId);
        const siteName = prompt(`Ingrese el nombre del Nuevo Site / Planta para "${companyName}":`);
        if (!siteName || !siteName.trim()) return;

        const res = await fetch('/api/sites', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                company_id: companyId,
                name: siteName.trim(),
                timezone: "America/Mexico_City"
            })
        });
        const data = await res.json();
        if (data.success) {
            showToast(`✅ Site "${siteName.trim()}" registrado en Supabase.`);
            loadSettings();
        } else {
            showToast('❌ ' + (data.message || 'Error al crear el Site.'), 'error');
        }
    }

    async function showAddAreaForSiteModal(siteId, siteName, parentCompNodeId, parentSiteNodeId) {
        if (parentCompNodeId) expandedTreeNodes.add(parentCompNodeId);
        if (parentSiteNodeId) expandedTreeNodes.add(parentSiteNodeId);

        const areaName = prompt(`Ingrese el nombre de la Nueva Área / Línea de Producción para "${siteName}":`);
        if (!areaName || !areaName.trim()) return;

        const res = await fetch('/api/lines', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                site_id: siteId,
                nombre_linea: areaName.trim()
            })
        });
        const data = await res.json();
        if (data.success) {
            showToast(`✅ Área / Línea "${areaName.trim()}" registrada en Supabase.`);
            loadSettings();
        } else {
            showToast('❌ ' + (data.message || 'Error al crear el Área / Línea.'), 'error');
        }
    }

    async function showAddSubOperationModal(siteId, areaName, parentCompNodeId, parentSiteNodeId) {
        if (parentCompNodeId) expandedTreeNodes.add(parentCompNodeId);
        if (parentSiteNodeId) expandedTreeNodes.add(parentSiteNodeId);

        const opName = prompt(`Ingrese el nombre de la Operación / Sub-área para "${areaName}":`);
        if (!opName || !opName.trim()) return;

        const fullName = `${areaName} -> ${opName.trim()}`;
        const res = await fetch('/api/lines', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                site_id: siteId,
                nombre_linea: fullName
            })
        });
        const data = await res.json();
        if (data.success) {
            showToast(`✅ Operación "${opName.trim()}" agregada a "${areaName}" en Supabase.`);
            loadSettings();
        } else {
            showToast('❌ ' + (data.message || 'Error al crear la Operación.'), 'error');
        }
    }

    async function showAddSiteModal() {
        if (!allCompanies || allCompanies.length === 0) {
            alert("Primero debes registrar una Empresa.");
            return;
        }

        const compNameList = allCompanies.map((c, i) => `${i + 1}. ${c.name}`).join('\n');
        const compIdx = prompt(`Selecciona el número de la Empresa a la que pertenecerá el Site:\n${compNameList}`);
        if (!compIdx) return;
        const idx = parseInt(compIdx) - 1;
        if (isNaN(idx) || idx < 0 || idx >= allCompanies.length) {
            alert("Selección inválida.");
            return;
        }

        const selectedCompany = allCompanies[idx];
        showAddSiteForCompanyModal(selectedCompany.id, selectedCompany.name);
    }

    // --- USER MANAGEMENT & ROLE PERMISSION BADGES ---
    async function loadUsersTable() {
        const res = await fetch('/api/users');
        const users = await res.json();
        const tbody = document.getElementById('users-table-body');
        tbody.innerHTML = '';

        if (!users || users.length === 0) {
            tbody.innerHTML = '<tr><td colspan="5" style="text-align:center;">Sin usuarios registrados.</td></tr>';
            return;
        }

        users.forEach(u => {
            const role = u.role || 'Auditor';
            let roleBadgeClass = 'badge-pass';
            if (role === 'SuperAdmin') roleBadgeClass = 'badge-pending';
            if (role === 'CompanyAdmin') roleBadgeClass = 'badge-pass';
            if (role === 'Viewer') roleBadgeClass = 'badge-fail';

            const compObj = u.companies || allCompanies.find(c => c.id === u.company_id);
            const compName = compObj ? compObj.name : 'Corporativo Global';

            const siteObj = u.sites || allSites.find(s => s.id === u.site_id);
            const siteName = siteObj ? siteObj.name : 'Todos / Global';

            tbody.innerHTML += `<tr>
                <td>
                    <b>${u.full_name || 'Usuario'}</b>
                    <div style="font-size:11px; color:var(--text-muted);">${u.email}</div>
                </td>
                <td><span class="${roleBadgeClass}">${role}</span></td>
                <td><b>${compName}</b></td>
                <td>${siteName}</td>
                <td>
                    <button type="button" class="btn-primary" style="background:var(--accent-rose); padding:4px 8px; font-size:11px;" onclick="deleteUser('${u.id}')">🗑️ Eliminar</button>
                </td>
            </tr>`;
        });
    }

    document.getElementById('form-create-user').onsubmit = async function(e) {
        e.preventDefault();
        const email = document.getElementById('u-email').value.trim();
        const full_name = document.getElementById('u-fullname').value.trim();
        const password = document.getElementById('u-password').value;
        const role = document.getElementById('u-role').value;
        const company_id = document.getElementById('u-company-select').value || null;
        const site_id = document.getElementById('u-site-select').value || null;

        const res = await fetch('/api/users', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                email,
                full_name,
                password,
                role,
                company_id,
                site_id,
                is_active: true
            })
        });
        const data = await res.json();
        if (data.success) {
            alert(`✅ Usuario "${full_name}" con rol "${role}" creado con éxito.`);
            document.getElementById('form-create-user').reset();
            loadUsersTable();
        } else {
            alert('❌ Error al crear el usuario.');
        }
    };

    async function deleteUser(userId) {
        if (!confirm('¿Estás seguro de que deseas eliminar este usuario?')) return;
        const res = await fetch(`/api/users/${userId}`, { method: 'DELETE' });
        const data = await res.json();
        if (data.success) {
            alert('✅ Usuario eliminado.');
            loadUsersTable();
        }
    }
</script>
