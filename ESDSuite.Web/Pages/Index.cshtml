    function populateValidationElements() {
        const sel = document.getElementById('val-elemento-sel');
        if (!sel) return;
        const currentVal = sel.value;
        sel.innerHTML = '';
        Object.keys(INFO_ELEMENTOS_ESD_DEF).forEach(canonicalKey => {
            const opt = document.createElement('option');
            opt.value = canonicalKey;
            const translated = t(`validation.elements.${canonicalKey}`, canonicalKey);
            opt.textContent = translated;
            if (currentVal === canonicalKey) opt.selected = true;
            sel.appendChild(opt);
        });

        if (sel.options.length > 0 && !currentVal) {
            onValElementoChange(sel.options[0].value);
        }
    }

