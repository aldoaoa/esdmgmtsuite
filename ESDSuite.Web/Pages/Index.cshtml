    function updateIsoPointBadge(idx) {
        const voltInput = document.getElementById(`iso-pt-volt-${idx}`);
        const badge = document.getElementById(`iso-pt-badge-${idx}`);
        if (!voltInput || !badge) return;

        const valStr = voltInput.value.trim();
        if (valStr === '') {
            badge.style.display = 'none';
            return;
        }

        const v = parseFloat(valStr);
        badge.style.display = 'inline-block';
        if (isNaN(v)) {
            badge.className = 'badge-pending';
            badge.innerText = 'Inválido';
        } else if (v >= -35.0 && v <= 35.0) {
            badge.className = 'badge-pass';
            badge.innerText = `🟢 PASS (${v > 0 ? '+' : ''}${v} V)`;
        } else {
            badge.className = 'badge-fail';
            badge.innerText = `🔴 FAIL (${v > 0 ? '+' : ''}${v} V / Fuera de ±35V)`;
        }
    }

