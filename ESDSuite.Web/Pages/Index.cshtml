                <div>No se encontraron prendas o vestimenta ESD con los filtros seleccionados.</div>
            </td></tr>`;
            return;
        }

        items.forEach(g => {
            const isPass = (g.estatus || '').toUpperCase().includes('CUMPLE') || (g.estatus || '').toUpperCase().includes('VIGENTE');
            const isFail = (g.estatus || '').toUpperCase().includes('NO CUMPLE') || (g.estatus || '').toUpperCase().includes('RECHAZADO');
            
            const badgeClass = isPass ? 'badge-pass' : isFail ? 'badge-fail' : 'badge-warn';
            const statusLabel = g.estatus || 'VIGENTE';

            const measuredDisplay = (g.valor_resistencia !== undefined && g.valor_resistencia !== null) ?
                formatScientificVal(g.valor_resistencia) + ' &Omega;' : 'Pendiente';

            const limitDisplay = g.limite_texto || (g.limite_referencia ? `&le; ${formatScientificVal(g.limite_referencia)} &Omega;` : 'Normativo');

            const itemEscaped = encodeURIComponent(JSON.stringify(g));

            tbody.innerHTML += `
                <tr style="transition:background 0.15s ease;">
                    <td style="font-family:var(--font-mono); font-weight:800; color:var(--accent-blue);">
                        ${escapeHtml(g.id || 'N/A')}
                    </td>
                    <td>
                        <div style="font-weight:700; color:var(--text-primary); display:flex; align-items:center; gap:6px;">
                            ${getGarmentIcon(g.category)} ${escapeHtml(g.category || 'Bata')}
                        </div>
                        <div style="font-size:11px; color:var(--text-muted); margin-top:2px;">
                            ${escapeHtml(g.classification || 'ANSI/ESD STM2.1')}
                        </div>
                    </td>
                    <td>
                        <div style="font-weight:700; color:var(--text-primary);">
                            ${g.nombre_empleado ? escapeHtml(g.nombre_empleado) : '<i style="color:var(--text-muted);">Sin asignar</i>'}
                        </div>
                        <div style="font-size:11px; color:var(--text-muted); font-family:var(--font-mono);">
                            ${g.num_empleado ? `#${escapeHtml(g.num_empleado)}` : 'Lote / Stock'}
                        </div>
                    </td>
                    <td style="font-size:12px; color:var(--text-secondary);">
                        ${escapeHtml(g.departamento || 'General')}
                    </td>
                    <td style="font-family:var(--font-mono); font-size:11.5px; font-weight:700; color:var(--text-secondary);">
                        ${limitDisplay}
                    </td>
                    <td style="font-family:var(--font-mono); font-size:12px; font-weight:700; color:${isPass ? 'var(--accent-emerald)' : isFail ? 'var(--accent-rose)' : 'var(--text-primary)'};">
                        ${measuredDisplay}
                    </td>
                    <td style="font-size:11.5px; color:var(--text-muted);">
                        ${g.fecha_vencimiento ? g.fecha_vencimiento.split('T')[0] : 'N/D'}
                    </td>
                    <td>
                        <span class="${badgeClass}" style="font-size:10.5px; padding:3px 8px; font-weight:800;">
                            ${statusLabel}
                        </span>
                    </td>
                    <td style="text-align:center;">
                        <div style="display:inline-flex; gap:6px; align-items:center;">
                            <button type="button" class="tab-btn" onclick="openGarmentQuickValModal('${itemEscaped}')" style="padding:4px 9px; font-size:11px; font-weight:700; background:#ECFDF5; color:#065F46; border-color:#A7F3D0;" title="Validar / Medir Prenda">
                                🧪 Validar
                            </button>
                            <button type="button" class="tab-btn" onclick="openGarmentModal('${itemEscaped}')" style="padding:4px 9px; font-size:11px; font-weight:700;" title="Editar">
                                ✏️
                            </button>
                            <button type="button" class="tab-btn" onclick="deleteGarmentItem('${escapeHtml(g.id)}')" style="padding:4px 9px; font-size:11px; font-weight:700; color:var(--accent-rose); border-color:#FECDD3;" title="Eliminar">
                                🗑️
                            </button>
                        </div>
                    </td>
                </tr>
            `;
        });
    }

    function getGarmentIcon(category) {
        const c = (category || '').toLowerCase();
        if (c.includes('bata')) return '🥼';
        if (c.includes('calzado')) return '👟';
        if (c.includes('guante')) return '🧤';
        if (c.includes('gorra')) return '🧢';
        return '🥼';
    }

    function openGarmentModal(itemJsonEncoded = null) {
        const modal = document.getElementById('modal-garment-form');
        if (!modal) return;

        // Reset all inputs to empty (Rule: all inputs default empty)
        document.getElementById('gar-form-id').value = '';
        document.getElementById('gar-form-emp-num').value = '';
        document.getElementById('gar-form-emp-name').value = '';
        document.getElementById('gar-form-dept').value = '';
        document.getElementById('gar-form-resistance').value = '';
        document.getElementById('gar-form-notes').value = '';
        document.getElementById('gar-form-is-edit').value = '0';

        if (itemJsonEncoded) {
            try {
                const item = JSON.parse(decodeURIComponent(itemJsonEncoded));
                document.getElementById('gar-form-is-edit').value = '1';
                document.getElementById('gar-form-id').value = item.id || '';
                document.getElementById('gar-form-cat').value = item.category || 'Bata';
                onGarmentCategoryFormChange(item.category || 'Bata');
                
                if (item.classification) {
                    document.getElementById('gar-form-classification').value = item.classification;
                }
                onGarmentClassificationChange();

                document.getElementById('gar-form-emp-num').value = item.num_empleado || '';
                document.getElementById('gar-form-emp-name').value = item.nombre_empleado || '';
                document.getElementById('gar-form-dept').value = item.departamento || '';
                document.getElementById('gar-form-resistance').value = (item.valor_resistencia !== undefined && item.valor_resistencia !== null) ? item.valor_resistencia : '';
                document.getElementById('gar-form-notes').value = item.notas || '';
                document.getElementById('modal-garment-form-title').innerText = '✏️ Editar Prenda / Asignación ESD';
            } catch(e) {
                console.error(e);
            }
        } else {
            document.getElementById('gar-form-cat').value = 'Bata';
            onGarmentCategoryFormChange('Bata');
            document.getElementById('modal-garment-form-title').innerText = '🥼 Registrar / Asignar Prenda ESD (ANSI/ESD S20.20)';
        }

        modal.style.display = 'flex';
    }

    function closeGarmentModal() {
        const modal = document.getElementById('modal-garment-form');
