    let brandingSelectedCompanyId = null;

    function isUserSuperAdmin() {
        if (!sessionData) return false;
        const r = (sessionData.user_role || '').toLowerCase().replace(/[\s_-]/g, '');
        return r === 'superadmin' || r === 'root' || !!sessionData.can_create_company;
    }

    function isUserCompanyAdminOrSuper() {
        if (!sessionData) return false;
        if (isUserSuperAdmin()) return true;
        const r = (sessionData.user_role || '').toLowerCase().replace(/[\s_-]/g, '');
        return r === 'companyadmin' || !!sessionData.can_create_site;
    }

    function updateSidebarCompanyLogo(logoUrl) {
        const sidebarLogo = document.getElementById('sidebar-brand-logo');
        if (!sidebarLogo) return;
        sidebarLogo.onerror = function() {
            this.onerror = null;
            this.src = '/images/esd360-logo.png';
        };
        sidebarLogo.src = logoUrl || '/images/esd360-logo.png';
    }

    async function syncActiveCompanySidebarLogo() {
        try {
            const compId = (sessionData && sessionData.company_id) || '';
            const url = compId ? `/api/settings/company-logo?companyId=${encodeURIComponent(compId)}` : '/api/settings/company-logo';
            const res = await fetch(url);
            if (res.ok) {
                const data = await res.json();
                if (data && data.logo_url) {
                    updateSidebarCompanyLogo(data.logo_url);
                    return;
