    async function showAddSiteForCompanyModal(companyId, companyName, parentCompNodeId) {
        if (parentCompNodeId) expandedTreeNodes.add(parentCompNodeId);
        const siteName = prompt(`Ingrese el nombre del Nuevo Site / Planta para "${companyName}":`);
        if (!siteName || !siteName.trim()) return;

        const res = await fetch('/api/sites', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                company_id: companyId,
                name: siteName.trim(),
                timezone: "America/Mexico_City"
            })
        });
        const data = await res.json();
        if (data.success) {
            showToast(`✅ Site "${siteName.trim()}" registrado exitosamente.`);
            loadSettings();
        } else {
            showToast('❌ ' + (data.message || 'Error al crear el Site.'), 'error');
        }
    }

    async function showAddAreaForSiteModal(siteId, siteName, parentCompNodeId, parentSiteNodeId) {
        if (parentCompNodeId) expandedTreeNodes.add(parentCompNodeId);
        if (parentSiteNodeId) expandedTreeNodes.add(parentSiteNodeId);

        const areaName = prompt(`Ingrese el nombre de la Nueva Área / Línea de Producción para "${siteName}":`);
        if (!areaName || !areaName.trim()) return;

        const res = await fetch('/api/lines', {
