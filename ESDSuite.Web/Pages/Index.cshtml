    async function showAddSiteModal() {
        if (!allCompanies || allCompanies.length === 0) {
            alert("Primero debes registrar una Empresa.");
            return;
        }

        const compNameList = allCompanies.map((c, i) => `${i + 1}. ${c.name}`).join('\n');
        const compIdx = prompt(`Selecciona el número de la Empresa a la que pertenecerá el Site:\n${compNameList}`);
        if (!compIdx) return;
        const idx = parseInt(compIdx) - 1;
        if (isNaN(idx) || idx < 0 || idx >= allCompanies.length) {
            alert("Selección inválida.");
            return;
        }

        const selectedCompany = allCompanies[idx];
        showAddSiteForCompanyModal(selectedCompany.id, selectedCompany.name);
    }

    // --- USER MANAGEMENT & ROLE PERMISSION BADGES ---
    async function loadUsersTable() {
        const res = await fetch('/api/users');
        const users = await res.json();
        const tbody = document.getElementById('users-table-body');
        tbody.innerHTML = '';

        if (!users || users.length === 0) {
            tbody.innerHTML = '<tr><td colspan="5" style="text-align:center;">Sin usuarios registrados.</td></tr>';
            return;
        }

        users.forEach(u => {
            const role = u.role || 'Auditor';
            let roleBadgeClass = 'badge-pass';
            if (role === 'SuperAdmin') roleBadgeClass = 'badge-pending';
            if (role === 'CompanyAdmin') roleBadgeClass = 'badge-pass';
            if (role === 'Viewer') roleBadgeClass = 'badge-fail';

            const compObj = u.companies || allCompanies.find(c => c.id === u.company_id);
            const compName = compObj ? compObj.name : 'Corporativo Global';

            const siteObj = u.sites || allSites.find(s => s.id === u.site_id);
            const siteName = siteObj ? siteObj.name : 'Todos / Global';

            tbody.innerHTML += `<tr>
                <td>
                    <b>${u.full_name || 'Usuario'}</b>
                    <div style="font-size:11px; color:var(--text-muted);">${u.email}</div>
                </td>
                <td><span class="${roleBadgeClass}">${role}</span></td>
                <td><b>${compName}</b></td>
                <td>${siteName}</td>
                <td>
                    <button type="button" class="btn-primary" style="background:var(--accent-rose); padding:4px 8px; font-size:11px;" onclick="deleteUser('${u.id}')">🗑️ Eliminar</button>
                </td>
            </tr>`;
        });
    }

