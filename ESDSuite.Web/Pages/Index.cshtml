    function filterLessonsLearned() {
        const q = (document.getElementById('fnd-lessons-search')?.value || '').toLowerCase().trim();
        if (!q) {
            renderLessonsLearned(allLessonsLearned);
            return;
        }
        const filtered = allLessonsLearned.filter(item => {
            const h = `${item.tracker_code || item.tracking_code || ''} ${item.title || ''} ${item.root_cause || ''} ${item.corrective_action || ''} ${item.lesson || item.lessons_learned || ''} ${item.location || ''} ${item.area || ''} ${item.category || ''} ${item.normative_table || ''} ${item.element_id || ''} ${item.author || item.assigned_to || ''}`.toLowerCase();
            return h.includes(q);
        });
        renderLessonsLearned(filtered);
    }

    function openNewLessonModal() {
        const form = document.getElementById('form-new-lesson');
        if (form) form.reset();
        const authorInput = document.getElementById('lsn-new-author');
        if (authorInput && typeof sessionData !== 'undefined' && sessionData) {
            authorInput.value = sessionData.user_name || sessionData.user_email || '';
        }
        const modal = document.getElementById('modal-new-lesson');
        if (modal) modal.style.display = 'flex';
    }

    function closeNewLessonModal() {
        const modal = document.getElementById('modal-new-lesson');
        if (modal) modal.style.display = 'none';
    }

    async function submitNewLesson(e) {
        if (e && e.preventDefault) e.preventDefault();

        const title = (document.getElementById('lsn-new-title')?.value || '').trim();
        const lesson = (document.getElementById('lsn-new-lesson')?.value || '').trim();
        const rootCause = (document.getElementById('lsn-new-root-cause')?.value || '').trim();
        const corrective = (document.getElementById('lsn-new-corrective')?.value || '').trim();
        const location = (document.getElementById('lsn-new-location')?.value || '').trim();
        const category = document.getElementById('lsn-new-category')?.value || 'General';
        const normativeTable = document.getElementById('lsn-new-table')?.value || 'Buenas Prácticas ANSI/ESD S20.20';
        const elementId = (document.getElementById('lsn-new-element')?.value || '').trim();
        const author = (document.getElementById('lsn-new-author')?.value || '').trim() || (typeof sessionData !== 'undefined' && sessionData ? (sessionData.user_name || sessionData.user_email || 'Auditor') : 'Auditor');

        if (!title || !lesson || !rootCause || !corrective || !location) {
            alert('⚠️ Por favor completa los campos obligatorios marcados con (*).');
            return;
        }

        const fileInput = document.getElementById('lsn-new-photo-file');
        let evidenceUrl = '';

        if (fileInput && fileInput.files && fileInput.files.length > 0) {
            try {
                const formData = new FormData();
                formData.append('file', fileInput.files[0]);
                formData.append('photo', fileInput.files[0]);
                formData.append('finding_id', 'lesson_draft');
                formData.append('type', 'open');
                formData.append('evidence_type', 'open');
                const upRes = await fetch('/api/findings/upload-evidence', { method: 'POST', body: formData });
                const upText = await upRes.text();
                let upData;
                try {
                    upData = JSON.parse(upText);
                } catch(pe) {
                    console.warn('Non-JSON response from upload-evidence for lesson:', upText);
                }
                if (upData && upData.success && upData.url) evidenceUrl = upData.url;
            } catch(e) {
                console.warn('Could not pre-upload photo:', e);
            }
        }

        const payload = {
            site_id: getActiveSiteId(),
            title: title,
            lesson: lesson,
            lessons_learned: lesson,
            root_cause: rootCause,
            corrective_action: corrective,
            location: location,
            category: category,
            normative_table: normativeTable,
            element_id: elementId,
            author: author,
            assigned_to: author,
            evidence_url: evidenceUrl
        };

        try {
            const res = await fetch('/api/lessons-learned', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            });
            const resText = await res.text();
            let data;
            try {
                data = JSON.parse(resText);
            } catch(pe) {
                console.error('Non-JSON response from /api/lessons-learned:', resText);
                alert(`❌ Error del servidor (${res.status}): ${resText.substring(0, 150)}`);
                return;
            }
            if (data && data.success) {
                const code = data.tracking_code || (data.lesson && (data.lesson.tracking_code || data.lesson.tracker_code)) || '';
                alert('✅ Lección aprendida guardada exitosamente' + (code ? `: ${code}` : '.'));
                closeNewLessonModal();
                await loadLessonsLearned();
                if (typeof loadFindingsDashboard === 'function') loadFindingsDashboard();
            } else {
                alert('❌ ' + (data && data.message ? data.message : 'Error al guardar la lección aprendida.'));
            }
        } catch(err) {
            console.error('Error saving manual lesson learned:', err);
            alert('❌ Error al registrar la lección aprendida: ' + (err.message || err));
        }
    }

    async function deleteLessonLearned(id, code) {
        if (!id) return;
        if (typeof isUserCompanyAdminOrSuper === 'function' && !isUserCompanyAdminOrSuper()) {
            alert('⚠️ Permiso denegado: Solo un Administrador de Empresa (Company Admin) o SuperAdmin puede eliminar lecciones aprendidas.');
            return;
        }
        const label = code || id;
        if (!confirm(`¿Está seguro de eliminar permanentemente la lección aprendida "${label}"?\n\nEsta acción no se puede deshacer y se eliminará del sistema.`)) {
            return;
        }
        try {
            const res = await fetch('/api/findings/' + encodeURIComponent(id), {
                method: 'DELETE'
            });
            const data = await res.json();
            if (data.success) {
                alert(`✅ Lección aprendida "${label}" eliminada correctamente.`);
                await loadLessonsLearned();
                if (typeof loadFindingsDashboard === 'function') loadFindingsDashboard();
            } else {
                alert('❌ ' + (data.message || 'Error al eliminar la lección aprendida.'));
            }
        } catch(e) {
            console.error('Error deleting lesson learned:', e);
            alert('❌ Error de conexión al eliminar la lección aprendida.');
        }
    }

    async function loadNormativeLimitsSettings() {
        const container = document.getElementById('normative-limits-container');
        if (!container) return;

        try {
            const res = await fetch('/api/normative-limits');
            const data = await res.json();
            if (!data.success || !data.limits) {
                container.innerHTML = `<p style="color:var(--text-muted); text-align:center;">Error al cargar límites normativos.</p>`;
                return;
            }

            allNormativeLimits = data.limits;
            const tables = [
                { id: 'Tabla 1', title: 'Tabla 1: Conexión a Tierra del Personal (Wrist Straps & Smocks)', icon: '⚡' },
                { id: 'Tabla 2', title: 'Tabla 2: Superficies de Trabajo, Mobiliario y Equipos', icon: '🪑' },
                { id: 'Tabla 3', title: 'Tabla 3: Sistemas de Piso y Calzado ESD (Piso / Calzado en Movimiento)', icon: '👞' },
                { id: 'Tabla 4', title: 'Tabla 4: Empaque ESD & Materiales Aislantes / Ionización', icon: '📦' }
            ];

            let html = '';
            tables.forEach(tbl => {
                const items = allNormativeLimits.filter(l => l.table_name === tbl.id);
                html += `
                <div class="glass-card" style="background:#FFFFFF; border:1px solid var(--border-color); border-radius:10px; padding:16px;">
                    <h4 style="margin:0 0 10px 0; font-size:14px; font-weight:800; color:var(--text-primary); display:flex; align-items:center; gap:8px;">
                        <span>${tbl.icon}</span>
                        <span>${tbl.title}</span>
                    </h4>
                    <div style="overflow-x:auto;">
                        <table class="data-table" style="width:100%; border-collapse:collapse; font-size:12px;">
                            <thead>
                                <tr style="background:#F8FAFC;">
                                    <th style="width:200px;">Parámetro / Elemento</th>
                                    <th style="width:120px;">Límite Normativo Oficial</th>
                                    <th style="width:110px;">Operador</th>
                                    <th style="width:140px;">Valor Máx (Notación / Real)</th>
                                    <th style="width:90px;">Unidad</th>
                                    <th style="width:130px;">Severidad Auto</th>
                                    <th style="width:100px; text-align:center;">Auto-Disparo</th>
                                </tr>
                            </thead>
                            <tbody>`;

                items.forEach(item => {
                    html += `
                    <tr id="limit-row-${item.id}" style="border-bottom:1px solid #F1F5F9;">
                        <td style="padding:8px 10px;">
                            <div style="font-weight:700; color:var(--text-primary);">${escapeHtml(item.name)}</div>
                            <div style="font-size:10.5px; color:var(--text-muted); font-family:var(--font-mono);">${escapeHtml(item.id)}</div>
                        </td>
                        <td style="padding:8px 10px; font-weight:600; color:var(--text-secondary);">
                            ${escapeHtml(item.standard_reference || '-')}
                        </td>
                        <td style="padding:8px 10px;">
                            <select class="form-control limit-input-operator" data-limit-id="${item.id}" style="font-size:11.5px; height:30px; padding:2px 6px;">
                                <option value="LESS_THAN" ${item.operator === 'LESS_THAN' ? 'selected' : ''}>&lt; Menor que</option>
                                <option value="LESS_THAN_OR_EQUAL" ${item.operator === 'LESS_THAN_OR_EQUAL' ? 'selected' : ''}>&le; Menor o igual</option>
                                <option value="GREATER_THAN" ${item.operator === 'GREATER_THAN' ? 'selected' : ''}>&gt; Mayor que</option>
                                <option value="RANGE" ${item.operator === 'RANGE' ? 'selected' : ''}>[ ] Rango</option>
                            </select>
                        </td>
                        <td style="padding:8px 10px;">
                            <input type="number" step="any" class="form-control limit-input-max" data-limit-id="${item.id}" value="${item.max_value !== null ? item.max_value : ''}" style="font-size:11.5px; height:30px; font-family:var(--font-mono); font-weight:700;" />
                        </td>
                        <td style="padding:8px 10px; font-family:var(--font-mono); font-weight:700; color:var(--accent-blue);">
                            ${escapeHtml(item.unit || '')}
                        </td>
                        <td style="padding:8px 10px;">
                            <select class="form-control limit-input-severity" data-limit-id="${item.id}" style="font-size:11.5px; height:30px; padding:2px 6px;">
                                <option value="CRITICAL" ${item.default_severity === 'CRITICAL' ? 'selected' : ''}>🔴 Crítica</option>
                                <option value="MAJOR" ${item.default_severity === 'MAJOR' ? 'selected' : ''}>🟠 Mayor</option>
                                <option value="MINOR" ${item.default_severity === 'MINOR' ? 'selected' : ''}>🔵 Menor</option>
                            </select>
                        </td>
                        <td style="padding:8px 10px; text-align:center;">
                            <input type="checkbox" class="limit-input-trigger" data-limit-id="${item.id}" ${item.auto_trigger_finding ? 'checked' : ''} style="cursor:pointer; width:16px; height:16px;" title="Generar hallazgo automático al exceder tolerancia" />
                        </td>
                    </tr>`;
                });

                html += `
                            </tbody>
                        </table>
                    </div>
                </div>`;
            });

            container.innerHTML = html;
        } catch(e) {
            console.error('Error loading normative limits:', e);
            container.innerHTML = `<p style="color:var(--text-muted); text-align:center;">Error de conexión al cargar límites normativos.</p>`;
        }
    }

    async function saveNormativeLimitsSettings() {
        const updatedLimits = JSON.parse(JSON.stringify(allNormativeLimits));
        
        document.querySelectorAll('.limit-input-max').forEach(input => {
            const id = input.getAttribute('data-limit-id');
            const item = updatedLimits.find(x => x.id === id);
            if (item) {
                item.max_value = input.value !== '' ? parseFloat(input.value) : null;
            }
        });

        document.querySelectorAll('.limit-input-operator').forEach(select => {
            const id = select.getAttribute('data-limit-id');
            const item = updatedLimits.find(x => x.id === id);
            if (item) item.operator = select.value;
        });

        document.querySelectorAll('.limit-input-severity').forEach(select => {
            const id = select.getAttribute('data-limit-id');
            const item = updatedLimits.find(x => x.id === id);
            if (item) item.default_severity = select.value;
        });

        document.querySelectorAll('.limit-input-trigger').forEach(chk => {
            const id = chk.getAttribute('data-limit-id');
            const item = updatedLimits.find(x => x.id === id);
            if (item) item.auto_trigger_finding = chk.checked;
        });

        try {
            const res = await fetch('/api/normative-limits', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(updatedLimits)
            });
            const data = await res.json();
            if (data.success) {
                alert('✅ Límites y tolerancias normativas ANSI/ESD S20.20 guardados correctamente.');
                allNormativeLimits = updatedLimits;
            } else {
                alert('❌ ' + (data.message || 'Error al guardar los límites.'));
            }
        } catch(e) {
            console.error('Error saving normative limits:', e);
            alert('❌ Error de conexión al guardar los límites normativos.');
        }
    }

    async function resetNormativeLimitsSettings() {
        if (!confirm('¿Confirma que desea restaurar todos los límites a los valores oficiales de la norma ANSI/ESD S20.20-2021? Se perderán las modificaciones personalizadas de planta.')) {
            return;
        }

        try {
            const res = await fetch('/api/normative-limits/reset', { method: 'POST' });
            const data = await res.json();
            if (data.success) {
                alert('🔄 Límites normativos restaurados al estándar ANSI/ESD S20.20-2021.');
                loadNormativeLimitsSettings();
            } else {
                alert('❌ Error al restaurar límites.');
            }
        } catch(e) {
            console.error('Error resetting normative limits:', e);
            alert('❌ Error de conexión al restaurar límites.');
        }
    }
</script>

