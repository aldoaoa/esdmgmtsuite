    // --- EDIT / RENAME LOCATION MODAL ---
    function openEditLocationModal(entityType, targetIdOrSiteId, oldName, parentAreaName, parentCompNodeId, parentSiteNodeId) {
        if (parentCompNodeId) expandedTreeNodes.add(parentCompNodeId);
        if (parentSiteNodeId) expandedTreeNodes.add(parentSiteNodeId);

        editLocContext = {
            entityType: entityType,
            targetId: targetIdOrSiteId,
            oldName: oldName,
            parentArea: parentAreaName || ''
        };

        const inp = document.getElementById('edit-loc-input-name');
        if (inp) {
            inp.value = oldName;
            inp.onkeydown = function(ev) {
                if (ev.key === 'Enter') {
                    ev.preventDefault();
                    submitEditLocationModal();
                }
            };
        }

        const titleMap = {
            company: '✏️ Editar Nombre de Empresa',
            site: '✏️ Editar Nombre de Site / Planta',
            area: '✏️ Editar Nombre de Área / Línea',
            suboperation: `✏️ Editar Operación (en ${parentAreaName})`
        };
        const titleEl = document.getElementById('edit-loc-modal-title');
        const subEl = document.getElementById('edit-loc-modal-sub');
        if (titleEl) titleEl.innerText = titleMap[entityType] || '✏️ Editar Nombre de Ubicación';
        if (subEl) {
            subEl.innerText =
                entityType === 'area' || entityType === 'suboperation'
                    ? 'Se actualizarán automáticamente todas las máquinas, mediciones, planos ESD y bitácoras vinculadas a esta ubicación.'
                    : 'Se actualizará el nombre en toda la estructura multi-tenant.';
        }

        const modal = document.getElementById('modal-edit-location-name');
        if (modal) {
            modal.style.display = 'flex';
            setTimeout(() => {
                if (inp) { inp.focus(); inp.select(); }
            }, 50);
        }
    }

    function closeEditLocationModal() {
        const modal = document.getElementById('modal-edit-location-name');
        if (modal) modal.style.display = 'none';
    }

    async function submitEditLocationModal(e) {
        if (e && e.preventDefault) e.preventDefault();
        const { entityType, targetId, oldName, parentArea } = editLocContext;
        const inp = document.getElementById('edit-loc-input-name');
        const newName = (inp ? inp.value : '').trim();

        if (!newName) return;
        if (newName === oldName) {
            closeEditLocationModal();
            return;
        }

        const btn = document.getElementById('btn-save-edit-loc');
        if (btn) { btn.disabled = true; btn.innerText = '⏳ Guardando...'; }

        try {
            let res;
            if (entityType === 'company') {
                res = await fetch(`/api/companies/${encodeURIComponent(targetId)}`, {
                    method: 'PUT',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ name: newName })
                });
            } else if (entityType === 'site') {
                res = await fetch(`/api/sites/${encodeURIComponent(targetId)}`, {
                    method: 'PUT',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ name: newName })
                });
            } else {
                const isArea = entityType === 'area';
                const fullOld = isArea ? oldName : `${parentArea} -> ${oldName}`;
                const fullNew = isArea ? newName : `${parentArea} -> ${newName}`;
                res = await fetch('/api/lines/rename', {
                    method: 'PUT',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        site_id: targetId,
                        old_name: fullOld,
                        new_name: fullNew,
                        is_area: isArea
                    })
                });
            }

            const data = await res.json();
            if (res.ok && data.success) {
                showToast(`✅ ${data.message || 'Nombre actualizado correctamente.'}`);
                closeEditLocationModal();
                await loadSettings();
                try { await loadSites(); } catch (err) {}
            } else {
                showToast('❌ ' + (data.message || 'Error al actualizar el nombre.'), 'error');
            }
        } catch (ex) {
            showToast('❌ Error de conexión al actualizar el nombre.', 'error');
        } finally {
            if (btn) { btn.disabled = false; btn.innerText = '💾 Guardar Cambios'; }
        }
    }

    // --- ARCHIVED LOCATION GROUPS (BÓVEDA DE RESGUARDO & REASIGNACIÓN) ---
    let cachedArchivedGroups = [];

    async function loadArchivedLocationGroups() {
        const panel = document.getElementById('archived-groups-panel');
        const listEl = document.getElementById('archived-groups-list');
        if (!panel || !listEl) return;

        if (!isUserCompanyAdminOrSuper()) {
            panel.style.display = 'none';
            return;
        }

        try {
            const res = await fetch('/api/hierarchy/archived-groups');
            if (!res.ok) return;
            cachedArchivedGroups = await res.json();

            if (!cachedArchivedGroups || cachedArchivedGroups.length === 0) {
                panel.style.display = 'none';
                return;
            }

            panel.style.display = 'block';

            const typeLabels = {
                site: '🏢 Site Completo',
                area: '🏭 Área / Línea',
                suboperation: '⚙️ Operación'
            };

            let html = '';
            cachedArchivedGroups.forEach(g => {
                const counts = g.counts || {};
                const typeBadge = typeLabels[g.group_type] || g.group_type;
                const dateStr = g.deleted_at ? new Date(g.deleted_at).toLocaleString() : '';
                const safeGroupName = (g.group_name || '').replace(/'/g, "\\'");
                const locsPreview = (g.locations || []).slice(0, 4).join(', ') + ((g.locations || []).length > 4 ? ` (+${g.locations.length - 4} más)` : '');

                html += `<div style="background:#fff; border:1px solid #BAE6FD; border-radius:8px; padding:12px 14px; display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:10px;">
                    <div style="flex:1; min-width:260px;">
                        <div style="display:flex; align-items:center; gap:8px; flex-wrap:wrap;">
                            <span style="background:#E0F2FE; color:#0369A1; font-size:11px; font-weight:700; padding:2px 8px; border-radius:10px;">${typeBadge}</span>
                            <b style="font-size:13.5px; color:#0F172A;">${g.group_name}</b>
                            <span style="font-size:11.5px; color:#64748B;">(Origen: <b>${g.source_site_name || 'N/A'}</b> · ${g.company_name || 'Corporativo'})</span>
                        </div>
                        ${locsPreview ? `<div style="font-size:11.5px; color:#475569; margin-top:4px;">📍 <b>Ubicaciones agrupadas:</b> ${locsPreview}</div>` : ''}
                        <div style="display:flex; gap:12px; flex-wrap:wrap; margin-top:6px; font-size:11.5px; color:#0284C7; font-weight:600;">
                            <span>🛠️ ${counts.assets || 0} Máquinas/Activos</span>
                            <span>📊 ${counts.measurements || 0} Mediciones</span>
                            <span>🎛️ ${counts.equipment || 0} Equipos Calibración</span>
                            <span>📋 ${counts.epa_logs || 0} Registros Historial EPA</span>
                            ${dateStr ? `<span style="color:#94A3B8; font-weight:400;">🕒 ${dateStr}</span>` : ''}
                        </div>
                    </div>
                    <div style="display:flex; align-items:center; gap:8px;">
                        <button type="button" class="btn-primary" style="background:#0284C7; padding:6px 12px; font-size:12px;" onclick="openReassignGroupModal('${g.group_id}')">🔄 Reasignar a otro Site</button>
                        <button type="button" class="btn-primary" style="background:#FEE2E2; color:#DC2626; border:1px solid #FECACA; padding:6px 10px; font-size:12px;" title="Eliminar permanentemente este paquete en resguardo" onclick="deleteArchivedGroupPermanently('${g.group_id}', '${safeGroupName}')">🗑️</button>
                    </div>
                </div>`;
            });

            listEl.innerHTML = html;
        } catch (ex) {
            console.warn('Error loading archived location groups:', ex);
        }
    }

    async function openReassignGroupModal(groupId) {
        const group = cachedArchivedGroups.find(g => g.group_id === groupId);
        if (!group) return;

        activeReassignGroupId = group.group_id;
        const counts = group.counts || {};
        const summaryEl = document.getElementById('reassign-group-summary');
        if (summaryEl) {
            summaryEl.innerHTML = `
                <div><b>📦 Paquete Agrupado:</b> ${group.group_name} <span style="color:#64748B;">(Origen: ${group.source_site_name || 'N/A'})</span></div>
                <div style="margin-top:4px;">Incluye <b>${counts.assets || 0}</b> máquinas, <b>${counts.measurements || 0}</b> mediciones, <b>${counts.equipment || 0}</b> equipos y <b>${counts.epa_logs || 0}</b> registros de historial EPA.</div>
            `;
        }

        if (!allSites || allSites.length === 0) {
            try {
                const sRes = await fetch('/api/sites');
                if (sRes.ok) allSites = await sRes.json();
            } catch (e) {}
        }

        const siteSel = document.getElementById('reassign-target-site');
        if (siteSel) {
            siteSel.innerHTML = '<option value="">-- Seleccionar Site Destino --</option>';
            (allSites || []).forEach(s => {
                siteSel.innerHTML += `<option value="${s.id}">${s.name}</option>`;
            });
        }

        const modeSel = document.getElementById('reassign-loc-mode');
        if (modeSel) modeSel.value = 'keep';
        const customInput = document.getElementById('reassign-custom-loc-input');
        if (customInput) customInput.value = '';
        onReassignLocModeChange('keep');

        const modal = document.getElementById('modal-reassign-group');
