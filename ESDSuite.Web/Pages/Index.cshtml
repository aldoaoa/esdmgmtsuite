    async function saveGarmentForm() {
        const id = document.getElementById('gar-form-id').value.trim();
        const cat = document.getElementById('gar-form-cat').value;
        const classification = cat === 'Bata' ? document.getElementById('gar-form-classification').value : `${cat} ESD`;
        const limitVal = parseFloat(document.getElementById('gar-form-limit-val').value) || 1.0e11;
        const empNum = document.getElementById('gar-form-emp-num').value.trim();
        const empName = document.getElementById('gar-form-emp-name').value.trim();
        const dept = document.getElementById('gar-form-dept').value.trim();
        const resValStr = document.getElementById('gar-form-resistance').value.trim();
        const notes = document.getElementById('gar-form-notes').value.trim();

        const payload = {
            id: id,
            category: cat,
            classification: classification,
            limite_referencia: limitVal,
            limite_texto: document.getElementById('gar-form-limit-display').innerText,
            num_empleado: empNum,
            nombre_empleado: empName,
            departamento: dept,
            metodo: cat === 'Bata' ? 'ANSI/ESD STM2.1 / TR53' : cat === 'Calzado' ? 'ANSI/ESD STM9.1 / TR53' : 'ANSI/ESD SP15.1 / TR53',
            notas: notes,
            site_id: (sessionData && sessionData.site_id) || ''
        };

        if (resValStr) {
            const parsed = parseFloat(resValStr);
            if (!isNaN(parsed)) {
                payload.valor_resistencia = parsed;
                payload.fecha_inspeccion = new Date().toISOString().split('T')[0];
                const dueDate = new Date();
                dueDate.setMonth(dueDate.getMonth() + 6);
                payload.fecha_vencimiento = dueDate.toISOString().split('T')[0];
            }
        }

        try {
            const res = await fetch('/api/garments', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            });
            if (res.ok) {
                closeGarmentModal();
                loadGarmentsCatalog();
            } else {
                alert('Error al guardar prenda.');
            }
        } catch(e) {
            console.error('Error saving garment:', e);
        }
    }

