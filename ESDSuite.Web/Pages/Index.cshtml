    async function submitNewAsset() {
        const custom_id = document.getElementById('inv-new-id').value.trim();
        const name = document.getElementById('inv-new-name').value.trim();
        const category = document.getElementById('inv-new-category').value;
        const subtype = document.getElementById('inv-new-subtype').value;
        const location = document.getElementById('inv-new-line').value;
        const area = document.getElementById('inv-new-area').value.trim();
        const periodicity = document.getElementById('inv-new-periodicity').value;
        const created_at = document.getElementById('inv-new-date').value;
        const notes = document.getElementById('inv-new-notes').value.trim();

        if (!custom_id) {
            alert('Por favor ingresa el Código / ID único del activo.');
            return;
        }
        if (!name) {
            alert('Por favor ingresa el Nombre / Descripción del activo.');
            return;
        }
        if (!location) {
            alert('Por favor selecciona una Línea / Ubicación.');
            return;
        }

        try {
            const res = await fetch('/api/inventory/assets', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    custom_id,
                    name,
                    category,
                    subtype,
                    location,
                    area: area || (location.includes('->') ? location.split('->')[0].trim() : 'General'),
                    periodicity,
                    created_at: created_at ? new Date(created_at).toISOString() : new Date().toISOString(),
                    notes,
                    site_id: (sessionData && sessionData.site_id) || ''
                })
            });

            const data = await res.json();
            if (res.ok && data.success) {
                alert('✅ Activo registrado y configurado exitosamente.');
                closeNewAssetModal();
                loadInventory();
                if (currentModule === 'schedule') loadScheduleData();
            } else {
                alert('❌ ' + (data.message || 'Error al registrar el activo.'));
            }
        } catch(e) {
            console.error('Error submitting new asset:', e);
            alert('❌ Error de conexión al guardar el activo.');
        }
    }

    // --- ASSET DETAIL & EDIT MODAL ---
    async function openAssetEditModal(assetId) {
        const modal = document.getElementById('modal-edit-asset');
        if (!modal) return;

        const a = allInventoryAssets.find(x => (x.custom_id === assetId || x.asset_id === assetId || x.id === assetId)) || {
            custom_id: assetId,
            name: assetId,
            category: 'Mobiliario ESD',
            sub_category: 'Mobiliario ESD',
            location: '',
            area: '',
            periodicity: '1m',
            notes: '',
            status: 'ACTIVE',
            site_id: (sessionData && sessionData.site_id) || ''
        };

        currentEditingAsset = a;

        // Set inputs
        document.getElementById('inv-edit-db-id').value = a.id || '';
        document.getElementById('inv-edit-id').value = a.custom_id || a.asset_id || assetId;
        document.getElementById('inv-edit-name').value = a.name || a.custom_id || assetId;

        // Normalize category
        const normCat = normalizeAssetCategory(a.category);
        const catSel = document.getElementById('inv-edit-category');
        if (catSel) catSel.value = normCat;

        document.getElementById('inv-edit-area').value = a.area || (a.location && a.location.includes('->') ? a.location.split('->')[0].trim() : '');
        document.getElementById('inv-edit-periodicity').value = a.periodicity || '1m';
        document.getElementById('inv-edit-notes').value = a.notes || '';

        // Subtypes selection
        onEditAssetCategoryChange(normCat, a.sub_category);

        // Populate lines dynamically for this site
        await populateAssetModalLines('inv-edit-line', a.location, a.site_id || (sessionData && sessionData.site_id) || '');

        // Status Badge & Decommission / Reactivate button toggling
        const stBadge = document.getElementById('inv-edit-status-badge');
        const btnDecom = document.getElementById('inv-btn-decommission');
        const btnReact = document.getElementById('inv-btn-reactivate');
        const isInactive = (a.status === 'INACTIVE' || a.status === 'BAJA' || a.status === 'DECOMMISSIONED');
        const isPending = (a.status === 'PENDING' || a.status === 'PENDIENTE' || (!a.last_verification && (a.total_audits === 0 || !a.total_audits)));

        if (isInactive) {
            if (stBadge) {
                stBadge.className = 'badge-fail';
                stBadge.innerText = t('inventory.status_inactive', 'DADO DE BAJA');
            }
            if (btnDecom) btnDecom.style.display = 'none';
            if (btnReact) btnReact.style.display = 'inline-flex';
        } else if (isPending) {
            if (stBadge) {
                stBadge.className = 'badge-pending';
                stBadge.innerText = t('inventory.status_pending', 'PENDIENTE');
            }
            if (btnDecom) btnDecom.style.display = 'inline-flex';
            if (btnReact) btnReact.style.display = 'none';
        } else {
            if (stBadge) {
                const isPass = (a.status !== 'FAIL');
                stBadge.className = isPass ? 'badge-pass' : 'badge-fail';
                stBadge.innerText = isPass ? 'PASS' : 'FAIL';
            }
            if (btnDecom) btnDecom.style.display = 'inline-flex';
            if (btnReact) btnReact.style.display = 'none';
        }

        // Read-only audit & validation information
        const elAuditor = document.getElementById('inv-edit-auditor');
        const elLastDate = document.getElementById('inv-edit-last-date');
        const elNextDate = document.getElementById('inv-edit-next-date');
        const elMeas = document.getElementById('inv-edit-measurements');

        if (elAuditor) elAuditor.innerText = a.auditor || 'Auditor ESD';
        if (elLastDate) elLastDate.innerText = a.last_verification ? a.last_verification.split('T')[0] : 'Sin verificaciones registradas';
        if (elNextDate) elNextDate.innerText = a.next_verification || (a.last_verification ? calculateNextDate(a.last_verification) : 'N/D');

        if (elMeas) {
            if (a.resistance_value !== null && a.resistance_value !== undefined) {
                const resFmt = Number(a.resistance_value).toExponential(2);
                const voltFmt = a.static_field_value !== null && a.static_field_value !== undefined ? `${a.static_field_value}V` : '0V';
                elMeas.innerHTML = `<span style="font-family:monospace; font-weight:700; color:var(--text-primary);">⚡ Resistencia: ${resFmt} Ω &nbsp;|&nbsp; 🧲 Voltaje: ${voltFmt}</span>`;
            } else if (a.tiempo_descarga !== null && a.tiempo_descarga !== undefined) {
                const tFmt = `${a.tiempo_descarga}s`;
                const bFmt = `${a.voltaje_balance || 0}V`;
                elMeas.innerHTML = `<span style="font-family:monospace; font-weight:700; color:var(--text-primary);">⚡ Tiempo de Descarga: ${tFmt} &nbsp;|&nbsp; 🧲 Balance: ${bFmt}</span>`;
            } else {
                elMeas.innerHTML = `<span style="color:var(--text-muted); font-size:12px;">Sin mediciones registradas en el sistema.</span>`;
            }
        }

        modal.style.display = 'flex';
        applyTranslations();
    }

    function closeAssetEditModal() {
        const modal = document.getElementById('modal-edit-asset');
        if (modal) modal.style.display = 'none';
        currentEditingAsset = null;
    }

    function onEditAssetCategoryChange(category, preselectedSubtype) {
        const subSel = document.getElementById('inv-edit-subtype');
        if (!subSel) return;
        subSel.innerHTML = '';
        const group = getCategoryGroup(category);
        const keys = ELEMENT_SUBTYPES_DEF[group] || ELEMENT_SUBTYPES_DEF["furniture"];
        let found = false;
        keys.forEach(k => {
            const label = t('audit.subtypes.' + k, k);
            const opt = document.createElement('option');
            opt.value = label;
            opt.textContent = label;
            if (preselectedSubtype && (preselectedSubtype === label || preselectedSubtype === k || preselectedSubtype.toLowerCase() === label.toLowerCase())) {
                opt.selected = true;
                found = true;
            }
            subSel.appendChild(opt);
        });

        if (preselectedSubtype && !found && preselectedSubtype.trim() !== '') {
            const opt = document.createElement('option');
            opt.value = preselectedSubtype;
            opt.textContent = preselectedSubtype;
            opt.selected = true;
            subSel.appendChild(opt);
        }
    }

    function onEditAssetLineChange(lineVal) {
        const areaInp = document.getElementById('inv-edit-area');
        if (areaInp && lineVal && lineVal.includes('->') && !areaInp.value) {
            areaInp.value = lineVal.split('->')[0].trim();
        }
    }

    async function saveAssetChanges() {
        const dbId = document.getElementById('inv-edit-db-id').value;
        const custom_id = document.getElementById('inv-edit-id').value.trim();
        const name = document.getElementById('inv-edit-name').value.trim();
        const category = document.getElementById('inv-edit-category').value;
        const subtype = document.getElementById('inv-edit-subtype').value;
        const location = document.getElementById('inv-edit-line').value;
        const area = document.getElementById('inv-edit-area').value.trim();
        const periodicity = document.getElementById('inv-edit-periodicity').value;
        const notes = document.getElementById('inv-edit-notes').value.trim();

        if (!name) {
            alert('Por favor ingresa el Nombre / Descripción del activo.');
            return;
        }
        if (!location) {
            alert('Por favor selecciona una Línea / Ubicación.');
            return;
        }

        const targetId = dbId || custom_id;
        try {
            const res = await fetch(`/api/inventory/assets/${encodeURIComponent(targetId)}`, {
                method: 'PUT',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    id: dbId,
                    custom_id,
                    name,
                    category,
                    subtype,
                    location,
                    area: area || (location.includes('->') ? location.split('->')[0].trim() : 'General'),
                    periodicity,
                    notes,
                    site_id: (sessionData && sessionData.site_id) || ''
                })
            });

            const data = await res.json();
            if (res.ok && data.success) {
                alert('✅ Cambios guardados exitosamente.');
                closeAssetEditModal();
                loadInventory();
                if (currentModule === 'schedule') loadScheduleData();
            } else {
                alert('❌ ' + (data.message || 'Error al guardar los cambios del activo.'));
            }
        } catch(e) {
            console.error('Error updating asset:', e);
            alert('❌ Error de conexión al guardar los cambios.');
        }
    }

