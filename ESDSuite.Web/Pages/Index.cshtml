    function viewHistoryFromEditModal() {
        if (!currentEditingAsset) return;
        const assetId = currentEditingAsset.custom_id || currentEditingAsset.asset_id;
        const cat = currentEditingAsset.category;
        const loc = currentEditingAsset.location;
