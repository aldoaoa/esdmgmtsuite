    async function loadInventory() {
        const tbody = document.getElementById('inventory-table-body');
        const countBadge = document.getElementById('inv-count-badge');
        if (!tbody) return;
        
        tbody.innerHTML = `<tr><td colspan="9" style="text-align:center; padding:24px;">${t('inventory.loading', 'Cargando activos...')}</td></tr>`;

        try {
            const siteId = (sessionData && sessionData.site_id) || '';
            const search = (document.getElementById('inventory-search-input')?.value || '').trim();
            const category = document.getElementById('inventory-category-filter')?.value || 'all';
            const status = document.getElementById('inventory-status-filter')?.value || 'all';

            const query = new URLSearchParams({ siteId, search, category, status });
            const res = await fetch(`/api/inventory?${query.toString()}`);
            if (!res.ok) throw new Error('Error al cargar inventario');
            const data = await res.json();
            allInventoryAssets = data || [];

            tbody.innerHTML = '';
            if (countBadge) countBadge.innerText = `${allInventoryAssets.length} ${t('sidebar.inventory', 'Activos')}`;

            if (!allInventoryAssets || allInventoryAssets.length === 0) {
                tbody.innerHTML = `<tr><td colspan="9" style="text-align:center; padding:32px; color:var(--text-muted);">ℹ️ ${t('inventory.no_assets', 'No se encontraron activos para los criterios seleccionados.')}</td></tr>`;
                return;
            }

            const perLabels = {
                '1d': '1 Día',
                '1w': '1 Semana',
                '2w': '2 Semanas',
                '1m': '1 Mes',
                '3m': '3 Meses',
                '6m': '6 Meses',
                '1y': '1 Año',
                'permanent': 'Permanente'
            };

            allInventoryAssets.forEach(a => {
                const assetId = a.custom_id || a.asset_id || a.id || 'N/A';
                const assetName = a.name && a.name !== assetId ? a.name : '';
                const cat = a.category || 'Mobiliario ESD';
                const subCat = a.sub_category || a.category || '';
                const loc = a.location || 'N/A';
                const per = a.periodicity || '1m';
                const perLabel = t('periodicity.' + per, perLabels[per] || per);
                const isInactive = (a.status === 'INACTIVE' || a.status === 'BAJA' || a.status === 'DECOMMISSIONED');
                const statusStr = isInactive ? t('inventory.status_inactive', 'DADO DE BAJA') : (a.status === 'FAIL' ? 'FAIL' : 'PASS');
                const badgeCls = isInactive ? 'badge-fail' : (statusStr === 'PASS' ? 'badge-pass' : 'badge-fail');
                const lastDate = a.last_verification ? a.last_verification.split('T')[0] : 'N/D';
                const nextDate = isInactive ? 'N/A' : (a.next_verification || (a.last_verification ? calculateNextDate(a.last_verification) : 'N/D'));

                // Format Measurement Values
                let measHtml = '';
                if (a.resistance_value !== null && a.resistance_value !== undefined) {
                    const resFmt = Number(a.resistance_value).toExponential(2);
                    const voltFmt = a.static_field_value !== null && a.static_field_value !== undefined ? `${a.static_field_value}V` : '0V';
                    measHtml = `<span style="font-family:monospace; font-weight:600;">⚡ ${resFmt}Ω | 🧲 ${voltFmt}</span>`;
                } else if (a.tiempo_descarga !== null && a.tiempo_descarga !== undefined) {
                    const tFmt = `${a.tiempo_descarga}s`;
                    const bFmt = `${a.voltaje_balance || 0}V`;
                    measHtml = `<span style="font-family:monospace; font-weight:600;">⚡ ${tFmt} | 🧲 ${bFmt}</span>`;
                } else {
                    measHtml = `<span style="color:var(--text-muted); font-size:11.5px;">Sin mediciones registradas</span>`;
                }

                if (a.punto_contacto) {
                    measHtml += `<div style="font-size:11px; color:var(--text-secondary); margin-top:2px;">📍 <i>${a.punto_contacto}</i></div>`;
                }

                if (a.extra_points && a.extra_points.length > 0) {
                    measHtml += `<span class="badge-pass" style="background:#FEF3C7; color:#B45309; border-color:#FDE68A; font-size:10px; padding:1px 6px; margin-left:4px; font-weight:700;">+${a.extra_points.length} pts</span>`;
                }

                const catLabel = cat;
                const subCatLabel = (subCat && subCat !== cat) ? `<div style="font-size:11px; color:var(--text-muted);">${subCat}</div>` : '';
                const nameLabel = assetName ? `<div style="font-size:11px; color:var(--text-muted); font-weight:500;">${assetName}</div>` : '';

                tbody.innerHTML += `
                    <tr style="cursor:pointer; ${isInactive ? 'opacity:0.65; background:#FFF1F2;' : ''}" onclick="openAssetEditModal('${escapeJsString(assetId)}')">
                        <td>
                            <strong style="color:var(--accent-blue); font-size:13px; font-family:monospace;">${assetId}</strong>
                            ${nameLabel}
                        </td>
                        <td>
                            <div style="font-weight:600;">${catLabel}</div>
                            ${subCatLabel}
                        </td>
                        <td>
                            <span style="font-weight:600; color:var(--text-primary);">${loc}</span>
                        </td>
                        <td>
                            <span class="badge-pass" style="background:#F8FAFC; color:var(--text-primary); border-color:#E2E8F0; font-size:11px; padding:2px 7px;">${perLabel}</span>
                        </td>
                        <td>
                            <span class="${badgeCls}">${statusStr}</span>
                        </td>
                        <td>
                            <span style="font-size:12px; color:var(--text-secondary);">${lastDate}</span>
                        </td>
                        <td>
                            <span style="font-size:12px; font-weight:600; color:${nextDate === 'N/D' || nextDate === 'N/A' ? 'var(--text-muted)' : 'var(--accent-blue)'};">${nextDate}</span>
                        </td>
                        <td>
                            <div>${measHtml}</div>
                        </td>
                        <td style="text-align:center;" onclick="event.stopPropagation();">
                            <div style="display:inline-flex; gap:6px;">
                                <button type="button" class="btn-primary" style="padding:4px 9px; font-size:11.5px; background:var(--accent-blue);" onclick="openAssetEditModal('${escapeJsString(assetId)}')" title="Editar Activo">
                                    ✏️
                                </button>
                                <button type="button" class="tab-btn" style="padding:4px 9px; font-size:11.5px; font-weight:600;" onclick="openAssetHistoryModal('${escapeJsString(assetId)}', '${escapeJsString(cat)}', '${escapeJsString(loc)}')" title="Ver Historial">
                                    📜
                                </button>
                            </div>
                        </td>
                    </tr>
                `;
            });
        } catch (err) {
            tbody.innerHTML = `<tr><td colspan="9" style="text-align:center; color:var(--accent-rose); padding:20px;">❌ Error al cargar activos: ${err.message}</td></tr>`;
        }
    }

    function calculateNextDate(dateStr) {
        try {
            const d = new Date(dateStr);
            if (isNaN(d.getTime())) return 'N/D';
            d.setDate(d.getDate() + 30);
            return d.toISOString().split('T')[0];
        } catch(e) {
            return 'N/D';
        }
    }

    function escapeJsString(str) {
        if (!str) return '';
        return str.replace(/'/g, "\\'").replace(/"/g, '&quot;');
    }

    function resetInventoryFilters() {
        const sInp = document.getElementById('inventory-search-input');
        const cSel = document.getElementById('inventory-category-filter');
        const stSel = document.getElementById('inventory-status-filter');
        if (sInp) sInp.value = '';
        if (cSel) cSel.value = 'all';
        if (stSel) stSel.value = 'all';
        loadInventory();
    }

    async function openAssetHistoryModal(assetId, category, location) {
        const modal = document.getElementById('modal-asset-history');
        const title = document.getElementById('modal-hist-asset-id');
        const sub = document.getElementById('modal-hist-subtitle');
        const tbody = document.getElementById('modal-history-tbody');
        if (!modal || !tbody) return;

        title.innerHTML = `<img src="/images/icons/icon-inventory.svg" class="ui-icon-3d" alt="" /> ${t('inventory.modal_history_title', 'Historial de Mediciones')}: <b>${assetId}</b>`;
        sub.innerHTML = `<img src="/images/icons/icon-furniture.svg" class="ui-icon-3d-sm" alt="" /> ${category || 'Mobiliario ESD'} &bull; <img src="/images/icons/icon-routes.svg" class="ui-icon-3d-sm" alt="" /> ${location || 'N/A'}`;
        tbody.innerHTML = `<tr><td colspan="6" style="text-align:center; padding:24px;">${t('inventory.loading', 'Cargando historial...')}</td></tr>`;
        modal.style.display = 'flex';

        try {
            const res = await fetch(`/api/inventory/history/${encodeURIComponent(assetId)}`);
            if (!res.ok) throw new Error(`HTTP ${res.status}: ${res.statusText}`);
            const data = await res.json();

            tbody.innerHTML = '';
            if (!Array.isArray(data) || data.length === 0) {
                tbody.innerHTML = `<tr><td colspan="6" style="text-align:center; padding:28px; color:var(--text-muted);">ℹ️ ${t('inventory.modal_no_history', 'No se encontraron registros de auditoría para este activo.')}</td></tr>`;
                return;
            }

            data.forEach(m => {
                const dateStr = m.measured_at ? m.measured_at.replace('T', ' ').substring(0, 19) : (m.fecha_medicion || 'N/A');
                const st = (m.status_result === 'PASS' || m.estatus === 'PASA') ? 'PASS' : 'FAIL';
                const badge = st === 'PASS' ? 'badge-pass' : 'badge-fail';
                
                let auditorName = 'Auditor ESD';
                let ptContacto = '';
                let extraPts = [];

                if (m.extra_data) {
                    auditorName = m.extra_data.auditor || auditorName;
                    ptContacto = m.extra_data.punto_contacto || '';
                    extraPts = m.extra_data.mediciones_extra || [];
                }

                // Primary measurement
                let primMeas = '';
                if (m.resistance_value !== null && m.resistance_value !== undefined) {
                    primMeas = `<div style="font-family:monospace; font-weight:700;">⚡ ${Number(m.resistance_value).toExponential(2)} Ω | 🧲 ${m.static_field_value || 0} V</div>`;
                } else if (m.extra_data && m.extra_data.tiempo_descarga !== undefined) {
                    primMeas = `<div style="font-family:monospace; font-weight:700;">⚡ ${m.extra_data.tiempo_descarga}s | 🧲 ${m.extra_data.voltaje_balance || 0} V</div>`;
                } else if (m.resistencia) {
                    primMeas = `<div style="font-family:monospace; font-weight:700;">⚡ ${Number(m.resistencia).toExponential(2)} Ω | 🧲 ${m.voltaje_campo || 0} V</div>`;
                } else {
                    primMeas = `<span style="color:var(--text-muted);">N/D</span>`;
                }

                if (ptContacto) {
                    primMeas += `<div style="font-size:11px; color:var(--accent-blue); margin-top:2px;">📍 <b>Pto:</b> ${ptContacto}</div>`;
                }

                // Extra points
                let extraHtml = '-';
                if (extraPts && extraPts.length > 0) {
                    extraHtml = '<div style="display:flex; flex-direction:column; gap:3px;">';
                    extraPts.forEach(ep => {
                        const valTxt = ep.tipo === 'resistencia' ? `${ep.valor} Ω` : `${ep.valor} V`;
                        const desc = ep.comentario ? ` (${ep.comentario})` : '';
                        extraHtml += `<span style="font-size:11px; font-family:monospace; background:#F1F5F9; padding:2px 6px; border-radius:4px;">🔹 ${valTxt}${desc}</span>`;
                    });
                    extraHtml += '</div>';
                }

                const obs = m.observaciones || m.comentarios || '-';

                tbody.innerHTML += `
                    <tr>
                        <td><span style="font-size:12px; font-weight:600;">${dateStr}</span></td>
                        <td><span class="${badge}">${st}</span></td>
                        <td><span style="font-size:12px;">${auditorName}</span></td>
                        <td>${primMeas}</td>
                        <td>${extraHtml}</td>
                        <td><span style="font-size:11.5px; color:var(--text-secondary);">${obs}</span></td>
                    </tr>
                `;
            });
        } catch(e) {
            tbody.innerHTML = `<tr><td colspan="6" style="text-align:center; color:var(--accent-rose); padding:20px;">❌ Error al consultar historial: ${e.message}</td></tr>`;
        }
    }

    function closeAssetHistoryModal() {
        const modal = document.getElementById('modal-asset-history');
        if (modal) modal.style.display = 'none';
    }

