    function onGarmentQuickValResistanceInput(valStr) {
        const badge = document.getElementById('gar-qval-preview-badge');
        if (!badge || !activeQuickValGarment) return;

        const val = parseFloat(valStr);
        if (isNaN(val) || val <= 0) {
            badge.style.display = 'none';
            return;
        }

        const limit = activeQuickValGarment.limite_referencia || 1.0e11;
        const isPass = val <= limit;

        badge.style.display = 'inline-block';
        if (isPass) {
            badge.className = 'badge-pass';
            badge.style.background = '#ECFDF5';
            badge.style.color = '#065F46';
            badge.style.borderColor = '#10B981';
            badge.innerHTML = `✅ CUMPLE (PASS) &bull; ${formatScientificVal(val)} &Omega; &le; ${formatScientificVal(limit)} &Omega;`;
        } else {
            badge.className = 'badge-fail';
            badge.style.background = '#FFF1F2';
            badge.style.color = '#9F1239';
            badge.style.borderColor = '#F43F5E';
            badge.innerHTML = `❌ NO CUMPLE (FAIL) &bull; ${formatScientificVal(val)} &Omega; > ${formatScientificVal(limit)} &Omega;`;
        }
    }

