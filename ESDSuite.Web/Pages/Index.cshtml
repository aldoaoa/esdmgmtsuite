                                <div style="font-size:12px; font-weight:700; color:var(--text-muted); margin-bottom:10px;" data-i18n="settings.branding_current_logo">Logotipo Corporativo Actual:</div>
                                <div style="display:flex; justify-content:center; align-items:center; min-height:90px; background:#FFFFFF; border:1px solid #E2E8F0; border-radius:8px; padding:12px; max-width:320px; margin:0 auto;">
                                    <img id="branding-logo-preview-img" src="/images/esd360-logo.png" alt="Company Logo" style="max-height:80px; max-width:100%; object-fit:contain;" />
                                </div>
                            </div>

                            <!-- UPLOAD NEW LOGO -->
                            <form id="form-upload-branding-logo" onsubmit="submitCompanyLogo(event)">
                                <div class="form-group" style="margin-bottom:16px;">
                                    <label data-i18n="settings.branding_upload_lbl" style="font-size:12.5px; font-weight:700;">Seleccionar Archivo de Logotipo (PNG, JPG, SVG, WebP):</label>
                                    <input type="file" id="branding-file-input" class="form-control" accept="image/png,image/jpeg,image/svg+xml,image/webp" required onchange="previewBrandingFile(this)" />
                                    <small style="color:var(--text-muted); font-size:11px; margin-top:4px; display:block;">Recomendado: Imagen con fondo transparente o blanco, resolución mínima 400x120px.</small>
                                </div>

                                <button type="submit" class="btn-primary" id="btn-save-company-logo" style="width:100%; height:44px; font-weight:700; font-size:13.5px;" data-i18n="settings.branding_btn_upload">
                                    💾 Subir y Guardar Logotipo
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </main>
</div>

<script>
    let currentModule = 'dashboard';
    let sessionData = null;
    let extraPoints = [];
    let currentLocale = {};
    let allCompanies = [];
    let allSites = [];

    // QR SCANNER STATE
    let html5QrCode = null;
    let videoDevices = [];
    let currentCamIdx = 0;
    let wideCamId = null;

    window.onload = function() {
        checkSession();
    };

    async function checkSession() {
        let sessionRes = null;
        try {
            const res = await fetch('/api/session');
            if (res.ok) {
                sessionRes = await res.json();
            }
        } catch (e) {
            console.error('Error fetching session:', e);
        }

        if (sessionRes && sessionRes.isLoggedIn) {
            sessionData = sessionRes;
            const overlay = document.getElementById('login-overlay');
            if (overlay) overlay.style.display = 'none';

            if (document.getElementById('user-display-name')) {
                document.getElementById('user-display-name').innerText = sessionRes.user_name || sessionRes.user_email || 'Usuario';
            }
            if (document.getElementById('user-display-role')) {
                document.getElementById('user-display-role').innerText = sessionRes.user_role || 'AUDITOR';
            }
            if (document.getElementById('user-avatar-initials')) {
                document.getElementById('user-avatar-initials').innerText = (sessionRes.user_name || 'U').substring(0, 1).toUpperCase();
            }
            if (document.getElementById('audit-auditor')) {
                document.getElementById('audit-auditor').value = sessionRes.user_name || 'Auditor ESD';
            }
            
            const userLang = getStoredLang();
            if (document.getElementById('settings-lang-select')) document.getElementById('settings-lang-select').value = userLang;
            if (document.getElementById('login-landing-lang-select')) document.getElementById('login-landing-lang-select').value = userLang;

            const userReportLang = sessionRes.report_lang || getStoredReportLang();
            setStoredReportLang(userReportLang);
            if (document.getElementById('settings-reports-lang-select')) document.getElementById('settings-reports-lang-select').value = userReportLang;

            if (sessionRes.version && document.getElementById('system-version-badge')) {
                document.getElementById('system-version-badge').innerText = 'v' + sessionRes.version;
            }
            if (sessionRes.version && document.getElementById('login-version-badge')) {
                document.getElementById('login-version-badge').innerText = 'v' + sessionRes.version;
            }

            try { enforceRolePermissions(); } catch(e) { console.warn('enforceRolePermissions error:', e); }
            try { await loadTranslations(userLang); } catch(e) { console.warn('loadTranslations error:', e); }
            try { await loadSites(); } catch(e) { console.warn('loadSites error:', e); }
            try { await loadEquipmentForSite(); } catch(e) { console.warn('loadEquipmentForSite error:', e); }
            try { await loadSitePhotoPolicy(); } catch(e) { console.warn('loadSitePhotoPolicy error:', e); }
            try { await loadDashboardMetrics(); } catch(e) { console.warn('loadDashboardMetrics error:', e); }
        } else {
            const landingLang = getStoredLang();
            const overlay = document.getElementById('login-overlay');
            if (overlay) overlay.style.display = 'flex';
            if (document.getElementById('login-landing-lang-select')) {
                document.getElementById('login-landing-lang-select').value = landingLang;
            }
            try { await loadTranslations(landingLang); } catch(e) {}
        }
    }

    function getStoredLang() {
        const match = document.cookie.match(/(?:^|; )esd360_lang=([^;]*)/);
        if (match && match[1]) return match[1];
        return localStorage.getItem('esd360_lang') || 'es';
    }

    function setStoredLang(lang) {
        localStorage.setItem('esd360_lang', lang);
        document.cookie = `esd360_lang=${lang}; path=/; max-age=${365 * 24 * 60 * 60}; SameSite=Lax`;
    }

    function getStoredReportLang() {
        const match = document.cookie.match(/(?:^|; )esd360_report_lang=([^;]*)/);
        if (match && match[1]) return match[1];
        return localStorage.getItem('esd360_report_lang') || getStoredLang() || 'es';
    }

    function setStoredReportLang(lang) {
        localStorage.setItem('esd360_report_lang', lang);
        document.cookie = `esd360_report_lang=${lang}; path=/; max-age=${365 * 24 * 60 * 60}; SameSite=Lax`;
    }

    async function changeReportsLanguage(lang) {
        setStoredReportLang(lang);
        if (document.getElementById('settings-reports-lang-select')) document.getElementById('settings-reports-lang-select').value = lang;
        try {
            await fetch('/api/set-report-lang', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ lang })
            });
        } catch(ex) {}
    }

    function enforceRolePermissions() {
        const canComp = sessionData.can_create_company;
        const canSite = sessionData.can_create_site;
        const canArea = sessionData.can_create_area;
        const canUser = sessionData.can_create_user;
        const canChangeSite = sessionData.can_change_site;

        const btnComp = document.getElementById('btn-add-company');
        if (btnComp) btnComp.style.display = canComp ? 'inline-flex' : 'none';

        const btnSite = document.getElementById('btn-add-site');
        if (btnSite) btnSite.style.display = canSite ? 'inline-flex' : 'none';

        const siteSelect = document.getElementById('active-site-select');
        if (siteSelect) {
            siteSelect.disabled = !canChangeSite;
            if (!canChangeSite) {
                siteSelect.title = "Tu rol no permite cambiar de site. Estás asignado a tu planta.";
            }
        }

        // Filter user role options in User Creation Form based on session user permissions
        const roleSel = document.getElementById('u-role');
        if (roleSel) {
            Array.from(roleSel.options).forEach(opt => {
                if (opt.value === 'SuperAdmin') opt.disabled = !canComp;
                if (opt.value === 'CompanyAdmin') opt.disabled = !canComp;
                if (opt.value === 'SiteAdmin') opt.disabled = !canSite;
            });
        }

        const isSiteAdminOrAbove = sessionData && (sessionData.user_role === 'SuperAdmin' || sessionData.user_role === 'CompanyAdmin' || sessionData.user_role === 'SiteAdmin' || sessionData.can_create_site);
        const btnMapsTab = document.getElementById('set-tab-btn-maps');
        if (btnMapsTab) btnMapsTab.style.display = isSiteAdminOrAbove ? 'inline-block' : 'none';

        const isCompanyAdminOrAbove = sessionData && (sessionData.user_role === 'SuperAdmin' || sessionData.user_role === 'CompanyAdmin' || sessionData.can_create_company);
        const btnBrandingTab = document.getElementById('set-tab-btn-branding');
        if (btnBrandingTab) btnBrandingTab.style.display = isCompanyAdminOrAbove ? 'inline-block' : 'none';
    }

    // --- I18N ENGINE LOGIC ---
    async function loadTranslations(lang) {
        try {
            const res = await fetch(`/locales/${lang}.json?v=${Date.now()}`);
            if (res.ok) {
                currentLocale = await res.json();
                applyTranslations();
            }
        } catch (e) {
            console.log('Error loading locale json:', e);
        }
    }

    function t(path, defaultStr) {
        if (!path) return defaultStr;
        const parts = path.split('.');
        let val = currentLocale;
        for (const p of parts) {
            if (val && val[p] !== undefined) val = val[p];
            else return defaultStr;
        }
        return typeof val === 'string' ? val : defaultStr;
    }

    function applyTranslations() {
        if (!currentLocale) return;

        document.querySelectorAll('[data-i18n]').forEach(el => {
            const key = el.getAttribute('data-i18n');
            const translated = t(key, null);
            if (translated !== null && translated !== undefined) {
                if (el.tagName === 'INPUT' || el.tagName === 'TEXTAREA') {
                    if (el.hasAttribute('placeholder')) el.placeholder = translated;
                } else if (el.tagName === 'OPTION') {
                    el.text = translated;
                } else {
                    el.innerHTML = translated;
                }
            }
        });

        document.querySelectorAll('[data-i18n-placeholder]').forEach(el => {
            const key = el.getAttribute('data-i18n-placeholder');
            const translated = t(key, null);
            if (translated !== null && translated !== undefined) {
                el.placeholder = translated;
            }
        });

        document.querySelectorAll('[data-i18n-title]').forEach(el => {
            const key = el.getAttribute('data-i18n-title');
            const translated = t(key, null);
            if (translated !== null && translated !== undefined) {
                el.title = translated;
            }
        });

        if (currentModule) {
            const hTitle = document.getElementById('header-module-title');
            const hSub = document.getElementById('header-module-caption');
            if (hTitle) {
                const titleVal = t(currentModule + '.title', null);
                if (titleVal !== null) hTitle.innerHTML = titleVal;
            }
            if (hSub) {
                const subVal = t(currentModule + '.subtitle', null);
                if (subVal !== null) hSub.innerHTML = subVal;
            }
        }

        if (typeof populateElementSubtypes === 'function') {
            const eqTypeEl = document.getElementById('audit-tipo-equipo');
            if (eqTypeEl) populateElementSubtypes(eqTypeEl.value);
        }
        if (typeof renderExtraPoints === 'function') {
            renderExtraPoints();
        }
        if (currentModule === 'eventmeter' && typeof loadEventMeterHistory === 'function') {
            loadEventMeterHistory();
        }
    }

    async function changeLanguage(lang) {
        setStoredLang(lang);
        if (document.getElementById('settings-lang-select')) document.getElementById('settings-lang-select').value = lang;
        if (document.getElementById('login-landing-lang-select')) document.getElementById('login-landing-lang-select').value = lang;
        try {
            await fetch('/api/set-lang', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ lang })
            });
        } catch(ex) {}
        await loadTranslations(lang);
    }

    document.getElementById('login-form').onsubmit = async function(e) {
        e.preventDefault();
        const email = document.getElementById('login-email').value.trim();
        const password = document.getElementById('login-password').value;
        const errDiv = document.getElementById('login-error');
        const submitBtn = this.querySelector('button[type="submit"]');
        
        if (errDiv) errDiv.style.display = 'none';
        if (submitBtn) {
            submitBtn.disabled = true;
            submitBtn.innerText = '⏳ Verificando credenciales...';
        }

        try {
            const res = await fetch('/api/login', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ email, password })
            });
            const data = await res.json();
            if (res.ok && data.success) {
                // Instantly update session state and display dashboard
                await checkSession();
                document.getElementById('login-password').value = '';
            } else {
                if (errDiv) {
                    errDiv.innerText = data.message ? `❌ ${data.message}` : '❌ Credenciales incorrectas o cuenta inactiva.';
                    errDiv.style.display = 'block';
                }
            }
        } catch (ex) {
            if (errDiv) {
                errDiv.innerText = '❌ Error de conexión al servidor.';
                errDiv.style.display = 'block';
            }
        } finally {
            if (submitBtn) {
                submitBtn.disabled = false;
                submitBtn.innerText = t('login.submit', '🔒 Iniciar Sesión en esd360');
            }
        }
    };

    async function logout() {
        await fetch('/api/logout', { method: 'POST' });
        location.reload();
    }

    async function loadSites() {
        const sel = document.getElementById('active-site-select');
        try {
            const res = await fetch('/api/sites');
            const sites = await res.json();
            allSites = sites || [];

            if (sel) {
                sel.innerHTML = '';
                if (!sessionData.can_change_site) {
                    const activeName = sessionData.site_name || (allSites.length > 0 ? allSites[0].name : 'Mi Planta');
                    const activeId = sessionData.site_id || (allSites.length > 0 ? allSites[0].id : '');
                    sel.innerHTML = `<option value="${activeId}" selected>${activeName}</option>`;
                    sel.disabled = true;
                    sel.title = "Tu rol no permite cambiar de site. Estás asignado exclusivamente a tu planta.";
                } else {
                    sel.disabled = false;
                    allSites.forEach(s => {
                        const opt = document.createElement('option');
                        opt.value = s.id;
                        opt.innerText = `${s.name}`;
                        if (s.id === sessionData.site_id) opt.selected = true;
                        sel.appendChild(opt);
                    });
                }
            }

            populateEquipmentSiteSelects(allSites);
        } catch (ex) {
            console.log('Error loading sites:', ex);
            if (sel) {
                sel.innerHTML = `<option value="${sessionData.site_id || ''}" selected>${sessionData.site_name || 'Mi Planta'}</option>`;
                sel.disabled = true;
            }
        }
    }

    function populateEquipmentSiteSelects(sites) {
        const eqFilter = document.getElementById('eq-site-filter');
        const eqFormSite = document.getElementById('eq-form-site');
        const siteGroup = document.getElementById('eq-site-group');

        if (eqFilter) {
            eqFilter.innerHTML = '<option value="">Todos los Sites...</option>';
            sites.forEach(s => {
                eqFilter.innerHTML += `<option value="${s.id}">${s.name}</option>`;
            });
            if (sessionData.site_id) eqFilter.value = sessionData.site_id;
        }

        if (eqFormSite) {
            eqFormSite.innerHTML = '';
            if (!sessionData.can_change_site) {
                eqFormSite.innerHTML = `<option value="${sessionData.site_id}" selected>${sessionData.site_name || 'Mi Planta'}</option>`;
                if (siteGroup) siteGroup.style.display = 'none';
            } else {
                if (siteGroup) siteGroup.style.display = 'block';
                sites.forEach(s => {
                    eqFormSite.innerHTML += `<option value="${s.id}">${s.name}</option>`;
                });
                if (sessionData.site_id) eqFormSite.value = sessionData.site_id;
            }
        }
    }

    async function changeActiveSite(siteId) {
        const sel = document.getElementById('active-site-select');
        const siteName = sel.options[sel.selectedIndex].text;
        await fetch('/api/set-site', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ site_id: siteId, site_name: siteName })
        });
        location.reload();
    }

    function toggleMobileSidebar() {
        const sidebar = document.getElementById('app-sidebar');
        const backdrop = document.getElementById('sidebar-backdrop');
        if (sidebar && backdrop) {
            sidebar.classList.toggle('open');
            backdrop.classList.toggle('open');
        }
    }

    function closeMobileSidebar() {
        const sidebar = document.getElementById('app-sidebar');
        const backdrop = document.getElementById('sidebar-backdrop');
        if (sidebar && backdrop) {
            sidebar.classList.remove('open');
            backdrop.classList.remove('open');
        }
    }

    function switchModule(modName) {
        currentModule = modName;
        closeMobileSidebar();
        document.querySelectorAll('.module-view').forEach(el => el.style.display = 'none');
        document.querySelectorAll('.nav-item').forEach(el => el.classList.remove('active'));

        const modEl = document.getElementById('mod-' + modName);
        if (modEl) modEl.style.display = 'block';

        const navEl = document.getElementById('nav-' + modName);
        if (navEl) navEl.classList.add('active');

        const hTitle = document.getElementById('header-module-title');
        const hSub = document.getElementById('header-module-caption');
        if (hTitle) {
            hTitle.setAttribute('data-i18n', modName + '.title');
            const titleVal = t(modName + '.title', null);
            if (titleVal !== null) hTitle.innerHTML = titleVal;
        }
        if (hSub) {
            hSub.setAttribute('data-i18n', modName + '.subtitle');
            const subVal = t(modName + '.subtitle', null);
            if (subVal !== null) hSub.innerHTML = subVal;
        }

        loadEquipmentForSite();
        loadSitePhotoPolicy();

        if (modName === 'dashboard') loadDashboardMetrics();
        if (modName === 'audit') initQRScanner();
        if (modName === 'eventmeter') {
            loadEventMeterLinesSelect();
            loadEventMeterHistory();
        }
        if (modName === 'infra') loadInfraData();
        if (modName === 'schedule') {
            loadInfraLinesSelect();
            loadScheduleData();
        }
        if (modName === 'inventory') loadInventory();
        if (modName === 'lab') loadLab();
        if (modName === 'routes') loadRoutes();
        if (modName === 'employees') loadEmployees();
        if (modName === 'settings') loadSettings();
    }

    // --- LIGHTWEIGHT QR SCANNER LOGIC ---
    function initQRScanner() {
        loadAuditLinesSelect();
        populateElementSubtypes(document.getElementById('audit-tipo-equipo').value || "Mobiliario ESD");
        if (!window.Html5Qrcode) return;
        const statusEl = document.getElementById('cam-status');
        
        Html5Qrcode.getCameras().then(devices => {
            if (devices && devices.length) {
                videoDevices = devices.filter(c => {
                    const lbl = c.label.toLowerCase();
                    return lbl.includes('back') || lbl.includes('trasera') || lbl.includes('environment');
                });
                if (videoDevices.length === 0) videoDevices = devices;

                wideCamId = videoDevices[0].id;
                for (let c of videoDevices) {
                    let lbl = c.label.toLowerCase();
                    if (lbl.includes('wide') && !lbl.includes('ultra')) {
                        wideCamId = c.id; break;
                    }
                }
                currentCamIdx = videoDevices.findIndex(c => c.id === wideCamId);
                if (currentCamIdx === -1) currentCamIdx = 0;

                startScannerWithCamId(wideCamId);
            } else {
                statusEl.innerText = "No se detectaron cámaras en el dispositivo.";
            }
        }).catch(err => {
            statusEl.innerText = "Permisos de cámara denegados o cámara no disponible.";
        });
    }

    function startScannerWithCamId(camId) {
        if (!html5QrCode) html5QrCode = new Html5Qrcode("qr-reader");
        const statusEl = document.getElementById('cam-status');

        if (html5QrCode.isScanning) {
            html5QrCode.stop().then(() => { runScanner(camId); }).catch(e => console.log(e));
        } else {
            runScanner(camId);
        }
    }

    function runScanner(camId) {
        const statusEl = document.getElementById('cam-status');
        html5QrCode.start(
            camId,
            { fps: 15, qrbox: { width: 220, height: 220 }, aspectRatio: 1.0 },
            (decodedText) => {
                // QR Code detected!
                document.getElementById('audit-id-elemento').value = decodedText.toUpperCase();
                lookupScannedAsset(decodedText);
            },
            (err) => {}
        ).then(() => {
            let activeCam = videoDevices.find(c => c.id === camId);
            statusEl.innerText = "Lente activo: " + (activeCam ? activeCam.label : "Cámara");
        }).catch(err => {
            statusEl.innerText = "Error al iniciar lente. Prueba '🔄 OTRA CÁMARA'.";
        });
    }

    function startScannerStandard() {
        if (wideCamId) startScannerWithCamId(wideCamId);
    }

    function cycleCamera() {
        if (!videoDevices.length) return;
        currentCamIdx = (currentCamIdx + 1) % videoDevices.length;
        startScannerWithCamId(videoDevices[currentCamIdx].id);
    }

    // --- LOOKUP SCANNED ASSET & HISTORY ---
    async function lookupScannedAsset(scannedId) {
        if (!scannedId || !scannedId.trim()) return;
        const cleanId = scannedId.trim().toUpperCase();
        document.getElementById('audit-id-elemento').value = cleanId;

        const res = await fetch(`/api/audit/last-measurement/${encodeURIComponent(cleanId)}`);
        const data = await res.json();
        
        const card = document.getElementById('scanned-asset-card');
        const cardId = document.getElementById('card-asset-id');
        const cardStatus = document.getElementById('card-asset-status');
        const cardLoc = document.getElementById('card-asset-loc');
        const cardClass = document.getElementById('card-asset-class');
        const cardHist = document.getElementById('card-history-details');

        card.style.display = 'block';
        cardId.innerText = `🔍 ID: ${cleanId}`;

        if (data.found && data.data) {
            const m = data.data;
            cardStatus.className = (m.estatus === 'PASA' || m.status_result === 'PASS') ? 'badge-pass' : 'badge-fail';
            cardStatus.innerText = m.estatus || m.status_result || 'ACTIVE';
            cardLoc.innerText = m.ubicacion || m.linea_ubicacion || m.location || 'N/A';
            cardClass.innerText = m.tipo_equipo || m.category || 'Mobiliario ESD';

            const resTxt = m.resistencia ? `${m.resistencia.toExponential(2)} Ω` : (m.resistance_value ? `${m.resistance_value.toExponential(2)} Ω` : 'N/D');
            const voltTxt = m.voltaje_campo !== undefined ? `${m.voltaje_campo} V` : (m.static_field_value !== undefined ? `${m.static_field_value} V` : 'N/D');

            const lblDate = t('audit.card_date', 'Fecha');
            const lblRes = t('audit.card_res', 'Resistencia');
            const lblField = t('audit.card_field', 'Campo');
            const lblStatus = t('audit.card_status', 'Estatus');

            if (m.is_asset_only) {
                cardHist.innerHTML = `<div>📦 <b>${t('audit.card_registered_asset', 'Activo Registrado en Catálogo')}</b> | 📍 <b>${m.location || 'N/A'}</b></div>`;
            } else {
                const ptTxt = m.punto_contacto ? ` | 📍 <i>${m.punto_contacto}</i>` : '';
                cardHist.innerHTML = `
                    <div>📅 <b>${lblDate}:</b> ${m.fecha_medicion || m.measured_at || 'N/A'}${ptTxt}</div>
                    <div>⚡ <b>${lblRes}:</b> ${resTxt} | 🧲 <b>${lblField}:</b> ${voltTxt}</div>
                    <div>📊 <b>${lblStatus}:</b> <b>${m.estatus || m.status_result || 'PASA'}</b></div>
                `;
            }
            if (m.tipo_equipo || m.category) {
                const eqCat = m.tipo_equipo || m.category;
                document.getElementById('audit-tipo-equipo').value = eqCat;
                toggleAuditFormType(eqCat);
            }
            if (m.subtipo_elemento || m.sub_category || m.subtipo_key) {
                populateElementSubtypes(m.tipo_equipo || m.category, m.subtipo_key || m.subtipo_elemento || m.sub_category);
            }
            if (m.ubicacion || m.location) {
                const u = m.ubicacion || m.location;
                const selU = document.getElementById('audit-ubicacion-select');
                if (selU) {
                    for (let opt of selU.options) {
                        if (opt.value === u || opt.value.toUpperCase() === u.toUpperCase()) {
                            opt.selected = true; break;
                        }
                    }
                }
            }
            if (m.punto_contacto) {
                const mobPt = document.getElementById('mob-punto-contacto');
                const ionPt = document.getElementById('ion-punto-contacto');
                if (mobPt) mobPt.value = m.punto_contacto;
                if (ionPt) ionPt.value = m.punto_contacto;
            }
        } else {
