    document.getElementById('form-event-meter').onsubmit = async function(e) {
        e.preventDefault();
        const linea = document.getElementById('em-linea').value;
        const opId = document.getElementById('em-op-id').value;
        if (!linea) {
            alert(t('eventmeter.opt_select_line', 'Por favor selecciona una línea de producción.'));
            return;
        }
        if (!opId) {
            alert(t('eventmeter.opt_select_asset', 'Por favor selecciona o ingresa el ID de Operación.'));
            return;
        }

        const tiempoRaw = document.getElementById('em-tiempo-valor').value.trim();
        const tiempoVal = tiempoRaw ? parseFloat(tiempoRaw) : null;
        if (!tiempoVal) {
            alert(t('eventmeter.ph_duration', 'Por favor ingresa el tiempo de análisis.'));
            return;
        }
        const tiempoUnidad = document.getElementById('em-tiempo-unidad').value || 'min';
        const tiempoAnalisis = `${tiempoVal} ${tiempoUnidad}`;

        const tempRaw = document.getElementById('em-temp').value.trim();
        const humRaw = document.getElementById('em-hum').value.trim();
        const tempVal = tempRaw ? parseFloat(tempRaw) : 23.5;
        const humVal = humRaw ? parseFloat(humRaw) : 45.0;

        const payload = {
            linea_ubicacion: linea,
            id_operacion: opId,
            tipo_contacto: document.getElementById('em-contacto').value,
            tiempo_analisis: tiempoAnalisis,
            tiempo_analisis_valor: tiempoVal,
            tiempo_analisis_unidad: tiempoUnidad,
            cantidad_eventos: parseInt(document.getElementById('em-cant').value) || 0,
            voltaje_maximo: parseFloat(document.getElementById('em-volt-max').value) || 0,
            temperatura: tempVal,
            humedad: humVal,
            notas: document.getElementById('em-notas').value.trim()
        };

        try {
            const res = await fetch('/api/event-meter', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            });
            const data = await res.json();
            if (data.success) {
                if (data.is_out_of_limit || data.estatus === 'FAIL' || payload.voltaje_maximo > 100) {
                    alert(`⚠️ ¡ALERTA DE DESCARGA FUERA DE LÍMITE!\n\nEl estudio se guardó exitosamente en el sistema, pero el voltaje máximo detectado (${payload.voltaje_maximo} V) EXCEDE el límite permitido de 100 V (Estatus: FAIL / RECHAZADO).\n\nSe requiere atención y revisión en la línea/operación.`);
                } else {
                    alert(`${t('eventmeter.saved_success', 'Estudio Event Meter registrado exitosamente.')} (Estatus: PASS)`);
                }
                document.getElementById('em-linea').value = '';
                document.getElementById('em-op-id').innerHTML = `<option value="">${t('eventmeter.opt_select_asset', '-- Seleccionar Activo u Operación --')}</option>`;
                document.getElementById('em-tiempo-valor').value = '';
                document.getElementById('em-cant').value = '';
                document.getElementById('em-volt-max').value = '';
                document.getElementById('em-temp').value = '';
                document.getElementById('em-hum').value = '';
                document.getElementById('em-notas').value = '';
                loadEventMeterHistory();
            } else {
                alert('❌ Error al guardar el registro de Event Meter.');
            }
        } catch(ex) {
            alert('❌ Error de conexión al servidor.');
        }
    };

    async function loadEventMeterHistory() {
        const container = document.getElementById('event-meter-history-table');
        if (!container) return;

        try {
            const siteId = sessionData.site_id || '';
            const res = await fetch(`/api/event-meter?siteId=${siteId}`);
            if (!res.ok) throw new Error('Error fetching event meter history');
            const logs = await res.json();
            cachedEventMeterLogs = logs || [];

            if (cachedEventMeterLogs.length === 0) {
                container.innerHTML = `<div class="glass-card" style="text-align:center; padding:20px; color:var(--text-muted); font-size:13px;">${t('eventmeter.no_records', 'No hay registros de Event Meter para este site.')}</div>`;
                return;
            }

            const isAdmin = sessionData.can_create_user || sessionData.user_role === 'SuperAdmin' || sessionData.user_role === 'CompanyAdmin' || sessionData.user_role === 'SiteAdmin';

            let html = `<div class="table-responsive" style="max-height:500px; overflow-y:auto; border:1px solid var(--border-color); border-radius:8px;">
                <table class="data-table" style="margin:0; width:100%;">
                    <thead style="position:sticky; top:0; background:#F8FAFC; z-index:2;">
                        <tr>
                            <th style="min-width:120px;" data-i18n="eventmeter.col_date">${t('eventmeter.col_date', 'Fecha')}</th>
                            <th style="min-width:130px;" data-i18n="eventmeter.col_line">${t('eventmeter.col_line', 'Línea / Ubicación')}</th>
                            <th style="min-width:120px;" data-i18n="eventmeter.col_op_id">${t('eventmeter.col_op_id', 'ID Operación')}</th>
                            <th style="min-width:110px;" data-i18n="eventmeter.col_contact">${t('eventmeter.col_contact', 'Contacto')}</th>
                            <th style="min-width:90px; text-align:center;" data-i18n="eventmeter.col_duration">${t('eventmeter.col_duration', 'Tiempo')}</th>
                            <th style="min-width:80px; text-align:center;" data-i18n="eventmeter.col_events">${t('eventmeter.col_events', 'Eventos')}</th>
                            <th style="min-width:100px;" data-i18n="eventmeter.col_volt_max">${t('eventmeter.col_volt_max', 'Voltaje Máx')}</th>
                            <th style="min-width:110px;" data-i18n="eventmeter.col_temp_hum">${t('eventmeter.col_temp_hum', 'Temp / Hum')}</th>
                            <th style="min-width:85px; text-align:center;" data-i18n="eventmeter.col_status">${t('eventmeter.col_status', 'Estatus')}</th>
                            ${isAdmin ? `<th style="min-width:140px; text-align:center;" data-i18n="eventmeter.col_actions">${t('eventmeter.col_actions', 'Acciones')}</th>` : ''}
                        </tr>
                    </thead>
                    <tbody>`;

            cachedEventMeterLogs.forEach(l => {
                const dateStr = l.measured_at ? new Date(l.measured_at).toLocaleDateString() + ' ' + new Date(l.measured_at).toLocaleTimeString([], {hour:'2-digit', minute:'2-digit'}) : '-';
                const statusBadge = (l.status_result === 'PASS') 
                    ? `<span class="badge-pass" style="font-size:11px; padding:3px 8px;">PASS</span>` 
                    : `<span class="badge-fail" style="font-size:11px; padding:3px 8px;">FAIL</span>`;
                const tempHum = (l.temperatura || l.humedad) ? `${l.temperatura || '--'}°C / ${l.humedad || '--'}%` : '-';
                const durationStr = l.tiempo_analisis || (l.tiempo_analisis_valor ? `${l.tiempo_analisis_valor} ${l.tiempo_analisis_unidad || 'min'}` : '-');
                const obsTooltip = l.observaciones ? `<div style="font-size:11px; color:var(--text-muted); font-style:italic; margin-top:2px;">${l.observaciones}</div>` : '';

                html += `<tr>
                    <td style="font-size:12px;"><b>${dateStr}</b></td>
                    <td style="font-size:12px;">${l.linea_ubicacion || 'SMT-01'}</td>
                    <td style="font-size:12.5px; font-weight:700; color:var(--accent-blue);">${l.id_operacion || '-'}</td>
                    <td style="font-size:12px;">${l.tipo_contacto || '-'}</td>
                    <td style="text-align:center; font-size:12px; font-weight:600;">${durationStr}</td>
                    <td style="text-align:center; font-weight:700; font-size:12.5px;">${l.cantidad_eventos}</td>
                    <td style="font-weight:800; color:${l.voltaje_maximo > 100 ? 'var(--accent-rose)' : 'var(--text-primary)'}; font-size:12.5px;">${l.voltaje_maximo} V</td>
                    <td style="font-size:11.5px; color:var(--text-muted);">${tempHum}</td>
                    <td style="text-align:center;">${statusBadge}${obsTooltip}</td>
                    ${isAdmin ? `
                    <td style="text-align:center;">
                        <div style="display:flex; justify-content:center; gap:6px;">
                            <button type="button" class="tab-btn" style="padding:4px 8px; font-size:11px;" onclick="openEditEventMeterModal('${l.id}')" title="Modificar">${t('eventmeter.btn_edit', '✏️ Editar')}</button>
                            <button type="button" class="tab-btn" style="padding:4px 8px; font-size:11px; color:var(--accent-rose); border-color:rgba(225,29,72,0.3);" onclick="deleteEventMeterLog('${l.id}')" title="Eliminar">${t('eventmeter.btn_delete', '🗑️ Eliminar')}</button>
                        </div>
                    </td>` : ''}
                </tr>`;
            });

            html += `</tbody></table></div>`;
            container.innerHTML = html;
        } catch(ex) {
            console.error('Error rendering event meter history:', ex);
            container.innerHTML = `<div class="glass-card" style="text-align:center; color:var(--accent-rose); padding:16px;">❌ Error al cargar historial.</div>`;
        }
    }

    async function openEditEventMeterModal(logId) {
        const log = cachedEventMeterLogs.find(x => x.id === logId);
        if (!log) return;

        const modal = document.getElementById('modal-edit-eventmeter');
        if (!modal) return;

        document.getElementById('edit-em-id').value = log.id;
        document.getElementById('edit-em-contacto').value = log.tipo_contacto || 'Maquinaria';
        document.getElementById('edit-em-tiempo-valor').value = log.tiempo_analisis_valor || (log.tiempo_analisis ? parseFloat(log.tiempo_analisis) : 30) || 30;
        document.getElementById('edit-em-tiempo-unidad').value = log.tiempo_analisis_unidad || (log.tiempo_analisis && log.tiempo_analisis.includes('s') ? 's' : (log.tiempo_analisis && log.tiempo_analisis.includes('h') ? 'h' : 'min')) || 'min';
        document.getElementById('edit-em-cant').value = log.cantidad_eventos;
        document.getElementById('edit-em-volt-max').value = log.voltaje_maximo;
        document.getElementById('edit-em-temp').value = log.temperatura || 23.5;
        document.getElementById('edit-em-hum').value = log.humedad || 45;
        document.getElementById('edit-em-notas').value = log.observaciones || '';

        // Populate lines in edit modal
        const lineSel = document.getElementById('edit-em-linea');
        const siteId = sessionData.site_id || '';
        try {
            const res = await fetch(`/api/lines?siteId=${siteId}`);
            if (res.ok) {
                const lines = await res.json();
                lineSel.innerHTML = '';
                lines.forEach(l => {
                    const name = l.nombre_linea || l.name;
                    lineSel.innerHTML += `<option value="${name}">${name}</option>`;
                });
                lineSel.value = log.linea_ubicacion || (lines.length > 0 ? (lines[0].nombre_linea || lines[0].name) : '');
            }
        } catch(e) {}

        // Populate operation / assets in edit modal
        const opSel = document.getElementById('edit-em-op-id');
        try {
            const res = await fetch(`/api/line-assets?line=${encodeURIComponent(lineSel.value)}&siteId=${siteId}`);
            if (res.ok) {
                const assets = await res.json();
                opSel.innerHTML = '';
                let foundCurrent = false;
                assets.forEach(a => {
                    const subtype = a.element_subtype ? ` (${a.element_subtype})` : '';
                    if (a.asset_id === log.id_operacion) foundCurrent = true;
                    opSel.innerHTML += `<option value="${a.asset_id}">${a.asset_id}${subtype}</option>`;
                });
                if (!foundCurrent && log.id_operacion) {
                    opSel.innerHTML = `<option value="${log.id_operacion}" selected>${log.id_operacion}</option>` + opSel.innerHTML;
                }
                opSel.value = log.id_operacion;
            }
        } catch(e) {}

        modal.style.display = 'flex';
    }

    function closeEditEventMeterModal() {
        const modal = document.getElementById('modal-edit-eventmeter');
        if (modal) modal.style.display = 'none';
    }

    async function submitEditEventMeter(e) {
        e.preventDefault();
        const id = document.getElementById('edit-em-id').value;
        const tiempoVal = parseFloat(document.getElementById('edit-em-tiempo-valor').value) || 30;
        const tiempoUnidad = document.getElementById('edit-em-tiempo-unidad').value || 'min';
        const tiempoAnalisis = `${tiempoVal} ${tiempoUnidad}`;

        const payload = {
            linea_ubicacion: document.getElementById('edit-em-linea').value,
            id_operacion: document.getElementById('edit-em-op-id').value,
            tipo_contacto: document.getElementById('edit-em-contacto').value,
            tiempo_analisis: tiempoAnalisis,
            tiempo_analisis_valor: tiempoVal,
            tiempo_analisis_unidad: tiempoUnidad,
            cantidad_eventos: parseInt(document.getElementById('edit-em-cant').value) || 0,
            voltaje_maximo: parseFloat(document.getElementById('edit-em-volt-max').value) || 0,
            temperatura: parseFloat(document.getElementById('edit-em-temp').value) || 23.5,
            humedad: parseFloat(document.getElementById('edit-em-hum').value) || 45.0,
            notas: document.getElementById('edit-em-notas').value.trim()
        };

        try {
            const res = await fetch(`/api/event-meter/${encodeURIComponent(id)}`, {
                method: 'PUT',
                headers: { 
                    'Content-Type': 'application/json',
                    'X-User-Id': (sessionData && sessionData.user_id) || '',
                    'X-User-Role': (sessionData && sessionData.user_role) || ''
                },
                body: JSON.stringify(payload)
            });
            const data = await res.json();
            if (res.ok && data.success) {
                alert(t('eventmeter.updated_success', 'Registro de Event Meter actualizado exitosamente.'));
                closeEditEventMeterModal();
                loadEventMeterHistory();
            } else {
                alert(data.message || '❌ Error al actualizar registro.');
            }
        } catch(ex) {
            alert('❌ Error de conexión con el servidor.');
        }
    }

    async function deleteEventMeterLog(logId) {
        if (!confirm(t('eventmeter.confirm_delete', '¿Estás seguro de que deseas eliminar este registro de Event Meter?'))) return;

        try {
            const res = await fetch(`/api/event-meter/${encodeURIComponent(logId)}`, {
                method: 'DELETE',
                headers: {
                    'Content-Type': 'application/json',
                    'X-User-Id': (sessionData && sessionData.user_id) || '',
                    'X-User-Role': (sessionData && sessionData.user_role) || ''
                }
            });
            const data = await res.json();
            if (res.ok && data.success) {
                alert(t('eventmeter.deleted_success', 'Registro de Event Meter eliminado exitosamente.'));
                loadEventMeterHistory();
            } else {
                alert(data.message || '❌ Error al eliminar el registro.');
            }
        } catch(ex) {
            alert('❌ Error de comunicación con el servidor.');
        }
    }

    async function loadDashboardMetrics() {
        const res = await fetch('/api/dashboard-metrics');
        const data = await res.json();

        document.getElementById('dash-total-assets').innerText = data.totalAssets;
        document.getElementById('dash-total-floors').innerText = data.totalFloors;
        document.getElementById('dash-total-grounding').innerText = data.totalGrounding;
        document.getElementById('dash-total-entrance').innerText = data.totalEntrance;

        renderDashboardChart(data.assetsData);
    }

    let chartInstance = null;
    function renderDashboardChart(assets) {
        const ctx = document.getElementById('dashboardChart').getContext('2d');
        if (chartInstance) chartInstance.destroy();

        const categories = {};
        assets.forEach(a => {
            const cat = a.category || 'General';
            categories[cat] = (categories[cat] || 0) + 1;
        });

        chartInstance = new Chart(ctx, {
            type: 'bar',
            data: {
                labels: Object.keys(categories),
                datasets: [{
                    label: 'Cantidad de Activos Registrados',
                    data: Object.values(categories),
                    backgroundColor: '#2563EB',
                    borderRadius: 5
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: { legend: { labels: { color: '#0F172A', font: { family: 'Montserrat', weight: '700' } } } },
                scales: {
                    x: { ticks: { color: '#64748B', font: { family: 'Montserrat' } }, grid: { color: '#F1F5F9' } },
                    y: { ticks: { color: '#64748B', font: { family: 'Inter' } }, grid: { color: '#F1F5F9' } }
                }
            }
        });
    }

    function switchInfraTab(tabName) {
        document.querySelectorAll('#mod-infra .tab-btn').forEach(btn => btn.classList.remove('active'));
        document.querySelectorAll('#mod-infra .tab-content').forEach(c => c.classList.remove('active'));
        event.currentTarget.classList.add('active');
        document.getElementById('infra-tab-' + tabName).classList.add('active');
    }

    async function loadInfraLinesSelect() {
        const selects = ['gnd-loc', 'fl-room', 'iso-loc', 'rep-linea'];
        try {
            const siteId = (sessionData && sessionData.site_id) || '';
            const res = await fetch(`/api/lines?siteId=${siteId}`);
            if (res.ok) {
                const lines = await res.json();
                const defaultText = t('eventmeter.opt_select_line', '-- Seleccionar Línea --');
                selects.forEach(id => {
                    const sel = document.getElementById(id);
                    if (!sel) return;
                    const prevVal = sel.value;
                    sel.innerHTML = `<option value="">${defaultText}</option>`;
                    lines.forEach(l => {
                        const name = l.nombre_linea || l.name;
                        sel.innerHTML += `<option value="${name}">${name}</option>`;
                    });
                    if (prevVal && lines.some(l => (l.nombre_linea || l.name) === prevVal)) {
                        sel.value = prevVal;
                    } else {
                        sel.value = '';
                    }
                });
            }
        } catch(e) {
            console.error('Error loading infra lines:', e);
        }
    }

    async function loadInfraData() {
        await loadInfraLinesSelect();
        const siteId = (sessionData && sessionData.site_id) || '';

        // 1. Load Grounding History
        try {
            const gRes = await fetch(`/api/infra/grounding?siteId=${siteId}`);
