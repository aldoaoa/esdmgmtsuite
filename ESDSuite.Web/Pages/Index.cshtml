    // --- EMAIL NOTIFICATIONS CLIENT LOGIC ---
    async function sendTestNotificationEmail() {
        const input = document.getElementById('test-email-target');
        const fb = document.getElementById('test-email-feedback');
        const btn = document.getElementById('btn-send-test-email');
        const email = input ? input.value.trim() : '';

        if (!email) {
            alert('Por favor ingresa un correo destinatario.');
            return;
        }

        if (btn) { btn.disabled = true; btn.innerText = '⏳ Enviando...'; }
        if (fb) { fb.style.display = 'none'; }

        try {
            const res = await fetch('/api/notifications/test-email', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ to_email: email })
            });
            const data = await res.json();
            if (fb) {
                fb.style.display = 'block';
                if (data.success) {
                    fb.style.color = '#059669';
                    fb.innerHTML = `✅ ${escapeHtml(data.message)}`;
                    await loadEmailNotificationLogs();
                } else {
                    fb.style.color = '#DC2626';
                    fb.innerHTML = `❌ ${escapeHtml(data.message || 'Error al enviar')}`;
                }
            }
        } catch(ex) {
            if (fb) {
                fb.style.display = 'block';
                fb.style.color = '#DC2626';
                fb.innerHTML = '❌ Error de comunicación con el servidor.';
            }
        } finally {
            if (btn) { btn.disabled = false; btn.innerText = '📨 Enviar Prueba'; }
        }
    }

