    // --- COMPANY BRANDING & LOGO MANAGEMENT ---
    let brandingSelectedCompanyId = null;

    function checkBrandingTabVisibility() {
        const isSuperAdmin = sessionData && (sessionData.user_role === 'SuperAdmin' || sessionData.user_role === 'Root' || sessionData.can_create_company);
        const isCompanyAdmin = sessionData && (sessionData.user_role === 'CompanyAdmin' || sessionData.can_create_site || isSuperAdmin);

        const tabBtn = document.getElementById('set-tab-btn-branding');
        if (tabBtn) {
            tabBtn.style.display = isCompanyAdmin ? 'inline-block' : 'none';
        }
    }

    async function loadBrandingSettingsTab() {
        const isSuperAdmin = sessionData && (sessionData.user_role === 'SuperAdmin' || sessionData.user_role === 'Root' || sessionData.can_create_company);
        const isCompanyAdmin = sessionData && (sessionData.user_role === 'CompanyAdmin' || sessionData.can_create_site || isSuperAdmin);

        const tabBtn = document.getElementById('set-tab-btn-branding');
        if (tabBtn) {
            tabBtn.style.display = isCompanyAdmin ? 'inline-block' : 'none';
        }

        if (!isCompanyAdmin) return;

        const compSelectContainer = document.getElementById('branding-company-select-container');
        const compSelect = document.getElementById('branding-company-select');

        if (isSuperAdmin) {
            if (compSelectContainer) compSelectContainer.style.display = 'block';
            if (compSelect && allCompanies && allCompanies.length > 0) {
                compSelect.innerHTML = allCompanies.map(c => `<option value="${c.id}">${c.name}</option>`).join('');
                if (!brandingSelectedCompanyId) {
                    brandingSelectedCompanyId = compSelect.value || allCompanies[0].id;
                } else {
                    compSelect.value = brandingSelectedCompanyId;
                }
            }
        } else {
            if (compSelectContainer) compSelectContainer.style.display = 'none';
            brandingSelectedCompanyId = sessionData.company_id || '';
        }

        await fetchCompanyLogo(brandingSelectedCompanyId);
    }

    async function onBrandingCompanyChange(companyId) {
        brandingSelectedCompanyId = companyId;
        await fetchCompanyLogo(companyId);
    }

    async function fetchCompanyLogo(companyId) {
        const img = document.getElementById('branding-logo-preview-img');
        if (!img) return;

        try {
            const url = companyId ? `/api/settings/company-logo?companyId=${companyId}` : '/api/settings/company-logo';
            const res = await fetch(url);
            const data = await res.json();
            if (data && data.logo_url) {
                img.src = data.logo_url;
            } else {
                img.src = '/images/esd360-logo.png';
            }
        } catch {
            img.src = '/images/esd360-logo.png';
        }
    }

    function previewBrandingFile(input) {
        if (input.files && input.files[0]) {
            const reader = new FileReader();
            reader.onload = function(e) {
                const img = document.getElementById('branding-logo-preview-img');
                if (img) img.src = e.target.result;
            };
            reader.readAsDataURL(input.files[0]);
        }
    }

    async function submitCompanyLogo(e) {
        e.preventDefault();
        const fileInput = document.getElementById('branding-file-input');
        const btn = document.getElementById('btn-save-company-logo');

        if (!fileInput || !fileInput.files || !fileInput.files[0]) {
            alert('⚠️ Selecciona un archivo de imagen válido.');
            return;
        }

        const formData = new FormData();
        formData.append('file', fileInput.files[0]);
        if (brandingSelectedCompanyId) {
            formData.append('companyId', brandingSelectedCompanyId);
        }

        if (btn) {
            btn.disabled = true;
            btn.innerText = '⏳ Guardando logotipo corporativo...';
        }

        try {
            const res = await fetch('/api/settings/company-logo', {
                method: 'POST',
                body: formData
            });
            const data = await res.json();
            if (res.ok && data.success) {
                alert('✅ ' + (data.message || t('settings.branding_success', 'Logotipo corporativo actualizado exitosamente.')));
                if (data.logo_url) {
                    const img = document.getElementById('branding-logo-preview-img');
                    if (img) img.src = data.logo_url;
                }
                fileInput.value = '';
            } else {
                alert('❌ Error al subir logotipo: ' + (data.message || 'Error desconocido'));
            }
        } catch (ex) {
            alert('❌ Error de conexión: ' + ex.message);
        } finally {
            if (btn) {
                btn.disabled = false;
                btn.innerText = t('settings.branding_btn_upload', '💾 Subir y Guardar Logotipo');
            }
        }
    }

    async function loadEquipmentTable() {
        const filterVal = document.getElementById('eq-site-filter')?.value || '';
        const url = filterVal ? `/api/equipment?siteId=${filterVal}` : '/api/equipment';
        try {
            const res = await fetch(url);
            const eqList = await res.json();
            const tbody = document.getElementById('equipment-table-body');
            if (!tbody) return;

            tbody.innerHTML = '';
            if (!eqList || eqList.length === 0) {
                tbody.innerHTML = '<tr><td colspan="9" style="text-align:center; padding:18px; color:var(--text-muted);">No hay equipos de medición registrados en este site.</td></tr>';
                return;
            }

            eqList.forEach(eq => {
                const nextDateStr = eq.fecha_proxima_calibracion || eq.fecha_vencimiento || '';
                let statusBadge = `<span class="badge-pass">🟢 ${t('settings.status_valid', 'Vigente')}</span>`;
                
                if (nextDateStr) {
                    const nextDate = new Date(nextDateStr);
                    const today = new Date();
                    today.setHours(0,0,0,0);
                    const diffTime = nextDate - today;
                    const diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24));
                    
                    if (diffDays < 0) {
                        statusBadge = `<span class="badge-fail">🔴 ${t('settings.status_expired', 'Vencido')} (${Math.abs(diffDays)}d)</span>`;
                    } else if (diffDays <= 30) {
                        statusBadge = `<span class="badge-pending">⚠️ ${t('settings.status_soon', 'Por vencer')} (${diffDays}d)</span>`;
                    } else {
                        statusBadge = `<span class="badge-pass">🟢 ${t('settings.status_valid', 'Vigente')} (${diffDays}d)</span>`;
                    }
                }

                const canDelete = sessionData && sessionData.can_create_area; // SiteAdmin or higher

                const certHtml = eq.certificado_url
                    ? `<a href="${eq.certificado_url}" target="_blank" download class="btn-primary" style="background:#2563EB; padding:3px 8px; font-size:11px; text-decoration:none; display:inline-flex; align-items:center; gap:4px;" title="Descargar / Abrir Certificado"><span data-i18n="settings.btn_view_cert">📄 ${t('settings.btn_view_cert', 'Ver PDF')}</span></a>`
                    : `<span style="color:var(--text-muted); font-size:11px;" data-i18n="settings.no_cert">${t('settings.no_cert', 'Sin certificado')}</span>`;

                tbody.innerHTML += `<tr>
                    <td><b style="${eq.certificado_url ? 'cursor:pointer; color:var(--accent-blue);' : ''}" onclick="${eq.certificado_url ? `window.open('${eq.certificado_url}', '_blank')` : ''}">${eq.codigo_equipo || 'N/A'}</b></td>
                    <td>${eq.nombre_equipo || 'Sin descripción'}</td>
                    <td>${eq.marca_modelo || eq.marca || 'N/A'}</td>
                    <td>${eq.numero_serie || 'N/A'}</td>
                    <td>${eq.fecha_ultima_calibracion || 'N/A'}</td>
                    <td><b>${nextDateStr || 'N/A'}</b></td>
                    <td>${statusBadge}</td>
                    <td>${certHtml}</td>
                    <td>
                        ${canDelete ? `<button type="button" class="btn-primary" style="background:var(--accent-rose); padding:3px 7px; font-size:11px;" onclick="deleteEquipment('${eq.id}')">🗑️ Eliminar</button>` : '<span style="color:var(--text-muted); font-size:11px;">Lectura</span>'}
                    </td>
                </tr>`;
            });
        } catch (ex) {
            console.log('Error loading equipment table:', ex);
        }
    }

    function toggleAddEquipmentForm() {
        const container = document.getElementById('eq-form-container');
        if (container) {
            container.style.display = container.style.display === 'none' ? 'block' : 'none';
        }
    }

    document.getElementById('form-create-equipment').onsubmit = async function(e) {
        e.preventDefault();
        const site_id = document.getElementById('eq-form-site').value || sessionData.site_id;
        const codigo_equipo = document.getElementById('eq-code').value.trim();
        const nombre_equipo = document.getElementById('eq-name').value.trim();
        const marca_modelo = document.getElementById('eq-brand').value.trim();
        const numero_serie = document.getElementById('eq-sn').value.trim();
        const fecha_ultima_calibracion = document.getElementById('eq-date-last').value;
        const fecha_proxima_calibracion = document.getElementById('eq-date-next').value;

        const fileInput = document.getElementById('eq-cert-file');
        let certificado_url = '';
        let certificado_nombre = '';

        const submitBtn = document.getElementById('btn-save-eq-submit');
        if (submitBtn) {
            submitBtn.disabled = true;
            submitBtn.innerText = t('settings.uploading_cert', 'Subiendo certificado...');
        }

        try {
            if (fileInput && fileInput.files && fileInput.files[0]) {
                const formData = new FormData();
                formData.append('file', fileInput.files[0]);
                formData.append('equipmentCode', codigo_equipo);
                formData.append('siteId', site_id);

                const upRes = await fetch('/api/equipment/upload-certificate', {
                    method: 'POST',
                    body: formData
                });
                if (upRes.ok) {
                    const upData = await upRes.json();
                    if (upData.success) {
                        certificado_url = upData.certificate_url;
                        certificado_nombre = upData.filename;
                    }
                }
            }

            const res = await fetch('/api/equipment', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    site_id,
                    codigo_equipo,
                    nombre_equipo,
                    marca_modelo,
                    numero_serie,
                    fecha_ultima_calibracion,
                    fecha_proxima_calibracion,
                    certificado_url,
                    certificado_nombre
                })
            });

            const data = await res.json();
            if (data.success) {
                showToast(`✅ Equipo "${codigo_equipo}" registrado exitosamente.`);
                toggleAddEquipmentForm();
                document.getElementById('form-create-equipment').reset();
                loadEquipmentTable();
                loadEquipmentForSite();
            } else {
                showToast('❌ ' + (data.message || 'Error al registrar el equipo de medición.'), 'error');
            }
        } catch(ex) {
            console.error('Error creating equipment:', ex);
            showToast('❌ Error de conexión al guardar el equipo.', 'error');
        } finally {
            if (submitBtn) {
                submitBtn.disabled = false;
                submitBtn.innerText = t('settings.btn_save_supabase', '💾 Guardar Equipo');
            }
        }
    };

    async function deleteEquipment(id) {
        if (!confirm('¿Estás seguro de eliminar este equipo de medición?')) return;
        const res = await fetch(`/api/equipment/${id}`, { method: 'DELETE' });
        const data = await res.json();
        if (data.success) {
            showToast('✅ Equipo eliminado correctamente.');
            loadEquipmentTable();
            loadEquipmentForSite();
        } else {
            showToast('❌ Error al eliminar el equipo.', 'error');
        }
    }

    let expandedTreeNodes = new Set();

    function showToast(msg, type = 'success') {
        const container = document.getElementById('toast-container');
        if (!container) return;
        const toast = document.createElement('div');
        toast.className = `toast-msg toast-${type}`;
        toast.innerHTML = msg;
        container.appendChild(toast);
        setTimeout(() => {
            toast.style.opacity = '0';
            toast.style.transition = 'opacity 0.3s ease';
            setTimeout(() => toast.remove(), 300);
        }, 2200);
    }

    async function loadHierarchyTree() {
        const container = document.getElementById('multi-tenant-tree');
        try {
            const res = await fetch('/api/hierarchy');
            if (!res.ok) {
                container.innerHTML = `<p style="font-size:12.5px; color:var(--accent-rose);">❌ Error al cargar jerarquía desde el servidor.</p>`;
                return;
            }
            const tree = await res.json();
            
            if (!tree || tree.length === 0) {
                container.innerHTML = `<p style="font-size:12.5px; color:var(--text-muted);">No hay empresas o sites registrados aún.</p>`;
                return;
            }

            const canCreateSite = sessionData && sessionData.can_create_site;
            const canCreateArea = sessionData && sessionData.can_create_area;

            let html = '';
            tree.forEach((comp, cIdx) => {
                const compId = `comp-children-${cIdx}`;
                const sites = comp.sites || [];
                const safeCompName = (comp.name || '').replace(/'/g, "\\'");
                const isCompOpen = expandedTreeNodes.has(compId) ? ' open' : '';
                
                html += `<div class="tree-node">
                    <div class="tree-header" onclick="toggleTreeNode('${compId}')">
                        <span style="display:inline-flex; align-items:center; gap:6px;"><img src="/images/icons/icon-companies.svg" class="ui-icon-3d-sm" alt="" /> <b>${comp.name}</b> <span style="font-size:11px; color:var(--text-muted); font-weight:400;">(${sites.length} Sites)</span></span>
                        <div style="display:flex; align-items:center; gap:8px;">
                            ${canCreateSite ? `<button type="button" class="tree-action-btn" title="Agregar Site a esta Empresa" onclick="event.stopPropagation(); showAddSiteForCompanyModal('${comp.id}', '${safeCompName}', '${compId}')">➕ Site</button>` : ''}
                            <span style="font-size:11px;">▶️</span>
                        </div>
                    </div>
                    <div class="tree-children${isCompOpen}" id="${compId}">`;

                if (sites.length === 0) {
                    html += `<div class="tree-leaf"><i>Sin sites registrados en esta empresa.</i></div>`;
                } else {
                    sites.forEach((site, sIdx) => {
                        const siteId = `site-children-${cIdx}-${sIdx}`;
                        const locs = site.locations || [];
                        const safeSiteName = (site.name || '').replace(/'/g, "\\'");
                        const isSiteOpen = expandedTreeNodes.has(siteId) ? ' open' : '';

                        html += `<div style="margin:4px 0;">
                            <div class="tree-subnode" onclick="toggleTreeNode('${siteId}')">
                                <span style="display:inline-flex; align-items:center; gap:6px;"><img src="/images/icons/icon-companies.svg" class="ui-icon-3d-sm" style="width:15px; height:15px;" alt="" /> <b>${site.name}</b> <span style="font-size:11px; color:var(--text-muted);">(${locs.length} Áreas/Líneas)</span></span>
                                <div style="display:flex; align-items:center; gap:8px;">
                                    ${canCreateArea ? `<button type="button" class="tree-action-btn" title="Agregar Área a este Site" onclick="event.stopPropagation(); showAddAreaForSiteModal('${site.id}', '${safeSiteName}', '${compId}', '${siteId}')">➕ Área / Línea</button>` : ''}
                                    <span style="font-size:10px;">▶️</span>
                                </div>
                            </div>
                            <div class="tree-children${isSiteOpen}" id="${siteId}">`;

                        if (locs.length === 0) {
                            html += `<div class="tree-leaf" style="justify-content:space-between;">
                                <span><img src="/images/icons/icon-routes.svg" class="ui-icon-3d-sm" alt="" /> <i>Sin áreas registradas en este site.</i></span>
                            </div>`;
                        } else {
                            const areaGroupMap = {};
                            locs.forEach(loc => {
                                if (loc.includes(' -> ')) {
                                    const parts = loc.split(' -> ');
                                    const parent = parts[0].trim();
                                    const child = parts.slice(1).join(' -> ').trim();
                                    if (!areaGroupMap[parent]) areaGroupMap[parent] = [];
                                    if (child && !areaGroupMap[parent].includes(child)) {
                                        areaGroupMap[parent].push(child);
                                    }
                                } else {
                                    if (!areaGroupMap[loc]) areaGroupMap[loc] = [];
                                }
                            });

                            Object.keys(areaGroupMap).forEach(areaName => {
                                const subOps = areaGroupMap[areaName];
                                const safeAreaName = (areaName || '').replace(/'/g, "\\'");

                                html += `<div class="area-card-box">
                                    <div class="area-header">
                                        <span style="display:inline-flex; align-items:center; gap:6px;"><img src="/images/icons/icon-routes.svg" class="ui-icon-3d-sm" alt="" /> <b>${areaName}</b> ${subOps.length > 0 ? `<span style="font-size:11px; color:var(--text-muted); font-weight:400;">(${subOps.length} Sub-operaciones)</span>` : ''}</span>
                                        ${canCreateArea ? `<button type="button" class="tree-action-btn" style="padding:2px 8px; font-size:10.5px;" title="Agregar Operación a ${safeAreaName}" onclick="event.stopPropagation(); showAddSubOperationModal('${site.id}', '${safeAreaName}', '${compId}', '${siteId}')">➕ Operación</button>` : ''}
                                    </div>`;

                                if (subOps.length > 0) {
                                    html += `<div class="sub-ops-container">`;
                                    subOps.forEach(sub => {
                                        html += `<div class="sub-op-item">
                                            <span style="display:inline-flex; align-items:center; gap:6px;"><img src="/images/icons/icon-machinery.svg" class="ui-icon-3d-sm" alt="" /> <b>${sub}</b></span>
                                            <span style="font-size:10.5px; color:var(--text-muted); font-weight:600;">Operación</span>
                                        </div>`;
                                    });
                                    html += `</div>`;
                                }

                                html += `</div>`;
                            });
                        }
                        html += `</div></div>`;
                    });
                }
                html += `</div></div>`;
            });

            container.innerHTML = html;
        } catch (ex) {
            console.log('Error loading hierarchy:', ex);
            container.innerHTML = `<p style="font-size:12.5px; color:var(--accent-rose);">❌ Error de conexión al cargar la estructura.</p>`;
        }
    }

    function toggleTreeNode(id) {
        const el = document.getElementById(id);
        if (el) {
            el.classList.toggle('open');
            if (el.classList.contains('open')) {
                expandedTreeNodes.add(id);
            } else {
                expandedTreeNodes.delete(id);
            }
        }
    }

