        });
    }

    document.getElementById('audit-main-form').onsubmit = async function(e) {
        e.preventDefault();
        const id_elemento = document.getElementById('audit-id-elemento').value.trim().toUpperCase();
        const tipo_equipo = document.getElementById('audit-tipo-equipo').value;
        const subtipo_key = document.getElementById('audit-subtipo-elemento').value;
        const subtipo_label = t('audit.subtypes.' + subtipo_key, subtipo_key);
        const ubicacion = document.getElementById('audit-ubicacion-select').value;
        const auditor = (sessionData && (sessionData.user_name || sessionData.user_email)) || 'Auditor ESD';
        const comentarios = document.getElementById('audit-comentarios').value;

        if (!ubicacion) {
            alert(t('audit.opt_select_line', 'Por favor selecciona una línea de producción.'));
            return;
        }

        const group = getCategoryGroup(tipo_equipo);
        const punto_contacto = (group === 'ionizer') 
            ? (document.getElementById('ion-punto-contacto')?.value.trim() || '') 
            : (document.getElementById('mob-punto-contacto')?.value.trim() || '');

        const equipment_id = document.getElementById('audit-equipment-select')?.value || '';
        const evidence_url = document.getElementById('audit-photo-url')?.value || '';

        const payload = {
            id_elemento,
            tipo_equipo,
            subtipo_elemento: subtipo_label,
            subtipo_key,
            ubicacion,
            punto_contacto,
            auditor,
            comentarios,
            equipment_id,
            evidence_url,
            es_maquinaria: group === 'machinery'
        };

        if (group === 'ionizer') {
            payload.tiempo_descarga = parseFloat(document.getElementById('ion-tiempo').value || 0);
            payload.voltaje_balance = parseInt(document.getElementById('ion-balance').value || 0);
        } else {
            payload.resistencia = parseFloat(document.getElementById('mob-resistencia').value || 0);
            payload.voltaje_campo = parseInt(document.getElementById('mob-campo').value || 0);
            payload.mediciones_extra = extraPoints;
        }

        const res = await fetch('/api/audit/submit-form', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
        });
        const data = await res.json();
        if (data.success) {
            if (data.estatus === 'PASA') {
                alert(`✅ Medición guardada correctamente para ${id_elemento}. Estatus: PASA`);
            } else {
                alert(`⚠️ ¡MEDICIÓN GUARDADA PERO FUERA DE ESPECIFICACIÓN!\nEl activo ${id_elemento} excedió límites. Estatus: PENDIENTE.`);
            }
            extraPoints = [];
            renderExtraPoints();
            clearGenericPhoto('audit-photo-file', 'audit-photo-thumb', 'audit-photo-img', 'audit-photo-url');
            lookupScannedAsset(id_elemento);
        } else {
            alert('❌ Error al guardar la auditoría.');
        }
    };

