    function switchSettingsTab(tabName) {
        document.querySelectorAll('#mod-settings .tab-btn').forEach(btn => btn.classList.remove('active'));
        document.querySelectorAll('#mod-settings .tab-content').forEach(c => c.classList.remove('active'));
        
        const tabBtn = document.getElementById('set-tab-btn-' + tabName) || 
                       Array.from(document.querySelectorAll('#mod-settings .tab-btn')).find(b => b.getAttribute('onclick')?.includes(tabName));
        if (tabBtn) tabBtn.classList.add('active');

        const tabEl = document.getElementById('set-tab-' + tabName);
        if (tabEl) tabEl.classList.add('active');

        if (tabName === 'equipment') loadEquipmentTable();
        if (tabName === 'maps') loadMapsEditor();
