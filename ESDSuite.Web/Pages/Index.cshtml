    document.getElementById('form-infra-iso').onsubmit = async function(e) {
        e.preventDefault();
        const loc = document.getElementById('iso-loc').value;
        if (!loc) {
            alert(t('eventmeter.opt_select_line', 'Por favor selecciona una línea.'));
            return;
        }
        const assetId = document.getElementById('iso-asset-id').value;
        const op = document.getElementById('iso-op').value.trim();
        if (!op) {
            alert('Por favor ingresa la Operación / Estación / ID.');
            return;
        }
        const notes = document.getElementById('iso-notes').value.trim();
        const equipment_id = document.getElementById('iso-equipment-select')?.value || '';

        // Collect points
        const points = [];
        const z0 = document.getElementById('iso-pt-zone-0').value.trim();
        const v0 = parseFloat(document.getElementById('iso-pt-volt-0').value);
        const url0 = document.getElementById('iso-pt-url-0').value;
        if (!z0 || isNaN(v0)) {
            alert('Por favor ingresa la Zona y el Voltaje Máximo para la Medición #1.');
            return;
        }
        points.push({ zone: z0, voltage: v0, evidence_url: url0 });

        const extraCards = document.querySelectorAll('#iso-extra-points-container .iso-point-card');
        for (let i = 0; i < extraCards.length; i++) {
            const card = extraCards[i];
            const idxMatch = card.id.match(/\d+$/);
            if (!idxMatch) continue;
            const idx = idxMatch[0];
            const zEl = document.getElementById(`iso-pt-zone-${idx}`);
            const vEl = document.getElementById(`iso-pt-volt-${idx}`);
            const uEl = document.getElementById(`iso-pt-url-${idx}`);
            if (zEl && vEl) {
                const zVal = zEl.value.trim();
                const vVal = parseFloat(vEl.value);
                if (!zVal || isNaN(vVal)) {
                    alert(`Por favor completa la Zona y Voltaje para la Medición Extra.`);
                    return;
                }
                points.push({ zone: zVal, voltage: vVal, evidence_url: (uEl ? uEl.value : '') });
            }
        }

        try {
            const res = await fetch('/api/infra/isolated', {
                method: 'POST',
                headers: { 
                    'Content-Type': 'application/json',
                    'X-User-Id': (sessionData && sessionData.user_id) || '',
                    'X-User-Role': (sessionData && sessionData.user_role) || ''
                },
                body: JSON.stringify({
                    location: loc,
                    asset_id: assetId,
                    operation_id: op,
                    equipment_id: equipment_id,
                    points: points,
                    notes: notes,
                    site_id: (sessionData && sessionData.site_id) || ''
                })
            });
            const data = await res.json();
            if (res.ok && data.success) {
                if (data.status_result === 'FAIL') {
                    alert(t('infra.iso_warn_fail', '⚠️ ADVERTENCIA: Uno o más voltajes exceden el rango normativo (-35V a +35V). El registro se guardó como FAIL.'));
                } else {
                    alert('✅ Registro de Conductor Aislado guardado exitosamente (PASS).');
                }

                // Reset form fields
                document.getElementById('iso-loc').value = '';
                document.getElementById('iso-asset-id').innerHTML = '<option value="">-- Seleccionar Activo / Equipo --</option>';
                document.getElementById('iso-op').value = '';
                document.getElementById('iso-pt-zone-0').value = '';
                document.getElementById('iso-pt-volt-0').value = '';
                clearIsoPhoto(0);
                updateIsoPointBadge(0);
                document.getElementById('iso-extra-points-container').innerHTML = '';
                isoExtraPointsCount = 0;
                document.getElementById('iso-notes').value = '';

                await loadIsolatedHistory();
            } else {
                alert('❌ Error al guardar conductor aislado.');
            }
        } catch(ex) {
            alert('❌ Error de conexión con el servidor.');
        }
    };

    // ========================================================
    // ENTRANCE CHECKERS CALIBRATION & VERIFICATION LOGIC
    // ========================================================
    function updateCheckerVariation() {
        const readLStr = document.getElementById('chk-read-l').value.trim();
        const readRStr = document.getElementById('chk-read-r').value.trim();
        const refLStr = document.getElementById('chk-ref-l').value.trim();
        const refRStr = document.getElementById('chk-ref-r').value.trim();

        const readL = parseFloat(readLStr);
        const readR = parseFloat(readRStr);
        const refL = parseFloat(refLStr);
        const refR = parseFloat(refRStr);

        const minR = parseFloat(document.getElementById('chk-range-min').value) || 1e3;
        const maxR = parseFloat(document.getElementById('chk-range-max').value) || 1e12;
        const totalDecades = (Math.log10(maxR) - Math.log10(minR)) || 9;

        const devLText = document.getElementById('chk-dev-l-text');
        const devRText = document.getElementById('chk-dev-r-text');
        const overallBadge = document.getElementById('chk-overall-badge');

        let devLPct = null;
        let devRPct = null;

        if (!isNaN(readL) && !isNaN(refL) && readL > 0 && refL > 0) {
            devLPct = (Math.abs(Math.log10(readL) - Math.log10(refL)) / totalDecades) * 100;
            const isPassL = devLPct <= 5.0;
            devLText.innerHTML = `<span style="font-weight:700; color:${isPassL ? 'var(--accent-emerald)' : 'var(--accent-rose)'};">${devLPct.toFixed(2)}% (${isPassL ? 'PASS ≤ 5%' : 'FAIL > 5%'})</span>`;
        } else {
            devLText.innerHTML = `<span style="color:var(--text-muted);">-</span>`;
        }

        if (!isNaN(readR) && !isNaN(refR) && readR > 0 && refR > 0) {
            devRPct = (Math.abs(Math.log10(readR) - Math.log10(refR)) / totalDecades) * 100;
            const isPassR = devRPct <= 5.0;
            devRText.innerHTML = `<span style="font-weight:700; color:${isPassR ? 'var(--accent-emerald)' : 'var(--accent-rose)'};">${devRPct.toFixed(2)}% (${isPassR ? 'PASS ≤ 5%' : 'FAIL > 5%'})</span>`;
        } else {
            devRText.innerHTML = `<span style="color:var(--text-muted);">-</span>`;
        }

        if (devLPct !== null || devRPct !== null) {
            overallBadge.style.display = 'inline-block';
            const passL = devLPct === null || devLPct <= 5.0;
            const passR = devRPct === null || devRPct <= 5.0;
            if (passL && passR) {
                overallBadge.className = 'badge-pass';
                overallBadge.innerText = '🟢 PASS (Tolerancia Conforme ≤ 5.0%)';
            } else {
                overallBadge.className = 'badge-fail';
                overallBadge.innerText = '🔴 FAIL (Variación > 5.0% / Requiere Calibración)';
            }
        } else {
            overallBadge.style.display = 'none';
        }
    }

