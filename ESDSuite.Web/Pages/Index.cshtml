        if (!overlay || !currentViewerMap || !currentViewerMap.points) return;

        overlay.innerHTML = '';
        let total = currentViewerMap.points.length;
        let measured = 0;
        let pass = 0;
        let fail = 0;

        currentViewerMap.points.forEach((pt, idx) => {
            const pin = document.createElement('div');
            pin.className = 'floor-pin';
            pin.style.left = `${pt.xPercent}%`;
            pin.style.top = `${pt.yPercent}%`;

            let resText = 'N/D';
            if (pt.lastResistanceOhms != null && !isNaN(pt.lastResistanceOhms)) {
                measured++;
                const ohms = parseFloat(pt.lastResistanceOhms);
                resText = formatResistanceScientific(ohms) + ' Ω';

                if (ohms <= 1.0e8) {
                    pin.classList.add('pin-pass');
                    pass++;
                } else if (ohms <= 1.0e9) {
                    pin.classList.add('pin-warning');
                    pass++;
                } else {
                    pin.classList.add('pin-fail');
                    fail++;
                }
            }

            pin.innerHTML = `${pt.code || (idx + 1)}<div class="pin-tooltip"><b>${pt.label || 'Punto ' + (idx + 1)}</b>: ${resText}</div>`;
            pin.addEventListener('click', () => openPointMeasurementModal(idx));
            overlay.appendChild(pin);
        });

        document.getElementById('v-total-pts').innerText = total;
        document.getElementById('v-measured-pts').innerText = measured;
        document.getElementById('v-pass-pts').innerText = pass;
        document.getElementById('v-fail-pts').innerText = fail;
    }

    function formatResistanceScientific(val) {
        if (val == null || val === '' || val === '-') return '-';
        const num = typeof val === 'number' ? val : parseFloat(val.toString().replace(/,/g, ''));
        if (isNaN(num)) return val.toString();
        if (num < 10) {
            return num.toFixed(2);
        }
        if (num < 1000) {
            return Math.round(num).toString();
        }
        let exp = Math.floor(Math.log10(num));
        let mantissa = num / Math.pow(10, exp);
        if (parseFloat(mantissa.toFixed(2)) >= 10.0) {
            mantissa /= 10.0;
            exp += 1;
        }
        return `${mantissa.toFixed(2)}x10^${exp}`;
    }

