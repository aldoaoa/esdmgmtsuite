                const readRFmt = formatResistanceScientific(r.reading_right);
                const refRFmt = formatResistanceScientific(r.reference_right);
                let devR = r.deviation_right != null ? parseFloat(r.deviation_right) : 0;

                // Normalize any legacy anomalous raw values from early test data
                if (devL > 100 && isPass && r.reading_left > 0 && r.reference_left > 0) {
                    const logDiff = Math.abs(Math.log10(r.reading_left) - Math.log10(r.reference_left));
