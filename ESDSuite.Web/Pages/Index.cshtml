<script>
    let currentModule = 'dashboard';
    let sessionData = null;
    let extraPoints = [];
    let currentLocale = {};
    let allCompanies = [];
    let allSites = [];

    // QR SCANNER STATE
    let html5QrCode = null;
    let videoDevices = [];
    let currentCamIdx = 0;
    let wideCamId = null;

    window.onload = function() {
        checkSession();
    };

    async function checkSession() {
        try {
            const res = await fetch('/api/session');
            const data = await res.json();
            if (data.isLoggedIn) {
                sessionData = data;
                document.getElementById('login-overlay').style.display = 'none';
                document.getElementById('user-display-name').innerText = data.user_name || data.user_email;
                document.getElementById('user-display-role').innerText = data.user_role || 'AUDITOR';
                document.getElementById('user-avatar-initials').innerText = (data.user_name || 'U').substring(0, 1).toUpperCase();
                document.getElementById('audit-auditor').value = data.user_name || 'Auditor ESD';
                
                const userLang = getStoredLang();
                if (document.getElementById('settings-lang-select')) document.getElementById('settings-lang-select').value = userLang;
                if (document.getElementById('login-landing-lang-select')) document.getElementById('login-landing-lang-select').value = userLang;
                if (data.version) document.getElementById('system-version-badge').innerText = 'v' + data.version;
                
                enforceRolePermissions();
                await loadTranslations(userLang);
                loadSites();
                loadDashboardMetrics();
            } else {
                const landingLang = getStoredLang();
                document.getElementById('login-overlay').style.display = 'flex';
                if (document.getElementById('login-landing-lang-select')) {
                    document.getElementById('login-landing-lang-select').value = landingLang;
                }
                await loadTranslations(landingLang);
            }
        } catch (e) {
            const landingLang = getStoredLang();
            document.getElementById('login-overlay').style.display = 'flex';
            if (document.getElementById('login-landing-lang-select')) {
                document.getElementById('login-landing-lang-select').value = landingLang;
            }
            await loadTranslations(landingLang);
        }
    }

    function getStoredLang() {
        const match = document.cookie.match(/(?:^|; )esd360_lang=([^;]*)/);
        if (match && match[1]) return match[1];
        return localStorage.getItem('esd360_lang') || 'en';
    }

    function setStoredLang(lang) {
        localStorage.setItem('esd360_lang', lang);
        document.cookie = `esd360_lang=${lang}; path=/; max-age=${365 * 24 * 60 * 60}; SameSite=Lax`;
    }

    function enforceRolePermissions() {
        const canComp = sessionData.can_create_company;
        const canSite = sessionData.can_create_site;
        const canArea = sessionData.can_create_area;
        const canUser = sessionData.can_create_user;
        const canChangeSite = sessionData.can_change_site;

        const btnComp = document.getElementById('btn-add-company');
        if (btnComp) btnComp.style.display = canComp ? 'inline-flex' : 'none';

        const btnSite = document.getElementById('btn-add-site');
        if (btnSite) btnSite.style.display = canSite ? 'inline-flex' : 'none';

        const siteSelect = document.getElementById('active-site-select');
        if (siteSelect) {
            siteSelect.disabled = !canChangeSite;
            if (!canChangeSite) {
                siteSelect.title = "Tu rol no permite cambiar de site. Estás asignado a tu planta.";
            }
        }

        // Filter user role options in User Creation Form based on session user permissions
        const roleSel = document.getElementById('u-role');
        if (roleSel) {
            Array.from(roleSel.options).forEach(opt => {
                if (opt.value === 'SuperAdmin') opt.disabled = !canComp;
                if (opt.value === 'CompanyAdmin') opt.disabled = !canComp;
                if (opt.value === 'SiteAdmin') opt.disabled = !canSite;
            });
        }
    }

    // --- I18N ENGINE LOGIC ---
    async function loadTranslations(lang) {
        try {
            const res = await fetch(`/locales/${lang}.json?v=${Date.now()}`);
            if (res.ok) {
                currentLocale = await res.json();
                applyTranslations();
            }
        } catch (e) {
            console.log('Error loading locale json:', e);
        }
    }

    function t(path, defaultStr) {
        if (!path) return defaultStr;
        const parts = path.split('.');
        let val = currentLocale;
        for (const p of parts) {
            if (val && val[p] !== undefined) val = val[p];
            else return defaultStr;
        }
        return typeof val === 'string' ? val : defaultStr;
    }

    function applyTranslations() {
        if (!currentLocale) return;

        document.querySelectorAll('[data-i18n]').forEach(el => {
            const key = el.getAttribute('data-i18n');
            const translated = t(key, null);
            if (translated !== null && translated !== undefined) {
                if (el.tagName === 'INPUT' || el.tagName === 'TEXTAREA') {
                    if (el.hasAttribute('placeholder')) el.placeholder = translated;
                } else {
                    el.innerHTML = translated;
                }
            }
        });

        document.querySelectorAll('[data-i18n-placeholder]').forEach(el => {
            const key = el.getAttribute('data-i18n-placeholder');
            const translated = t(key, null);
            if (translated !== null && translated !== undefined) {
                el.placeholder = translated;
            }
        });

        document.querySelectorAll('[data-i18n-title]').forEach(el => {
            const key = el.getAttribute('data-i18n-title');
            const translated = t(key, null);
            if (translated !== null && translated !== undefined) {
                el.title = translated;
            }
        });

        if (currentModule) {
            const hTitle = document.getElementById('header-module-title');
            const hSub = document.getElementById('header-module-caption');
            if (hTitle) {
                const titleVal = t(currentModule + '.title', null);
                if (titleVal !== null) hTitle.innerHTML = titleVal;
            }
            if (hSub) {
                const subVal = t(currentModule + '.subtitle', null);
                if (subVal !== null) hSub.innerHTML = subVal;
            }
        }

        if (typeof populateElementSubtypes === 'function') {
            const eqTypeEl = document.getElementById('audit-tipo-equipo');
            if (eqTypeEl) populateElementSubtypes(eqTypeEl.value);
        }
        if (typeof renderExtraPoints === 'function') {
            renderExtraPoints();
        }
    }

