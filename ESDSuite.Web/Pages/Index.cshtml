            list.forEach((r, idx) => {
                const dateStr = r.measured_at ? new Date(r.measured_at).toLocaleDateString() + ' ' + new Date(r.measured_at).toLocaleTimeString([], {hour:'2-digit', minute:'2-digit'}) : '-';
