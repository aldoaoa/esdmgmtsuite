    document.getElementById('form-event-meter').onsubmit = async function(e) {
        e.preventDefault();
        const linea = document.getElementById('em-linea').value;
        const opId = document.getElementById('em-op-id').value;
        if (!linea) {
            alert(t('eventmeter.opt_select_line', 'Por favor selecciona una línea de producción.'));
            return;
        }
        if (!opId) {
            alert(t('eventmeter.opt_select_asset', 'Por favor selecciona o ingresa el ID de Operación.'));
            return;
        }

        const tiempoRaw = document.getElementById('em-tiempo-valor').value.trim();
        const tiempoVal = tiempoRaw ? parseFloat(tiempoRaw) : null;
        if (!tiempoVal) {
            alert(t('eventmeter.ph_duration', 'Por favor ingresa el tiempo de análisis.'));
            return;
        }
        const tiempoUnidad = document.getElementById('em-tiempo-unidad').value || 'min';
        const tiempoAnalisis = `${tiempoVal} ${tiempoUnidad}`;

        const tempRaw = document.getElementById('em-temp').value.trim();
        const humRaw = document.getElementById('em-hum').value.trim();
        const tempVal = tempRaw ? parseFloat(tempRaw) : 23.5;
        const humVal = humRaw ? parseFloat(humRaw) : 45.0;

        const payload = {
            linea_ubicacion: linea,
            id_operacion: opId,
            tipo_contacto: document.getElementById('em-contacto').value,
            tiempo_analisis: tiempoAnalisis,
            tiempo_analisis_valor: tiempoVal,
            tiempo_analisis_unidad: tiempoUnidad,
            cantidad_eventos: parseInt(document.getElementById('em-cant').value) || 0,
            voltaje_maximo: parseFloat(document.getElementById('em-volt-max').value) || 0,
            temperatura: tempVal,
            humedad: humVal,
            equipment_id: document.getElementById('em-equipment-select')?.value || '',
            evidence_url: document.getElementById('em-photo-url')?.value || '',
            notas: document.getElementById('em-notas').value.trim()
        };

        try {
            const res = await fetch('/api/event-meter', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            });
            const data = await res.json();
            if (data.success) {
                if (data.is_out_of_limit || data.estatus === 'FAIL' || payload.voltaje_maximo > 100) {
                    alert(`⚠️ ¡ALERTA DE DESCARGA FUERA DE LÍMITE!\n\nEl estudio se guardó exitosamente en el sistema, pero el voltaje máximo detectado (${payload.voltaje_maximo} V) EXCEDE el límite permitido de 100 V (Estatus: FAIL / RECHAZADO).\n\nSe requiere atención y revisión en la línea/operación.`);
                } else {
                    alert(`${t('eventmeter.saved_success', 'Estudio Event Meter registrado exitosamente.')} (Estatus: PASS)`);
                }
                document.getElementById('em-linea').value = '';
                document.getElementById('em-op-id').innerHTML = `<option value="">${t('eventmeter.opt_select_asset', '-- Seleccionar Activo u Operación --')}</option>`;
                document.getElementById('em-tiempo-valor').value = '';
                document.getElementById('em-cant').value = '';
                document.getElementById('em-volt-max').value = '';
                document.getElementById('em-temp').value = '';
                document.getElementById('em-hum').value = '';
                document.getElementById('em-notas').value = '';
                clearGenericPhoto('em-photo-file', 'em-photo-thumb', 'em-photo-img', 'em-photo-url');
                loadEventMeterHistory();
            } else {
                alert('❌ Error al guardar el registro de Event Meter.');
            }
        } catch(ex) {
            alert('❌ Error de conexión al servidor.');
        }
    };

    async function loadEventMeterHistory() {
        const container = document.getElementById('event-meter-history-table');
        if (!container) return;

        try {
            const siteId = sessionData.site_id || '';
            const res = await fetch(`/api/event-meter?siteId=${siteId}`);
            if (!res.ok) throw new Error('Error fetching event meter history');
            const logs = await res.json();
            cachedEventMeterLogs = logs || [];

            if (cachedEventMeterLogs.length === 0) {
                container.innerHTML = `<div class="glass-card" style="text-align:center; padding:20px; color:var(--text-muted); font-size:13px;">${t('eventmeter.no_records', 'No hay registros de Event Meter para este site.')}</div>`;
                return;
            }

            const isAdmin = sessionData.can_create_user || sessionData.user_role === 'SuperAdmin' || sessionData.user_role === 'CompanyAdmin' || sessionData.user_role === 'SiteAdmin';

            let html = `<div class="table-responsive" style="max-height:500px; overflow-y:auto; border:1px solid var(--border-color); border-radius:8px;">
                <table class="data-table" style="margin:0; width:100%;">
                    <thead style="position:sticky; top:0; background:#F8FAFC; z-index:2;">
                        <tr>
                            <th style="min-width:120px;" data-i18n="eventmeter.col_date">${t('eventmeter.col_date', 'Fecha')}</th>
                            <th style="min-width:130px;" data-i18n="eventmeter.col_line">${t('eventmeter.col_line', 'Línea / Ubicación')}</th>
                            <th style="min-width:120px;" data-i18n="eventmeter.col_op_id">${t('eventmeter.col_op_id', 'ID Operación')}</th>
                            <th style="min-width:110px;" data-i18n="eventmeter.col_contact">${t('eventmeter.col_contact', 'Contacto')}</th>
                            <th style="min-width:90px; text-align:center;" data-i18n="eventmeter.col_duration">${t('eventmeter.col_duration', 'Tiempo')}</th>
                            <th style="min-width:80px; text-align:center;" data-i18n="eventmeter.col_events">${t('eventmeter.col_events', 'Eventos')}</th>
                            <th style="min-width:100px;" data-i18n="eventmeter.col_volt_max">${t('eventmeter.col_volt_max', 'Voltaje Máx')}</th>
                            <th style="min-width:110px;" data-i18n="eventmeter.col_temp_hum">${t('eventmeter.col_temp_hum', 'Temp / Hum')}</th>
                            <th style="min-width:85px; text-align:center;" data-i18n="eventmeter.col_status">${t('eventmeter.col_status', 'Estatus')}</th>
                            ${isAdmin ? `<th style="min-width:140px; text-align:center;" data-i18n="eventmeter.col_actions">${t('eventmeter.col_actions', 'Acciones')}</th>` : ''}
                        </tr>
                    </thead>
                    <tbody>`;

            cachedEventMeterLogs.forEach(l => {
                const dateStr = l.measured_at ? new Date(l.measured_at).toLocaleDateString() + ' ' + new Date(l.measured_at).toLocaleTimeString([], {hour:'2-digit', minute:'2-digit'}) : '-';
                const statusBadge = (l.status_result === 'PASS') 
                    ? `<span class="badge-pass" style="font-size:11px; padding:3px 8px;">PASS</span>` 
                    : `<span class="badge-fail" style="font-size:11px; padding:3px 8px;">FAIL</span>`;
                const tempHum = (l.temperatura || l.humedad) ? `${l.temperatura || '--'}°C / ${l.humedad || '--'}%` : '-';
                const durationStr = l.tiempo_analisis || (l.tiempo_analisis_valor ? `${l.tiempo_analisis_valor} ${l.tiempo_analisis_unidad || 'min'}` : '-');
                const obsTooltip = l.observaciones ? `<div style="font-size:11px; color:var(--text-muted); font-style:italic; margin-top:2px;">${l.observaciones}</div>` : '';

                html += `<tr>
                    <td style="font-size:12px;"><b>${dateStr}</b></td>
