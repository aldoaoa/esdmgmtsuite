                            ${p.zone || 'P' + (pIdx + 1)}: ${pV > 0 ? '+' : ''}${pV}V
                        </span>`;
                        if (p.evidence_url && photoThumbHtml.includes('-')) {
                            photoThumbHtml = `<img src="${p.evidence_url}" style="width:36px; height:36px; object-fit:cover; border-radius:4px; border:1px solid var(--border-color); cursor:pointer;" onclick="previewIsoImageModal('${p.evidence_url}')" title="Ver foto" />`;
