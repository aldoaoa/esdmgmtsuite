                            <span style="color:var(--text-muted);">|</span>
                            <strong style="font-size:13.5px; color:var(--accent-blue); font-family:monospace;">${r.id_elemento || 'EQ'}</strong>
                            <span style="font-size:12.5px; font-weight:600; color:var(--text-secondary);">(${elemTranslated})</span>
                            <span style="color:var(--text-muted);">&bull;</span>
                            <span style="font-size:12px; color:var(--text-muted);">${r.ubicacion || 'Línea N/D'}</span>
                        </div>
                        <div style="display:flex; align-items:center; gap:10px;">
                            <span style="font-size:11.5px; font-weight:700; color:${colorClass}; padding:3px 9px; border-radius:12px; background:#FFF; border:1px solid ${borderClass};">
                                ${r.resultado || 'CUMPLE'}
                            </span>
                            <span style="font-size:13px; color:var(--text-muted);" id="icon-${cardId}">▼</span>
                        </div>
                    </div>

                    <!-- Collapsible Body -->
                    <div id="${cardId}" style="display:block; padding:16px; background:#FFFFFF;">
                        <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(200px, 1fr)); gap:16px; font-size:12.5px;">
                            <!-- Column 1: Elemento -->
                            <div>
                                <h5 style="margin:0 0 8px 0; font-size:12px; font-weight:700; color:var(--accent-blue);">📦 Elemento</h5>
                                <div><strong>ID:</strong> <span style="font-family:monospace;">${r.id_elemento || 'N/D'}</span></div>
                                <div><strong>Fabricante:</strong> ${r.fabricante_elem || 'N/D'}</div>
                                <div><strong>Modelo:</strong> ${r.modelo_elem || 'N/D'}</div>
                                <div><strong>Material:</strong> ${r.tipo_material || 'N/D'}</div>
                                <div><strong>No. Serie:</strong> <span style="font-family:monospace;">${r.sn_elem || 'N/D'}</span></div>
                                <div style="margin-top:6px; font-size:11.5px; color:var(--text-muted);">
                                    🌡️ ${tempFormatted} &bull; 💧 ${humidityStr}
                                </div>
                            </div>

                            <!-- Column 2: Trazabilidad -->
                            <div>
                                <h5 style="margin:0 0 8px 0; font-size:12px; font-weight:700; color:var(--accent-blue);">🛠️ Trazabilidad</h5>
                                <div><strong>Equipo Utilizado:</strong> <span style="font-weight:600;">${r.id_equipo_utilizado || 'MEG-01'}</span></div>
                                <div><strong>Certificado:</strong> ${r.reporte_cal || 'CERT-2026'}</div>
                                <div><strong>Próx. Cal.:</strong> <span style="color:var(--accent-blue); font-weight:600;">${r.fecha_prox_cal || 'N/D'}</span></div>
                                <div><strong>Auditor:</strong> ${r.auditor || 'Auditor ESD'}</div>
                            </div>

