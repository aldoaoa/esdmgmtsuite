                    <td style="font-size:12px;">
                        <span>${chkAbbr}: <b>${readRFmt}</b> Ω</span><br/>
                        <span style="color:var(--text-muted); font-size:11px;">${refAbbr}: ${refRFmt} Ω</span>
                    </td>
                    <td style="text-align:center; font-weight:700; color:${devR <= 5.0 ? 'var(--accent-emerald)' : 'var(--accent-rose)'};">${devR.toFixed(2)}%</td>
